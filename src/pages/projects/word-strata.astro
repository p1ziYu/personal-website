			</section>

			<!-- 6. FOOTER SECTION & AI DECLARATION (REPLICATED FROM LIGHTBEARER-LAB) -->
			<div class="pt-6 border-t border-zinc-800/80 text-xs font-mono text-zinc-400 flex flex-col sm:flex-row items-center justify-between gap-3">
				<div>
					<span class="lang-zh">灵感：2026 诺贝尔文学奖（Anne Carson）· 词层考古与古希腊词源探掘</span>
					<span class="lang-en">Inspired by the 2026 Nobel Prize in Literature (Anne Carson) · Etymology Excavation</span>
				</div>
				<div class="text-zinc-500">
					p1ziyu.com · 2026
				</div>
			</div>

			<hr class="my-6 border-zinc-800" />
			<blockquote class="text-xs opacity-50 border-l-2 border-amber-500/40 pl-3 py-1 my-4 italic">
				<span class="lang-zh">本文由 AI 生成。</span>
				<span class="lang-en">Generated by AI.</span>
			</blockquote>
		</div>
	</div>

	<!-- VANILLA JS CLIENT-SIDE ENGINE -->
	<script is:inline>
		(() => {
			function initWordStrata() {
				// ----------------------------------------------------
				// 1. THE WORD TRENCH EXCAVATION GAME ENGINE
				// ----------------------------------------------------
				const trenchTiles = document.querySelectorAll(".trench-tile");
				const trenchCounter = document.getElementById("trench-counter");
				const trenchCelebration = document.getElementById("trench-celebration");
				const btnExcavateAll = document.getElementById("btn-excavate-all");
				const btnResetTrench = document.getElementById("btn-reset-trench");

				function updateTrenchCounter() {
					let excavatedCount = 0;
					trenchTiles.forEach((tile) => {
						const depth = parseInt(tile.getAttribute("data-depth") || "1", 10);
						if (depth === 3) excavatedCount++;
					});

					if (trenchCounter) {
						trenchCounter.textContent = String(excavatedCount);
					}

					if (trenchCelebration) {
						if (excavatedCount === 8) {
							trenchCelebration.classList.remove("hidden");
						} else {
							trenchCelebration.classList.add("hidden");
						}
					}
				}

				function setTileDepth(tile, depth) {
					tile.setAttribute("data-depth", String(depth));
					const s1 = tile.querySelector(".stratum-1");
					const s2 = tile.querySelector(".stratum-2");
					const s3 = tile.querySelector(".stratum-3");
					const pill = tile.querySelector(".trench-depth-pill");
					const dots = tile.querySelector(".trench-level-dots");
					const icon = tile.querySelector(".trench-status-icon");

					if (s1) s1.classList.toggle("hidden", depth !== 1);
					if (s2) s2.classList.toggle("hidden", depth !== 2);
					if (s3) s3.classList.toggle("hidden", depth !== 3);

					if (depth === 1) {
						if (pill) pill.textContent = "L1 表层";
						if (dots) dots.textContent = "● ○ ○";
						if (icon) icon.textContent = "⛏️";
						tile.classList.remove("border-amber-500/70", "bg-amber-950/20", "shadow-[0_0_15px_rgba(245,158,11,0.2)]");
					} else if (depth === 2) {
						if (pill) pill.textContent = "L2 迂回";
						if (dots) dots.textContent = "● ● ○";
						if (icon) icon.textContent = "⛏️";
						tile.classList.remove("border-amber-500/70", "bg-amber-950/20", "shadow-[0_0_15px_rgba(245,158,11,0.2)]");
					} else if (depth === 3) {
						if (pill) pill.textContent = "L3 基岩 ★";
						if (dots) dots.textContent = "● ● ●";
						if (icon) icon.textContent = "✨";
						tile.classList.add("border-amber-500/70", "bg-amber-950/20", "shadow-[0_0_15px_rgba(245,158,11,0.2)]");
					}
					updateTrenchCounter();
				}

				trenchTiles.forEach((tile) => {
					tile.addEventListener("click", () => {
						const currentDepth = parseInt(tile.getAttribute("data-depth") || "1", 10);
						const nextDepth = currentDepth >= 3 ? 1 : currentDepth + 1;
						setTileDepth(tile, nextDepth);
					});
				});

				if (btnExcavateAll) {
					btnExcavateAll.addEventListener("click", () => {
						trenchTiles.forEach((tile) => setTileDepth(tile, 3));
					});
				}

				if (btnResetTrench) {
					btnResetTrench.addEventListener("click", () => {
						trenchTiles.forEach((tile) => setTileDepth(tile, 1));
					});
				}

				// ----------------------------------------------------
				// 2. SWEET-BITTER METER ENGINE
				// ----------------------------------------------------
				const slider = document.getElementById("sweet-bitter-slider");
				const statusBadge = document.getElementById("meter-status-badge");
				const paradoxCards = document.querySelectorAll(".paradox-card");

				const descriptions = [
					// Pair 1: reach / grasp
					{
						low: { zh: "纯粹甘美：指尖伸展于无限距离，渴望因未曾触及而常新。", en: "Pure sweetness: reaching across boundless air; wanting stays luminous." },
						mid: { zh: "苦甜相依：伸手与握紧的恒久拉锯，欲望栖居在将及未及的间距中。", en: "Sweet-bitter: the perennial tension between reach and grasp." },
						high: { zh: "冷峻苦涩：五指攥紧占有，距离坍缩成实物，欲念随之消亡。", en: "Severe bitterness: grasping hard; distance collapses into possession." }
					},
					// Pair 2: ancient / modern
					{
						low: { zh: "纯粹甘美：萨福与古风抒情诗，黄金时代的残卷与里拉琴余音。", en: "Pure sweetness: Sappho and archaic lyric gold, lyres in the morning." },
						mid: { zh: "苦甜相依：跨越时空的古今对谈，神话在打字机与录音带中借体还魂。", en: "Sweet-bitter: ancient myths breathing through 20th-century tape recorders." },
						high: { zh: "冷峻苦涩：现代火山旅馆与冰岛寒风，剥离一切温情神话的严酷当下。", en: "Severe bitterness: volcanic motels and gales, stripped of comfort." }
					},
					// Pair 3: verse / prose
					{
						low: { zh: "纯粹甘美：音步跳跃与轻灵短句，诗歌留白的微光与喘息。", en: "Pure sweetness: lyrical staccato and crystalline line breaks." },
						mid: { zh: "苦甜相依：长诗小说的混合体裁，叙事逻辑与韵律冲撞出新的火花。", en: "Sweet-bitter: the verse novel hybrid, narrative wrestling with rhythm." },
						high: { zh: "冷峻苦涩：文献学家冰冷的解剖刀，古典学注释的严谨重力。", en: "Severe bitterness: the philologist's scalpel and academic rigor." }
					},
					// Pair 4: night / noon
					{
						low: { zh: "纯粹甘美：黑夜的温柔怀抱，星空下未曾言明的梦境与爱抚。", en: "Pure sweetness: night's gentle cloak, unuttered dreams under stars." },
						mid: { zh: "苦甜相依：晨昏交接的薄暮微光，在此刻词源的古老轮廓最为清晰。", en: "Sweet-bitter: crepuscular twilight where archaic contours surface." },
						high: { zh: "冷峻苦涩：正午烈日的无情曝晒，真相如锋利白光无处躲藏。", en: "Severe bitterness: harsh illumination under noon's unsparing sun." }
					},
					// Pair 5: monster / hero
					{
						low: { zh: "纯粹甘美：长着红羽翼的害羞少年革律翁，在黑暗中守护自己的相机。", en: "Pure sweetness: shy red-winged Geryon tending his camera in secret." },
						mid: { zh: "苦甜相依：颠倒的神话图景，被诛戮的异类比暴烈的征服者更具人性。", en: "Sweet-bitter: inverted myth where the slain beast outlives the hero." },
						high: { zh: "冷峻苦涩：赫拉克勒斯的青铜利刃，英雄史诗对异质生命的无情屠戮。", en: "Severe bitterness: Herakles' bronze sword, brute heroic conquest." }
					},
					// Pair 6: silence / song
					{
						low: { zh: "纯粹甘美：抒情狂喜的最高赞歌，音符拨动心弦的甘甜颤音。", en: "Pure sweetness: euphoric lyric hymn and melodic strings." },
						mid: { zh: "苦甜相依：音节边缘的深长留白，唱罢之后空气中未散的余震。", en: "Sweet-bitter: the pregnant pause between syllables, vibrating stillness." },
						high: { zh: "冷峻苦涩：北大西洋荒原上的沉寂，卡森在冰岛“聆听风声”。", en: "Severe bitterness: North Atlantic squalls, Carson 'listening to the wind'." }
					}
				];

				function updateMeter(val) {
					const sweetPct = 100 - val;
					const bitterPct = val;

					if (statusBadge) {
						if (val < 35) {
							statusBadge.textContent = `🍯 SWEET 甘美占优 (${sweetPct}% : ${bitterPct}%)`;
							statusBadge.className = "px-3 py-1 rounded-full text-xs font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40";
						} else if (val > 65) {
							statusBadge.textContent = `🗡️ BITTER 苦烈占优 (${sweetPct}% : ${bitterPct}%)`;
							statusBadge.className = "px-3 py-1 rounded-full text-xs font-mono font-bold bg-red-500/20 text-red-300 border border-red-500/40";
						} else {
							statusBadge.textContent = `⚖️ GLUKUPRIKON · 苦甜交织 (${sweetPct}% : ${bitterPct}%)`;
							statusBadge.className = "px-3 py-1 rounded-full text-xs font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40";
						}
					}

					paradoxCards.forEach((card, idx) => {
						const ratioElem = card.querySelector(".paradox-ratio");
						const leftSpan = card.querySelector(".card-left");
						const rightSpan = card.querySelector(".card-right");
						const descElem = card.querySelector(".paradox-desc");

						if (ratioElem) ratioElem.textContent = `${sweetPct}% : ${bitterPct}%`;

						// Visual crossfade opacity
						const leftOpacity = Math.max(0.2, (100 - val) / 100);
						const rightOpacity = Math.max(0.2, val / 100);
						if (leftSpan) leftSpan.style.opacity = String(leftOpacity);
						if (rightSpan) rightSpan.style.opacity = String(rightOpacity);

						// Switch descriptions according to pole
						const item = descriptions[idx];
						if (item && descElem) {
							let tier = "mid";
							if (val < 35) tier = "low";
							else if (val > 65) tier = "high";

							const zhSpan = descElem.querySelector(".lang-zh");
							const enSpan = descElem.querySelector(".lang-en");
							if (zhSpan) zhSpan.textContent = item[tier].zh;
							if (enSpan) enSpan.textContent = item[tier].en;
						}
					});
				}

				if (slider) {
					slider.addEventListener("input", (e) => {
						const val = parseInt(e.target.value, 10);
						updateMeter(val);
					});
					updateMeter(parseInt(slider.value, 10));
				}
			}

			initWordStrata();
			document.addEventListener("astro:page-load", initWordStrata);
		})();
	</script>
</MainGridLayout>
