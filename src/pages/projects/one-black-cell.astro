					class3: [18, 22, 30, 45, 60, 90, 105, 126, 150],
					// Class 4: complex / localized gliders / universal
					class4: [54, 110, 124, 137, 193]
				};

				function getWolframClass(rule) {
					if (WOLFRAM_CLASSES.class4.includes(rule)) {
						return { nameZh: "Class 4 · 复杂图灵完备", nameEn: "Class 4 · Complex / Universal", descZh: "局部滑翔机相撞与通用计算", descEn: "Gliders & universal computation", color: "text-purple-400" };
					}
					if (WOLFRAM_CLASSES.class3.includes(rule)) {
						return { nameZh: "Class 3 · 确定性混沌", nameEn: "Class 3 · Chaotic", descZh: "非周期性不可约混沌结构", descEn: "Aperiodic irreducible chaos", color: "text-rose-400" };
					}
					if (WOLFRAM_CLASSES.class2.includes(rule)) {
						return { nameZh: "Class 2 · 周期条纹", nameEn: "Class 2 · Periodic", descZh: "收敛于周期性振荡与稳定条纹", descEn: "Periodic stripes & oscillations", color: "text-blue-400" };
					}
					if (WOLFRAM_CLASSES.class1.includes(rule)) {
						return { nameZh: "Class 1 · 均质冻结", nameEn: "Class 1 · Homogeneous", descZh: "演化迅速收敛于全死或全生形态", descEn: "Freezes into uniform state", color: "text-slate-400" };
					}
					return { nameZh: "Class 2/3 · 复合模式", nameEn: "Class 2/3 · Hybrid", descZh: "介于条纹与混沌之间的混合演化", descEn: "Intermediate discrete dynamical state", color: "text-cyan-400" };
				}

				// ==========================================
				// 2. DOM ELEMENT REFERENCES
				// ==========================================
				const universeCanvas = document.getElementById("universe-canvas");
				const uCtx = universeCanvas ? universeCanvas.getContext("2d") : null;

				const metricRuleNum = document.getElementById("metric-rule-num");
				const metricRuleBin = document.getElementById("metric-rule-bin");
				const metricClassName = document.getElementById("metric-class-name");
				const metricClassDesc = document.getElementById("metric-class-desc");
				const metricStepCount = document.getElementById("metric-step-count");
				const metricDensity = document.getElementById("metric-density");
				const metricAliveCount = document.getElementById("metric-alive-count");
				const metricGridDim = document.getElementById("metric-grid-dim");
				const metricFps = document.getElementById("metric-fps");
				const metricEngineState = document.getElementById("metric-engine-state");

				const btnPlayPause = document.getElementById("btn-play-pause");
				const playIcon = document.getElementById("play-icon");
				const playText = document.getElementById("play-text");
				const playTextEn = document.getElementById("play-text-en");
				const btnStep = document.getElementById("btn-step");
				const btnStep10 = document.getElementById("btn-step-10");
				const btnRestart = document.getElementById("btn-restart");
				const btnDownload = document.getElementById("btn-download");

				const inputRuleNum = document.getElementById("input-rule-num");
				const sliderRuleNum = document.getElementById("slider-rule-num");
				const sliderSpeed = document.getElementById("slider-speed");
				const speedLabel = document.getElementById("speed-label");
				const sliderGen = document.getElementById("slider-gen");
				const genLabel = document.getElementById("gen-label");
				const sliderCellSize = document.getElementById("slider-cell-size");
				const cellSizeLabel = document.getElementById("cell-size-label");

				const seedCellsStrip = document.getElementById("seed-cells-strip");
				const seedStat = document.getElementById("seed-stat");
				const seedBtnSingle = document.getElementById("seed-btn-single");
				const seedBtnSoup = document.getElementById("seed-btn-soup");
				const seedBtnDouble = document.getElementById("seed-btn-double");
				const seedBtnInvert = document.getElementById("seed-btn-invert");
				const seedBtnClear = document.getElementById("seed-btn-clear");

				const inspX = document.getElementById("insp-x");
				const inspT = document.getElementById("insp-t");
				const inspVal = document.getElementById("insp-val");
				const inspNeigh = document.getElementById("insp-neigh");

				const formulaBreakdown = document.getElementById("formula-breakdown");
				const ruleBitBtns = document.querySelectorAll(".rule-bit-btn");
				const presetBtns = document.querySelectorAll(".preset-btn");
				const themeBtns = document.querySelectorAll(".theme-btn");
				const galleryCards = document.querySelectorAll(".gallery-card");

				// ==========================================
				// 3. CORE CELLULAR AUTOMATA COMPUTATION
				// ==========================================
				// Compute next generation from previous generation row using currentRule
				function stepRow(prevRow, rule) {
					const nextRow = new Uint8Array(GRID_WIDTH);
					for (let i = 0; i < GRID_WIDTH; i++) {
						// Periodic toroidal boundary conditions
						const left = i === 0 ? prevRow[GRID_WIDTH - 1] : prevRow[i - 1];
						const center = prevRow[i];
						const right = i === GRID_WIDTH - 1 ? prevRow[0] : prevRow[i + 1];

						const neighborhood = (left << 2) | (center << 1) | right;
						nextRow[i] = (rule >> neighborhood) & 1;
					}
					return nextRow;
				}

				// Reset history from initialRow
				function resetSimulation() {
					history = [];
					const row0 = new Uint8Array(initialRow);
					history.push(row0);
					renderUniverseCanvas();
					updateStatusMetrics();
				}

				// Advance 1 generation step
				function advanceSimulation(count = 1) {
					for (let k = 0; k < count; k++) {
						const lastRow = history[history.length - 1];
						const next = stepRow(lastRow, currentRule);
						if (history.length >= maxGenerations) {
							// Waterfall scrolling: discard oldest row, append new row!
							history.shift();
						}
						history.push(next);
					}
					renderUniverseCanvas();
					updateStatusMetrics();
				}

				// ==========================================
				// 4. HIGH-DPI CANVAS RENDERING ENGINE
				// ==========================================
				function renderUniverseCanvas() {
					if (!universeCanvas || !uCtx) return;

					const palette = THEMES[currentTheme] || THEMES.ember;
					const w = GRID_WIDTH * cellSize;
					const h = maxGenerations * cellSize;

					if (universeCanvas.width !== w || universeCanvas.height !== h) {
						universeCanvas.width = w;
						universeCanvas.height = h;
					}

					// Clear canvas background
					uCtx.fillStyle = palette.bg;
					uCtx.fillRect(0, 0, w, h);

					// Draw cell grid generations
					const rowsToDraw = history.length;
					const aliveFill = palette.alive;

					uCtx.fillStyle = aliveFill;
					for (let r = 0; r < rowsToDraw; r++) {
						const row = history[r];
						const y = r * cellSize;
						for (let c = 0; c < GRID_WIDTH; c++) {
							if (row[c] === 1) {
								uCtx.fillRect(c * cellSize, y, cellSize, cellSize);
							}
						}
					}
				}

				// Update real-time statistics and badges
				function updateStatusMetrics() {
					if (!metricRuleNum) return;

					metricRuleNum.textContent = currentRule.toString();
					const binStr = currentRule.toString(2).padStart(8, "0");
					if (metricRuleBin) metricRuleBin.textContent = `${binStr}₂`;

					const wClass = getWolframClass(currentRule);
					if (metricClassName) {
						metricClassName.textContent = wClass.nameZh;
						metricClassName.className = `text-base font-black ${wClass.color} mt-1`;
					}
					if (metricClassDesc) metricClassDesc.textContent = wClass.descZh;
					if (metricStepCount) metricStepCount.textContent = history.length.toString();

					// Calculate active alive cell count & density across all rows currently visible
					let totalAlive = 0;
					let totalCells = history.length * GRID_WIDTH;
					for (let r = 0; r < history.length; r++) {
						const row = history[r];
						for (let c = 0; c < GRID_WIDTH; c++) {
							if (row[c] === 1) totalAlive++;
						}
					}
					const densityPct = totalCells > 0 ? ((totalAlive / totalCells) * 100).toFixed(1) : "0.0";
					if (metricDensity) metricDensity.textContent = `${densityPct}%`;
					if (metricAliveCount) metricAliveCount.textContent = `${totalAlive.toLocaleString()} / ${totalCells.toLocaleString()}`;
					if (metricGridDim) metricGridDim.textContent = `${GRID_WIDTH} 胞`;

					// Update Lookup Table Visualizer buttons (bit 7 down to bit 0)
					const weights = [1, 2, 4, 8, 16, 32, 64, 128];
					let formulaTerms = [];

					ruleBitBtns.forEach((btn) => {
						const bitIdx = Number.parseInt(btn.getAttribute("data-bit-idx") || "0", 10);
						const bitVal = (currentRule >> bitIdx) & 1;
						btn.textContent = bitVal.toString();
						if (bitVal === 1) {
							btn.className = "rule-bit-btn w-full py-1.5 rounded-lg font-black text-sm border transition cursor-pointer active:scale-95 bg-amber-500/20 text-amber-300 border-amber-500 shadow-[0_0_8px_rgba(245,158,11,0.3)]";
						} else {
							btn.className = "rule-bit-btn w-full py-1.5 rounded-lg font-black text-sm border transition cursor-pointer active:scale-95 bg-slate-950 text-slate-400 border-slate-700 hover:border-amber-400";
						}
					});

					for (let i = 7; i >= 0; i--) {
						const val = (currentRule >> i) & 1;
						formulaTerms.push(val === 1 ? weights[i].toString() : "0");
					}
					if (formulaBreakdown) {
						formulaBreakdown.textContent = `${formulaTerms.join(" + ")} = ${currentRule}`;
					}

					// Synchronize slider and input
					if (sliderRuleNum && Number.parseInt(sliderRuleNum.value, 10) !== currentRule) {
						sliderRuleNum.value = currentRule.toString();
					}
					if (inputRuleNum && Number.parseInt(inputRuleNum.value, 10) !== currentRule) {
						inputRuleNum.value = currentRule.toString();
					}

					// Update active preset chips & gallery card highlights
					presetBtns.forEach((btn) => {
						const r = Number.parseInt(btn.getAttribute("data-rule") || "0", 10);
						if (r === currentRule) {
							btn.className = "preset-btn active px-2.5 py-1 rounded bg-amber-500/20 text-amber-300 border border-amber-500/50 hover:bg-amber-500/30 transition cursor-pointer active:scale-95";
						} else {
							btn.className = "preset-btn px-2.5 py-1 rounded bg-slate-900 text-slate-300 border border-slate-700 hover:border-slate-500 transition cursor-pointer active:scale-95";
						}
					});

					galleryCards.forEach((card) => {
						const r = Number.parseInt(card.getAttribute("data-gallery-rule") || "0", 10);
						if (r === currentRule) {
							card.className = "gallery-card active p-3 rounded-xl bg-slate-900/90 border border-amber-500/80 hover:border-amber-400 transition cursor-pointer group shadow-lg shadow-amber-500/10";
						} else {
							card.className = "gallery-card p-3 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-slate-700 transition cursor-pointer group shadow-lg";
						}
					});
				}

				// ==========================================
				// 5. ANIMATION MAIN LOOP
				// ==========================================
				let lastTimestamp = performance.now();
				let frameCount = 0;
				let lastFpsTimestamp = performance.now();
				let stepAccumulator = 0;

				function loop(timestamp) {
					if (lifecycle.signal.aborted) return;

					const delta = timestamp - lastTimestamp;
					lastTimestamp = timestamp;

					// FPS measurement
					frameCount++;
					if (timestamp - lastFpsTimestamp >= 1000) {
						const currentFps = Math.round((frameCount * 1000) / (timestamp - lastFpsTimestamp));
						if (metricFps) metricFps.textContent = `${currentFps} FPS`;
						frameCount = 0;
						lastFpsTimestamp = timestamp;
					}

					if (isPlaying) {
						stepAccumulator += delta;
						const stepInterval = 1000 / simSpeed; // ms per generation step
						if (stepAccumulator >= stepInterval) {
							const stepsToRun = Math.min(Math.floor(stepAccumulator / stepInterval), 4);
							stepAccumulator %= stepInterval;
							advanceSimulation(stepsToRun);
						}
					}

					const id = requestAnimationFrame(loop);
					animFrameIds.push(id);
				}

				// ==========================================
				// 6. INITIAL SEED ROW STRIP EDITOR
				// ==========================================
				// Render interactive clickable strip for central 61 cells
				function renderSeedStrip() {
					if (!seedCellsStrip) return;
					seedCellsStrip.innerHTML = "";

					const windowRadius = 30; // 30 on left, center, 30 on right = 61 cells
					const startIdx = CENTER_IDX - windowRadius;
					const endIdx = CENTER_IDX + windowRadius;

					for (let i = startIdx; i <= endIdx; i++) {
						const isCenter = i === CENTER_IDX;
						const cellBtn = document.createElement("button");
						cellBtn.type = "button";
						cellBtn.setAttribute("data-cell-idx", i.toString());
						const isAlive = initialRow[i] === 1;

						let classes = "w-3.5 h-6 rounded-xs transition cursor-pointer flex-shrink-0 active:scale-90 ";
						if (isAlive) {
							classes += isCenter
								? "bg-amber-400 border border-white shadow-[0_0_6px_rgba(245,158,11,0.8)]"
								: "bg-amber-500 border border-amber-300";
						} else {
							classes += isCenter
								? "bg-slate-900 border border-amber-500/50 hover:bg-slate-800"
								: "bg-slate-950 border border-slate-800 hover:bg-slate-800";
						}
						cellBtn.className = classes;
						cellBtn.title = `Cell ${i - CENTER_IDX} (${isAlive ? "Black / 1" : "White / 0"})`;

						cellBtn.addEventListener("click", () => {
							initialRow[i] = initialRow[i] === 1 ? 0 : 1;
							renderSeedStrip();
							resetSimulation();
						}, { signal: lifecycle.signal });

						seedCellsStrip.appendChild(cellBtn);
					}

					// Update seed status description
					let totalAliveInSeed = 0;
					for (let i = 0; i < GRID_WIDTH; i++) {
						if (initialRow[i] === 1) totalAliveInSeed++;
					}
					if (seedStat) {
						if (totalAliveInSeed === 1 && initialRow[CENTER_IDX] === 1) {
							seedStat.textContent = "(中央单黑点)";
						} else if (totalAliveInSeed === 0) {
							seedStat.textContent = "(全白空白种子)";
						} else {
							seedStat.textContent = `(${totalAliveInSeed} 个活元胞活跃)`;
						}
					}
				}

				// Seed preset handlers
				if (seedBtnSingle) {
					seedBtnSingle.addEventListener("click", () => {
						initialRow.fill(0);
						initialRow[CENTER_IDX] = 1;
						renderSeedStrip();
						resetSimulation();
					}, { signal: lifecycle.signal });
				}

				if (seedBtnSoup) {
					seedBtnSoup.addEventListener("click", () => {
						for (let i = 0; i < GRID_WIDTH; i++) {
							initialRow[i] = Math.random() < 0.5 ? 1 : 0;
						}
						renderSeedStrip();
						resetSimulation();
					}, { signal: lifecycle.signal });
				}

				if (seedBtnDouble) {
					seedBtnDouble.addEventListener("click", () => {
						initialRow.fill(0);
						initialRow[CENTER_IDX] = 1;
						initialRow[CENTER_IDX + 1] = 1;
						renderSeedStrip();
						resetSimulation();
					}, { signal: lifecycle.signal });
				}

				if (seedBtnInvert) {
					seedBtnInvert.addEventListener("click", () => {
						for (let i = 0; i < GRID_WIDTH; i++) {
							initialRow[i] = initialRow[i] === 1 ? 0 : 1;
						}
						renderSeedStrip();
						resetSimulation();
					}, { signal: lifecycle.signal });
				}

				if (seedBtnClear) {
					seedBtnClear.addEventListener("click", () => {
						initialRow.fill(0);
						renderSeedStrip();
						resetSimulation();
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 7. USER INTERFACE CONTROLS & LISTENERS
				// ==========================================
				function setRule(newRule) {
					currentRule = Math.max(0, Math.min(255, newRule));
					resetSimulation();
				}

				// Play/Pause button
				if (btnPlayPause) {
					btnPlayPause.addEventListener("click", () => {
						isPlaying = !isPlaying;
						if (playIcon) playIcon.textContent = isPlaying ? "⏸" : "▶";
						if (playText) playText.textContent = isPlaying ? "暂停推进" : "继续推进";
						if (playTextEn) playTextEn.textContent = isPlaying ? "Pause" : "Resume";
						if (metricEngineState) {
							metricEngineState.textContent = isPlaying ? "● 持续推进中" : "⏸ 暂停待命";
							metricEngineState.className = isPlaying ? "text-[11px] text-emerald-400" : "text-[11px] text-amber-400";
						}
					}, { signal: lifecycle.signal });
				}

				// Step buttons
				if (btnStep) {
					btnStep.addEventListener("click", () => {
						isPlaying = false;
						if (playIcon) playIcon.textContent = "▶";
						if (playText) playText.textContent = "继续推进";
						if (playTextEn) playTextEn.textContent = "Resume";
						if (metricEngineState) {
							metricEngineState.textContent = "⏸ 步进模式";
							metricEngineState.className = "text-[11px] text-cyan-400";
						}
						advanceSimulation(1);
					}, { signal: lifecycle.signal });
				}

				if (btnStep10) {
					btnStep10.addEventListener("click", () => {
						isPlaying = false;
						if (playIcon) playIcon.textContent = "▶";
						if (playText) playText.textContent = "继续推进";
						if (playTextEn) playTextEn.textContent = "Resume";
						advanceSimulation(10);
					}, { signal: lifecycle.signal });
				}

				// Restart button
				if (btnRestart) {
					btnRestart.addEventListener("click", () => {
						resetSimulation();
					}, { signal: lifecycle.signal });
				}

				// Sliders listeners
				if (sliderRuleNum) {
					sliderRuleNum.addEventListener("input", (e) => {
						const val = Number.parseInt(e.target.value, 10);
						setRule(val);
					}, { signal: lifecycle.signal });
				}

				if (inputRuleNum) {
					inputRuleNum.addEventListener("change", (e) => {
						const val = Number.parseInt(e.target.value, 10) || 0;
						setRule(val);
					}, { signal: lifecycle.signal });
				}

				if (sliderSpeed) {
					sliderSpeed.addEventListener("input", (e) => {
						simSpeed = Number.parseInt(e.target.value, 10);
						if (speedLabel) speedLabel.textContent = `${(simSpeed / 30).toFixed(1)}×`;
					}, { signal: lifecycle.signal });
				}

				if (sliderGen) {
					sliderGen.addEventListener("input", (e) => {
						maxGenerations = Number.parseInt(e.target.value, 10);
						if (genLabel) genLabel.textContent = `${maxGenerations} 行`;
						renderUniverseCanvas();
					}, { signal: lifecycle.signal });
				}

				if (sliderCellSize) {
					sliderCellSize.addEventListener("input", (e) => {
						cellSize = Number.parseInt(e.target.value, 10);
						if (cellSizeLabel) cellSizeLabel.textContent = `${cellSize} px`;
						renderUniverseCanvas();
					}, { signal: lifecycle.signal });
				}

				// Rule table bit buttons
				ruleBitBtns.forEach((btn) => {
					btn.addEventListener("click", () => {
						const bitIdx = Number.parseInt(btn.getAttribute("data-bit-idx") || "0", 10);
						// Flip the bit at bitIdx
						const newRule = currentRule ^ (1 << bitIdx);
						setRule(newRule);
					}, { signal: lifecycle.signal });
				});

				// Preset buttons
				presetBtns.forEach((btn) => {
					btn.addEventListener("click", () => {
						const r = Number.parseInt(btn.getAttribute("data-rule") || "0", 10);
						setRule(r);
					}, { signal: lifecycle.signal });
				});

				// Gallery cards
				galleryCards.forEach((card) => {
					card.addEventListener("click", () => {
						const r = Number.parseInt(card.getAttribute("data-gallery-rule") || "0", 10);
						setRule(r);
					}, { signal: lifecycle.signal });
				});

				// Theme buttons
				themeBtns.forEach((btn) => {
					btn.addEventListener("click", () => {
						const th = btn.getAttribute("data-theme") || "ember";
						currentTheme = th;
						themeBtns.forEach((b) => {
							if (b === btn) {
								b.className = "theme-btn active px-2.5 py-1 rounded text-amber-300 bg-amber-950/60 border border-amber-600/40 transition";
							} else {
								b.className = "theme-btn px-2.5 py-1 rounded text-slate-400 hover:text-white transition";
							}
						});
						renderUniverseCanvas();
					}, { signal: lifecycle.signal });
				});

				// Export high-resolution PNG
				if (btnDownload && universeCanvas) {
					btnDownload.addEventListener("click", () => {
						const link = document.createElement("a");
						link.download = `rule-${currentRule}-one-black-cell.png`;
						link.href = universeCanvas.toDataURL("image/png");
						link.click();
					}, { signal: lifecycle.signal });
				}

				// Canvas Hover Coordinate Inspector
				if (universeCanvas) {
					universeCanvas.addEventListener("mousemove", (e) => {
						const rect = universeCanvas.getBoundingClientRect();
						const scaleX = universeCanvas.width / rect.width;
						const scaleY = universeCanvas.height / rect.height;

						const canvasX = (e.clientX - rect.left) * scaleX;
						const canvasY = (e.clientY - rect.top) * scaleY;

						const col = Math.floor(canvasX / cellSize);
						const row = Math.floor(canvasY / cellSize);

						if (row >= 0 && row < history.length && col >= 0 && col < GRID_WIDTH) {
							const val = history[row][col];
							if (inspX) inspX.textContent = (col - CENTER_IDX).toString();
							if (inspT) inspT.textContent = row.toString();
							if (inspVal) {
								inspVal.textContent = val === 1 ? "1 (黑胞)" : "0 (白胞)";
								inspVal.className = val === 1 ? "font-bold text-amber-300" : "font-bold text-slate-400";
							}

							// Parent neighbourhood inspection
							if (row > 0 && inspNeigh) {
								const prevRow = history[row - 1];
								const l = col === 0 ? prevRow[GRID_WIDTH - 1] : prevRow[col - 1];
								const c = prevRow[col];
								const r = col === GRID_WIDTH - 1 ? prevRow[0] : prevRow[col + 1];
								inspNeigh.textContent = `${l}${c}${r}`;
							}
						}
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 8. RENDER GALLERY MINI THUMBNAILS
				// ==========================================
				// Dedicated offline mini-renderers for Rule Gallery
				function renderGalleryThumbnails() {
					const presets = [30, 90, 110, 184, 232, 54, 150, 60];
					const thumbW = 160;
					const thumbH = 90;

					presets.forEach((ruleNum) => {
						const canvas = document.getElementById(`thumb-${ruleNum}`);
						if (!canvas) return;
						const ctx = canvas.getContext("2d");
						if (!ctx) return;

						ctx.fillStyle = "#030712";
						ctx.fillRect(0, 0, thumbW, thumbH);

						// Simulate ruleNum with single center black cell for 90 generations
						let row = new Uint8Array(thumbW);
						row[Math.floor(thumbW / 2)] = 1;

						ctx.fillStyle = ruleNum === 30 ? "#f59e0b" : ruleNum === 90 ? "#06b6d4" : ruleNum === 110 ? "#c084fc" : ruleNum === 184 ? "#34d399" : ruleNum === 232 ? "#60a5fa" : ruleNum === 54 ? "#fb7185" : ruleNum === 150 ? "#818cf8" : "#2dd4bf";

						for (let t = 0; t < thumbH; t++) {
							for (let x = 0; x < thumbW; x++) {
								if (row[x] === 1) {
									ctx.fillRect(x, t, 1, 1);
								}
							}
							const nextRow = new Uint8Array(thumbW);
							for (let x = 0; x < thumbW; x++) {
								const l = x === 0 ? row[thumbW - 1] : row[x - 1];
								const c = row[x];
								const r = x === thumbW - 1 ? row[0] : row[x + 1];
								const nh = (l << 2) | (c << 1) | r;
								nextRow[x] = (ruleNum >> nh) & 1;
							}
							row = nextRow;
						}
					});
				}

				// ==========================================
				// 9. STARTUP INITIALIZATION
				// ==========================================
				renderSeedStrip();
				resetSimulation();
				renderGalleryThumbnails();

				// Pre-populate initial 120 steps immediately so user lands on a glorious grown Rule 30 pattern!
				advanceSimulation(120);

				const firstAnimId = requestAnimationFrame(loop);
				animFrameIds.push(firstAnimId);
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initOneBlackCell);
			} else {
				initOneBlackCell();
			}
			document.addEventListener("astro:page-load", initOneBlackCell);
		})();
	</script>
</MainGridLayout>
