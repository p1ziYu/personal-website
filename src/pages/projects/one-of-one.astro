						h2 = ((h2 << 5) + h2 + ch) | 0;
					}
					const p1 = Math.abs(h1).toString(16).padStart(8, "0");
					const p2 = Math.abs(h2).toString(16).padStart(8, "0");
					return (p1 + p2 + p1 + p2).slice(0, 64);
				}

				// Deterministic Persona Calculation
				function derivePersona(hashHex) {
					const b0 = parseInt(hashHex.slice(0, 2), 16) || 0;
					const b1 = parseInt(hashHex.slice(2, 4), 16) || 0;
					const b2 = parseInt(hashHex.slice(4, 6), 16) || 0;
					const b3 = parseInt(hashHex.slice(6, 8), 16) || 0;

					const traitIndex = (b0 * 256 + b1) % TRAITS.length;
					const animalIndex = (b2 * 256 + b3) % ANIMALS.length;

					const trait = TRAITS[traitIndex];
					const animal = ANIMALS[animalIndex];

					return {
						trait,
						animal,
						emoji: animal.emoji,
						titleZh: `${trait.zh}${animal.zh}`,
						titleEn: `${trait.en} ${animal.en}`
					};
				}

				// Master Scanning Execution
				async function runFullScan() {
					scanCounter++;
					const startTime = performance.now();

					// Visual Scanning State
					if (rescanSpinner) rescanSpinner.classList.add("animate-spin");
					if (scanStatusPill) {
						scanStatusPill.className = "px-2.5 py-0.5 rounded-full text-xs font-mono bg-amber-500/20 text-amber-300 border border-amber-500/40 animate-pulse";
						scanStatusPill.innerHTML = '<span class="lang-zh">采样中...</span><span class="lang-en">Sampling...</span>';
					}

					// Execute synchronous and async probes
					const [resCanvas, resWebgl, resAudio, resFonts, resScreen, resIntl, resHardware, resPlatform] = await Promise.all([
						Promise.resolve(probeCanvas()),
						Promise.resolve(probeWebGL()),
						probeAudio(),
						Promise.resolve(probeFonts()),
						Promise.resolve(probeScreen()),
						Promise.resolve(probeIntl()),
						Promise.resolve(probeHardware()),
						Promise.resolve(probePlatform())
					]);

					// Populate table cells
					if (valCanvas) valCanvas.textContent = resCanvas.value;
					if (valWebgl) valWebgl.textContent = resWebgl.value;
					if (valAudio) valAudio.textContent = resAudio.value;
					if (valFonts) valFonts.textContent = resFonts.value;
					if (valScreen) valScreen.textContent = resScreen.value;
					if (valIntl) valIntl.textContent = resIntl.value;
					if (valHardware) valHardware.textContent = resHardware.value;
					if (valPlatform) valPlatform.textContent = resPlatform.value;

					// Assemble Canonical Fingerprint String
					const canonical = [
						resCanvas.raw,
						resWebgl.raw,
						resAudio.raw,
						resFonts.raw,
						resScreen.raw,
						resIntl.raw,
						resHardware.raw,
						resPlatform.raw
					].join("||");

					// Compute Cryptographic Digest
					const fullSha256 = await computeSha256(canonical);
					lastFullHash = fullSha256;
					const truncated = fullSha256.slice(0, 16);

					// Compute Persona
					const persona = derivePersona(fullSha256);

					// Render to Hero Identity Card
					if (fingerprintHashEl) {
						fingerprintHashEl.textContent = truncated;
					}
					if (nicknameTitleEl) {
						nicknameTitleEl.innerHTML = `<span class="lang-zh">${persona.titleZh}</span><span class="lang-en">${persona.titleEn}</span>`;
					}
					if (nicknameEmojiEl) {
						nicknameEmojiEl.textContent = persona.emoji;
					}

					const duration = Math.max(1, Math.round(performance.now() - startTime));
					if (scanTimeLabel) {
						scanTimeLabel.textContent = isEn() ? `Scan time: ${duration}ms` : `扫描耗时：${duration}ms`;
					}
					if (scanCountLabel) {
						scanCountLabel.textContent = isEn() ? `Scans performed: ${scanCounter}` : `已执行采样：${scanCounter}次`;
					}

					// Restore Status Pill & Spinner
					if (rescanSpinner) rescanSpinner.classList.remove("animate-spin");
					if (scanStatusPill) {
						scanStatusPill.className = "px-2.5 py-0.5 rounded-full text-xs font-mono bg-cyan-500/20 text-cyan-300 border border-cyan-500/40";
						scanStatusPill.innerHTML = '<span class="lang-zh">采样就绪</span><span class="lang-en">Sample Active</span>';
					}
				}

				// Re-Scan Button Trigger
				if (btnRescan) {
					btnRescan.addEventListener("click", () => {
						runFullScan();
					}, { signal: lifecycle.signal });
				}

				// Copy Hash Button Trigger
				if (btnCopyHash) {
					btnCopyHash.addEventListener("click", async () => {
						if (!lastFullHash) return;
						try {
							await navigator.clipboard.writeText(lastFullHash);
							if (copyTextZh) copyTextZh.textContent = "已复制 SHA-256!";
							if (copyTextEn) copyTextEn.textContent = "Copied SHA-256!";
							setTimeout(() => {
								if (copyTextZh) copyTextZh.textContent = "复制完整哈希";
								if (copyTextEn) copyTextEn.textContent = "Copy Full Hash";
							}, 2000);
						} catch (e) {
							// Clipboard write fallback
						}
					}, { signal: lifecycle.signal });
				}

				// Initial Execution on Load
				runFullScan();
			}

			// Initialize and bind to Astro Page Transitions (Swup)
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initOneOfOne);
			} else {
				initOneOfOne();
			}

			if (!window.__oneOfOnePageLoadBound) {
				window.__oneOfOnePageLoadBound = true;
				document.addEventListener("astro:page-load", initOneOfOne);
			}
		})();
	</script>
</MainGridLayout>
