						liveReadout.innerHTML = `<span class="lang-zh">准备就绪：发射倒计时中</span><span class="lang-en">Pre-launch: Final countdown on pad</span>`;
					} else if (now < marsArrival) {
						const daysElapsed = Math.max(0, Math.floor((now.getTime() - launchDate.getTime()) / (1000 * 60 * 60 * 24)));
						liveReadout.innerHTML = `<span class="lang-zh">MMX 飞行第 ${daysElapsed} 天：地火转移巡航中（预计 2027 年 8 月抵火）</span><span class="lang-en">Day ${daysElapsed} of flight: Cruising to Mars (Arrival Aug 2027)</span>`;
					} else if (now < marsDepart) {
						liveReadout.innerHTML = `<span class="lang-zh">MMX 任务中：身处火星系统执行火卫一勘测与采样</span><span class="lang-en">Active at Mars: Phobos surveying & sampling underway</span>`;
					} else if (now < earthTouch) {
						liveReadout.innerHTML = `<span class="lang-zh">MMX 返航中：携 10 克火卫一样品飞向地球</span><span class="lang-en">Inbound Cruise: Returning to Earth with Phobos samples</span>`;
					} else {
						liveReadout.innerHTML = `<span class="lang-zh">已回收：样品安全送达地球，实验室分析中</span><span class="lang-en">Delivered: Sample in Earth laboratory quarantine</span>`;
					}
				}

				// ==========================================
				// 2. FLY THE TRAJECTORY SIMULATOR (CANVAS)
				// ==========================================
				const trajCanvas = document.getElementById("traj-canvas");
				const trajCtx = trajCanvas ? trajCanvas.getContext("2d") : null;
				let trajPlaying = true;
				let trajProgress = 0.05; // 0 to 1 across 4 legs
				let activeLegIdx = 0;

				const legNames = [
					"Earth → Mars Cruise (2026–2027)",
					"Mars Arrival & Phobos QSO (2027–2030)",
					"Deimos Flyby (2030 Late)",
					"Mars → Earth Return (2030–2031)"
				];

				function resizeCanvas(canvas) {
					if (!canvas) return;
					const rect = canvas.getBoundingClientRect();
					const dpr = window.devicePixelRatio || 1;
					if (canvas.width !== rect.width * dpr || canvas.height !== rect.height * dpr) {
						canvas.width = rect.width * dpr;
						canvas.height = rect.height * dpr;
					}
				}

				function renderTrajectory() {
					if (!trajCanvas || !trajCtx) return;
					resizeCanvas(trajCanvas);
					const w = trajCanvas.width;
					const h = trajCanvas.height;
					const dpr = window.devicePixelRatio || 1;

					trajCtx.save();
					trajCtx.scale(dpr, dpr);
					const cssW = w / dpr;
					const cssH = h / dpr;

					trajCtx.clearRect(0, 0, cssW, cssH);

					const cx = cssW * 0.42;
					const cy = cssH * 0.52;
					const rEarth = Math.min(cssW, cssH) * 0.24;
					const rMars = Math.min(cssW, cssH) * 0.39;

					// Draw Sun
					trajCtx.beginPath();
					trajCtx.arc(cx, cy, 14, 0, Math.PI * 2);
					trajCtx.fillStyle = "#fbbf24";
					trajCtx.shadowColor = "#f59e0b";
					trajCtx.shadowBlur = 20;
					trajCtx.fill();
					trajCtx.shadowBlur = 0;

					trajCtx.fillStyle = "#ffffff";
					trajCtx.font = "10px monospace";
					trajCtx.textAlign = "center";
					trajCtx.fillText("Sun (太阳)", cx, cy + 26);

					// Draw Earth Orbit
					trajCtx.beginPath();
					trajCtx.arc(cx, cy, rEarth, 0, Math.PI * 2);
					trajCtx.strokeStyle = "rgba(56, 189, 248, 0.25)";
					trajCtx.lineWidth = 1.5;
					trajCtx.setLineDash([4, 4]);
					trajCtx.stroke();
					trajCtx.setLineDash([]);

					// Draw Earth Position
					const earthAngle = -Math.PI * 0.3;
					const ex = cx + rEarth * Math.cos(earthAngle);
					const ey = cy + rEarth * Math.sin(earthAngle);
					trajCtx.beginPath();
					trajCtx.arc(ex, ey, 7, 0, Math.PI * 2);
					trajCtx.fillStyle = "#38bdf8";
					trajCtx.fill();
					trajCtx.fillText("Earth (地球)", ex, ey - 12);

					// Draw Mars Orbit
					trajCtx.beginPath();
					trajCtx.arc(cx, cy, rMars, 0, Math.PI * 2);
					trajCtx.strokeStyle = "rgba(249, 115, 22, 0.25)";
					trajCtx.lineWidth = 1.5;
					trajCtx.setLineDash([4, 4]);
					trajCtx.stroke();
					trajCtx.setLineDash([]);

					// Draw Mars Position
					const marsAngle = Math.PI * 0.15;
					const mx = cx + rMars * Math.cos(marsAngle);
					const my = cy + rMars * Math.sin(marsAngle);
					trajCtx.beginPath();
					trajCtx.arc(mx, my, 8, 0, Math.PI * 2);
					trajCtx.fillStyle = "#f97316";
					trajCtx.fill();
					trajCtx.fillText("Mars (火星)", mx, my - 14);

					// Draw Phobos Orbit around Mars (schematic zoomed inset near Mars)
					trajCtx.beginPath();
					trajCtx.arc(mx, my, 22, 0, Math.PI * 2);
					trajCtx.strokeStyle = "rgba(251, 191, 36, 0.5)";
					trajCtx.lineWidth = 1;
					trajCtx.stroke();
					trajCtx.fillText("Phobos QSO", mx, my + 32);

					// Draw Deimos Orbit (further out)
					trajCtx.beginPath();
					trajCtx.arc(mx, my, 34, 0, Math.PI * 2);
					trajCtx.strokeStyle = "rgba(148, 163, 184, 0.3)";
					trajCtx.lineWidth = 0.8;
					trajCtx.setLineDash([2, 2]);
					trajCtx.stroke();
					trajCtx.setLineDash([]);

					// Transfer Curve 1: Earth to Mars (Hohmann-like bezier)
					trajCtx.beginPath();
					trajCtx.moveTo(ex, ey);
					const cpx1 = cx + (rEarth + rMars) * 0.5 * Math.cos(0.0);
					const cpy1 = cy + (rEarth + rMars) * 0.5 * Math.sin(0.0);
					trajCtx.quadraticCurveTo(cpx1, cpy1, mx, my);
					trajCtx.strokeStyle = "rgba(251, 191, 36, 0.4)";
					trajCtx.lineWidth = 2;
					trajCtx.stroke();

					// Compute craft position along the mission progress (0 to 1)
					let craftX = ex;
					let craftY = ey;
					let simYear = 2026.8;

					if (trajProgress < 0.25) {
						// Leg 1: Earth -> Mars
						const t = trajProgress / 0.25;
						activeLegIdx = 0;
						simYear = 2026.8 + t * (2027.6 - 2026.8);
						const invT = 1 - t;
						craftX = invT * invT * ex + 2 * invT * t * cpx1 + t * t * mx;
						craftY = invT * invT * ey + 2 * invT * t * cpy1 + t * t * my;
					} else if (trajProgress < 0.65) {
						// Leg 2: Mars Phobos QSO Loop
						const t = (trajProgress - 0.25) / 0.4;
						activeLegIdx = 1;
						simYear = 2027.6 + t * (2030.8 - 2027.6);
						const loopAngle = t * Math.PI * 6;
						craftX = mx + Math.cos(loopAngle) * 22;
						craftY = my + Math.sin(loopAngle) * 22;
					} else if (trajProgress < 0.75) {
						// Leg 3: Deimos Flyby
						const t = (trajProgress - 0.65) / 0.1;
						activeLegIdx = 2;
						simYear = 2030.8 + t * 0.1;
						const flyAngle = t * Math.PI * 2;
						craftX = mx + Math.cos(flyAngle) * 34;
						craftY = my + Math.sin(flyAngle) * 34;
					} else {
						// Leg 4: Mars -> Earth return
						const t = (trajProgress - 0.75) / 0.25;
						activeLegIdx = 3;
						simYear = 2030.9 + t * (2031.6 - 2030.9);
						const invT = 1 - t;
						const cpx2 = cx + (rEarth + rMars) * 0.4 * Math.cos(-Math.PI * 0.1);
						const cpy2 = cy + (rEarth + rMars) * 0.4 * Math.sin(-Math.PI * 0.1);
						craftX = invT * invT * mx + 2 * invT * t * cpx2 + t * t * ex;
						craftY = invT * invT * my + 2 * invT * t * cpy2 + t * t * ey;
					}

					// Draw Craft Marker (MMX)
					trajCtx.beginPath();
					trajCtx.arc(craftX, craftY, 5, 0, Math.PI * 2);
					trajCtx.fillStyle = "#ffffff";
					trajCtx.shadowColor = "#38bdf8";
					trajCtx.shadowBlur = 12;
					trajCtx.fill();
					trajCtx.shadowBlur = 0;

					// Label craft
					trajCtx.fillStyle = "#38bdf8";
					trajCtx.font = "bold 10px monospace";
					trajCtx.fillText("MMX", craftX + 8, craftY - 6);

					trajCtx.restore();

					// Update DOM labels
					const txtLeg = document.getElementById("traj-current-leg-name");
					const txtYear = document.getElementById("traj-sim-year");
					if (txtLeg) txtLeg.textContent = legNames[activeLegIdx];
					if (txtYear) txtYear.textContent = simYear.toFixed(1);

					// Sync active leg buttons
					const legBtns = document.querySelectorAll(".traj-leg-btn");
					legBtns.forEach((b, i) => {
						if (i === activeLegIdx) {
							b.className = "traj-leg-btn active px-3 py-2 rounded-xl bg-slate-900 border border-amber-500 text-amber-300 text-left transition cursor-pointer";
						} else {
							b.className = "traj-leg-btn px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 text-left transition hover:border-amber-500/50 cursor-pointer";
						}
					});
				}

				function animateTrajectory() {
					if (trajPlaying) {
						trajProgress += 0.0015;
						if (trajProgress > 1.0) trajProgress = 0.0;
						renderTrajectory();
					}
					const req = requestAnimationFrame(animateTrajectory);
					animFrameIds.push(req);
				}

				const btnTrajPlay = document.getElementById("btn-traj-toggle-play");
				const trajPlayIcon = document.getElementById("traj-play-icon");
				const trajTextZh = document.getElementById("traj-play-text-zh");
				const trajTextEn = document.getElementById("traj-play-text-en");
				if (btnTrajPlay) {
					btnTrajPlay.addEventListener("click", () => {
						trajPlaying = !trajPlaying;
						if (trajPlayIcon) trajPlayIcon.textContent = trajPlaying ? "⏸️" : "▶️";
						if (trajTextZh) trajTextZh.textContent = trajPlaying ? "暂停轨道推演" : "继续轨道推演";
						if (trajTextEn) trajTextEn.textContent = trajPlaying ? "Pause Flight" : "Resume Flight";
					}, { signal: lifecycle.signal });
				}

				const btnTrajReset = document.getElementById("btn-traj-reset");
				if (btnTrajReset) {
					btnTrajReset.addEventListener("click", () => {
						trajProgress = 0.0;
						renderTrajectory();
					}, { signal: lifecycle.signal });
				}

				const legBtns = document.querySelectorAll(".traj-leg-btn");
				legBtns.forEach((btn, idx) => {
					btn.addEventListener("click", () => {
						if (idx === 0) trajProgress = 0.05;
						if (idx === 1) trajProgress = 0.35;
						if (idx === 2) trajProgress = 0.68;
						if (idx === 3) trajProgress = 0.82;
						renderTrajectory();
					}, { signal: lifecycle.signal });
				});

				// ==========================================
				// 3. GRAVITY PLAYGROUND (DROP SIMULATOR)
				// ==========================================
				let selectedGravity = 0.0057; // m/s^2 for Phobos
				let dropHeight = 2.0; // metres
				const dropCanvas = document.getElementById("drop-canvas");
				const dropCtx = dropCanvas ? dropCanvas.getContext("2d") : null;
				let dropY = 0; // 0 to 1
				let dropAnimRunning = false;
				let dropStartTime = 0;
				let totalDropTime = 0;

				function calcDropTime() {
					return Math.sqrt((2 * dropHeight) / selectedGravity);
				}

				function updateDropMetrics() {
					const t = calcDropTime();
					const lbl = document.getElementById("drop-calculated-time");
					if (lbl) {
						if (t > 10) {
							lbl.textContent = `${t.toFixed(2)} 秒 (漫长缓慢漂落)`;
						} else {
							lbl.textContent = `${t.toFixed(2)} 秒`;
						}
					}
				}

				function renderDropChamber() {
					if (!dropCanvas || !dropCtx) return;
					resizeCanvas(dropCanvas);
					const w = dropCanvas.width;
					const h = dropCanvas.height;
					const dpr = window.devicePixelRatio || 1;

					dropCtx.save();
					dropCtx.scale(dpr, dpr);
					const cssW = w / dpr;
					const cssH = h / dpr;

					dropCtx.clearRect(0, 0, cssW, cssH);

					// Draw Chamber background height marks
					const startY = 30;
					const floorY = cssH - 30;
					const trackH = floorY - startY;

					dropCtx.strokeStyle = "#334155";
					dropCtx.lineWidth = 1;
					dropCtx.beginPath();
					dropCtx.moveTo(40, startY);
					dropCtx.lineTo(cssW - 40, startY);
					dropCtx.moveTo(40, floorY);
					dropCtx.lineTo(cssW - 40, floorY);
					dropCtx.stroke();

					dropCtx.fillStyle = "#64748b";
					dropCtx.font = "10px monospace";
					dropCtx.textAlign = "left";
					dropCtx.fillText(`h = ${dropHeight.toFixed(1)} m`, 45, startY - 8);
					dropCtx.fillText("Surface Ground (地表)", 45, floorY + 16);

					// Draw dropping capsule
					const currentY = startY + trackH * dropY;
					const craftX = cssW * 0.5;

					dropCtx.beginPath();
					dropCtx.arc(craftX, currentY, 12, 0, Math.PI * 2);
					dropCtx.fillStyle = "#38bdf8";
					dropCtx.shadowColor = "#38bdf8";
					dropCtx.shadowBlur = 10;
					dropCtx.fill();
					dropCtx.shadowBlur = 0;

					dropCtx.fillStyle = "#ffffff";
					dropCtx.font = "bold 9px monospace";
					dropCtx.textAlign = "center";
					dropCtx.fillText("SAMPLE", craftX, currentY + 3);

					dropCtx.restore();
				}

				function animateDrop() {
					if (!dropAnimRunning) return;
					const elapsed = (performance.now() - dropStartTime) / 1000;
					// For Phobos (26s), speed up visually by 3x so user doesn't wait forever, but show true clock
					const visualMultiplier = selectedGravity < 0.1 ? 3.0 : 1.0;
					const simElapsed = elapsed * visualMultiplier;

					if (simElapsed >= totalDropTime) {
						dropY = 1.0;
						dropAnimRunning = false;
						renderDropChamber();
						return;
					}

					dropY = (0.5 * selectedGravity * Math.pow(simElapsed, 2)) / dropHeight;
					dropY = Math.min(1.0, Math.max(0, dropY));
					renderDropChamber();

					const req = requestAnimationFrame(animateDrop);
					animFrameIds.push(req);
				}

				const btnDropRun = document.getElementById("btn-drop-run");
				if (btnDropRun) {
					btnDropRun.addEventListener("click", () => {
						totalDropTime = calcDropTime();
						dropStartTime = performance.now();
						dropY = 0;
						dropAnimRunning = true;
						animateDrop();
					}, { signal: lifecycle.signal });
				}

				const sliderHeight = document.getElementById("slider-drop-height");
				const txtHeightVal = document.getElementById("drop-height-val");
				if (sliderHeight) {
					sliderHeight.addEventListener("input", (e) => {
						dropHeight = parseFloat(e.target.value);
						if (txtHeightVal) txtHeightVal.textContent = `${dropHeight.toFixed(1)} m`;
						dropY = 0;
						updateDropMetrics();
						renderDropChamber();
					}, { signal: lifecycle.signal });
				}

				const gravBtns = document.querySelectorAll(".gravity-body-btn");
				gravBtns.forEach((b) => {
					b.addEventListener("click", () => {
						gravBtns.forEach((item) => {
							item.className = "gravity-body-btn px-2.5 py-1 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 cursor-pointer";
						});
						b.className = "gravity-body-btn active px-2.5 py-1 rounded-lg bg-cyan-950 border border-cyan-500 text-cyan-300 cursor-pointer";
						selectedGravity = parseFloat(b.dataset.gravity);
						dropY = 0;
						updateDropMetrics();
						renderDropChamber();
					}, { signal: lifecycle.signal });
				});

				// Paperclip line weight calculator
				const sliderWeight = document.getElementById("slider-earth-weight");
				const txtEarthW = document.getElementById("weight-earth-val");
				const txtPhobosW = document.getElementById("weight-phobos-g");
				const txtPhobosEquiv = document.getElementById("weight-phobos-equiv");

				if (sliderWeight) {
					sliderWeight.addEventListener("input", (e) => {
						const ew = parseFloat(e.target.value);
						if (txtEarthW) txtEarthW.textContent = `${ew} kg`;
						// Divide by ~2,000 to get grams
						const phobosGrams = (ew / 2.0).toFixed(1);
						if (txtPhobosW) txtPhobosW.textContent = phobosGrams;
						if (txtPhobosEquiv) {
							const clips = Math.round(ew / 2.0);
							txtPhobosEquiv.innerHTML = `<span class="lang-zh">相当于约 ${clips} 枚普通金属曲别针，或一节 5 号 AA 电池的轻巧感！</span><span class="lang-en">Equivalent to ~${clips} paperclips, or one lightweight AA battery!</span>`;
						}
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 4. MOON FACE-OFF SCALE CANVAS
				// ==========================================
				const scaleCanvas = document.getElementById("moon-scale-canvas");
				const scaleCtx = scaleCanvas ? scaleCanvas.getContext("2d") : null;
				let scaleMode = "cosmic"; // "cosmic" or "city"

				function renderMoonScale() {
					if (!scaleCanvas || !scaleCtx) return;
					resizeCanvas(scaleCanvas);
					const w = scaleCanvas.width;
					const h = scaleCanvas.height;
					const dpr = window.devicePixelRatio || 1;

					scaleCtx.save();
					scaleCtx.scale(dpr, dpr);
					const cssW = w / dpr;
					const cssH = h / dpr;

					scaleCtx.clearRect(0, 0, cssW, cssH);

					if (scaleMode === "cosmic") {
						// Moon is 3474 km, Phobos 22.2 km, Deimos 12.4 km
						// Render Moon as a large sphere on the left/center
						const moonRadius = cssH * 0.42;
						const moonX = cssW * 0.35;
						const moonY = cssH * 0.5;

						scaleCtx.beginPath();
						scaleCtx.arc(moonX, moonY, moonRadius, 0, Math.PI * 2);
						scaleCtx.fillStyle = "#94a3b8";
						scaleCtx.shadowColor = "rgba(148, 163, 184, 0.3)";
						scaleCtx.shadowBlur = 15;
						scaleCtx.fill();
						scaleCtx.shadowBlur = 0;

						scaleCtx.fillStyle = "#ffffff";
						scaleCtx.font = "bold 12px monospace";
						scaleCtx.textAlign = "center";
						scaleCtx.fillText("Moon (月球 · 3,474 km)", moonX, moonY);

						// Phobos to scale: 22.2 / 3474 * (moonRadius * 2) ≈ 2.5 pixels!
						const phobosX = cssW * 0.72;
						const phobosY = cssH * 0.45;
						const phobosPx = Math.max(3, (22.2 / 3474) * (moonRadius * 2));

						scaleCtx.beginPath();
						scaleCtx.arc(phobosX, phobosY, phobosPx, 0, Math.PI * 2);
						scaleCtx.fillStyle = "#f59e0b";
						scaleCtx.fill();

						// Ring indicator
						scaleCtx.beginPath();
						scaleCtx.arc(phobosX, phobosY, 14, 0, Math.PI * 2);
						scaleCtx.strokeStyle = "#f59e0b";
						scaleCtx.lineWidth = 1;
						scaleCtx.stroke();

						scaleCtx.font = "11px monospace";
						scaleCtx.fillStyle = "#f59e0b";
						scaleCtx.textAlign = "left";
						scaleCtx.fillText("Phobos (火卫一 · 22.2 km)", phobosX + 20, phobosY + 4);

						// Deimos: 12.4 km
						const deimosX = cssW * 0.72;
						const deimosY = cssH * 0.65;
						const deimosPx = Math.max(2, (12.4 / 3474) * (moonRadius * 2));

						scaleCtx.beginPath();
						scaleCtx.arc(deimosX, deimosY, deimosPx, 0, Math.PI * 2);
						scaleCtx.fillStyle = "#e2e8f0";
						scaleCtx.fill();

						scaleCtx.beginPath();
						scaleCtx.arc(deimosX, deimosY, 10, 0, Math.PI * 2);
						scaleCtx.strokeStyle = "#94a3b8";
						scaleCtx.lineWidth = 1;
						scaleCtx.stroke();

						scaleCtx.fillStyle = "#cbd5e1";
						scaleCtx.fillText("Deimos (火卫二 · 12.4 km)", deimosX + 20, deimosY + 4);
					} else {
						// City scale mode: Phobos 22.2 km compared to city ring road
						const centerX = cssW * 0.5;
						const centerY = cssH * 0.5;
						const phobosRadius = cssH * 0.35;

						// Draw City Ring Road
						scaleCtx.beginPath();
						scaleCtx.arc(centerX, centerY, phobosRadius, 0, Math.PI * 2);
						scaleCtx.strokeStyle = "rgba(56, 189, 248, 0.4)";
						scaleCtx.lineWidth = 3;
						scaleCtx.setLineDash([6, 4]);
						scaleCtx.stroke();
						scaleCtx.setLineDash([]);

						// Phobos shape (irregular potato-like polygon)
						scaleCtx.beginPath();
						const pts = 24;
						for (let i = 0; i <= pts; i++) {
							const theta = (i / pts) * Math.PI * 2;
							const rVar = phobosRadius * (0.88 + 0.14 * Math.sin(theta * 3) + 0.08 * Math.cos(theta * 5));
							const px = centerX + rVar * Math.cos(theta);
							const py = centerY + rVar * Math.sin(theta);
							if (i === 0) scaleCtx.moveTo(px, py);
							else scaleCtx.lineTo(px, py);
						}
						scaleCtx.fillStyle = "rgba(245, 158, 11, 0.35)";
						scaleCtx.fill();
						scaleCtx.strokeStyle = "#f59e0b";
						scaleCtx.lineWidth = 2;
						scaleCtx.stroke();

						// Labels
						scaleCtx.fillStyle = "#ffffff";
						scaleCtx.font = "bold 13px monospace";
						scaleCtx.textAlign = "center";
						scaleCtx.fillText("Phobos (~22.2 km Mean Diameter)", centerX, centerY - 10);
						scaleCtx.font = "11px sans-serif";
						scaleCtx.fillStyle = "#38bdf8";
						scaleCtx.fillText("≈ 大都市核心环线 / Major City Ring Road (~22 km across)", centerX, centerY + 14);

						// Deimos overlay size
						const deimosRadius = phobosRadius * (12.4 / 22.2);
						scaleCtx.beginPath();
						scaleCtx.arc(centerX + phobosRadius + 30, centerY, deimosRadius, 0, Math.PI * 2);
						scaleCtx.fillStyle = "rgba(148, 163, 184, 0.3)";
						scaleCtx.fill();
						scaleCtx.strokeStyle = "#cbd5e1";
						scaleCtx.stroke();
						scaleCtx.fillText("Deimos (12.4 km)", centerX + phobosRadius + 30, centerY + deimosRadius + 15);
					}

					scaleCtx.restore();
				}

				const btnScaleCosmic = document.getElementById("btn-scale-cosmic");
				const btnScaleCity = document.getElementById("btn-scale-city");
				const scaleLblZh = document.getElementById("scale-canvas-label-zh");
				const scaleLblEn = document.getElementById("scale-canvas-label-en");

				if (btnScaleCosmic) {
					btnScaleCosmic.addEventListener("click", () => {
						scaleMode = "cosmic";
						btnScaleCosmic.className = "px-3 py-1.5 rounded-lg bg-indigo-950 border border-indigo-500 text-indigo-300 font-mono text-xs transition cursor-pointer active:scale-95";
						if (btnScaleCity) btnScaleCity.className = "px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-400 font-mono text-xs transition cursor-pointer active:scale-95";
						if (scaleLblZh) scaleLblZh.textContent = "模式：宇宙宏观尺度对比（月球 vs 火星双卫）";
						if (scaleLblEn) scaleLblEn.textContent = "Mode: Cosmic Scale Comparison (Moon vs Martian Moons)";
						renderMoonScale();
					}, { signal: lifecycle.signal });
				}

				if (btnScaleCity) {
					btnScaleCity.addEventListener("click", () => {
						scaleMode = "city";
						btnScaleCity.className = "px-3 py-1.5 rounded-lg bg-indigo-950 border border-indigo-500 text-indigo-300 font-mono text-xs transition cursor-pointer active:scale-95";
						if (btnScaleCosmic) btnScaleCosmic.className = "px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-400 font-mono text-xs transition cursor-pointer active:scale-95";
						if (scaleLblZh) scaleLblZh.textContent = "模式：微观城市环线对比（火卫一如同一座大城市城区）";
						if (scaleLblEn) scaleLblEn.textContent = "Mode: City Scale Comparison (Phobos matches a major city ring)";
						renderMoonScale();
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 5. ISOTOPE FINGERPRINT REVEAL (CANVAS)
				// ==========================================
				const isoCanvas = document.getElementById("isotope-canvas");
				const isoCtx = isoCanvas ? isoCanvas.getContext("2d") : null;
				let isoMode = "sample"; // "remote" or "sample"

				function renderIsotopeChart() {
					if (!isoCanvas || !isoCtx) return;
					resizeCanvas(isoCanvas);
					const w = isoCanvas.width;
					const h = isoCanvas.height;
					const dpr = window.devicePixelRatio || 1;

					isoCtx.save();
					isoCtx.scale(dpr, dpr);
					const cssW = w / dpr;
					const cssH = h / dpr;

					isoCtx.clearRect(0, 0, cssW, cssH);

					const padL = 60;
					const padR = 30;
					const padT = 30;
					const padB = 40;
					const chartW = cssW - padL - padR;
					const chartH = cssH - padT - padB;

					// Axes
					isoCtx.strokeStyle = "#334155";
					isoCtx.lineWidth = 1;
					isoCtx.beginPath();
					isoCtx.moveTo(padL, padT);
					isoCtx.lineTo(padL, padT + chartH);
					isoCtx.lineTo(padL + chartW, padT + chartH);
					isoCtx.stroke();

					if (isoMode === "remote") {
						// Blurry spectral curve with noise & wide error band
						isoCtx.fillStyle = "rgba(239, 68, 68, 0.15)";
						isoCtx.beginPath();
						isoCtx.moveTo(padL, padT + chartH * 0.4);
						for (let x = 0; x <= chartW; x += 5) {
							const t = x / chartW;
							const yOffset = Math.sin(t * 3.5) * 20 + Math.cos(t * 7) * 8;
							isoCtx.lineTo(padL + x, padT + chartH * 0.4 + yOffset - 18);
						}
						for (let x = chartW; x >= 0; x -= 5) {
							const t = x / chartW;
							const yOffset = Math.sin(t * 3.5) * 20 + Math.cos(t * 7) * 8;
							isoCtx.lineTo(padL + x, padT + chartH * 0.4 + yOffset + 18);
						}
						isoCtx.closePath();
						isoCtx.fill();

						// Noisy mean line
						isoCtx.beginPath();
						for (let x = 0; x <= chartW; x += 4) {
							const t = x / chartW;
							const noise = (Math.sin(x * 123.4) * 4);
							const y = padT + chartH * 0.4 + Math.sin(t * 3.5) * 20 + Math.cos(t * 7) * 8 + noise;
							if (x === 0) isoCtx.moveTo(padL + x, y);
							else isoCtx.lineTo(padL + x, y);
						}
						isoCtx.strokeStyle = "#f87171";
						isoCtx.lineWidth = 2;
						isoCtx.stroke();

						isoCtx.fillStyle = "#fca5a5";
						isoCtx.font = "bold 11px monospace";
						isoCtx.textAlign = "left";
						isoCtx.fillText("Remote Reflectance: Broad & Blurry (Ambiguous D-type vs Basalt)", padL + 15, padT + 25);
					} else {
						// High-precision isotopic spikes
						const peaks = [
							{ name: "Δ¹⁷O (Oxygen)", x: 0.25, val: 0.75, color: "#10b981" },
							{ name: "ε⁵⁴Cr (Chromium)", x: 0.50, val: 0.88, color: "#38bdf8" },
							{ name: "ε⁵⁰Ti (Titanium)", x: 0.75, val: 0.65, color: "#fbbf24" }
						];

						peaks.forEach((p) => {
							const px = padL + chartW * p.x;
							const py = padT + chartH * (1 - p.val);

							// Draw sharp spike
							isoCtx.beginPath();
							isoCtx.moveTo(px, padT + chartH);
							isoCtx.lineTo(px, py);
							isoCtx.strokeStyle = p.color;
							isoCtx.lineWidth = 4;
							isoCtx.stroke();

							// Top marker
							isoCtx.beginPath();
							isoCtx.arc(px, py, 5, 0, Math.PI * 2);
							isoCtx.fillStyle = p.color;
							isoCtx.fill();

							// Label
							isoCtx.fillStyle = "#ffffff";
							isoCtx.font = "bold 10px monospace";
							isoCtx.textAlign = "center";
							isoCtx.fillText(p.name, px, py - 10);
							isoCtx.fillStyle = p.color;
							isoCtx.fillText(`Fingerprint: ${(p.val * 100).toFixed(1)} ppm`, px, py + 18);
						});

						isoCtx.fillStyle = "#34d399";
						isoCtx.font = "bold 11px monospace";
						isoCtx.textAlign = "left";
						isoCtx.fillText("Laboratory Mass Spec: Decisive Isotopic DNA Spikes", padL + 15, padT + 20);
					}

					isoCtx.restore();
				}

				const btnIsoRemote = document.getElementById("btn-reveal-remote");
				const btnIsoSample = document.getElementById("btn-reveal-sample");
				const isoStatusZh = document.getElementById("isotope-status-text-zh");
				const isoStatusEn = document.getElementById("isotope-status-text-en");

				if (btnIsoRemote) {
					btnIsoRemote.addEventListener("click", () => {
						isoMode = "remote";
						btnIsoRemote.className = "px-3 py-1.5 rounded-lg bg-emerald-950 border border-emerald-500 text-emerald-300 font-mono text-xs cursor-pointer transition active:scale-95";
						if (btnIsoSample) btnIsoSample.className = "px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 font-mono text-xs cursor-pointer transition active:scale-95";
						if (isoStatusZh) isoStatusZh.textContent = "轨道遥感光谱：太空风化使吸收带严重钝化，含碳小行星与火星玄武岩严重重叠！";
						if (isoStatusEn) isoStatusEn.textContent = "Remote Sensing: Space weathering severely flattens spectral features, leaving parentage ambiguous!";
						renderIsotopeChart();
					}, { signal: lifecycle.signal });
				}

				if (btnIsoSample) {
					btnIsoSample.addEventListener("click", () => {
						isoMode = "sample";
						btnIsoSample.className = "px-3 py-1.5 rounded-lg bg-emerald-950 border border-emerald-500 text-emerald-300 font-mono text-xs cursor-pointer transition active:scale-95";
						if (btnIsoRemote) btnIsoRemote.className = "px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 font-mono text-xs cursor-pointer transition active:scale-95";
						if (isoStatusZh) isoStatusZh.textContent = "返回物理样本分析：Δ¹⁷O 与 ε⁵⁴Cr 同位素比值呈现分明指纹，彻底定性母体来源！";
						if (isoStatusEn) isoStatusEn.textContent = "Physical Sample: Δ¹⁷O and ε⁵⁴Cr isotopic ratios reveal unambiguous planetary DNA!";
						renderIsotopeChart();
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 6. ONE PASS PER ORBIT CANVAS
				// ==========================================
				const orbitCanvas = document.getElementById("orbit-window-canvas");
				const orbitCtx = orbitCanvas ? orbitCanvas.getContext("2d") : null;
				let orbitAnimPlaying = true;
				let orbitAngle = 0;

				function renderOrbitWindow() {
					if (!orbitCanvas || !orbitCtx) return;
					resizeCanvas(orbitCanvas);
					const w = orbitCanvas.width;
					const h = orbitCanvas.height;
					const dpr = window.devicePixelRatio || 1;

					orbitCtx.save();
					orbitCtx.scale(dpr, dpr);
					const cssW = w / dpr;
					const cssH = h / dpr;

					orbitCtx.clearRect(0, 0, cssW, cssH);

					const cx = cssW * 0.5;
					const cy = cssH * 0.5;
					const rOrbit = Math.min(cssW, cssH) * 0.38;

					// Draw Mars Center
					orbitCtx.beginPath();
					orbitCtx.arc(cx, cy, 28, 0, Math.PI * 2);
					orbitCtx.fillStyle = "#c2410c";
					orbitCtx.shadowColor = "#ea580c";
					orbitCtx.shadowBlur = 15;
					orbitCtx.fill();
					orbitCtx.shadowBlur = 0;

					orbitCtx.fillStyle = "#ffffff";
					orbitCtx.font = "bold 11px monospace";
					orbitCtx.textAlign = "center";
					orbitCtx.fillText("Mars (火星)", cx, cy + 4);

					// Orbit Ring (Full 7.65 hr track)
					orbitCtx.beginPath();
					orbitCtx.arc(cx, cy, rOrbit, 0, Math.PI * 2);
					orbitCtx.strokeStyle = "rgba(148, 163, 184, 0.25)";
					orbitCtx.lineWidth = 2;
					orbitCtx.stroke();

					// 2.5-hour Sampling Window Arc (2.5 / 7.65 * 2PI ≈ 2.05 rad)
					const windowArc = (2.5 / 7.65) * Math.PI * 2;
					orbitCtx.beginPath();
					orbitCtx.arc(cx, cy, rOrbit, -windowArc * 0.5, windowArc * 0.5);
					orbitCtx.strokeStyle = "#ef4444";
					orbitCtx.lineWidth = 6;
					orbitCtx.stroke();

					orbitCtx.fillStyle = "#ef4444";
					orbitCtx.font = "bold 10px monospace";
					orbitCtx.fillText("~2.5h Touchdown Window (~32%)", cx + rOrbit + 15, cy - 10);

					// Phobos Moving along Orbit
					const px = cx + rOrbit * Math.cos(orbitAngle);
					const py = cy + rOrbit * Math.sin(orbitAngle);

					orbitCtx.beginPath();
					orbitCtx.arc(px, py, 8, 0, Math.PI * 2);
					orbitCtx.fillStyle = "#f59e0b";
					orbitCtx.fill();

					orbitCtx.fillStyle = "#fcd34d";
					orbitCtx.fillText("Phobos", px, py - 12);

					// Is it inside the window?
					const normAngle = ((orbitAngle % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
					const inWindow = normAngle < windowArc * 0.5 || normAngle > (Math.PI * 2 - windowArc * 0.5);

					if (inWindow) {
						orbitCtx.beginPath();
						orbitCtx.arc(px, py, 14, 0, Math.PI * 2);
						orbitCtx.strokeStyle = "#ef4444";
						orbitCtx.lineWidth = 2;
						orbitCtx.stroke();
					}

					orbitCtx.restore();
				}

				function animateOrbitWindow() {
					if (orbitAnimPlaying) {
						orbitAngle += 0.015;
						renderOrbitWindow();
					}
					const req = requestAnimationFrame(animateOrbitWindow);
					animFrameIds.push(req);
				}

				const btnOrbitToggle = document.getElementById("btn-orbit-anim-toggle");
				const orbitTxtZh = document.getElementById("orbit-anim-text-zh");
				const orbitTxtEn = document.getElementById("orbit-anim-text-en");
				if (btnOrbitToggle) {
					btnOrbitToggle.addEventListener("click", () => {
						orbitAnimPlaying = !orbitAnimPlaying;
						if (orbitTxtZh) orbitTxtZh.textContent = orbitAnimPlaying ? "暂停轨道" : "继续轨道";
						if (orbitTxtEn) orbitTxtEn.textContent = orbitAnimPlaying ? "Pause" : "Resume";
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// INITIALIZATION RUNNER
				// ==========================================
				selectPhase(0);
				renderTrajectory();
				animateTrajectory();
				updateDropMetrics();
				renderDropChamber();
				renderMoonScale();
				renderIsotopeChart();
				renderOrbitWindow();
				animateOrbitWindow();

				window.addEventListener("resize", () => {
					renderTrajectory();
					renderDropChamber();
					renderMoonScale();
					renderIsotopeChart();
					renderOrbitWindow();
				}, { signal: lifecycle.signal });
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initPhobosGambit);
			} else {
				initPhobosGambit();
			}
			document.addEventListener("astro:page-load", initPhobosGambit);
		})();
	</script>
</MainGridLayout>
