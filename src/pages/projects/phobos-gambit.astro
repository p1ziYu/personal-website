---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

interface Props {
	lang?: string;
}

const { lang = Astro.url.pathname.startsWith("/en") ? "en" : "zh_CN" } =
	Astro.props;
const isEn = lang === "en";

const title = isEn
	? "The Phobos Gambit · MMX Mission"
	: "盗火计划 · THE PHOBOS GAMBIT";
const description = isEn
	? "On 20 October 2026, Japan's JAXA launched the Martian Moons eXploration (MMX) mission — a five-year deep-space heist to steal at least 10 grams of dust from Mars's moon Phobos and return it to Earth in 2031."
	: "2026 年 10 月 20 日，日本 JAXA 成功发射火星卫星探测任务（MMX）。这是一场跨越五年的深空‘盗火’绝技：从火星卫星火卫一掠取至少 10 克未被人类触碰过的原始星尘，并在 2031 年安全带回地球。";
---

<MainGridLayout title={title} description={description} lang={lang}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mb-8">
		<div class="z-10 px-4 sm:px-8 py-8 relative w-full rounded-(--radius-large) overflow-hidden bg-[#05070f] text-slate-100 border border-slate-800/80 shadow-2xl selection:bg-amber-500/30 selection:text-amber-200">
			<!-- Ambient Space & Mars Glow -->
			<div class="absolute inset-0 pointer-events-none opacity-20 bg-[radial-gradient(#f97316_1px,transparent_1px)] [background-size:32px_32px] overflow-hidden"></div>
			<div class="absolute -top-32 -left-32 w-96 h-96 bg-amber-600/15 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute top-1/4 -right-32 w-96 h-96 bg-red-600/15 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute bottom-10 left-1/3 w-96 h-96 bg-cyan-600/10 rounded-full blur-3xl pointer-events-none"></div>

			<!-- HERO HEADER SECTION -->
			<header class="relative z-10 mb-10 pb-8 border-b border-slate-800/80">
				<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
					<div class="flex flex-wrap items-center gap-2">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-mono font-semibold tracking-wide">
							<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
							<span>JAXA · MMX MISSION LAUNCH · 2026-10-20</span>
						</div>
						<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-300 text-xs font-mono">
							<span>🚀</span>
							<span class="lang-zh">H3-24L 重型构型 F10 成功发射</span>
							<span class="lang-en">H3-24L Heavy Configuration F10 Success</span>
						</div>
						<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono">
							<span>🛰️</span>
							<span class="lang-zh">JAXA 主导 × NASA · CNES · DLR · ESA 国际协同</span>
							<span class="lang-en">JAXA Led × NASA · CNES · DLR · ESA Coalition</span>
						</div>
					</div>

					<!-- In-Page Language Switcher -->
					<div class="flex items-center gap-3">
						<div class="text-xs font-mono text-slate-400 hidden sm:block">
							<span class="lang-zh">种子岛宇宙中心 · 2026-10-20 04:41 JST</span>
							<span class="lang-en">Tanegashima · 2026-10-20 04:41 JST</span>
						</div>
						<a
							id="inpage-lang-toggle"
							href={isEn ? "/projects/phobos-gambit/" : "/en/projects/phobos-gambit/"}
							class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-900 border border-amber-500/40 text-amber-300 hover:text-white hover:bg-amber-950/60 font-mono text-xs transition cursor-pointer active:scale-95"
							title={isEn ? "切换为中文" : "Switch to English"}
						>
							<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
								<path d="m12.87 15.07-2.54-2.51.03-.03A17.52 17.52 0 0 0 14.07 6H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7 1.62-4.33L19.12 17h-3.24z"/>
							</svg>
							<span class="lang-zh font-bold">English</span>
							<span class="lang-en font-bold">中文</span>
						</a>
					</div>
				</div>

				<h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-2 font-sans">
					<span class="lang-zh">盗火计划 · THE PHOBOS GAMBIT</span>
					<span class="lang-en">THE PHOBOS GAMBIT · MMX MISSION</span>
				</h1>

				<p class="text-lg sm:text-xl font-bold text-amber-400 mb-4 tracking-wide font-mono">
					<span class="lang-zh">一场跨越五年的深空“夺宝”：从火星卫星掠走十克尘埃，并全身而退。</span>
					<span class="lang-en">A five-year deep-space heist: steal 10 grams of dust from a moon of Mars and get away with it.</span>
				</p>

				<div class="space-y-3 max-w-3xl text-slate-300 leading-relaxed text-sm sm:text-base">
					<p>
						<span class="lang-zh">
							<strong>2026 年 10 月 20 日 04:41:03 JST</strong>（世界协调时 10 月 19 日 19:41:03 UTC），日本宇宙航空研究开发机构（JAXA）从日本西南部鹿儿岛县的种子岛宇宙中心，使用 H3 重型火箭（H3-24L 构型：两台液氢液氧 LE-9 芯级发动机 + 四台固体助推器 + 加长整流罩，为其迄今最强运载能力；飞行代号 F10），成功发射了<strong>火星卫星探测任务（Martian Moons eXploration，简称 MMX）</strong>！飞船按计划精准星箭分离，JAXA 项目经理有田诚（Makoto Arita）宣布航天器以“极高精度（exceptional precision）”进入预定转移轨道。
						</span>
						<span class="lang-en">
							On <strong>20 October 2026 at 04:41:03 JST</strong> (19 October 19:41:03 UTC), Japan's JAXA launched the <strong>Martian Moons eXploration (MMX)</strong> mission aboard an H3 rocket in its H3-24L heavy configuration (two liquid LE-9 engines + four solid boosters under a long fairing — its heaviest payload capability to date; flight F10) from the Tanegashima Space Center in southwestern Japan. The MMX spacecraft separated cleanly, and JAXA project manager Makoto Arita reported it entered its planned trajectory with "exceptional precision."
						</span>
					</p>
					<p class="text-xs sm:text-sm text-slate-400">
						<span class="lang-zh">
							MMX 是日本主导的有史以来规模最大的月球与行星国际合作探测任务，总任务负责人为川胜康弘（Yasuhiro Kawakatsu），联合了 NASA、法国 CNES、德国 DLR 和欧空局 ESA。探测器发射总重约 4 吨（其中约半数为推进剂），全长约 9 米，由三组独立模块拼接而成：1,800 kg 的推进模块、150 kg 的环绕探测模块以及 1,050 kg 的返回模块。它的终极目标只有一个：深入火星引力深渊，在仅有微弱重力的火卫一（Phobos）上停靠触底，掠取<strong>至少 10 克（约 0.35 盎司）</strong>从未被人类触碰过的原始土壤，并在 2031 年 7 月将其带回澳大利亚南部的伍默拉禁区沙漠。
						</span>
						<span class="lang-en">
							Led by JAXA's mission lead Yasuhiro Kawakatsu in partnership with NASA, France's CNES, Germany's DLR, and ESA, JAXA calls MMX "the largest international collaborative mission in lunar and planetary exploration ever led by Japan." Weighing roughly 4 tonnes at launch (~half propellant) and ~9 metres long, it consists of three modular stages: a 1,800 kg propulsion module, a 150 kg exploration module, and a 1,050 kg return module. Its singular prize: land on the microgravity surface of Phobos, steal <strong>at least 10 grams (0.35 oz)</strong> of pristine regolith, and touch down at Australia's Woomera Prohibited Area in July 2031.
						</span>
					</p>
				</div>

				<!-- Attributed Quotes Section (Strictly the two permitted quotes) -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
					<div class="p-4 rounded-xl bg-slate-900/90 border border-amber-500/30 relative overflow-hidden">
						<div class="text-xs font-mono text-amber-400 font-semibold tracking-wider uppercase mb-1 flex items-center gap-2">
							<span>💬</span>
							<span class="lang-zh">JAXA 项目经理 · 有田诚 (MAKOTO ARITA)</span>
							<span class="lang-en">JAXA PROJECT MANAGER · MAKOTO ARITA</span>
						</div>
						<blockquote class="text-xs sm:text-sm text-slate-200 italic font-serif leading-relaxed">
							<span class="lang-zh">
								有田诚在确认飞船顺利入轨后评价道，探测器以“<strong class="text-amber-300">exceptional precision</strong>”（极高精度）进入了预定轨道。
							</span>
							<span class="lang-en">
								Makoto Arita confirmed that the MMX spacecraft separated cleanly and reached its planned orbit with "<strong class="text-amber-300">exceptional precision</strong>."
							</span>
						</blockquote>
					</div>

					<div class="p-4 rounded-xl bg-slate-900/90 border border-cyan-500/30 relative overflow-hidden">
						<div class="text-xs font-mono text-cyan-400 font-semibold tracking-wider uppercase mb-1 flex items-center gap-2">
							<span>💬</span>
							<span class="lang-zh">NASA 合作科学家 · 汤姆·斯塔特勒 (TOM STATLER)</span>
							<span class="lang-en">NASA COLLABORATING SCIENTIST · TOM STATLER</span>
						</div>
						<blockquote class="text-xs sm:text-sm text-slate-200 italic font-serif leading-relaxed">
							<span class="lang-zh">
								NASA 科学家汤姆·斯塔特勒指出：“<strong class="text-cyan-300">Having the answer will help illuminate that early era when Earth and the other inner planets may have been acquiring much of their water and organic compounds.</strong>”
								<span class="block text-xs font-sans text-slate-400 not-italic mt-1">（“揭开这个答案，将照亮地球及其它类地行星在太阳系早期可能从何处获取大量水和有机化合物的谜题。”）</span>
							</span>
							<span class="lang-en">
								Tom Statler (NASA, collaborating on MMX): "<strong class="text-cyan-300">Having the answer will help illuminate that early era when Earth and the other inner planets may have been acquiring much of their water and organic compounds.</strong>"
							</span>
						</blockquote>
					</div>
				</div>

				<!-- Scientific Honesty Note Card -->
				<div class="mt-4 p-4 rounded-xl bg-slate-900/80 border border-orange-500/30 text-xs text-slate-300 leading-relaxed">
					<div class="text-orange-400 font-mono font-bold uppercase tracking-wider mb-1.5 flex items-center gap-2">
						<span>🔬</span>
						<span class="lang-zh">科学严谨性与示意图解特别声明 (HONESTY NOTE)</span>
						<span class="lang-en">SCIENTIFIC HONESTY & SCHEMATIC ILLUSTRATION NOTE</span>
					</div>
					<p>
						<span class="lang-zh">
							必须明确强调：本页面呈现的所有轨道示意图、火卫一三维外形、重力下落与尺度对比均为用于互动演示与科普教学的<strong>概念性示意图解（schematic illustrations）</strong>，绝非 JAXA 官方实拍影像。今日（2026 年 10 月 20 日）发射已经圆满成功，探测器已启程前往火星；2027 年 8 月之后的所有任务节点均为科学规划路线。<strong>本任务目前绝未完成采样</strong>。本页绝不编造测量数据、日期或科学家姓名。
						</span>
						<span class="lang-en">
							All trajectory diagrams, Phobos renderings, and scale comparisons on this page are <strong>schematic illustrations</strong> clearly labeled as such — they are NOT official JAXA imagery. Launch is complete today (20 October 2026), and the spacecraft is now cruising; all milestones after August 2027 represent the planned timeline. <strong>The mission has NOT yet collected the sample</strong>. We do not invent measurements, dates, or personnel names.
						</span>
					</p>
				</div>
			</header>

			<!-- 7. FACTS STRIP SECTION -->
			<section class="relative z-10 mb-12 pb-10 border-b border-slate-800/80">
				<div class="flex items-center gap-2 mb-4">
					<span class="text-amber-400 font-mono text-xs font-bold uppercase tracking-wider">
						<span class="lang-zh">核心任务事实一览 · FACTS STRIP</span>
						<span class="lang-en">CORE MISSION FACTS STRIP</span>
					</span>
				</div>
				<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs font-mono">
					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/40 transition">
						<div class="text-amber-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">发射时间 (JST)</span>
							<span class="lang-en">LAUNCH TIME (JST)</span>
						</div>
						<div class="text-base sm:text-lg font-black text-white mt-1">2026-10-20</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">04:41:03 JST 种子岛</span>
							<span class="lang-en">19:41:03 UTC F10</span>
						</div>
					</div>

					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/40 transition">
						<div class="text-red-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">火箭构型</span>
							<span class="lang-en">LAUNCH VEHICLE</span>
						</div>
						<div class="text-base sm:text-lg font-black text-red-300 mt-1">H3-24L</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">2×LE-9 + 4 固推 (最强)</span>
							<span class="lang-en">2 LE-9 + 4 SRBs (max)</span>
						</div>
					</div>

					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/40 transition">
						<div class="text-cyan-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">飞船总质量</span>
							<span class="lang-en">SPACECRAFT MASS</span>
						</div>
						<div class="text-base sm:text-lg font-black text-cyan-300 mt-1">~4.0 吨</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">三模块组装 · 约半数燃料</span>
							<span class="lang-en">3 modules · ~50% prop</span>
						</div>
					</div>

					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/40 transition">
						<div class="text-emerald-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">目标猎物 (土壤)</span>
							<span class="lang-en">SAMPLE BOUNTY</span>
						</div>
						<div class="text-base sm:text-lg font-black text-emerald-300 mt-1">≥ 10 克</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">0.35 oz 原始火卫一表土</span>
							<span class="lang-en">≥10g pristine regolith</span>
						</div>
					</div>

					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/40 transition">
						<div class="text-purple-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">先锋漫游车</span>
							<span class="lang-en">SCOUT ROVER</span>
						</div>
						<div class="text-base sm:text-lg font-black text-purple-300 mt-1">IDEFIX (25kg)</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">法德研制 · &lt;100m 空投</span>
							<span class="lang-en">CNES/DLR · &lt;100m drop</span>
						</div>
					</div>

					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/40 transition">
						<div class="text-sky-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">地球回收时间</span>
							<span class="lang-en">EARTH RETURN</span>
						</div>
						<div class="text-base sm:text-lg font-black text-sky-300 mt-1">2031-07</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">澳大利亚伍默拉禁区</span>
							<span class="lang-en">Woomera, Australia</span>
						</div>
					</div>
				</div>
			</section>

			<!-- 1. CENTERPIECE TIMELINE: THE FIVE-YEAR HEIST -->
			<section class="relative z-10 mb-14 pb-12 border-b border-slate-800/80">
				<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
					<div>
						<div class="text-xs font-mono text-amber-400 font-semibold tracking-wider uppercase mb-1 flex items-center gap-2">
							<span>⏱️</span>
							<span class="lang-zh">核心交互时间轴 · 2026 → 2031 全程推演</span>
							<span class="lang-en">CENTERPIECE TIMELINE · 2026 → 2031 HEIST TIMELINE</span>
						</div>
						<h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
							<span class="lang-zh">五年“深空夺宝”的八个生死阶段</span>
							<span class="lang-en">The Five-Year Heist: Eight Critical Phases</span>
						</h2>
					</div>

					<!-- Real-time Where is MMX now tracker badge -->
					<div id="mmx-live-status-pill" class="p-2 sm:px-3 sm:py-1.5 rounded-xl bg-amber-950/40 border border-amber-500/40 text-xs font-mono text-amber-300 flex items-center gap-2 shadow-inner">
						<span class="relative flex h-2.5 w-2.5">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
						</span>
						<span id="mmx-live-readout-text">
							<span class="lang-zh">计算中：MMX 当前正在地火巡航轨道中奔向火星...</span>
							<span class="lang-en">Computing: MMX is currently cruising to Mars...</span>
						</span>
					</div>
				</div>

				<p class="text-xs sm:text-sm text-slate-400 mb-6 max-w-3xl leading-relaxed">
					<span class="lang-zh">
						点击下方 8 个关键任务阶段，查看每个步骤的精确执行时间、行动代号以及决定成败的“关键破案细节”。时间跨越从今天（2026 年 10 月 20 日发射）到 2031 年 7 月返回舱安全降落在澳大利亚红色荒漠。
					</span>
					<span class="lang-en">
						Click any of the 8 mission phases below to inspect dates, operational plans, and one critical telling detail for each step. Spanning from today's launch (20 Oct 2026) to the return capsule touchdown in July 2031 at Woomera.
					</span>
				</p>

				<!-- Timeline Stepper Grid -->
				<div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2 mb-6">
					<button class="timeline-step-btn active p-3 rounded-xl bg-slate-900 border border-amber-500 text-left transition hover:border-amber-400 cursor-pointer" data-phase="0">
						<div class="text-[10px] font-mono text-amber-400 font-bold">PHASE 01</div>
						<div class="text-xs font-bold text-white mt-0.5 truncate">
							<span class="lang-zh">发射启航</span>
							<span class="lang-en">Launch</span>
						</div>
						<div class="text-[10px] text-slate-400 font-mono mt-0.5">2026-10</div>
					</button>

					<button class="timeline-step-btn p-3 rounded-xl bg-slate-900 border border-slate-800 text-left transition hover:border-amber-500/50 cursor-pointer" data-phase="1">
						<div class="text-[10px] font-mono text-slate-500 font-bold">PHASE 02</div>
						<div class="text-xs font-bold text-white mt-0.5 truncate">
							<span class="lang-zh">火星捕获</span>
							<span class="lang-en">Mars Orbit</span>
						</div>
						<div class="text-[10px] text-slate-400 font-mono mt-0.5">2027-08</div>
					</button>

					<button class="timeline-step-btn p-3 rounded-xl bg-slate-900 border border-slate-800 text-left transition hover:border-amber-500/50 cursor-pointer" data-phase="2">
						<div class="text-[10px] font-mono text-slate-500 font-bold">PHASE 03</div>
						<div class="text-xs font-bold text-white mt-0.5 truncate">
							<span class="lang-zh">准卫星轨道</span>
							<span class="lang-en">Phobos QSO</span>
						</div>
						<div class="text-[10px] text-slate-400 font-mono mt-0.5">2027-09</div>
					</button>

					<button class="timeline-step-btn p-3 rounded-xl bg-slate-900 border border-slate-800 text-left transition hover:border-amber-500/50 cursor-pointer" data-phase="3">
						<div class="text-[10px] font-mono text-slate-500 font-bold">PHASE 04</div>
						<div class="text-xs font-bold text-white mt-0.5 truncate">
							<span class="lang-zh">IDEFIX 空投</span>
							<span class="lang-en">Rover Drop</span>
						</div>
						<div class="text-[10px] text-slate-400 font-mono mt-0.5">2028-2029</div>
					</button>

