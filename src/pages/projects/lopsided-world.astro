				// Mathematical model for WASP-17 b limb radius and temperature
				// theta in radians: 0 is evening (east), pi is morning (west), pi/2 is north, 3pi/2 is south
				function getLimbMetrics(angleDeg) {
					const rad = (angleDeg * Math.PI) / 180;
					const cosVal = Math.cos(rad);
					const sinVal = Math.sin(rad);

					// Temperature interpolation:
					// Evening (0°): ~1500 K
					// Morning (180°): ~850 K
					// Poles (90°, 270°): ~1100 K
					// T(theta) = 1175 + 325 * cos(theta) - 75 * sin^2(theta)
					const tempK = Math.round(1175 + 325 * cosVal - 75 * (sinVal * sinVal));
					const tempC = Math.round(tempK - 273.15);
					const tempF = Math.round((tempC * 9) / 5 + 32);

					// Radius extension factor:
					// 1.0x at morning, 1.764x (~1.8x) at evening
					// radiusFactor = 1.382 + 0.382 * cos(theta) - 0.08 * sin^2(theta)
					const radiusFactor = 1.382 + 0.382 * cosVal - 0.08 * (sinVal * sinVal);

					// Scale height H = (k_B * T) / (mu * g)
					// With mu = 2.3 g/mol, g = 3.16 m/s^2:
					// H ~ (1.38e-23 * T) / (2.3 * 1.66e-27 * 3.16) = T * 1.365 km
					const scaleHeightKm = Math.round(tempK * 1.366);

					return {
						rad,
						tempK,
						tempC,
						tempF,
						radiusFactor,
						scaleHeightKm,
					};
				}

				// Build SVG paths for asymmetric atmosphere
				function generateAtmospherePaths() {
					const cx = 250;
					const cy = 250;
					const rCore = 120;
					const baseThickness = 26; // morning side atmosphere thickness in SVG px
					const pointsOuter = [];

					for (let i = 0; i <= 360; i += 3) {
						const rad = (i * Math.PI) / 180;
						const cosVal = Math.cos(rad);
						const sinVal = Math.sin(rad);
						// Bulge factor relative to morning
						const factor = 1.382 + 0.382 * cosVal - 0.08 * (sinVal * sinVal);
						const rOuter = rCore + baseThickness * factor;
						const x = cx + rOuter * Math.cos(rad);
						const y = cy - rOuter * Math.sin(rad); // negative because SVG y is downwards
						pointsOuter.push(`${x.toFixed(1)},${y.toFixed(1)}`);
					}

					const outerPathD = `M ${pointsOuter.join(" L ")} Z`;
					return outerPathD;
				}

