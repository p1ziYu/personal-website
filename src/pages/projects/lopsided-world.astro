					const m = getLimbMetrics(angleDeg);

					if (txtAngleDeg) {
						let label = `${angleDeg}°`;
						if (angleDeg >= 345 || angleDeg <= 15) label += " (傍晚昏界 / Evening)";
						else if (angleDeg >= 75 && angleDeg <= 105) label += " (北极区 / North Pole)";
						else if (angleDeg >= 165 && angleDeg <= 195) label += " (清晨晨界 / Morning)";
						else if (angleDeg >= 255 && angleDeg <= 285) label += " (南极区 / South Pole)";
						txtAngleDeg.textContent = label;
					}

					if (dispTempK) dispTempK.textContent = `~${m.tempK.toLocaleString()} K`;
					if (dispTempC) dispTempC.textContent = `(~${m.tempC} °C / ~${m.tempF} °F)`;
					if (dispRadiusFactor) dispRadiusFactor.textContent = `${m.radiusFactor.toFixed(2)}×`;
					if (dispScaleHeight) dispScaleHeight.textContent = `~${m.scaleHeightKm.toLocaleString()} km`;

					// Update temp regime badge
					if (badgeTempRegime) {
						if (m.tempK >= 1350) {
							badgeTempRegime.className = "px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30";
							badgeTempRegime.textContent = "极热傍晚侧 (Scorching Evening)";
						} else if (m.tempK <= 950) {
							badgeTempRegime.className = "px-2 py-0.5 rounded-full text-[10px] font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30";
							badgeTempRegime.textContent = "清凉晨界 (Cooler Morning)";
						} else {
							badgeTempRegime.className = "px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30";
							badgeTempRegime.textContent = "过渡极区 (Polar Transition)";
						}
					}

					// Update temperature pin on bar (range 850 - 1500 K)
					if (tempIndicatorPin) {
						const pct = Math.max(0, Math.min(100, ((m.tempK - 850) / (1500 - 850)) * 100));
						tempIndicatorPin.style.left = `${pct}%`;
					}

					// Update probe needle line in SVG
					if (probeLine && probeTipDot) {
						const cx = 250;
						const cy = 250;
						const rCore = 120;
						const baseThickness = 26;
						const rOuter = rCore + baseThickness * m.radiusFactor;
						const px = cx + rOuter * Math.cos(m.rad);
						const py = cy - rOuter * Math.sin(m.rad);

						probeLine.setAttribute("x2", px.toFixed(1));
						probeLine.setAttribute("y2", py.toFixed(1));
						probeTipDot.setAttribute("cx", px.toFixed(1));
						probeTipDot.setAttribute("cy", py.toFixed(1));

						// Color tip dot based on temp
						if (m.tempK >= 1300) {
							probeTipDot.setAttribute("fill", "#f97316");
							probeLine.setAttribute("stroke", "#f97316");
						} else if (m.tempK <= 950) {
							probeTipDot.setAttribute("fill", "#38bdf8");
							probeLine.setAttribute("stroke", "#38bdf8");
						} else {
							probeTipDot.setAttribute("fill", "#a855f7");
							probeLine.setAttribute("stroke", "#a855f7");
						}
					}
				}

				if (limbAngleSlider) {
					limbAngleSlider.addEventListener("input", (e) => {
						autoSweepActive = false;
						if (btnAutoSweep) btnAutoSweep.classList.remove("bg-purple-600", "text-white");
