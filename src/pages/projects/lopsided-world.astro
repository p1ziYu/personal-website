				let transitProgress = 0.25; // 0 to 1

				function drawTransitScene() {
					if (!canvasTransit) return;
					const ctx = canvasTransit.getContext("2d");
					if (!ctx) return;

					const w = canvasTransit.width = canvasTransit.offsetWidth * window.devicePixelRatio || 600;
					const h = canvasTransit.height = canvasTransit.offsetHeight * window.devicePixelRatio || 280;

					ctx.clearRect(0, 0, w, h);

					// Draw deep space background with stars
					ctx.fillStyle = "#02040a";
					ctx.fillRect(0, 0, w, h);

					// Star WASP-17 parameters
					const starX = w * 0.5;
					const starY = h * 0.5;
					const starR = h * 0.42;

					// Draw Stellar Glow
					const glowGrad = ctx.createRadialGradient(starX, starY, starR * 0.7, starX, starY, starR * 1.3);
					glowGrad.addColorStop(0, "rgba(251, 191, 36, 0.45)");
					glowGrad.addColorStop(0.5, "rgba(245, 158, 11, 0.15)");
					glowGrad.addColorStop(1, "rgba(0, 0, 0, 0)");
					ctx.fillStyle = glowGrad;
					ctx.beginPath();
					ctx.arc(starX, starY, starR * 1.3, 0, Math.PI * 2);
					ctx.fill();

					// Draw Stellar Disk with Limb Darkening
					const starGrad = ctx.createRadialGradient(starX, starY, 0, starX, starY, starR);
					starGrad.addColorStop(0, "#fffbeb");
					starGrad.addColorStop(0.65, "#fde047");
					starGrad.addColorStop(0.9, "#f59e0b");
					starGrad.addColorStop(1, "#b45309"); // darkened limb
					ctx.fillStyle = starGrad;
					ctx.beginPath();
					ctx.arc(starX, starY, starR, 0, Math.PI * 2);
					ctx.fill();

					// Planet trajectory: moves from left (w * 0.12) to right (w * 0.88)
					const pStartX = starX - starR * 1.55;
					const pEndX = starX + starR * 1.55;
					const planetX = pStartX + (pEndX - pStartX) * transitProgress;
					const planetY = starY + starR * 0.15; // slightly inclined chord
					const planetR = starR * 0.22;

					// Planet chord path line
					ctx.strokeStyle = "rgba(148, 163, 184, 0.2)";
					ctx.lineWidth = 1;
					ctx.setLineDash([4, 4]);
					ctx.beginPath();
					ctx.moveTo(pStartX, planetY);
					ctx.lineTo(pEndX, planetY);
					ctx.stroke();
					ctx.setLineDash([]);

					// Determine transit phase
					const distFromCenter = Math.hypot(planetX - starX, planetY - starY);
					const isIngress = planetX < starX && distFromCenter >= starR - planetR * 1.5 && distFromCenter <= starR + planetR * 1.8;
					const isEgress = planetX > starX && distFromCenter >= starR - planetR * 1.5 && distFromCenter <= starR + planetR * 1.8;
					const isFullTransit = distFromCenter < starR - planetR * 1.5;

					// Update phase text
					if (txtTransitPhase && txtActiveString) {
						if (distFromCenter > starR + planetR * 1.8) {
							txtTransitPhase.textContent = planetX < starX ? "Pre-Transit (凌始切前)" : "Post-Transit (凌终切后)";
							txtActiveString.textContent = "无恒星背光 · 待机 (Out of Transit)";
						} else if (isIngress) {
							txtTransitPhase.textContent = "Ingress (第一至二接触 · 昏界先入)";
							txtActiveString.textContent = "🔥 东侧傍晚透射弦 (Eastern Evening String · ~1,500 K 膨胀气体正切入星盘)";
						} else if (isFullTransit) {
							txtTransitPhase.textContent = "Mid-Transit (全凌星态 · 双侧背光)";
							txtActiveString.textContent = "✨ 24 组透射弦全波段同时反演 (All 24 Strings Active)";
						} else if (isEgress) {
							txtTransitPhase.textContent = "Egress (第三至四接触 · 晨界最后移出)";
							txtActiveString.textContent = "❄️ 西侧清晨透射弦 (Western Morning String · ~850 K 致密边缘正在移出)";
						}
					}

					// Draw Asymmetric Planet Silhouette with Lopsided Atmosphere
					// Eastern limb (leading, rightward): puffed by 1.8x
					// Western limb (trailing, leftward): compact 1.0x
					ctx.save();
					ctx.translate(planetX, planetY);

					// Draw highlighted active transmission strings arcs when contacting stellar disk
					if (isIngress) {
						// Highlight leading eastern evening limb
						ctx.fillStyle = "rgba(249, 115, 22, 0.35)";
						ctx.strokeStyle = "#ea580c";
						ctx.lineWidth = 2.5;
						ctx.beginPath();
						ctx.arc(0, 0, planetR * 1.7, -Math.PI * 0.4, Math.PI * 0.4);
						ctx.stroke();
					} else if (isEgress) {
						// Highlight trailing western morning limb
						ctx.fillStyle = "rgba(56, 189, 248, 0.35)";
						ctx.strokeStyle = "#0284c7";
						ctx.lineWidth = 2.5;
						ctx.beginPath();
						ctx.arc(0, 0, planetR * 1.2, Math.PI * 0.6, Math.PI * 1.4);
						ctx.stroke();
					}

					// Draw lopsided atmosphere envelope
					ctx.beginPath();
					for (let i = 0; i <= 360; i += 6) {
						const rad = (i * Math.PI) / 180;
						const cosVal = Math.cos(rad);
						const sinVal = Math.sin(rad);
						// Leading edge is rightward (+x, evening), trailing is leftward (-x, morning)
						const rLimb = planetR * (1.28 + 0.38 * cosVal - 0.08 * (sinVal * sinVal));
						const px = rLimb * Math.cos(rad);
						const py = rLimb * Math.sin(rad);
						if (i === 0) ctx.moveTo(px, py);
						else ctx.lineTo(px, py);
					}
					ctx.closePath();

					// Atmosphere glow gradient
					const atmoGrad = ctx.createRadialGradient(0, 0, planetR * 0.8, 0, 0, planetR * 1.8);
					atmoGrad.addColorStop(0, "rgba(15, 23, 42, 0.95)");
					atmoGrad.addColorStop(0.5, "rgba(249, 115, 22, 0.4)");
					atmoGrad.addColorStop(1, "rgba(249, 115, 22, 0)");
					ctx.fillStyle = atmoGrad;
					ctx.fill();

					// Dark planet body
					ctx.fillStyle = "#020617";
					ctx.beginPath();
					ctx.arc(0, 0, planetR, 0, Math.PI * 2);
					ctx.fill();

					// Circular baseline ghost ring (old model assumption)
					ctx.strokeStyle = "rgba(239, 68, 68, 0.5)";
					ctx.lineWidth = 1;
					ctx.setLineDash([2, 3]);
					ctx.beginPath();
					ctx.arc(0, 0, planetR * 1.35, 0, Math.PI * 2);
					ctx.stroke();
					ctx.setLineDash([]);

					ctx.restore();
				}

				// Draw Lightcurve Canvas below
				function drawLightcurve() {
					if (!canvasLightcurve) return;
					const ctx = canvasLightcurve.getContext("2d");
					if (!ctx) return;

					const w = canvasLightcurve.width = canvasLightcurve.offsetWidth * window.devicePixelRatio || 500;
					const h = canvasLightcurve.height = canvasLightcurve.offsetHeight * window.devicePixelRatio || 100;

					ctx.clearRect(0, 0, w, h);

					// Axis grid
					ctx.strokeStyle = "rgba(51, 65, 85, 0.5)";
					ctx.lineWidth = 1;
					ctx.beginPath();
					ctx.moveTo(w * 0.05, h * 0.2);
					ctx.lineTo(w * 0.95, h * 0.2);
					ctx.moveTo(w * 0.05, h * 0.8);
					ctx.lineTo(w * 0.95, h * 0.8);
					ctx.stroke();

					// Labels
					ctx.fillStyle = "#64748b";
					ctx.font = `${Math.round(9 * window.devicePixelRatio)}px monospace`;
					ctx.fillText("1.000 (Base)", w * 0.06, h * 0.16);
					ctx.fillText("0.984 (Mid-Transit Depth ~1.6%)", w * 0.06, h * 0.92);

					// Transit light curve theoretical curve
					// Subtle asymmetry: ingress is slightly more gradual because the evening side is 1.8x puffier!
					ctx.strokeStyle = "#38bdf8";
					ctx.lineWidth = 2 * window.devicePixelRatio;
					ctx.beginPath();

					for (let i = 0; i <= 200; i++) {
						const prog = i / 200;
						const x = w * (0.05 + prog * 0.9);
						let depth = 0;

						// Transit shape: ingress around 0.15 - 0.32, bottom 0.32 - 0.68, egress 0.68 - 0.85
						if (prog < 0.15) {
							depth = 0;
						} else if (prog <= 0.32) {
							// Ingress with puffed evening atmosphere (softer shoulder)
							const t = (prog - 0.15) / (0.32 - 0.15);
							depth = Math.pow(t, 1.4);
						} else if (prog <= 0.68) {
							// In transit bottom (slight limb darkening curvature)
							const t = (prog - 0.5) / 0.18;
							depth = 1.0 + 0.04 * (1 - t * t);
						} else if (prog <= 0.85) {
							// Egress with compact morning atmosphere (steeper shoulder)
							const t = 1 - (prog - 0.68) / (0.85 - 0.68);
							depth = Math.pow(t, 1.1);
						} else {
							depth = 0;
						}

						const y = h * (0.2 + depth * 0.6);
						if (i === 0) ctx.moveTo(x, y);
						else ctx.lineTo(x, y);
					}
					ctx.stroke();

					// Current scrubber point
					const curX = w * (0.05 + transitProgress * 0.9);
					let curDepth = 0;
					if (transitProgress < 0.15) curDepth = 0;
					else if (transitProgress <= 0.32) curDepth = Math.pow((transitProgress - 0.15) / 0.17, 1.4);
					else if (transitProgress <= 0.68) {
						const t = (transitProgress - 0.5) / 0.18;
						curDepth = 1.0 + 0.04 * (1 - t * t);
					} else if (transitProgress <= 0.85) curDepth = Math.pow(1 - (transitProgress - 0.68) / 0.17, 1.1);
					else curDepth = 0;

					const curY = h * (0.2 + curDepth * 0.6);

					// Tracking circle
					ctx.fillStyle = "#f59e0b";
					ctx.beginPath();
					ctx.arc(curX, curY, 4 * window.devicePixelRatio, 0, Math.PI * 2);
					ctx.fill();
					ctx.strokeStyle = "#ffffff";
					ctx.lineWidth = 1.5;
					ctx.stroke();
				}

				function updateTransitAll() {
					drawTransitScene();
					drawLightcurve();
				}

				if (transitSlider) {
					transitSlider.addEventListener("input", (e) => {
						transitPlaying = false;
						if (btnTransitPlay) {
							const icon = document.getElementById("transit-play-icon");
							if (icon) icon.textContent = "▶";
						}
						transitProgress = parseInt(e.target.value, 10) / 1000;
						updateTransitAll();
					}, { signal: lifecycle.signal });
				}

				if (btnTransitPlay) {
					btnTransitPlay.addEventListener("click", () => {
						transitPlaying = !transitPlaying;
						const icon = document.getElementById("transit-play-icon");
						if (transitPlaying) {
							if (icon) icon.textContent = "⏸";
							function animLoop() {
								if (!transitPlaying) return;
								transitProgress += 0.0035;
								if (transitProgress > 1.0) transitProgress = 0.0;
								if (transitSlider) transitSlider.value = Math.round(transitProgress * 1000).toString();
								updateTransitAll();
								transitAnimReq = requestAnimationFrame(animLoop);
							}
							transitAnimReq = requestAnimationFrame(animLoop);
						} else {
							if (icon) icon.textContent = "▶";
							if (transitAnimReq) cancelAnimationFrame(transitAnimReq);
						}
					}, { signal: lifecycle.signal });
				}

				if (btnTransitReset) {
					btnTransitReset.addEventListener("click", () => {
						transitPlaying = false;
						const icon = document.getElementById("transit-play-icon");
						if (icon) icon.textContent = "▶";
						transitProgress = 0.25;
						if (transitSlider) transitSlider.value = "250";
						updateTransitAll();
					}, { signal: lifecycle.signal });
				}

				// Initial transit render
				updateTransitAll();

				// ==========================================
				// 3. OLD VIEW VS NEW VIEW TOGGLE
				// ==========================================
				const btnViewOld = document.getElementById("btn-view-old");
				const btnViewNew = document.getElementById("btn-view-new");
				const viewModeTitle = document.getElementById("view-mode-title");
				const viewVisualCaption = document.getElementById("view-visual-caption");
				const badgeSpectrumMode = document.getElementById("badge-spectrum-mode");
				const descSpectrumMode = document.getElementById("desc-spectrum-mode");
				const compareRingsGroup = document.getElementById("compare-rings-group");
				const canvasSpectrum = document.getElementById("canvas-spectrum");
				const spectrumLegend = document.getElementById("spectrum-legend");

				let isNewViewMode = true; // default new view

				function renderViewComparison() {
					// Toggle button styling
					if (isNewViewMode) {
						if (btnViewNew) btnViewNew.className = "px-3 py-1.5 text-xs font-mono font-bold rounded-lg transition cursor-pointer bg-purple-600 text-white shadow-md shadow-purple-600/30";
						if (btnViewOld) btnViewOld.className = "px-3 py-1.5 text-xs font-mono font-bold rounded-lg transition cursor-pointer text-slate-400 hover:text-white";
						if (viewModeTitle) viewModeTitle.textContent = "NEW VIEW · 24 TRANSMISSION STRINGS RESOLVED";
						if (badgeSpectrumMode) {
							badgeSpectrumMode.textContent = "独立双光谱 (Dual Decoupled)";
							badgeSpectrumMode.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30";
						}
						if (viewVisualCaption) {
							viewVisualCaption.innerHTML = `<span class="lang-zh">✨ 韦布透射弦新视角：24 组波段空间解耦，测得傍晚侧（1,500 K）向外延伸 1.8 倍，清晨侧（850 K）紧凑致密。</span><span class="lang-en">✨ JWST Transmission Strings: 24 decoupled bands reveal the ~1,500 K evening bulge extending 1.8x farther than the ~850 K morning limb.</span>`;
						}
						if (descSpectrumMode) {
							descSpectrumMode.innerHTML = `<span class="lang-zh">新方法提取出独立双光谱：傍晚侧（红橙线）通量吸收更深，展现 ~1,500 K 高温及水/二氧化碳特征；清晨侧（青蓝线）为 ~850 K。</span><span class="lang-en">Separate spectra extracted: evening limb (orange line) exhibits higher transit depth at ~1,500 K with distinct H₂O and CO₂ features; morning limb (blue line) stays near ~850 K.</span>`;
						}
						if (spectrumLegend) {
							spectrumLegend.innerHTML = `
								<div class="flex items-center gap-3">
									<span class="inline-flex items-center gap-1.5 text-amber-400 font-bold"><span class="w-3 h-0.5 bg-amber-400"></span> 傍晚边缘 (~1,500 K)</span>
									<span class="inline-flex items-center gap-1.5 text-cyan-400 font-bold"><span class="w-3 h-0.5 bg-cyan-400"></span> 清晨边缘 (~850 K)</span>
								</div>
								<span class="text-purple-300">温差 650 K 彻底显现</span>
							`;
						}
					} else {
						// Old View
						if (btnViewOld) btnViewOld.className = "px-3 py-1.5 text-xs font-mono font-bold rounded-lg transition cursor-pointer bg-slate-700 text-white shadow-md";
						if (btnViewNew) btnViewNew.className = "px-3 py-1.5 text-xs font-mono font-bold rounded-lg transition cursor-pointer text-slate-400 hover:text-white";
						if (viewModeTitle) viewModeTitle.textContent = "OLD VIEW · UNIFORM CIRCULAR RING ASSUMED";
						if (badgeSpectrumMode) {
							badgeSpectrumMode.textContent = "单一平均圆光谱 (Limb-Averaged Wash)";
							badgeSpectrumMode.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-slate-700 text-slate-300 border border-slate-600";
						}
						if (viewVisualCaption) {
							viewVisualCaption.innerHTML = `<span class="lang-zh">❌ 传统旧视角：将整个大气假定为对称的单一均匀正圆，空间维度差异被彻底抹平。</span><span class="lang-en">❌ Old View: Treated as a single uniform circular ring; spatial variation and the 650 K divide are completely erased.</span>`;
						}
						if (descSpectrumMode) {
							descSpectrumMode.innerHTML = `<span class="lang-zh">传统拟合仅得出一根全边缘平均光谱（灰色曲线）：将 850 K 的清晨与 1,500 K 的傍晚强行平均为 ~1,150 K，无法探测真实的晨昏不对称气候。</span><span class="lang-en">Standard models output one limb-averaged spectrum (grey line): blending 850 K and 1,500 K into a uniform ~1,150 K, masking real planetary dynamics.</span>`;
						}
						if (spectrumLegend) {
							spectrumLegend.innerHTML = `
								<div class="flex items-center gap-3">
									<span class="inline-flex items-center gap-1.5 text-slate-300 font-bold"><span class="w-3 h-0.5 bg-slate-400"></span> 边缘平均光谱 (~1,150 K 单一谱线)</span>
								</div>
								<span class="text-rose-400 font-bold">⚠️ 650 K 温差与 1.8× 膨胀完全不可见</span>
							`;
						}
					}

					// Render SVG in comparison group
					if (compareRingsGroup) {
						if (isNewViewMode) {
							// Draw asymmetric wedges representing transmission strings
							let wedgesHtml = "";
							for (let i = 0; i < 24; i++) {
								const degStart = i * 15;
								const degEnd = (i + 1) * 15;
								const midDeg = degStart + 7.5;
								const m = getLimbMetrics(midDeg);
								const rInner = 70;
								const rOuter = 70 + 16 * m.radiusFactor;

								const rad1 = (degStart * Math.PI) / 180;
								const rad2 = (degEnd * Math.PI) / 180;

								const x1 = (150 + rInner * Math.cos(rad1)).toFixed(1);
								const y1 = (150 - rInner * Math.sin(rad1)).toFixed(1);
								const x2 = (150 + rOuter * Math.cos(rad1)).toFixed(1);
								const y2 = (150 - rOuter * Math.sin(rad1)).toFixed(1);
								const x3 = (150 + rOuter * Math.cos(rad2)).toFixed(1);
								const y3 = (150 - rOuter * Math.sin(rad2)).toFixed(1);
								const x4 = (150 + rInner * Math.cos(rad2)).toFixed(1);
								const y4 = (150 - rInner * Math.sin(rad2)).toFixed(1);

								// Color interpolated from morning cyan to evening orange
								const strokeColor = m.tempK >= 1300 ? "#fb923c" : m.tempK <= 950 ? "#38bdf8" : "#a855f7";
								const fillColor = m.tempK >= 1300 ? "rgba(249, 115, 22, 0.45)" : m.tempK <= 950 ? "rgba(56, 189, 248, 0.45)" : "rgba(168, 85, 247, 0.35)";

								wedgesHtml += `<path d="M ${x1} ${y1} L ${x2} ${y2} L ${x3} ${y3} L ${x4} ${y4} Z" fill="${fillColor}" stroke="${strokeColor}" stroke-width="1" />`;
							}
							compareRingsGroup.innerHTML = wedgesHtml;
						} else {
							// Draw uniform circular grey-cyan ring
							compareRingsGroup.innerHTML = `
								<circle cx="150" cy="150" r="92" fill="none" stroke="#64748b" stroke-width="20" opacity="0.45" />
								<circle cx="150" cy="150" r="102" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3 3" />
							`;
						}
					}

					// Render Spectrum Canvas
					renderSpectrumCanvas();
				}

				function renderSpectrumCanvas() {
					if (!canvasSpectrum) return;
					const ctx = canvasSpectrum.getContext("2d");
					if (!ctx) return;

					const w = canvasSpectrum.width = canvasSpectrum.offsetWidth * window.devicePixelRatio || 500;
					const h = canvasSpectrum.height = canvasSpectrum.offsetHeight * window.devicePixelRatio || 170;

					ctx.clearRect(0, 0, w, h);

					// Draw wavelength grid lines (0.6, 1.4, 2.7, 4.3, 8.0, 12.0 um)
					const lambdaTicks = [0.6, 1.4, 2.7, 4.3, 8.0, 12.0];
					ctx.strokeStyle = "rgba(51, 65, 85, 0.4)";
					ctx.lineWidth = 1;
					ctx.setLineDash([2, 4]);

					lambdaTicks.forEach((tick, idx) => {
						const x = w * (0.08 + (idx / (lambdaTicks.length - 1)) * 0.84);
						ctx.beginPath();
						ctx.moveTo(x, h * 0.1);
						ctx.lineTo(x, h * 0.85);
						ctx.stroke();

						ctx.fillStyle = "#64748b";
						ctx.font = `${Math.round(8.5 * window.devicePixelRatio)}px monospace`;
						ctx.fillText(`${tick}µm`, x - 10, h * 0.96);
					});
					ctx.setLineDash([]);

					// Molecular absorption features template across 24 intervals
					function getFeatureOffset(xNorm) {
						// Water features near ~1.4 um (norm ~0.15), ~1.9 um (norm ~0.25), ~2.7 um (norm ~0.4)
						// CO2 near ~4.3 um (norm ~0.65)
						let f = Math.sin(xNorm * 18) * 0.08;
						if (Math.abs(xNorm - 0.18) < 0.08) f += 0.35 * Math.cos(((xNorm - 0.18) / 0.08) * Math.PI * 0.5);
						if (Math.abs(xNorm - 0.40) < 0.09) f += 0.45 * Math.cos(((xNorm - 0.40) / 0.09) * Math.PI * 0.5);
						if (Math.abs(xNorm - 0.65) < 0.07) f += 0.60 * Math.cos(((xNorm - 0.65) / 0.07) * Math.PI * 0.5); // CO2 peak
						return f;
					}

					if (isNewViewMode) {
						// 1. Draw Evening Limb Spectrum (High transit depth, hot, orange)
						ctx.strokeStyle = "#f59e0b";
						ctx.lineWidth = 2.5 * window.devicePixelRatio;
						ctx.beginPath();
						for (let i = 0; i <= 24; i++) {
							const t = i / 24;
							const x = w * (0.08 + t * 0.84);
							const feature = getFeatureOffset(t);
							// Base depth higher (puffed ~1.8x)
							const y = h * (0.42 - feature * 0.28);
							if (i === 0) ctx.moveTo(x, y);
							else ctx.lineTo(x, y);
						}
						ctx.stroke();

						// Evening data points (24 intervals)
						ctx.fillStyle = "#fbbf24";
						for (let i = 0; i <= 24; i++) {
							const t = i / 24;
							const x = w * (0.08 + t * 0.84);
							const feature = getFeatureOffset(t);
							const y = h * (0.42 - feature * 0.28);
							ctx.beginPath();
							ctx.arc(x, y, 2.5 * window.devicePixelRatio, 0, Math.PI * 2);
							ctx.fill();
						}

						// 2. Draw Morning Limb Spectrum (Lower transit depth, compact, cyan)
						ctx.strokeStyle = "#0ea5e9";
						ctx.lineWidth = 2.5 * window.devicePixelRatio;
						ctx.beginPath();
						for (let i = 0; i <= 24; i++) {
							const t = i / 24;
							const x = w * (0.08 + t * 0.84);
							const feature = getFeatureOffset(t);
							// Base depth lower (compact ~1.0x)
							const y = h * (0.74 - feature * 0.16);
							if (i === 0) ctx.moveTo(x, y);
							else ctx.lineTo(x, y);
						}
						ctx.stroke();

						// Morning data points
						ctx.fillStyle = "#38bdf8";
						for (let i = 0; i <= 24; i++) {
							const t = i / 24;
							const x = w * (0.08 + t * 0.84);
							const feature = getFeatureOffset(t);
							const y = h * (0.74 - feature * 0.16);
							ctx.beginPath();
							ctx.arc(x, y, 2.5 * window.devicePixelRatio, 0, Math.PI * 2);
							ctx.fill();
						}

						// Gas labels
						ctx.fillStyle = "#f59e0b";
						ctx.font = `${Math.round(9 * window.devicePixelRatio)}px monospace`;
						ctx.fillText("H₂O", w * 0.22, h * 0.22);
						ctx.fillText("H₂O", w * 0.40, h * 0.18);
						ctx.fillStyle = "#ef4444";
						ctx.fillText("CO₂", w * 0.65, h * 0.15);
					} else {
						// Draw single washed-out averaged spectrum
						ctx.strokeStyle = "#94a3b8";
						ctx.lineWidth = 2.5 * window.devicePixelRatio;
						ctx.beginPath();
						for (let i = 0; i <= 24; i++) {
							const t = i / 24;
							const x = w * (0.08 + t * 0.84);
							const feature = getFeatureOffset(t);
							// Intermediate washed out depth
							const y = h * (0.58 - feature * 0.22);
							if (i === 0) ctx.moveTo(x, y);
							else ctx.lineTo(x, y);
						}
						ctx.stroke();

						// Single grey points
						ctx.fillStyle = "#cbd5e1";
						for (let i = 0; i <= 24; i++) {
							const t = i / 24;
							const x = w * (0.08 + t * 0.84);
							const feature = getFeatureOffset(t);
							const y = h * (0.58 - feature * 0.22);
							ctx.beginPath();
							ctx.arc(x, y, 2.5 * window.devicePixelRatio, 0, Math.PI * 2);
							ctx.fill();
						}

						ctx.fillStyle = "#94a3b8";
						ctx.font = `${Math.round(9 * window.devicePixelRatio)}px monospace`;
						ctx.fillText("Limb-Averaged Wash (~1,150 K)", w * 0.35, h * 0.32);
					}
				}

				if (btnViewOld) {
					btnViewOld.addEventListener("click", () => {
						isNewViewMode = false;
						renderViewComparison();
					}, { signal: lifecycle.signal });
				}
				if (btnViewNew) {
					btnViewNew.addEventListener("click", () => {
						isNewViewMode = true;
						renderViewComparison();
					}, { signal: lifecycle.signal });
				}

				// Initial render of comparison
				renderViewComparison();

				// ==========================================
				// 4. WHY THE EVENING SIDE PUFFS UP: SCALE HEIGHT DEMO
				// ==========================================
				const sliderScaleTemp = document.getElementById("slider-scale-temp");
				const txtScaleTempVal = document.getElementById("txt-scale-temp-val");
				const btnScalePresetMorning = document.getElementById("btn-scale-preset-morning");
				const btnScalePresetEvening = document.getElementById("btn-scale-preset-evening");
				const calcKineticE = document.getElementById("calc-kinetic-e");
				const calcHVal = document.getElementById("calc-h-val");
				const txtColumnRatio = document.getElementById("txt-column-ratio");
				const canvasGasColumn = document.getElementById("canvas-gas-column");

				let scaleSimTemp = 1500; // default 1500 K
				let gasParticles = [];

				function initGasParticles() {
					gasParticles = [];
					for (let i = 0; i < 160; i++) {
						gasParticles.push({
							baseZ: Math.random(), // exponential normalized rank
							x: Math.random(),
							vx: (Math.random() - 0.5) * 0.8,
							vz: (Math.random() - 0.5) * 0.8,
							seed: Math.random() * Math.PI * 2,
						});
					}
				}
				initGasParticles();

				function updateScaleDemo(tempK) {
					scaleSimTemp = tempK;
					if (txtScaleTempVal) txtScaleTempVal.textContent = `${tempK.toLocaleString()} K`;

					// Kinetic energy ~ 3/2 k_B T in eV
					// 1 eV = 1.602e-19 J; k_B = 1.38e-23 J/K
					const kBEv = 8.617e-5;
					const eKinEv = (1.5 * kBEv * tempK).toFixed(2);
					if (calcKineticE) calcKineticE.textContent = `~${eKinEv} eV`;

					// Scale height H ~ tempK * 1.366 km
					const hKm = Math.round(tempK * 1.366);
					if (calcHVal) calcHVal.textContent = `~${hKm.toLocaleString()} km`;

					// Extension ratio relative to 850 K morning baseline
					const ratio = (tempK / 850).toFixed(2);
					if (txtColumnRatio) txtColumnRatio.textContent = `延伸倍率：${ratio}× (基准 850 K)`;
				}

				function renderGasColumnCanvas() {
					if (!canvasGasColumn) return;
					const ctx = canvasGasColumn.getContext("2d");
					if (!ctx) return;

					const w = canvasGasColumn.width = canvasGasColumn.offsetWidth * window.devicePixelRatio || 500;
					const h = canvasGasColumn.height = canvasGasColumn.offsetHeight * window.devicePixelRatio || 250;

					ctx.clearRect(0, 0, w, h);

					// Background gradient reflecting current temperature
					const normT = Math.max(0, Math.min(1, (scaleSimTemp - 800) / 800));
					// Color from cool cyan to hot fiery amber/rose
					const rColor = Math.round(14 + normT * 230);
					const gColor = Math.round(165 - normT * 70);
					const bColor = Math.round(233 - normT * 170);

					const bgGrad = ctx.createLinearGradient(0, h, 0, 0);
					bgGrad.addColorStop(0, "rgba(2, 6, 23, 0.95)");
					bgGrad.addColorStop(1, `rgba(${rColor}, ${gColor}, ${bColor}, 0.25)`);
					ctx.fillStyle = bgGrad;
					ctx.fillRect(0, 0, w, h);

					// Effective transit atmosphere height (H factor scales height)
					// At 850 K, reaches ~45% height; at 1500 K, reaches ~80% height!
					const effectiveH = h * (0.35 + normT * 0.48);

					// Draw exponential density curve overlay
					ctx.strokeStyle = `rgba(${rColor}, ${gColor}, ${bColor}, 0.85)`;
					ctx.lineWidth = 2 * window.devicePixelRatio;
					ctx.beginPath();
					for (let yPx = 0; yPx < h; yPx += 4) {
						const z = (h - yPx) / effectiveH; // z in units of H
						const density = Math.exp(-z * 1.5);
						const x = w * 0.15 + w * 0.7 * density;
						if (yPx === 0) ctx.moveTo(x, yPx);
						else ctx.lineTo(x, yPx);
					}
					ctx.stroke();

					// Draw horizontal optical transit boundary line (effective radius)
					const transitTopY = h - effectiveH;
					ctx.strokeStyle = "#fbbf24";
					ctx.lineWidth = 1.5 * window.devicePixelRatio;
					ctx.setLineDash([4, 4]);
					ctx.beginPath();
					ctx.moveTo(w * 0.05, transitTopY);
					ctx.lineTo(w * 0.95, transitTopY);
					ctx.stroke();
					ctx.setLineDash([]);

					ctx.fillStyle = "#fbbf24";
					ctx.font = `${Math.round(9 * window.devicePixelRatio)}px monospace`;
					ctx.fillText(`↑ 视星凌星消光高度截面 (R_transit) · ${(scaleSimTemp / 850).toFixed(2)}×`, w * 0.08, transitTopY - 6);

					// Draw baseline 850 K line for comparison
					const baselineY = h - h * (0.35 + (50 / 800) * 0.48);
					ctx.strokeStyle = "rgba(56, 189, 248, 0.5)";
					ctx.lineWidth = 1 * window.devicePixelRatio;
					ctx.setLineDash([2, 4]);
					ctx.beginPath();
					ctx.moveTo(w * 0.05, baselineY);
					ctx.lineTo(w * 0.95, baselineY);
					ctx.stroke();
					ctx.setLineDash([]);

					ctx.fillStyle = "rgba(56, 189, 248, 0.7)";
					ctx.fillText("1.00× 清晨侧基准线 (~850 K)", w * 0.08, baselineY + 12);

					// Draw gas particles obeying exponential distribution
					const now = performance.now() * 0.002;
					gasParticles.forEach((p) => {
						// Altitude z distributed exponentially
						const zNorm = -Math.log(1 - p.baseZ * 0.95) * (effectiveH / h) * 0.65;
						const jitter = Math.sin(now * (1 + normT * 2) + p.seed) * (1.5 + normT * 3.5);
						const py = Math.max(10, Math.min(h - 5, h - zNorm * h + jitter));
						const px = w * (0.05 + p.x * 0.9);

						ctx.fillStyle = `rgb(${rColor}, ${gColor}, ${bColor})`;
						ctx.beginPath();
						ctx.arc(px, py, (1.8 + normT * 0.8) * window.devicePixelRatio, 0, Math.PI * 2);
						ctx.fill();
					});
				}

				if (sliderScaleTemp) {
					sliderScaleTemp.addEventListener("input", (e) => {
						const val = parseInt(e.target.value, 10);
						updateScaleDemo(val);
						renderGasColumnCanvas();
					}, { signal: lifecycle.signal });
				}

				if (btnScalePresetMorning) {
					btnScalePresetMorning.addEventListener("click", () => {
						if (sliderScaleTemp) sliderScaleTemp.value = "850";
						updateScaleDemo(850);
						renderGasColumnCanvas();
					}, { signal: lifecycle.signal });
				}

				if (btnScalePresetEvening) {
					btnScalePresetEvening.addEventListener("click", () => {
						if (sliderScaleTemp) sliderScaleTemp.value = "1500";
						updateScaleDemo(1500);
						renderGasColumnCanvas();
					}, { signal: lifecycle.signal });
				}

				// Initial scale demo state
				updateScaleDemo(1500);
				renderGasColumnCanvas();

				// Window resize listener
				window.addEventListener("resize", () => {
					updateTransitAll();
					renderSpectrumCanvas();
					renderGasColumnCanvas();
				}, { signal: lifecycle.signal });
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initLopsidedWorld);
			} else {
				initLopsidedWorld();
			}
			document.addEventListener("astro:page-load", initLopsidedWorld);
		})();
	</script>
</MainGridLayout>
