					btnAngleEvening.addEventListener("click", () => {
						autoSweepActive = false;
						if (limbAngleSlider) limbAngleSlider.value = "0";
						updateCenterpiece(0);
					}, { signal: lifecycle.signal });
				}
				if (btnAngleNorth) {
