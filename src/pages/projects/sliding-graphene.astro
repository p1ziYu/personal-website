---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

interface Props {
	lang?: string;
}

const { lang = Astro.url.pathname.startsWith("/en") ? "en" : "zh_CN" } =
	Astro.props;
const isEn = lang === "en";

const title = isEn
	? "Sliding Graphene · Cornell Lab"
	: "滑出磁性 · SLIDING GRAPHENE";
const description = isEn
	? "Sliding Graphene: Voltage-driven interlayer sliding in tetralayer graphene switches between nonmagnetic Bernal and magnetic rhombohedral stacking, locking in the state nonvolatilely (Nature Nanotechnology 2026)."
	: "滑出磁性 · SLIDING GRAPHENE：探索康奈尔大学 2026 年在《自然·纳米技术》发表的里程碑发现——电压驱动四层石墨烯层间原子滑移，在非磁性伯纳尔构型与磁性菱方构型之间实现非易失电重写。";
---

<MainGridLayout title={title} description={description} lang={lang}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mb-8">
		<div class="z-10 px-4 sm:px-8 py-8 relative w-full rounded-(--radius-large) overflow-hidden bg-[#060913] text-slate-100 border border-slate-800/80 shadow-2xl selection:bg-indigo-500/30 selection:text-indigo-200">
			<!-- Ambient Quantum Lattice Glow -->
			<div class="absolute inset-0 pointer-events-none opacity-20 bg-[radial-gradient(#6366f1_1px,transparent_1px)] [background-size:28px_28px] overflow-hidden"></div>
			<div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute top-1/4 -right-32 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute bottom-10 left-1/3 w-96 h-96 bg-cyan-600/10 rounded-full blur-3xl pointer-events-none"></div>

			<!-- HERO HEADER SECTION -->
			<header class="relative z-10 mb-10 pb-8 border-b border-slate-800/80">
				<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
					<div class="flex flex-wrap items-center gap-2">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 text-xs font-mono font-semibold tracking-wide">
							<span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
							<span>NAT. NANOTECHNOL. · 2026-10-14 · DOI: 10.1038/s41565-026-02306-x</span>
						</div>
						<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono">
							<span>⚛</span>
							<span class="lang-zh">凝聚态物理 · 四层石墨烯滑移</span>
							<span class="lang-en">CONDENSED MATTER · TETRALAYER GRAPHENE SLIDING</span>
						</div>
					</div>

					<!-- In-Page Language Switcher -->
					<div class="flex items-center gap-3">
						<div class="text-xs font-mono text-slate-400 hidden sm:block">
							<span class="lang-zh">康奈尔大学安田健治实验室 · 2026-10-17</span>
							<span class="lang-en">Cornell University · Yasuda Lab · 2026-10-17</span>
						</div>
						<a
							id="inpage-lang-toggle"
							href={isEn ? "/projects/sliding-graphene/" : "/en/projects/sliding-graphene/"}
							class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-900 border border-indigo-500/40 text-indigo-300 hover:text-white hover:bg-indigo-950/60 font-mono text-xs transition cursor-pointer active:scale-95"
							title={isEn ? "Switch to Chinese" : "切换为英文"}
						>
							<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
								<path d="m12.87 15.07-2.54-2.51.03-.03A17.52 17.52 0 0 0 14.07 6H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7 1.62-4.33L19.12 17h-3.24z"/>
							</svg>
							<span class="lang-zh font-bold">English</span>
							<span class="lang-en font-bold">中文</span>
						</a>
					</div>
				</div>

				<h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-2 font-sans">
					<span class="lang-zh">滑出磁性 · SLIDING GRAPHENE</span>
					<span class="lang-en">SLIDING GRAPHENE · Cornell Lab</span>
				</h1>

				<p class="text-lg sm:text-xl font-bold text-indigo-400 mb-4 tracking-wide font-mono">
					<span class="lang-zh">给四层石墨烯加点电压，原子侧滑入位，磁性应声而起——撤去电压，磁性依然锁定。</span>
					<span class="lang-en">Push atoms sideways with voltage and magnetism turns on — cut the power, and the state stays locked.</span>
				</p>

				<div class="space-y-3 max-w-3xl text-slate-300 leading-relaxed text-sm sm:text-base">
					<p>
						<span class="lang-zh">
							2026 年 10 月 14 日发表于《自然·纳米技术》（<em>Nature Nanotechnology</em>，DOI: 10.1038/s41565-026-02306-x），并于 10 月 17 日广泛报道：美国康奈尔大学（Cornell University）应用与工程物理学助理教授安田健治（Kenji Yasuda）团队，由博士生丹尼尔·布兰登（Daniel Brandon）领衔，发现给一个恰好由<strong>四层单原子厚度石墨烯（tetralayer graphene）</strong>叠成的纳米器件施加微弱横向电压，各原子层便会发生微小的侧向“滑移”（sliding）。
						</span>
						<span class="lang-en">
							Reported in mid-October 2026 (published Oct. 14, 2026 in <em>Nature Nanotechnology</em>, DOI: 10.1038/s41565-026-02306-x), physicists at Cornell University in the laboratory of Assistant Professor Kenji Yasuda (School of Applied and Engineering Physics), led by doctoral researcher Daniel Brandon, discovered that applying a voltage pulse to a stack of exactly <strong>four layers of graphene (tetralayer graphene)</strong> causes the atomic sheets to slide sideways relative to one another.
						</span>
					</p>
					<p class="text-xs sm:text-sm text-slate-400">
						<span class="lang-zh">
							石墨烯内部每一个单层由碳原子在蜂窝状六角晶格中以强共价键紧密连结，但层与层之间仅由微弱的<strong>范德华力（van der Waals bonds）</strong>维系。电压诱导的滑移改变了原子的垂直堆叠顺序——将材料从最稳定、最常见的<strong>伯纳尔构型（Bernal, ABAB）</strong>，滑移切换至罕见的<strong>菱方构型（Rhombohedral, ABCA）</strong>。伯纳尔态完全非磁，而菱方构型引发电子平带强关联，瞬间点亮强烈的自发<strong>铁磁性</strong>。更为重要的是，这种切换具有<strong>非易失性（nonvolatile）</strong>：电压撤去后，堆垛状态持久锁定；施加反向电压，即可平滑复原。
						</span>
						<span class="lang-en">
							Within each one-atom-thick sheet, carbon atoms are locked in a honeycomb lattice by strong covalent bonds. Between sheets, however, they are bound only by whisper-weak <strong>van der Waals bonds</strong>. Voltage-driven sliding shifts the vertical atomic alignment from the standard, stable <strong>Bernal configuration (ABAB)</strong> to the rarer, metastable <strong>rhombohedral configuration (ABCA)</strong>. Bernal stacking is strictly nonmagnetic; rhombohedral stacking induces flat electronic bands that switch on spontaneous <strong>magnetism</strong>. Crucially, the switching is <strong>nonvolatile</strong>: once slid, the structure persists long after the voltage drops to zero, and reverses reliably with a reverse pulse.
						</span>
					</p>
				</div>

				<!-- Attributed Quotes Section (Yasuda and Brandon only) -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
					<div class="p-4 rounded-xl bg-slate-900/90 border border-indigo-500/30 relative overflow-hidden">
						<div class="text-xs font-mono text-indigo-400 font-semibold tracking-wider uppercase mb-1 flex items-center gap-2">
							<span>💬</span>
							<span class="lang-zh">领衔导师观点 · KENJI YASUDA (CORNELL)</span>
							<span class="lang-en">LEAD INVESTIGATOR · KENJI YASUDA (CORNELL)</span>
						</div>
						<blockquote class="text-xs sm:text-sm text-slate-200 italic font-serif leading-relaxed">
							<span class="lang-zh">
								安田健治教授指出：“<strong class="text-indigo-300">By electrically rewriting the structure, we may be able to switch not only magnetism, but also superconductivity and other quantum states, opening a path toward reconfigurable quantum materials and new forms of nonvolatile memory.</strong>”
								<span class="block text-xs font-sans text-slate-400 not-italic mt-1">（“通过电学手段重写结构，我们不仅可能调控磁性，还可能切换超导态与其他量子态，为可重构量子材料和新型非易失存储开辟了道路。”）</span>
							</span>
							<span class="lang-en">
								Kenji Yasuda stated: "<strong class="text-indigo-300">By electrically rewriting the structure, we may be able to switch not only magnetism, but also superconductivity and other quantum states, opening a path toward reconfigurable quantum materials and new forms of nonvolatile memory.</strong>"
							</span>
						</blockquote>
					</div>

					<div class="p-4 rounded-xl bg-slate-900/90 border border-cyan-500/30 relative overflow-hidden">
						<div class="text-xs font-mono text-cyan-400 font-semibold tracking-wider uppercase mb-1 flex items-center gap-2">
							<span>💬</span>
							<span class="lang-zh">第一作者观察 · DANIEL BRANDON (CORNELL)</span>
							<span class="lang-en">FIRST AUTHOR OBSERVATION · DANIEL BRANDON (CORNELL)</span>
						</div>
						<blockquote class="text-xs sm:text-sm text-slate-200 italic font-serif leading-relaxed">
							<span class="lang-zh">
								丹尼尔·布兰登强调：“<strong class="text-cyan-300">Once the material is in that state, it persists for a long time and it can go back and forth between the two fairly consistently.</strong>”
								<span class="block text-xs font-sans text-slate-400 not-italic mt-1">（“一旦材料进入该状态，它会持久保持很长时间，并且能够在两种构型之间相当一致地来回切换。”）</span>
							</span>
							<span class="lang-en">
								Daniel Brandon noted: "<strong class="text-cyan-300">Once the material is in that state, it persists for a long time and it can go back and forth between the two fairly consistently.</strong>"
							</span>
						</blockquote>
					</div>
				</div>

				<!-- Scientific Honesty Note Card -->
				<div class="mt-4 p-4 rounded-xl bg-slate-900/80 border border-amber-500/30 text-xs text-slate-300 leading-relaxed">
					<div class="text-amber-400 font-mono font-bold uppercase tracking-wider mb-1.5 flex items-center gap-2">
						<span>🔬</span>
						<span class="lang-zh">科学严谨性特别说明：微观实验原型与图解示意</span>
						<span class="lang-en">SCIENTIFIC HONESTY NOTE: RESEARCH DEVICE & SCHEMATIC VISUALS</span>
					</div>
					<p>
						<span class="lang-zh">
							必须诚实指出：本发现是在极低温与超高真空微纳器件中完成的<strong>实验室原型验证</strong>，而非已经上市的商业化芯片产品，绝不能声称其已投入商业制造。此外，原子层滑移的真实物理位移仅为化学键长的分数倍（约 <strong>0.14 纳米</strong>）；本交互页面中的所有层间滑移动态均为<strong>示意性图解（schematic illustrations）</strong>，方便观察层间相对位错与对称性转变，绝非真实比例的物理原子运动。
						</span>
						<span class="lang-en">
							This breakthrough is an experimental laboratory demonstration conducted on a 4-layer micro-device, not a commercial memory chip in products. It must not be mistaken for existing consumer silicon. Furthermore, the true atomic sliding distance spans only a fraction of a bond length (~0.14 nm); all layer-sliding animations on this page are clearly labeled <strong>schematic illustrations</strong> designed for human comprehension, not to-scale atomic trajectories.
						</span>
					</p>
				</div>
			</header>

			<!-- 5. FACTS STRIP SECTION -->
			<section class="relative z-10 mb-12 pb-10 border-b border-slate-800/80">
				<div class="flex items-center gap-2 mb-4">
					<span class="text-indigo-400 font-mono text-xs font-bold uppercase tracking-wider">
						<span class="lang-zh">核心物理事实一览</span>
						<span class="lang-en">CORE PHYSICAL FACTS STRIP</span>
					</span>
				</div>
				<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs font-mono">
					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-indigo-500/40 transition">
						<div class="text-indigo-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">原子层堆叠数</span>
							<span class="lang-en">LAYER COUNT</span>
						</div>
						<div class="text-2xl font-black text-white mt-1">4 层</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">四层石墨烯 (Tetralayer)</span>
							<span class="lang-en">Exactly 4 atomic sheets</span>
						</div>
					</div>

					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-indigo-500/40 transition">
						<div class="text-cyan-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">单层物理厚度</span>
							<span class="lang-en">SHEET THICKNESS</span>
						</div>
						<div class="text-2xl font-black text-white mt-1">1 个原子</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">六角蜂窝碳单层 (~0.34nm)</span>
							<span class="lang-en">Single carbon atom plane</span>
						</div>
					</div>

					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-indigo-500/40 transition">
						<div class="text-amber-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">层间结合作用</span>
							<span class="lang-en">INTERLAYER FORCE</span>
						</div>
						<div class="text-2xl font-black text-amber-300 mt-1">弱范德华力</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">弱范德华键 (非面内强共价)</span>
							<span class="lang-en">Weak van der Waals bonds</span>
						</div>
					</div>

					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-indigo-500/40 transition">
						<div class="text-emerald-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">伯纳尔基态</span>
							<span class="lang-en">BERNAL STACK</span>
						</div>
						<div class="text-2xl font-black text-emerald-300 mt-1">ABAB · 非磁</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">天然石墨稳定态，零净磁</span>
							<span class="lang-en">Stable baseline, nonmagnetic</span>
						</div>
					</div>

					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-indigo-500/40 transition">
						<div class="text-purple-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">菱方滑移态</span>
							<span class="lang-en">RHOMBOHEDRAL</span>
						</div>
						<div class="text-2xl font-black text-purple-300 mt-1">ABCA · 磁性</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">平带关联激发育出自发磁性</span>
							<span class="lang-en">Flat bands, spontaneous ferromagnetism</span>
						</div>
					</div>

					<div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-indigo-500/40 transition">
						<div class="text-rose-400 font-semibold uppercase tracking-wider">
							<span class="lang-zh">发表时间与刊物</span>
							<span class="lang-en">DATE & JOURNAL</span>
						</div>
						<div class="text-xl font-black text-rose-300 mt-1">2026-10-14</div>
						<div class="text-[11px] text-slate-400 mt-1">
							<span class="lang-zh">Nature Nanotechnology</span>
							<span class="lang-en">Nat. Nanotechnol. 2026</span>
						</div>
					</div>
				</div>
			</section>

			<!-- 1. CENTERPIECE: SLIDE THE LAYERS & HYSTERESIS -->
			<section class="relative z-10 mb-12 pb-10 border-b border-slate-800/80">
				<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
					<div>
						<div class="flex items-center gap-2 text-indigo-400 text-xs font-mono font-bold tracking-wider uppercase mb-1">
							<span>01</span>
							<span>·</span>
							<span class="lang-zh">核心实验交互模拟</span>
							<span class="lang-en">Flagship Interactive Experiment</span>
						</div>
						<h2 class="text-xl sm:text-3xl font-black text-white tracking-tight">
							<span class="lang-zh">滑移原子层：加压侧移，磁性涌现与非易失保持</span>
							<span class="lang-en">Slide the Layers: Voltage-Driven Switch & Nonvolatile Memory</span>
						</h2>
					</div>
					<div class="text-xs font-mono px-3 py-1.5 rounded-full bg-slate-900 border border-amber-500/40 text-amber-300">
						<span class="lang-zh">⚠️ 示意性图解，非真实尺度原子位移</span>
						<span class="lang-en">⚠️ Schematic visual, not to-scale atomic trajectory</span>
					</div>
				</div>

				<p class="text-sm text-slate-300 mb-6 max-w-3xl leading-relaxed">
					<span class="lang-zh">
						拖动电压滑块施加横向电场驱动四层石墨烯侧滑。当正向电压越过阈值（+1.5V）时，第三、四层原子从 B 站位滑移进入 C 站位，构型由<strong>伯纳尔（ABAB，非磁性）</strong>突变至<strong>菱方（ABCA，磁性）</strong>。<strong>最核心的物理学现象在于“非易失性”（Nonvolatility）</strong>：此时将电压归零（0V），磁性与晶格构型<strong>完好锁定保持</strong>，绝不丢失！唯有施加反向负电压越过阈值（-1.5V），原子层才会滑回初始非磁性态。
					</span>
					<span class="lang-en">
						Drag the voltage slider to apply an electric field that slides the tetralayer graphene. Crossing the positive threshold (+1.5V) shifts layers from B positions to C positions, morphing from <strong>Bernal (ABAB, nonmagnetic)</strong> to <strong>rhombohedral (ABCA, magnetic)</strong>. <strong>The defining physics is nonvolatility</strong>: returning voltage to 0V leaves the magnetic state <strong>permanently locked</strong>! Only a reverse threshold pulse (-1.5V) slides the sheets back to nonmagnetic Bernal.
					</span>
				</p>

				<!-- Controls Bar -->
				<div class="p-4 rounded-xl bg-slate-900/90 border border-slate-800 mb-6">
					<div class="flex flex-wrap items-center justify-between gap-3 mb-3">
						<div class="flex items-center gap-2 text-xs font-mono font-bold text-slate-300">
							<span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
							<span class="lang-zh">外加栅极电压 (Gate Voltage):</span>
							<span class="lang-en">Applied Gate Voltage:</span>
							<span id="slider-volts-val" class="text-indigo-400 font-mono text-base font-black ml-1">+0.00 V</span>
						</div>
						<div class="flex flex-wrap items-center gap-2">
							<button id="btn-pulse-plus" type="button" class="px-2.5 py-1 text-xs font-mono font-semibold rounded-lg bg-indigo-900/60 border border-indigo-500/50 text-indigo-200 hover:bg-indigo-600 hover:text-white transition cursor-pointer active:scale-95">
								<span class="lang-zh">⚡ +2.0V 脉冲 (滑移至菱方·开启磁性)</span>
								<span class="lang-en">⚡ +2.0V Pulse (Slide to Rhombohedral)</span>
							</button>
							<button id="btn-pulse-zero" type="button" class="px-2.5 py-1 text-xs font-mono font-semibold rounded-lg bg-slate-950 border border-slate-700 text-slate-300 hover:bg-slate-800 hover:text-white transition cursor-pointer active:scale-95">
								<span class="lang-zh">🔌 归零 0.0V (验证非易失锁定)</span>
								<span class="lang-en">🔌 0.0V (Verify Nonvolatile Hold)</span>
							</button>
							<button id="btn-pulse-minus" type="button" class="px-2.5 py-1 text-xs font-mono font-semibold rounded-lg bg-slate-900 border border-rose-500/40 text-rose-300 hover:bg-rose-900/60 hover:text-white transition cursor-pointer active:scale-95">
								<span class="lang-zh">🔄 -2.0V 脉冲 (复位伯纳尔·熄灭磁性)</span>
								<span class="lang-en">🔄 -2.0V Pulse (Reset to Bernal)</span>
							</button>
							<button id="btn-auto-cycle" type="button" class="px-2.5 py-1 text-xs font-mono font-semibold rounded-lg bg-cyan-950/60 border border-cyan-500/50 text-cyan-200 hover:bg-cyan-600 hover:text-white transition cursor-pointer active:scale-95">
								<span class="lang-zh">🔁 自动回线循环</span>
								<span class="lang-en">🔁 Auto Cycle Loop</span>
							</button>
						</div>
					</div>

					<div class="relative flex items-center">
						<input
							type="range"
							id="voltage-slider"
							min="-2.5"
							max="2.5"
