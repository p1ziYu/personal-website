	<!-- CLIENT-SIDE SIMULATION ENGINE -->
	<script is:inline>
		(() => {
			let cleanup = null;

			function initSlidingGraphene() {
				if (cleanup) {
					cleanup();
					cleanup = null;
				}

				const lifecycle = new AbortController();
				cleanup = () => lifecycle.abort();

				// ==========================================
				// 1. CENTERPIECE: SLIDE THE LAYERS & HYSTERESIS
				// ==========================================
				const voltageSlider = document.getElementById("voltage-slider");
				const sliderVoltsVal = document.getElementById("slider-volts-val");
				const btnPulsePlus = document.getElementById("btn-pulse-plus");
				const btnPulseZero = document.getElementById("btn-pulse-zero");
				const btnPulseMinus = document.getElementById("btn-pulse-minus");
				const btnAutoCycle = document.getElementById("btn-auto-cycle");

				const layerGroup3 = document.getElementById("layer-group-3");
				const layerGroup4 = document.getElementById("layer-group-4");
				const lblL3Pos = document.getElementById("lbl-l3-pos");
				const lblL4Pos = document.getElementById("lbl-l4-pos");
				const badgeStacking = document.getElementById("badge-stacking");
				const badgeMagnetism = document.getElementById("badge-magnetism");
				const spinArrowsGroup = document.getElementById("spin-arrows-group");
				const magFieldOverlay = document.getElementById("magnetic-field-overlay");
				const txtLayerOffset = document.getElementById("txt-layer-offset");

				const tracerPoint = document.getElementById("tracer-point");
				const txtMagState = document.getElementById("txt-mag-state");
				const txtStackPhase = document.getElementById("txt-stack-phase");
				const txtRetention = document.getElementById("txt-retention");

				// State Machine: isRhombohedral indicates the current locked branch
				let isRhombohedral = false; // start in Bernal基态
				let autoCycleInterval = null;

				function updateHysteresisState(voltage) {
					// Hysteresis threshold logic:
					// Positive threshold: +1.5V switches to Rhombohedral (magnetic)
					// Negative threshold: -1.5V resets to Bernal (nonmagnetic)
					// Between -1.5V and +1.5V, the state remains unchanged (nonvolatile retention!)
					if (voltage >= 1.5) {
						isRhombohedral = true;
					} else if (voltage <= -1.5) {
						isRhombohedral = false;
					}

					// Stacking & Magnetism
					const isMag = isRhombohedral;
					// UI Labels
					if (sliderVoltsVal) {
						sliderVoltsVal.textContent = `${voltage >= 0 ? "+" : ""}${voltage.toFixed(2)} V`;
					}

					// Update Side-View Stack Graphic
					// Lateral offset in pixels: 0px when Bernal (A/B), 30px when Rhombohedral (C/A)
					const targetShift = isMag ? 32 : 0;
					if (layerGroup3) {
						layerGroup3.style.transform = `translateX(${targetShift}px)`;
					}
					if (layerGroup4) {
						layerGroup4.style.transform = `translateX(${targetShift}px)`;
					}

					if (lblL3Pos) {
						lblL3Pos.textContent = isMag ? "L3 [C]" : "L3 [A]";
						lblL3Pos.setAttribute("fill", isMag ? "#fbbf24" : "#f59e0b");
					}
					if (lblL4Pos) {
						lblL4Pos.textContent = isMag ? "L4 [A]" : "L4 [B]";
						lblL4Pos.setAttribute("fill", isMag ? "#c084fc" : "#a855f7");
					}

					if (badgeStacking) {
						if (isMag) {
							badgeStacking.className = "px-2 py-0.5 rounded bg-purple-950 border border-purple-500/50 text-purple-300 font-bold";
							badgeStacking.textContent = "ABCA (Rhombohedral)";
						} else {
							badgeStacking.className = "px-2 py-0.5 rounded bg-emerald-950 border border-emerald-500/50 text-emerald-300 font-bold";
							badgeStacking.textContent = "ABAB (Bernal)";
						}
					}

					if (badgeMagnetism) {
						if (isMag) {
							badgeMagnetism.className = "px-2 py-0.5 rounded bg-indigo-900 border border-indigo-400 text-indigo-200 font-bold shadow-lg shadow-indigo-500/30";
							badgeMagnetism.textContent = "MAGNETISM: ON (1.2 µB)";
						} else {
							badgeMagnetism.className = "px-2 py-0.5 rounded bg-slate-800 text-slate-400 font-bold";
							badgeMagnetism.textContent = "MAGNETISM: OFF (0 µB)";
						}
					}

					if (spinArrowsGroup) {
						spinArrowsGroup.style.opacity = isMag ? "1" : "0";
					}
					if (magFieldOverlay) {
						magFieldOverlay.style.opacity = isMag ? "1" : "0";
					}

					if (txtLayerOffset) {
						txtLayerOffset.textContent = isMag ? "0.14 nm (ABCA Rhombohedral Stacking)" : "0.00 nm (ABAB Bernal Baseline)";
					}

					// Update Tracer Point on Hysteresis Plot
					// Graph geometry:
					// V in [-2.5, +2.5] -> X in [40, 290]. Span = 250px.
					// Zero V is at x = 165px.
					// X(V) = 165 + (V / 2.5) * 125.
					const ptX = 165 + (voltage / 2.5) * 125;
					// Y: M=0 is y=240, M=1 is y=40.
					const ptY = isMag ? 40 : 240;

					if (tracerPoint) {
						tracerPoint.setAttribute("cx", ptX.toFixed(1));
						tracerPoint.setAttribute("cy", ptY.toFixed(1));
						tracerPoint.setAttribute("fill", isMag ? "#c084fc" : "#10b981");
					}

					// Readout Text
					if (txtMagState) {
						txtMagState.textContent = isMag ? "M = 1.00 (自发铁磁性 / On)" : "M = 0.00 (非磁性 / Off)";
						txtMagState.className = isMag ? "font-bold text-purple-300" : "font-bold text-slate-300";
					}
					if (txtStackPhase) {
						txtStackPhase.textContent = isMag ? "Rhombohedral (ABCA)" : "Bernal (ABAB)";
						txtStackPhase.className = isMag ? "font-bold text-purple-300" : "font-bold text-emerald-300";
					}
					if (txtRetention) {
						if (Math.abs(voltage) < 0.2) {
							txtRetention.textContent = isMag ? "0V 非易失磁性锁定 (LOCKED ON)" : "0V 非易失非磁保持 (LOCKED OFF)";
							txtRetention.className = "font-bold text-cyan-300";
						} else {
							txtRetention.textContent = "电场调谐中 (Tuning)";
							txtRetention.className = "font-bold text-indigo-400";
						}
					}
				}

				if (voltageSlider) {
					voltageSlider.addEventListener("input", (e) => {
						if (autoCycleInterval) {
							clearInterval(autoCycleInterval);
							autoCycleInterval = null;
						}
						updateHysteresisState(parseFloat(e.target.value));
					}, { signal: lifecycle.signal });
				}

				if (btnPulsePlus) {
					btnPulsePlus.addEventListener("click", () => {
						if (autoCycleInterval) clearInterval(autoCycleInterval);
						if (voltageSlider) voltageSlider.value = "2.0";
						updateHysteresisState(2.0);
					}, { signal: lifecycle.signal });
				}

				if (btnPulseZero) {
					btnPulseZero.addEventListener("click", () => {
						if (autoCycleInterval) clearInterval(autoCycleInterval);
						if (voltageSlider) voltageSlider.value = "0.0";
						updateHysteresisState(0.0);
					}, { signal: lifecycle.signal });
				}

				if (btnPulseMinus) {
					btnPulseMinus.addEventListener("click", () => {
						if (autoCycleInterval) clearInterval(autoCycleInterval);
						if (voltageSlider) voltageSlider.value = "-2.0";
						updateHysteresisState(-2.0);
					}, { signal: lifecycle.signal });
				}

				if (btnAutoCycle) {
					btnAutoCycle.addEventListener("click", () => {
						if (autoCycleInterval) {
							clearInterval(autoCycleInterval);
							autoCycleInterval = null;
							return;
						}
						let curV = voltageSlider ? parseFloat(voltageSlider.value) : 0;
						let step = 0.1;
						autoCycleInterval = setInterval(() => {
							curV += step;
							if (curV >= 2.4) {
								curV = 2.4;
								step = -0.1;
							} else if (curV <= -2.4) {
								curV = -2.4;
								step = 0.1;
							}
							if (voltageSlider) voltageSlider.value = curV.toFixed(2);
							updateHysteresisState(curV);
						}, 60);
					}, { signal: lifecycle.signal });
				}

				// Initialize centerpiece at 0V Bernal
				updateHysteresisState(0.0);


				// ==========================================
				// 2. TWO STACKINGS, TWO PERSONALITIES: TOP-VIEW LATTICE
				// ==========================================
				const toggleStackBernal = document.getElementById("toggle-stack-bernal");
				const toggleStackRhombo = document.getElementById("toggle-stack-rhombo");
				const cardBernal = document.getElementById("card-bernal");
				const cardRhombo = document.getElementById("card-rhombo");

				const chkLayer1 = document.getElementById("chk-layer1");
				const chkLayer2 = document.getElementById("chk-layer2");
				const chkLayer3 = document.getElementById("chk-layer3");
				const chkLayer4 = document.getElementById("chk-layer4");
				const lblChkL3 = document.getElementById("lbl-chk-l3");
				const lblChkL4 = document.getElementById("lbl-chk-l4");

				const topLayer1 = document.getElementById("top-layer-1");
				const topLayer2 = document.getElementById("top-layer-2");
				const topLayer3 = document.getElementById("top-layer-3");
				const topLayer4 = document.getElementById("top-layer-4");

				// Render Top-View Honeycomb paths
				function createHexagonRings(group, offsetX, offsetY, dotColor) {
					if (!group) return;
					const a = 24; // hex side length
					const dx = a * Math.sqrt(3); // ~41.57
					const dy = a * 1.5; // 36
					const markup = [];

					for (let row = 0; row < 5; row++) {
						for (let col = 0; col < 8; col++) {
							const cx = col * dx + (row % 2 ? dx / 2 : 0) + offsetX;
							const cy = row * dy + offsetY;

							// Draw 6-sided hexagon
							const pts = [];
							for (let i = 0; i < 6; i++) {
								const angle = (Math.PI / 180) * (60 * i - 30);
								pts.push(`${(cx + a * Math.cos(angle)).toFixed(1)},${(cy + a * Math.sin(angle)).toFixed(1)}`);
							}
							markup.push(`<polygon points="${pts.join(" ")}" fill="none" stroke-width="1.5"/>`);

							// Atom dots at vertices
							for (let i = 0; i < 6; i++) {
								const angle = (Math.PI / 180) * (60 * i - 30);
								const px = (cx + a * Math.cos(angle)).toFixed(1);
								const py = (cy + a * Math.sin(angle)).toFixed(1);
								markup.push(`<circle cx="${px}" cy="${py}" r="3" fill="${dotColor}"/>`);
							}
						}
					}
					group.innerHTML = markup.join("");
				}

				// Build fixed layers: Layer 1 (A) at (40, 30), Layer 2 (B) shifted by (14, 24)
				createHexagonRings(topLayer1, 40, 30, "#38bdf8");
				createHexagonRings(topLayer2, 54, 54, "#34d399");
				// Initial Layer 3 (A) at (40, 30)
				createHexagonRings(topLayer3, 40, 30, "#fbbf24");
				// Initial Layer 4 (B) at (54, 54)
				createHexagonRings(topLayer4, 54, 54, "#c084fc");

				function setTopStackMode(mode) {
					const isR = mode === "rhombo";

					if (isR) {
						// Shift Layer 3 to C position: offset vector (+28, 0)
						// Shift Layer 4 to A position: offset vector (-14, -24)
						if (topLayer3) topLayer3.style.transform = "translate(24px, 12px)";
						if (topLayer4) topLayer4.style.transform = "translate(-14px, -24px)";

						if (lblChkL3) lblChkL3.textContent = "L3 [C]";
						if (lblChkL4) lblChkL4.textContent = "L4 [A]";

						if (toggleStackRhombo) {
							toggleStackRhombo.className = "px-3 py-1 text-xs font-mono font-bold rounded-lg bg-purple-600 text-white shadow-lg shadow-purple-500/20 cursor-pointer transition active:scale-95";
						}
						if (toggleStackBernal) {
							toggleStackBernal.className = "px-3 py-1 text-xs font-mono font-bold rounded-lg bg-slate-900 border border-slate-700 text-slate-300 hover:text-white cursor-pointer transition active:scale-95";
						}

						if (cardRhombo) {
							cardRhombo.className = "p-4 rounded-xl bg-slate-900/90 border-2 border-purple-500/60 transition-all duration-300 opacity-100";
						}
						if (cardBernal) {
							cardBernal.className = "p-4 rounded-xl bg-slate-900/40 border border-slate-800 transition-all duration-300 opacity-50";
						}
					} else {
						if (topLayer3) topLayer3.style.transform = "translate(0px, 0px)";
						if (topLayer4) topLayer4.style.transform = "translate(0px, 0px)";

						if (lblChkL3) lblChkL3.textContent = "L3 [A]";
						if (lblChkL4) lblChkL4.textContent = "L4 [B]";

						if (toggleStackBernal) {
							toggleStackBernal.className = "px-3 py-1 text-xs font-mono font-bold rounded-lg bg-emerald-600 text-white shadow-lg shadow-emerald-500/20 cursor-pointer transition active:scale-95";
						}
						if (toggleStackRhombo) {
							toggleStackRhombo.className = "px-3 py-1 text-xs font-mono font-bold rounded-lg bg-slate-900 border border-slate-700 text-slate-300 hover:text-white cursor-pointer transition active:scale-95";
						}

						if (cardBernal) {
							cardBernal.className = "p-4 rounded-xl bg-slate-900/90 border-2 border-emerald-500/60 transition-all duration-300 opacity-100";
						}
						if (cardRhombo) {
							cardRhombo.className = "p-4 rounded-xl bg-slate-900/40 border border-slate-800 transition-all duration-300 opacity-50";
						}
					}
				}

				if (toggleStackBernal) {
					toggleStackBernal.addEventListener("click", () => setTopStackMode("bernal"), { signal: lifecycle.signal });
				}
				if (toggleStackRhombo) {
					toggleStackRhombo.addEventListener("click", () => setTopStackMode("rhombo"), { signal: lifecycle.signal });
				}

				// Checkboxes for individual layers
				if (chkLayer1 && topLayer1) {
					chkLayer1.addEventListener("change", (e) => {
						topLayer1.style.display = e.target.checked ? "block" : "none";
					}, { signal: lifecycle.signal });
				}
				if (chkLayer2 && topLayer2) {
					chkLayer2.addEventListener("change", (e) => {
						topLayer2.style.display = e.target.checked ? "block" : "none";
					}, { signal: lifecycle.signal });
				}
				if (chkLayer3 && topLayer3) {
					chkLayer3.addEventListener("change", (e) => {
						topLayer3.style.display = e.target.checked ? "block" : "none";
					}, { signal: lifecycle.signal });
				}
				if (chkLayer4 && topLayer4) {
					chkLayer4.addEventListener("change", (e) => {
						topLayer4.style.display = e.target.checked ? "block" : "none";
					}, { signal: lifecycle.signal });
				}


				// ==========================================
				// 3. WHY SLIDING IS CHEAP: ENERGY TEST
				// ==========================================
				const btnTriggerRewrite = document.getElementById("btn-trigger-rewrite");
				const barConvEnergy = document.getElementById("bar-conv-energy");
				const barVdwEnergy = document.getElementById("bar-vdw-energy");
				const txtConvTemp = document.getElementById("txt-conv-temp");
				const txtConvPress = document.getElementById("txt-conv-press");
				const badgeConvStatus = document.getElementById("badge-conv-status");
				const badgeVdwStatus = document.getElementById("badge-vdw-status");

				let rewriteTesting = false;

				if (btnTriggerRewrite) {
					btnTriggerRewrite.addEventListener("click", () => {
						if (rewriteTesting) return;
						rewriteTesting = true;

						if (badgeConvStatus) badgeConvStatus.textContent = "重构执行中 (Simulating...)";
						if (badgeVdwStatus) badgeVdwStatus.textContent = "电脉冲微滑 (Sliding...)";

						// Animate conventional bar up and down
						if (barConvEnergy) barConvEnergy.style.width = "10%";
						if (barVdwEnergy) barVdwEnergy.style.width = "0%";

						setTimeout(() => {
							if (barConvEnergy) barConvEnergy.style.width = "100%";
							if (barVdwEnergy) barVdwEnergy.style.width = "3%";
							if (txtConvTemp) txtConvTemp.textContent = "1,650 °C (极端热裂解)";
							if (txtConvPress) txtConvPress.textContent = "14.2 GPa (金刚石砧顶压)";
						}, 300);

						setTimeout(() => {
							if (badgeConvStatus) {
								badgeConvStatus.textContent = "化学键强行断裂 / 芯片损毁";
								badgeConvStatus.className = "text-xs font-mono text-rose-400 font-bold";
							}
							if (badgeVdwStatus) {
								badgeVdwStatus.textContent = "原子顺滑到位 / 完好锁定";
								badgeVdwStatus.className = "text-xs font-mono text-emerald-400 font-bold";
							}
							rewriteTesting = false;
						}, 1200);
					}, { signal: lifecycle.signal });
				}


				// ==========================================
				// 4. MEMORY THAT STAYS: 4-BIT NONVOLATILE DEMO
				// ==========================================
				const bitCards = document.querySelectorAll(".bit-card");
				const btnTogglePower = document.getElementById("btn-toggle-power");
				const btnReadMemory = document.getElementById("btn-read-memory");
				const btnEraseAll = document.getElementById("btn-erase-all");
				const btnPresetMems = document.querySelectorAll(".btn-preset-mem");

				const powerIndicatorDot = document.getElementById("power-indicator-dot");
				const txtPowerStatus = document.getElementById("txt-power-status");
				const readoutBin = document.getElementById("readout-bin");
				const readoutHex = document.getElementById("readout-hex");
				const readoutDec = document.getElementById("readout-dec");

				// 4 bits: index 3, 2, 1, 0
				const memBits = [0, 0, 0, 0];
				let powerOnline = true;

				function renderBitCards() {
					bitCards.forEach((card) => {
						const bitIdx = parseInt(card.dataset.bit, 10);
						const val = memBits[bitIdx];
						const valDisplay = card.querySelector(".bit-val-display");
						const stackLabel = card.querySelector(".bit-stack-label");
						const statusDesc = card.querySelector(".bit-status-desc");

						if (valDisplay) {
							valDisplay.textContent = val.toString();
							if (val === 1) {
								valDisplay.className = "bit-val-display text-4xl sm:text-5xl font-mono font-black text-center py-3 text-purple-400 transition-colors";
								card.className = "bit-card p-4 rounded-xl bg-slate-900 border-2 border-purple-500/80 shadow-lg shadow-purple-500/20 hover:border-purple-400 transition cursor-pointer select-none";
							} else {
								valDisplay.className = "bit-val-display text-4xl sm:text-5xl font-mono font-black text-center py-3 text-slate-500 transition-colors";
								card.className = "bit-card p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-indigo-500/50 transition cursor-pointer select-none";
							}
						}

						if (stackLabel) {
							if (val === 1) {
								stackLabel.className = "bit-stack-label text-[10px] px-1.5 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-500/50";
								stackLabel.textContent = "ABCA (Mag)";
							} else {
								stackLabel.className = "bit-stack-label text-[10px] px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-400";
								stackLabel.textContent = "ABAB (Non)";
							}
						}

						if (statusDesc) {
							if (val === 1) {
								statusDesc.innerHTML = `<span class="lang-zh text-purple-300">菱方铁磁 · 0V 保持</span><span class="lang-en text-purple-300">Rhombo Mag · 0V Hold</span>`;
							} else {
								statusDesc.innerHTML = `<span class="lang-zh text-slate-400">伯纳尔非磁 · 0V 保持</span><span class="lang-en text-slate-400">Bernal Non · 0V Hold</span>`;
							}
						}
					});
				}

				function updateReadoutDisplays() {
					const binStr = `${memBits[3]}${memBits[2]}${memBits[1]}${memBits[0]}`;
					const intVal = parseInt(binStr, 2);
					if (readoutBin) readoutBin.textContent = binStr;
					if (readoutHex) readoutHex.textContent = `0x${intVal.toString(16).toUpperCase()}`;
					if (readoutDec) readoutDec.textContent = intVal.toString();
				}

				// Click bit to toggle / pulse
				bitCards.forEach((card) => {
					card.addEventListener("click", () => {
						const bitIdx = parseInt(card.dataset.bit, 10);
						memBits[bitIdx] = memBits[bitIdx] === 0 ? 1 : 0;
						renderBitCards();
						updateReadoutDisplays();
					}, { signal: lifecycle.signal });
				});

				if (btnTogglePower) {
					btnTogglePower.addEventListener("click", () => {
						powerOnline = !powerOnline;
						if (powerOnline) {
							if (powerIndicatorDot) powerIndicatorDot.className = "w-3 h-3 rounded-full bg-emerald-400";
							if (txtPowerStatus) {
								txtPowerStatus.textContent = "ONLINE (V_supply = 2.5 V)";
								txtPowerStatus.className = "font-bold text-emerald-300";
							}
							btnTogglePower.className = "px-3 py-1.5 text-xs font-mono font-bold rounded-lg bg-rose-600 hover:bg-rose-500 text-white shadow-lg shadow-rose-600/30 cursor-pointer transition active:scale-95 flex items-center gap-2";
							btnTogglePower.innerHTML = `<span class="w-2 h-2 rounded-full bg-white animate-ping"></span><span class="lang-zh">🔌 切断供电电源 (0.0V)</span><span class="lang-en">🔌 CUT POWER (0.0V)</span>`;
						} else {
							// POWER CUT TO 0V!
							if (powerIndicatorDot) powerIndicatorDot.className = "w-3 h-3 rounded-full bg-slate-600";
							if (txtPowerStatus) {
								txtPowerStatus.textContent = "OFFLINE (0.00 V — DATA SECURELY LOCKED!)";
								txtPowerStatus.className = "font-bold text-cyan-400 animate-pulse";
							}
							btnTogglePower.className = "px-3 py-1.5 text-xs font-mono font-bold rounded-lg bg-emerald-700 hover:bg-emerald-600 text-white shadow-lg shadow-emerald-700/30 cursor-pointer transition active:scale-95 flex items-center gap-2";
							btnTogglePower.innerHTML = `<span>⚡</span><span class="lang-zh">恢复电源供电 (RESTORE)</span><span class="lang-en">RESTORE POWER</span>`;
						}
					}, { signal: lifecycle.signal });
				}

				if (btnReadMemory) {
					btnReadMemory.addEventListener("click", () => {
						updateReadoutDisplays();
						// Flash readout container
						if (readoutBin) {
							readoutBin.classList.add("scale-110", "text-cyan-300");
							setTimeout(() => {
								readoutBin.classList.remove("scale-110", "text-cyan-300");
							}, 300);
						}
					}, { signal: lifecycle.signal });
				}

				if (btnEraseAll) {
					btnEraseAll.addEventListener("click", () => {
						memBits[0] = 0;
						memBits[1] = 0;
						memBits[2] = 0;
						memBits[3] = 0;
						renderBitCards();
						updateReadoutDisplays();
					}, { signal: lifecycle.signal });
				}

				btnPresetMems.forEach((btn) => {
					btn.addEventListener("click", () => {
						const val = btn.dataset.val;
						if (val && val.length === 4) {
							memBits[3] = parseInt(val[0], 10);
							memBits[2] = parseInt(val[1], 10);
							memBits[1] = parseInt(val[2], 10);
							memBits[0] = parseInt(val[3], 10);
							renderBitCards();
							updateReadoutDisplays();
						}
					}, { signal: lifecycle.signal });
				});

				// Initialize memory displays
				renderBitCards();
				updateReadoutDisplays();
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initSlidingGraphene);
			} else {
				initSlidingGraphene();
			}
			document.addEventListener("astro:page-load", initSlidingGraphene);
		})();
	</script>
</MainGridLayout>
