		.laser-beam.animating {
			animation: laserSweep 1.1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
		}

		@keyframes laserSweep {
			0% {
				top: 0%;
				opacity: 0;
			}
			15% {
				opacity: 1;
			}
			85% {
				opacity: 1;
			}
			100% {
				top: 100%;
				opacity: 0;
			}
		}

		/* Thermal Receipt Paper Aesthetic */
		.thermal-receipt {
			background-image: radial-gradient(#1f293d 0.5px, transparent 0.5px);
			background-size: 8px 8px;
		}
	</style>

	<script>
		import { drawQrCodeToCanvas } from "@/lib/qrcode";

		// ==========================================
		// 1. UPC-A 1D Barcode Encoding Tables & Logic
		// ==========================================
		// Standard Table L (Left digits 1-6: odd parity, 7 modules each)
		const TABLE_L = [
			"0001101", // 0
			"0011001", // 1
			"0010011", // 2
			"0111101", // 3
			"0100011", // 4
			"0110001", // 5
			"0101111", // 6
			"0111011", // 7
			"0110111", // 8
			"0001011", // 9
		];

		// Standard Table R (Right digits 7-12: even parity, 7 modules each - bitwise inverted Table L)
		const TABLE_R = [
			"1110010", // 0
			"1100110", // 1
			"1101100", // 2
			"1000010", // 3
			"1011100", // 4
			"1001110", // 5
			"1010000", // 6
			"1000100", // 7
			"1001000", // 8
			"1110100", // 9
		];

		// Compute UPC-A check digit for 11 digits
		function computeUpcCheckDigit(d11: string): number {
			let oddSum = 0;
			let evenSum = 0;
			for (let i = 0; i < 11; i++) {
				const num = Number.parseInt(d11[i], 10);
				if (i % 2 === 0) {
					oddSum += num; // 1st, 3rd, 5th, 7th, 9th, 11th digit
				} else {
					evenSum += num; // 2nd, 4th, 6th, 8th, 10th digit
				}
			}
			const total = oddSum * 3 + evenSum;
			return (10 - (total % 10)) % 10;
		}

		const isEn = () =>
			document.documentElement.lang === "en" ||
			location.pathname.startsWith("/en") ||
			document.documentElement.getAttribute("data-lang") === "en";

		// Draw 1D UPC-A on canvas
		function drawUpcaToCanvas(canvas: HTMLCanvasElement, gtin12: string): boolean {
			const ctx = canvas.getContext("2d");
			if (!ctx) return false;

			// Display settings
			const dpr = window.devicePixelRatio || 1;
			const displayW = 300;
			const displayH = 150;
			canvas.style.width = `${displayW}px`;
			canvas.style.height = `${displayH}px`;
			canvas.width = displayW * dpr;
			canvas.height = displayH * dpr;

			ctx.save();
			ctx.scale(dpr, dpr);
			ctx.clearRect(0, 0, displayW, displayH);

			// Background
			ctx.fillStyle = "#ffffff";
			ctx.fillRect(0, 0, displayW, displayH);

			// Check digit valid?
			if (gtin12.length !== 12 || !/^\d{12}$/.test(gtin12)) {
				ctx.fillStyle = "#ef4444";
				ctx.font = "12px monospace";
				ctx.textAlign = "center";
				ctx.fillText(
					isEn() ? "Invalid GTIN format (12 numeric digits required)" : "GTIN 格式无效 (需 12 位纯数字)",
					displayW / 2,
					displayH / 2
				);
				ctx.restore();
				return false;
			}

			// Build bit pattern:
			// Start guard (101) + Left 6 digits (42) + Center guard (01010) + Right 6 digits (42) + End guard (101) = 95 modules
			const pattern: { bit: number; isGuard: boolean }[] = [];

			// Start guard: 101
			pattern.push({ bit: 1, isGuard: true });
			pattern.push({ bit: 0, isGuard: true });
			pattern.push({ bit: 1, isGuard: true });

			// Left 6 digits
			for (let i = 0; i < 6; i++) {
				const d = Number.parseInt(gtin12[i], 10);
				const bits = TABLE_L[d];
				for (let j = 0; j < 7; j++) {
					pattern.push({ bit: bits[j] === "1" ? 1 : 0, isGuard: false });
				}
			}

			// Center guard: 01010
			pattern.push({ bit: 0, isGuard: true });
			pattern.push({ bit: 1, isGuard: true });
			pattern.push({ bit: 0, isGuard: true });
			pattern.push({ bit: 1, isGuard: true });
			pattern.push({ bit: 0, isGuard: true });

			// Right 6 digits
			for (let i = 6; i < 12; i++) {
				const d = Number.parseInt(gtin12[i], 10);
				const bits = TABLE_R[d];
				for (let j = 0; j < 7; j++) {
					pattern.push({ bit: bits[j] === "1" ? 1 : 0, isGuard: false });
				}
			}

			// End guard: 101
			pattern.push({ bit: 1, isGuard: true });
			pattern.push({ bit: 0, isGuard: true });
			pattern.push({ bit: 1, isGuard: true });

			// Draw dimensions
			const moduleCount = 95;
			const moduleW = 2.4;
			const totalBarcodeW = moduleCount * moduleW;
			const offsetX = Math.floor((displayW - totalBarcodeW) / 2);
			const startY = 16;
			const normalBarH = 92;
			const guardBarH = 104;

			ctx.fillStyle = "#0c111a";

			for (let i = 0; i < pattern.length; i++) {
				if (pattern[i].bit === 1) {
					const h = pattern[i].isGuard ? guardBarH : normalBarH;
					ctx.fillRect(offsetX + i * moduleW, startY, moduleW, h);
				}
			}

			// Human readable numbers
			ctx.font = "bold 13px ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace";
			ctx.textBaseline = "middle";

			// First digit (d1) outside left guard
			ctx.textAlign = "right";
			ctx.fillText(gtin12[0], offsetX - 5, startY + normalBarH - 4);

			// Left 5 digits (d2..d6)
			ctx.textAlign = "center";
			const leftGroupCenter = offsetX + (3 + 21) * moduleW;
			ctx.fillText(gtin12.slice(1, 6), leftGroupCenter, startY + normalBarH + 10);

			// Right 5 digits (d7..d11)
			const rightGroupCenter = offsetX + (3 + 42 + 5 + 21) * moduleW;
			ctx.fillText(gtin12.slice(6, 11), rightGroupCenter, startY + normalBarH + 10);

			// Last digit (d12 - check digit) outside right guard
			ctx.textAlign = "left";
			ctx.fillText(gtin12[11], offsetX + totalBarcodeW + 5, startY + normalBarH - 4);

			ctx.restore();
			return true;
		}

		// WebAudio checkout scanner beep
		function playScannerBeep() {
			try {
				const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
				if (!AudioContextClass) return;
				const audioCtx = new AudioContextClass();
				const osc = audioCtx.createOscillator();
				const gain = audioCtx.createGain();

				// Supermarket scanner pitch ~2600Hz
				osc.type = "sine";
				osc.frequency.setValueAtTime(2600, audioCtx.currentTime);

				// Crisp click-free volume envelope (85ms duration)
				gain.gain.setValueAtTime(0, audioCtx.currentTime);
				gain.gain.linearRampToValueAtTime(0.2, audioCtx.currentTime + 0.008);
				gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.085);

				osc.connect(gain);
				gain.connect(audioCtx.destination);

				osc.start(audioCtx.currentTime);
				osc.stop(audioCtx.currentTime + 0.085);
			} catch (_e) {
				// User gesture might not be ready
			}
		}

		// Global reference to countdown timer
		let countdownInterval: number | null = null;

		function initPage() {
			// Elements
			const gtinInput = document.getElementById("input-gtin") as HTMLInputElement | null;
			const batchInput = document.getElementById("input-batch") as HTMLInputElement | null;
			const expiryInput = document.getElementById("input-expiry") as HTMLInputElement | null;
			const gtinValidation = document.getElementById("gtin-validation");
			const gs1UrlText = document.getElementById("gs1-url-text");
			const btnCopyUrl = document.getElementById("btn-copy-url");
			const btnScan = document.getElementById("btn-scan");
			const laserSweep = document.getElementById("laser-sweep");

			// Receipt elements
			const receipt1dGtin = document.getElementById("receipt-1d-gtin");
			const receipt2dGtin = document.getElementById("receipt-2d-gtin");
			const receipt2dBatch = document.getElementById("receipt-2d-batch");
			const receipt2dExpiry = document.getElementById("receipt-2d-expiry");
			const receipt2dSerial = document.getElementById("receipt-2d-serial");
			const receipt2dLink = document.getElementById("receipt-2d-link") as HTMLAnchorElement | null;

			// Canvases
			const canvasUpca = document.getElementById("canvas-upca") as HTMLCanvasElement | null;
			const canvasQr = document.getElementById("canvas-qr") as HTMLCanvasElement | null;

			if (!gtinInput || !canvasUpca || !canvasQr) return;

			// Format expiry YYMMDD to readable date
			function formatExpiryDate(yymmdd: string): string {
				if (!/^\d{6}$/.test(yymmdd)) return yymmdd || (isEn() ? "Unspecified" : "未指定");
				const yy = yymmdd.slice(0, 2);
				const mm = yymmdd.slice(2, 4);
				const dd = yymmdd.slice(4, 6);
				return `20${yy}-${mm}-${dd}`;
			}

			// Generate the canonical GS1 Digital Link URL
			function getGs1Url(gtin12: string, batch: string, expiry: string, serial: string): string {
				const gtin14 = gtin12.padStart(14, "0");
				const params = new URLSearchParams();
				if (batch.trim()) params.set("10", batch.trim());
				if (expiry.trim()) params.set("17", expiry.trim());
				if (serial.trim()) params.set("21", serial.trim());
				const query = params.toString();
				return `https://id.gs1.org/01/${gtin14}${query ? `?${query}` : ""}`;
			}

			// Refresh barcodes and data
			function updateBarcodes() {
				if (!gtinInput || !canvasUpca || !canvasQr) return;

				let rawGtin = gtinInput.value.replace(/\D/g, "");

				// If user entered 11 digits, auto compute check digit
				if (rawGtin.length === 11) {
					const check = computeUpcCheckDigit(rawGtin);
					rawGtin += check.toString();
					gtinInput.value = rawGtin;
				}

				const isValid = rawGtin.length === 12;

				if (gtinValidation) {
					if (isValid) {
						const expectedCheck = computeUpcCheckDigit(rawGtin.slice(0, 11));
						const actualCheck = Number.parseInt(rawGtin[11], 10);
						if (expectedCheck === actualCheck) {
							gtinValidation.textContent = isEn() ? "Valid Checksum ✓" : "校验码有效 ✓";
							gtinValidation.className = "absolute right-3 top-2.5 text-xs font-mono text-emerald-400";
						} else {
							gtinValidation.textContent = isEn() ? `Expected Check: ${expectedCheck}` : `建议校验位: ${expectedCheck}`;
							gtinValidation.className = "absolute right-3 top-2.5 text-xs font-mono text-amber-400";
						}
					} else {
						gtinValidation.textContent = isEn()
							? `Enter 12 numeric digits (${rawGtin.length}/12)`
							: `请输入 12 位纯数字 (${rawGtin.length}/12)`;
						gtinValidation.className = "absolute right-3 top-2.5 text-xs font-mono text-red-400";
					}
				}

				const batch = batchInput?.value || "BATCH7";
				const expiry = expiryInput?.value || "271231";
				const serial = "SN123";

				// Draw 1D UPC-A
				drawUpcaToCanvas(canvasUpca, rawGtin);

				// Draw 2D GS1 Digital Link
				const gs1Url = getGs1Url(rawGtin, batch, expiry, serial);
				if (gs1UrlText) gs1UrlText.textContent = gs1Url;

				try {
					drawQrCodeToCanvas(canvasQr, gs1Url, {
						border: 3,
						lightColor: "#ffffff",
						darkColor: "#0a0e17",
						ecLevel: "M",
					});
				} catch (e) {
					console.error("QR Code Error:", e);
				}

				// Update receipt data
				const gtin14 = rawGtin.padStart(14, "0");
				if (receipt1dGtin) receipt1dGtin.textContent = rawGtin;
				if (receipt2dGtin) receipt2dGtin.textContent = gtin14;
				if (receipt2dBatch) receipt2dBatch.textContent = batch || (isEn() ? "Unspecified" : "未指定");
				if (receipt2dExpiry) receipt2dExpiry.textContent = `${formatExpiryDate(expiry)} (${expiry})`;
				if (receipt2dSerial) receipt2dSerial.textContent = serial;
				if (receipt2dLink) {
					receipt2dLink.href = gs1Url;
					receipt2dLink.textContent = gs1Url;
				}
			}

			// Preset buttons
			document.getElementById("btn-preset-wrigley")?.addEventListener("click", () => {
				if (!gtinInput || !batchInput || !expiryInput) return;
				gtinInput.value = "011110000645"; // 1974 Wrigley's gum
				batchInput.value = "MARSH1974";
				expiryInput.value = "741231";
				updateBarcodes();
			});

			document.getElementById("btn-preset-default")?.addEventListener("click", () => {
				if (!gtinInput || !batchInput || !expiryInput) return;
				gtinInput.value = "012345678905";
				batchInput.value = "BATCH7";
				expiryInput.value = "271231";
				updateBarcodes();
			});

			document.getElementById("btn-preset-beverage")?.addEventListener("click", () => {
				if (!gtinInput || !batchInput || !expiryInput) return;
				gtinInput.value = "049000028904"; // Coca-Cola classic UPC
				batchInput.value = "LOT2026C";
				expiryInput.value = "270630";
				updateBarcodes();
			});

			// Input events
			gtinInput.addEventListener("input", updateBarcodes);
			batchInput?.addEventListener("input", updateBarcodes);
			expiryInput?.addEventListener("input", updateBarcodes);

			// Copy URL button
			btnCopyUrl?.addEventListener("click", async () => {
				const url = gs1UrlText?.textContent?.trim() || "";
				if (!url) return;
				try {
					await navigator.clipboard.writeText(url);
					btnCopyUrl.textContent = isEn() ? "Copied ✓" : "已复制 ✓";
					setTimeout(() => {
						btnCopyUrl.textContent = isEn() ? "Copy URL" : "复制 URL";
					}, 2000);
				} catch (_e) {
					btnCopyUrl.textContent = isEn() ? "Copy failed" : "复制失败";
				}
			});

			// Checkout Scan Simulator
			btnScan?.addEventListener("click", () => {
				// Play supermarket scanner audio beep
				playScannerBeep();

				// Trigger laser sweep animation across barcodes
				if (laserSweep) {
					laserSweep.classList.remove("animating");
					void laserSweep.offsetWidth; // trigger reflow
					laserSweep.classList.add("animating");
				}

				// Flash receipts
				const receipts = document.querySelectorAll(".thermal-receipt");
				receipts.forEach((r) => {
					r.classList.add("ring-2", "ring-red-500/50");
					setTimeout(() => r.classList.remove("ring-2", "ring-red-500/50"), 800);
				});
			});

			// Countdown logic to 2028-01-01T00:00:00 local time
			const ledDays = document.getElementById("led-days");
			const ledHours = document.getElementById("led-hours");
			const ledMinutes = document.getElementById("led-minutes");
			const ledSeconds = document.getElementById("led-seconds");

			const targetTime = new Date(2028, 0, 1, 0, 0, 0).getTime();

			function updateCountdown() {
				const now = Date.now();
				const diff = Math.max(0, targetTime - now);

				const days = Math.floor(diff / (1000 * 60 * 60 * 24));
				const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
				const minutes = Math.floor((diff / (1000 * 60)) % 60);
				const seconds = Math.floor((diff / 1000) % 60);

				if (ledDays) ledDays.textContent = String(days).padStart(3, "0");
				if (ledHours) ledHours.textContent = String(hours).padStart(2, "0");
				if (ledMinutes) ledMinutes.textContent = String(minutes).padStart(2, "0");
				if (ledSeconds) ledSeconds.textContent = String(seconds).padStart(2, "0");
			}

			if (countdownInterval !== null) {
				clearInterval(countdownInterval);
			}
			updateCountdown();
			countdownInterval = window.setInterval(updateCountdown, 1000);

			window.addEventListener("lang-change", () => {
				updateBarcodes();
			});

			// Initial render
			updateBarcodes();
		}

		// Initial launch & Swup / Page transition support
		initPage();
		document.addEventListener("astro:page-load", initPage);
	</script>
</MainGridLayout>
