---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

interface Props {
	lang?: string;
}

const { lang = Astro.url.pathname.startsWith("/en") ? "en" : "zh_CN" } =
	Astro.props;
const isEn = lang === "en";

const title = isEn
	? "The Last Scan · Dusk of the Barcode & Sunrise 2027"
	: "最后一次扫描 · 条形码的黄昏与 Sunrise 2027";
const description = isEn
	? "Interactive duel between classic 1D UPC-A barcodes and next-gen GS1 Digital Link 2D codes: live barcode generation, laser checkout simulator, Sunrise 2027 countdown, and retail evolution history."
	: "交互式对比经典 1D UPC-A 条形码与新一代 GS1 Digital Link 二维码：实时生成条码、收银台激光扫码模拟、Sunrise 2027 倒计时与零售演进史。";
---

<MainGridLayout title={title} description={description}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mb-8">
		<div class="z-10 px-5 sm:px-9 py-8 relative w-full rounded-(--radius-large) overflow-hidden bg-[#0a0e17] text-zinc-100 border border-zinc-800/80 shadow-2xl selection:bg-red-500/30 selection:text-red-200">
			<!-- Background Ambient Glow & Grid -->
			<div class="absolute inset-0 pointer-events-none opacity-20 bg-[radial-gradient(#ef4444_1px,transparent_1px)] [background-size:24px_24px] overflow-hidden"></div>
			<div class="absolute -top-32 -left-32 w-80 h-80 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute top-1/2 -right-32 w-80 h-80 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>

			<!-- HERO SECTION -->
			<section class="relative z-10 mb-10 pb-8 border-b border-zinc-800/80">
				<div class="flex flex-wrap items-center justify-between gap-4 mb-3">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-mono font-medium tracking-wide">
						<span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
						RETAIL MILESTONE · SUNRISE 2027
					</div>
					<div class="text-xs font-mono text-zinc-300">
						<span class="lang-zh">HN 热议 · 2026-10-03</span>
						<span class="lang-en">Trending on HN · 2026-10-03</span>
					</div>
				</div>

				<h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-3">
					<span class="lang-zh">最后一次扫描</span>
					<span class="lang-en">The Last Scan</span>
				</h1>
				<p class="text-lg sm:text-xl font-medium text-red-400/90 mb-4 tracking-wide font-mono">
					<span class="lang-zh">条形码的黄昏 / Sunrise 2027</span>
					<span class="lang-en">Dusk of the Barcode / Sunrise 2027</span>
				</p>
				<p class="text-sm sm:text-base text-zinc-300/80 max-w-3xl leading-relaxed mb-8">
					<span class="lang-zh">
						2026 年 10 月 3 日，Hacker News 首页热榜讨论《条形码即将走向黄昏》（Barcodes are about to go extinct）：全球零售业迎来 GS1“Sunrise 2027（2027 黎明日）”大转折。
						到 2027 年底，全球超市收银 POS 系统将全面普及具备读取 2D 条码（GS1 Digital Link 二维码 / GS1 DataMatrix）的能力。
						50 年来在收银台此起彼伏的“哔”声，正在迎来半个世纪以来最大的信息维度跃迁。
					</span>
					<span class="lang-en">
						On October 3, 2026, the Hacker News front page sparked an impassioned debate on "Barcodes are about to go extinct": global retail is racing toward GS1's watershed "Sunrise 2027" milestone.
						By the end of 2027, supermarket checkout POS scanners worldwide will be upgraded to decode 2D barcodes (GS1 Digital Link QR codes / GS1 DataMatrix).
						The iconic checkout "beep" that has echoed across cash registers for over 50 years is about to make its biggest leap in data capacity in half a century.
					</span>
				</p>

				<!-- 7-Segment LED Countdown Display -->
				<div class="rounded-2xl bg-black/80 border border-zinc-800 p-5 sm:p-7 shadow-inner relative overflow-hidden">
					<div class="flex flex-wrap items-center justify-between gap-2 mb-4">
						<div class="flex items-center gap-2">
							<span class="text-xs font-mono uppercase tracking-widest text-zinc-300">
								<span class="lang-zh">距离 Sunrise 2027 终局节点（2028-01-01 00:00:00）剩余</span>
								<span class="lang-en">Time remaining until Sunrise 2027 full transition (2028-01-01 00:00:00):</span>
							</span>
						</div>
						<div class="text-[11px] font-mono text-red-400/80 bg-red-950/40 px-2.5 py-0.5 rounded border border-red-900/50">
							LIVE SYNC · 7-SEGMENT LED
						</div>
					</div>

					<div class="grid grid-cols-4 gap-2 sm:gap-6 text-center max-w-3xl mx-auto">
						<!-- DAYS -->
						<div class="flex flex-col items-center bg-zinc-950/90 rounded-xl p-2 sm:p-4 border border-zinc-800/80 shadow-[inset_0_2px_4px_rgba(0,0,0,0.8)]">
							<div class="countdown-digit-wrap flex justify-center items-center gap-1 sm:gap-2 text-red-500 font-mono text-2xl sm:text-4xl md:text-5xl font-black drop-shadow-[0_0_12px_rgba(239,68,68,0.7)]" id="led-days">
								000
							</div>
							<span class="mt-2 text-[9px] min-[360px]:text-[10px] sm:text-xs font-mono uppercase tracking-tight sm:tracking-wider text-zinc-300 block text-center truncate max-w-full">
								<span class="lang-zh">天 (Days)</span>
								<span class="lang-en">Days</span>
							</span>
						</div>

						<!-- HOURS -->
						<div class="flex flex-col items-center bg-zinc-950/90 rounded-xl p-2 sm:p-4 border border-zinc-800/80 shadow-[inset_0_2px_4px_rgba(0,0,0,0.8)]">
							<div class="countdown-digit-wrap flex justify-center items-center gap-1 sm:gap-2 text-red-500 font-mono text-2xl sm:text-4xl md:text-5xl font-black drop-shadow-[0_0_12px_rgba(239,68,68,0.7)]" id="led-hours">
								00
							</div>
							<span class="mt-2 text-[9px] min-[360px]:text-[10px] sm:text-xs font-mono uppercase tracking-tight sm:tracking-wider text-zinc-300 block text-center truncate max-w-full">
								<span class="lang-zh">时 (Hours)</span>
								<span class="lang-en">Hours</span>
							</span>
						</div>

						<!-- MINUTES -->
						<div class="flex flex-col items-center bg-zinc-950/90 rounded-xl p-2 sm:p-4 border border-zinc-800/80 shadow-[inset_0_2px_4px_rgba(0,0,0,0.8)]">
							<div class="countdown-digit-wrap flex justify-center items-center gap-1 sm:gap-2 text-red-500 font-mono text-2xl sm:text-4xl md:text-5xl font-black drop-shadow-[0_0_12px_rgba(239,68,68,0.7)]" id="led-minutes">
								00
							</div>
							<span class="mt-2 text-[9px] min-[360px]:text-[10px] sm:text-xs font-mono uppercase tracking-tight sm:tracking-wider text-zinc-300 block text-center truncate max-w-full">
								<span class="lang-zh">分 (Minutes)</span>
								<span class="lang-en">Minutes</span>
							</span>
						</div>

						<!-- SECONDS -->
						<div class="flex flex-col items-center bg-zinc-950/90 rounded-xl p-2 sm:p-4 border border-zinc-800/80 shadow-[inset_0_2px_4px_rgba(0,0,0,0.8)]">
							<div class="countdown-digit-wrap flex justify-center items-center gap-1 sm:gap-2 text-red-500 font-mono text-2xl sm:text-4xl md:text-5xl font-black drop-shadow-[0_0_12px_rgba(239,68,68,0.7)]" id="led-seconds">
								00
							</div>
							<span class="mt-2 text-[9px] min-[360px]:text-[10px] sm:text-xs font-mono uppercase tracking-tight sm:tracking-wider text-zinc-300 block text-center truncate max-w-full">
								<span class="lang-zh">秒 (Seconds)</span>
								<span class="lang-en">Seconds</span>
							</span>
						</div>
					</div>
				</div>
			</section>

			<!-- BARCODE DUEL SECTION -->
			<section class="relative z-10 mb-10 pb-10 border-b border-zinc-800/80">
				<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
					<div>
						<h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2">
							<span class="text-red-500 font-mono text-xl">01/</span>
							<span class="lang-zh">条码对决 (Barcode Duel)</span>
							<span class="lang-en">Barcode Duel</span>
						</h2>
						<p class="text-xs sm:text-sm text-zinc-300 mt-1">
							<span class="lang-zh">纯原生 Canvas 绘制经典 1D UPC-A 条形码与 GS1 2D 数字链接二维码，实时比较信息编码密度。</span>
							<span class="lang-en">Pure native Canvas rendering comparing classic 1D UPC-A linear barcodes with GS1 2D Digital Link QR codes in real time.</span>
						</p>
					</div>

					<!-- Presets picker -->
					<div class="flex flex-wrap gap-2 text-xs font-mono">
						<button id="btn-preset-wrigley" class="px-2.5 py-1.5 rounded-lg bg-zinc-900 border border-zinc-700/80 hover:border-red-500/60 hover:text-white transition active:scale-95 text-zinc-300">
							<span class="lang-zh">🍬 1974 箭牌口香糖</span>
							<span class="lang-en">🍬 1974 Wrigley's Gum</span>
						</button>
						<button id="btn-preset-default" class="px-2.5 py-1.5 rounded-lg bg-zinc-900 border border-zinc-700/80 hover:border-red-500/60 hover:text-white transition active:scale-95 text-zinc-300">
							<span class="lang-zh">📦 标准 GTIN-12</span>
							<span class="lang-en">📦 Standard GTIN-12</span>
						</button>
						<button id="btn-preset-beverage" class="px-2.5 py-1.5 rounded-lg bg-zinc-900 border border-zinc-700/80 hover:border-red-500/60 hover:text-white transition active:scale-95 text-zinc-300">
							<span class="lang-zh">🥤 经典罐装可乐</span>
							<span class="lang-en">🥤 Classic Coke Can</span>
						</button>
					</div>
				</div>

				<!-- Duel Inputs Form -->
				<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8 bg-zinc-950/60 p-4 sm:p-5 rounded-2xl border border-zinc-800/80">
					<div class="md:col-span-2">
						<label for="input-gtin" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5">
							<span class="lang-zh">GTIN-12 / UPC 代码 (输入 11 位自动计算第 12 位校验码)</span>
							<span class="lang-en">GTIN-12 / UPC Code (11 digits auto-completes 12th check digit)</span>
						</label>
						<div class="relative">
							<input
								id="input-gtin"
								type="text"
								maxlength="12"
								value="012345678905"
								class="w-full bg-black/80 border border-zinc-700 rounded-xl px-3.5 py-2.5 font-mono text-base text-zinc-100 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition"
								placeholder="012345678905"
							/>
							<span id="gtin-validation" class="absolute right-3 top-2.5 text-xs font-mono text-emerald-400">
								<span class="lang-zh">校验有效</span>
								<span class="lang-en">Valid Checksum</span>
							</span>
						</div>
					</div>

					<div>
						<label for="input-batch" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5">
							<span class="lang-zh">生产批次 / Lot (AI 10)</span>
							<span class="lang-en">Batch / Lot Number (AI 10)</span>
						</label>
						<input
							id="input-batch"
							type="text"
							maxlength="20"
							value="BATCH7"
							class="w-full bg-black/80 border border-zinc-700 rounded-xl px-3.5 py-2.5 font-mono text-base text-zinc-100 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition"
							placeholder="BATCH7"
						/>
					</div>

					<div>
						<label for="input-expiry" class="block text-xs font-mono uppercase tracking-wider text-zinc-300 mb-1.5">
							<span class="lang-zh">到期日 / Expiry (AI 17, YYMMDD)</span>
							<span class="lang-en">Expiry Date (AI 17, YYMMDD)</span>
						</label>
						<input
							id="input-expiry"
							type="text"
							maxlength="6"
							value="271231"
							class="w-full bg-black/80 border border-zinc-700 rounded-xl px-3.5 py-2.5 font-mono text-base text-zinc-100 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition"
							placeholder="271231 (2027-12-31)"
						/>
					</div>
				</div>

				<!-- Barcode Duel Rendering Arena -->
				<div id="duel-arena" class="relative grid grid-cols-1 md:grid-cols-2 gap-6 p-4 sm:p-6 rounded-2xl bg-zinc-950/80 border border-zinc-800 overflow-hidden">
					<!-- Animated Sweeping Laser Line (Active on Scan) -->
					<div id="laser-sweep" class="laser-beam pointer-events-none opacity-0"></div>

					<!-- LEFT CARD: 1D UPC-A -->
					<div class="flex flex-col items-center justify-between p-5 rounded-xl bg-[#0e1422] border border-zinc-800/80 relative">
						<div class="w-full flex items-center justify-between text-xs font-mono pb-3 mb-3 border-b border-zinc-800">
							<span class="text-zinc-300 font-semibold">
								<span class="lang-zh">1D 传统线性条形码 (UPC-A)</span>
								<span class="lang-en">1D Classic Linear Barcode (UPC-A)</span>
							</span>
							<span class="px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 text-[10px]">
								<span class="lang-zh">1974 年代标准</span>
								<span class="lang-en">1974 Legacy Standard</span>
							</span>
						</div>

						<!-- Canvas Container -->
						<div class="w-full flex items-center justify-center p-3 bg-white rounded-lg shadow-md my-2">
							<canvas id="canvas-upca" width="300" height="150" class="max-w-full block"></canvas>
						</div>

						<div class="w-full mt-3 text-xs font-mono space-y-1 text-zinc-300">
							<div class="flex justify-between">
								<span>
									<span class="lang-zh">编码容量:</span>
									<span class="lang-en">Data Capacity:</span>
								</span>
								<span class="text-zinc-200">
									<span class="lang-zh">仅 12 个纯数字</span>
									<span class="lang-en">Strictly 12 digits</span>
								</span>
							</div>
							<div class="flex justify-between">
								<span>
									<span class="lang-zh">容错纠错:</span>
									<span class="lang-en">Error Correction:</span>
								</span>
								<span class="text-amber-400">
									<span class="lang-zh">无 (破损即无法读取)</span>
									<span class="lang-en">None (Scratches cause read failure)</span>
								</span>
							</div>
							<div class="flex justify-between">
								<span>
									<span class="lang-zh">手机相机支持:</span>
									<span class="lang-en">Smartphone Camera:</span>
								</span>
								<span class="text-red-400">
									<span class="lang-zh">否 (需专用激光扫码枪)</span>
									<span class="lang-en">No (Requires laser scanner)</span>
								</span>
							</div>
						</div>
					</div>

					<!-- RIGHT CARD: 2D GS1 Digital Link -->
					<div class="flex flex-col items-center justify-between p-5 rounded-xl bg-[#0e1422] border border-zinc-800/80 relative">
						<div class="w-full flex items-center justify-between text-xs font-mono pb-3 mb-3 border-b border-zinc-800">
							<span class="text-red-400 font-semibold">
								<span class="lang-zh">2D GS1 Digital Link (二维码)</span>
								<span class="lang-en">2D GS1 Digital Link (QR Code)</span>
							</span>
							<span class="px-2 py-0.5 rounded bg-red-950/60 border border-red-800/50 text-red-400 text-[10px]">
								<span class="lang-zh">Sunrise 2027 规范</span>
								<span class="lang-en">Sunrise 2027 Standard</span>
							</span>
						</div>

						<!-- Canvas Container -->
						<div class="w-full flex items-center justify-center p-3 bg-white rounded-lg shadow-md my-2">
							<canvas id="canvas-qr" width="260" height="260" class="max-w-full block"></canvas>
						</div>

						<div class="w-full mt-3 text-xs font-mono space-y-1 text-zinc-300">
							<div class="flex justify-between">
								<span>
									<span class="lang-zh">编码容量:</span>
									<span class="lang-en">Data Capacity:</span>
								</span>
								<span class="text-emerald-400">
									<span class="lang-zh">达数千字节 (URL + 结构化参数)</span>
									<span class="lang-en">Kilobytes (URL + structured data)</span>
								</span>
							</div>
							<div class="flex justify-between">
								<span>
									<span class="lang-zh">容错纠错:</span>
									<span class="lang-en">Error Correction:</span>
								</span>
								<span class="text-emerald-400">
									<span class="lang-zh">Reed-Solomon (最高 30% 遮挡自愈)</span>
									<span class="lang-en">Reed-Solomon (Recovers up to 30% damage)</span>
								</span>
							</div>
							<div class="flex justify-between">
								<span>
									<span class="lang-zh">手机相机支持:</span>
									<span class="lang-en">Smartphone Camera:</span>
								</span>
								<span class="text-emerald-400">
									<span class="lang-zh">是 (普通手机原生相机秒开网页)</span>
									<span class="lang-en">Yes (Native camera scans directly)</span>
								</span>
							</div>
						</div>
					</div>
				</div>

				<!-- GS1 Digital Link URL Live Preview -->
				<div class="mt-4 p-3 rounded-xl bg-black/60 border border-zinc-800/80 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
					<div class="flex items-center gap-2 overflow-hidden text-ellipsis">
						<span class="text-zinc-400 uppercase">GS1 URL:</span>
						<span id="gs1-url-text" class="text-red-400/90 truncate max-w-xl">
							https://id.gs1.org/01/00012345678905?10=BATCH7&17=271231&21=SN123
						</span>
					</div>
					<button id="btn-copy-url" class="px-3 py-1 rounded-lg bg-zinc-900 border border-zinc-700 hover:border-red-500 hover:text-white transition active:scale-95 text-zinc-300 whitespace-nowrap">
						<span class="lang-zh">复制 URL</span>
						<span class="lang-en">Copy URL</span>
					</button>
				</div>
			</section>

			<!-- CHECKOUT SIMULATOR SECTION -->
			<section class="relative z-10 mb-10 pb-10 border-b border-zinc-800/80">
				<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
					<div>
						<h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2">
							<span class="text-red-500 font-mono text-xl">02/</span>
							<span class="lang-zh">收银台模拟 (Checkout Simulator)</span>
							<span class="lang-en">Checkout Simulator</span>
						</h2>
						<p class="text-xs sm:text-sm text-zinc-300 mt-1">
							<span class="lang-zh">模拟收银员扫描：触发激光线扫描动画、伴随经典的 WebAudio 高频结账“哔”声，对比两张收银终端小票。</span>
							<span class="lang-en">Simulate the cashier scan: trigger an animated laser beam with classic high-frequency WebAudio checkout "beep", comparing both POS terminal receipts.</span>
						</p>
					</div>

					<button
						id="btn-scan"
						class="px-6 py-3 rounded-xl bg-red-600 hover:bg-red-500 active:scale-95 text-white font-mono font-bold text-sm tracking-wide shadow-[0_0_20px_rgba(239,68,68,0.5)] transition flex items-center gap-2"
					>
						<span class="text-lg">⚡</span>
						<span>
							<span class="lang-zh">立即扫描 (Scan Both)</span>
							<span class="lang-en">Scan Both Now</span>
						</span>
					</button>
				</div>

				<!-- Receipt Comparison Panel -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- 1D Receipt -->
					<div class="thermal-receipt bg-zinc-950 p-5 rounded-2xl border border-zinc-800 font-mono text-xs text-zinc-300 relative">
						<div class="text-center pb-3 mb-3 border-b border-dashed border-zinc-700">
							<div class="text-sm font-bold text-zinc-100">
								<span class="lang-zh">--- 1D 收银 POS 终端 ---</span>
								<span class="lang-en">--- 1D POS TERMINAL ---</span>
							</div>
							<div class="text-[10px] text-zinc-400 mt-0.5">LEGACY LINEAR UPC SCANNER</div>
						</div>

						<div class="space-y-2 py-2">
							<div class="text-zinc-300">
								<span class="lang-zh">读取模式: 光学反光电平变化</span>
								<span class="lang-en">Read Mode: Optical reflectance pulses</span>
							</div>
							<div class="p-2.5 rounded-lg bg-zinc-900/90 border border-zinc-800 text-zinc-200">
								<span class="text-zinc-400">GTIN: </span>
								<span id="receipt-1d-gtin" class="font-bold text-white">012345678905</span>
								<span class="text-amber-400 block mt-1 text-[11px]">
									<span class="lang-zh">就这些。12 个数字，没有更多信息。</span>
									<span class="lang-en">That's it. 12 digits, zero additional data.</span>
								</span>
							</div>

							<div class="space-y-1.5 pt-2 text-[11px] text-zinc-300">
								<div class="flex justify-between border-b border-zinc-800/60 pb-1">
									<span>
										<span class="lang-zh">生产批次 (Lot):</span>
										<span class="lang-en">Batch / Lot:</span>
									</span>
									<span class="text-red-400">
