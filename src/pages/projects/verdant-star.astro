	<!-- CLIENT-SIDE SIMULATION & INTERACTIVE ENGINE SCRIPT -->
	<script is:inline>
		(() => {
			function initVerdantStar() {
				const sliderNa = document.getElementById("slider-na");
				if (!sliderNa || sliderNa.dataset.vsReady === "true") return;
				sliderNa.dataset.vsReady = "true";

				// Lifecycle abort controller for clean listener cleanup on page navigation
				const lifecycle = new AbortController();
				const cleanup = () => {
					lifecycle.abort();
					document.removeEventListener("astro:before-swap", cleanup);
				};
				document.addEventListener("astro:before-swap", cleanup, { once: true });

				// ==========================================
				// 1. STAR PAINTER INTERACTIVE ENGINE
				// ==========================================
				const sliderCarbon = document.getElementById("slider-carbon");
				const sliderDebris = document.getElementById("slider-debris");
				const sliderH2he = document.getElementById("slider-h2he");

				const toggleNa = document.getElementById("toggle-na");
				const toggleCarbon = document.getElementById("toggle-carbon");
				const toggleDebris = document.getElementById("toggle-debris");
				const toggleH2he = document.getElementById("toggle-h2he");

				const badgeNa = document.getElementById("badge-na-val");
				const badgeCarbon = document.getElementById("badge-carbon-val");
				const badgeDebris = document.getElementById("badge-debris-val");
				const badgeH2he = document.getElementById("badge-h2he-val");

				const starDisc = document.getElementById("star-disc");
				const starMidHalo = document.getElementById("star-mid-halo");
				const starOuterHalo = document.getElementById("star-outer-halo");
				const starCoronaBg = document.getElementById("star-corona-bg");
				const starColorName = document.getElementById("star-color-name");
				const starColorHex = document.getElementById("star-color-hex");
				const starColorRgb = document.getElementById("star-color-rgb");
				const starColorDesc = document.getElementById("star-color-desc");

				const svgTransmitted = document.getElementById("svg-transmitted-path");
				const svgBaseline = document.getElementById("svg-baseline-path");
				const svgFill = document.getElementById("svg-fill-path");
				const rainbowMask = document.getElementById("rainbow-mask");

				const presetButtons = document.querySelectorAll(".preset-btn");

				// Model state
				const state = {
					na: 95,
					carbon: 0,
					debris: 0,
					h2he: 0,
					naActive: true,
					carbonActive: false,
					debrisActive: false,
					h2heActive: false,
				};

				// Presets data definitions
				const presets = {
					ordinary: { na: 0, carbon: 0, debris: 0, h2he: 0 },
					wd1330: { na: 95, carbon: 0, debris: 0, h2he: 0 },
					wd1011: { na: 0, carbon: 92, debris: 0, h2he: 0 },
					carbon: { na: 0, carbon: 98, debris: 0, h2he: 25 },
					debris: { na: 10, carbon: 0, debris: 85, h2he: 0 },
					h2he: { na: 0, carbon: 0, debris: 0, h2he: 88 },
				};

				// Planck blackbody helper at ~4273 K (normalized across 380 to 750 nm)
				function planck4000(lambda) {
					// Approximate curve peaking around 680-720 nm
					const x = (lambda - 380) / 370; // 0 to 1
					// Smooth rising curve with slight plateau
					return 0.35 + 0.65 * Math.sin(x * Math.PI * 0.65);
				}

				// Calculate transmission across wavelength
				function getTransmission(lambda) {
					let t = 1.0;
					const naVal = state.naActive ? state.na / 100 : 0;
					const carbonVal = state.carbonActive ? state.carbon / 100 : 0;
					const debrisVal = state.debrisActive ? state.debris / 100 : 0;
					const h2heVal = state.h2heActive ? state.h2he / 100 : 0;

					// 1. Sodium collisional broadening: broad trough across 550 to 650 nm, centered at 600 nm
					if (naVal > 0) {
						const dist = Math.abs(lambda - 600);
						const width = 45; // Broadened
						const notch = Math.exp(-0.5 * (dist / width) * (dist / width));
						t *= (1.0 - 0.94 * naVal * notch);
					}

					// 2. Carbon Swan bands: extinguishes wavelengths below 600 nm
					if (carbonVal > 0 && lambda < 605) {
						const cut = 1.0 / (1.0 + Math.exp((lambda - 580) / 12));
						t *= (1.0 - 0.95 * carbonVal * cut);
					}

					// 3. Debris: planetary metals (Ca, Fe, Li) absorb blue/UV < 490 nm
					if (debrisVal > 0 && lambda < 500) {
						const blueCut = (500 - lambda) / 120;
						t *= Math.max(0.05, 1.0 - 0.90 * debrisVal * Math.min(1.0, blueCut));
					}

					// 4. H2-He collision-induced absorption: absorbs red/infrared > 640 nm
					if (h2heVal > 0 && lambda > 620) {
						const redCut = (lambda - 620) / 130;
						t *= Math.max(0.08, 1.0 - 0.88 * h2heVal * Math.min(1.0, redCut));
					}

					return Math.max(0.02, t);
				}

				// Compute perceived RGB color based on transmitted spectrum and blackbody continuum
				function computeStarColor() {
					const naVal = state.naActive ? state.na / 100 : 0;
					const carbonVal = state.carbonActive ? state.carbon / 100 : 0;
					const debrisVal = state.debrisActive ? state.debris / 100 : 0;
					const h2heVal = state.h2heActive ? state.h2he / 100 : 0;

					// Calibrated RGB synthesis from spectral transmission
					let r = 1.0 * (1.0 - 0.86 * naVal) * (1.0 - 0.76 * h2heVal) + 0.18 * carbonVal + 0.20 * debrisVal;
					let g = 0.65 * (1.0 - 0.82 * carbonVal) * (1.0 - 0.25 * naVal * (1.0 - debrisVal)) * (1.0 - 0.15 * debrisVal) + 0.35 * naVal;
					let b = 0.35 * (1.0 - 0.92 * carbonVal) * (1.0 - 0.85 * debrisVal) * (1.0 + 0.25 * h2heVal);

					// When sodium is active and carbon is zero, enforce green-dominant chartreuse
					if (naVal > 0.5 && carbonVal < 0.2) {
						r = Math.min(r, 0.58);
						g = Math.max(g, 0.92);
						b = Math.min(b, 0.30);
					}

					// Normalize
					const maxChannel = Math.max(r, g, b, 0.001);
					r = Math.min(255, Math.max(0, Math.round((r / maxChannel) * 255)));
					g = Math.min(255, Math.max(0, Math.round((g / maxChannel) * 255)));
					b = Math.min(255, Math.max(0, Math.round((b / maxChannel) * 255)));

					const hex = `#${((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1).toUpperCase()}`;

					// Color naming & scientific description
					let nameZh = "普通橙红光 (Orange)";
					let nameEn = "Ordinary Orange Glow";
					let descZh = "4,000 °C 恒星常规热辐射，呈温暖橙红连续谱。";
					let descEn = "Baseline 4,000 °C stellar thermal radiation with continuous orange continuum.";

					if (naVal > 0.5 && carbonVal < 0.3) {
						nameZh = "查特酒绿 / 黄绿幽光 (Chartreuse)";
						nameEn = "Chartreuse Green Glow";
						descZh = "高密氦气碰撞致宽剧烈吸收橙黄红光，残存绿蓝波段，在人眼模型中呈现不可思议的黄绿幽光。";
						descEn = "Helium-sodium collisional broadening removes orange and red, leaving green and blue to form chartreuse.";
					} else if (carbonVal > 0.5) {
						nameZh = "深肉粉色 (Salmon Pink)";
						nameEn = "Deep Salmon Pink";
						descZh = "碳分子斯旺带彻底扼杀 600nm 以下波段，迫使全部光芒聚集于深红，形成极度深沉的肉粉色。";
						descEn = "Molecular carbon Swan bands choke light below 600nm, concentrating radiance into salmon-pink.";
					} else if (debrisVal > 0.5) {
						nameZh = "碎屑金黄色 (Yellow Tint)";
						nameEn = "Golden Yellow Tint";
						descZh = "吸积破碎岩质行星的金属元素（铁、钙）吸收蓝紫端，赋予白矮星金黄色泽。";
						descEn = "Accreted planetary debris with heavy elements absorbs blue/UV, casting a golden-yellow hue.";
					} else if (h2heVal > 0.5) {
						nameZh = "冷青冰蓝光 (Cyan / Pale Blue)";
						nameEn = "Cyan / Pale Blue";
						descZh = "低温氢氦混合大气中碰撞诱导吸收（CIA）压制红外与红光，使恒星显露清冷青蓝。";
						descEn = "Collision-induced absorption (CIA) suppresses red/infrared in cool H+He atmospheres, leaving cyan.";
					}

					return { r, g, b, hex, nameZh, nameEn, descZh, descEn };
				}

				// Render spectrum graph & star disc
				function updateStarPainter() {
					const col = computeStarColor();

					// 1. Update Glowing Star Disc
					if (starDisc) {
						starDisc.style.backgroundColor = col.hex;
						starDisc.style.boxShadow = `0 0 50px ${col.hex}, inset 0 0 20px #ffffff`;
					}
					if (starMidHalo) {
						starMidHalo.style.backgroundColor = col.hex;
						starMidHalo.style.boxShadow = `0 0 80px ${col.hex}`;
					}
					if (starOuterHalo) {
						starOuterHalo.style.backgroundColor = col.hex;
					}
					if (starCoronaBg) {
						starCoronaBg.style.backgroundColor = col.hex;
					}

					// 2. Update color names and values
					if (starColorName) {
						starColorName.innerHTML = `<span class="lang-zh">${col.nameZh}</span><span class="lang-en">${col.nameEn}</span>`;
						starColorName.style.color = col.hex;
					}
					if (starColorHex) starColorHex.textContent = col.hex;
					if (starColorRgb) starColorRgb.textContent = `rgb(${col.r}, ${col.g}, ${col.b})`;
					if (starColorDesc) {
						starColorDesc.innerHTML = `<span class="lang-zh">${col.descZh}</span><span class="lang-en">${col.descEn}</span>`;
					}

					// 3. Render SVG Curves (500x120 viewBox)
					// Sample 50 points from 380 to 750 nm
					const pointsBase = [];
					const pointsTrans = [];
					const widthPx = 500;
					const heightPx = 110;

					for (let i = 0; i <= 50; i++) {
						const lambda = 380 + (i / 50) * 370;
						const x = (i / 50) * widthPx;
						const baseFlux = planck4000(lambda);
						const trans = getTransmission(lambda);
						const transFlux = baseFlux * trans;

						const yBase = heightPx - baseFlux * 90;
						const yTrans = heightPx - transFlux * 90;

						pointsBase.push(`${x.toFixed(1)},${yBase.toFixed(1)}`);
						pointsTrans.push(`${x.toFixed(1)},${yTrans.toFixed(1)}`);
					}

					if (svgBaseline) {
						svgBaseline.setAttribute("d", `M ${pointsBase.join(" L ")}`);
					}
					if (svgTransmitted) {
						svgTransmitted.setAttribute("d", `M ${pointsTrans.join(" L ")}`);
						svgTransmitted.setAttribute("stroke", col.hex);
					}
					if (svgFill) {
						const fillD = `M ${pointsTrans[0]} L ${pointsTrans.join(" L ")} L ${widthPx},${heightPx} L 0,${heightPx} Z`;
						svgFill.setAttribute("d", fillD);
					}

					// 4. Update Rainbow Mask: darken regions of high absorption
					if (rainbowMask) {
						// Build simple linear-gradient opacity mask

						const gradStops = [];
						for (let s = 0; s <= 10; s++) {
							const lam = 380 + (s / 10) * 370;
							const trans = getTransmission(lam);
							const darkness = Math.max(0, 1.0 - trans) * 0.85;
							gradStops.push(`rgba(7, 11, 20, ${darkness.toFixed(2)}) ${(s * 10)}%`);
						}
						rainbowMask.style.background = `linear-gradient(to right, ${gradStops.join(", ")})`;
					}
				}

				// Slider Event Listeners
				function bindSlider(slider, badge, key) {
					if (!slider) return;
					slider.addEventListener("input", (e) => {
						const val = parseInt(e.target.value, 10);
						state[key] = val;
						if (badge) badge.textContent = `${val}%`;
						state[`${key}Active`] = val > 0;
						updateToggleBtn(key);
						highlightActivePreset(null);
						updateStarPainter();
					}, { signal: lifecycle.signal });
				}

				bindSlider(sliderNa, badgeNa, "na");
				bindSlider(sliderCarbon, badgeCarbon, "carbon");
				bindSlider(sliderDebris, badgeDebris, "debris");
				bindSlider(sliderH2he, badgeH2he, "h2he");

				// Toggle buttons
				function updateToggleBtn(key) {
					const btn = document.getElementById(`toggle-${key}`);
					if (!btn) return;
					const active = state[`${key}Active`];
					if (active) {
						btn.className = "w-5 h-5 rounded flex items-center justify-center border transition cursor-pointer bg-lime-500 border-lime-400 text-black font-bold text-xs";
						btn.textContent = "✓";
					} else {
						btn.className = "w-5 h-5 rounded flex items-center justify-center border transition cursor-pointer bg-slate-800 border-slate-700 text-transparent text-xs";
						btn.textContent = "";
					}
				}

				function bindToggle(btn, slider, badge, key) {
					if (!btn) return;
					btn.addEventListener("click", () => {
						state[`${key}Active`] = !state[`${key}Active`];
						if (state[`${key}Active`] && state[key] === 0) {
							state[key] = key === "na" ? 95 : 85;
							if (slider) slider.value = state[key];
							if (badge) badge.textContent = `${state[key]}%`;
						}
						updateToggleBtn(key);
						highlightActivePreset(null);
						updateStarPainter();
					}, { signal: lifecycle.signal });
				}

				bindToggle(toggleNa, sliderNa, badgeNa, "na");
				bindToggle(toggleCarbon, sliderCarbon, badgeCarbon, "carbon");
				bindToggle(toggleDebris, sliderDebris, badgeDebris, "debris");
				bindToggle(toggleH2he, sliderH2he, badgeH2he, "h2he");

				// Preset Buttons
				function applyPreset(presetKey) {
					const p = presets[presetKey];
					if (!p) return;

					state.na = p.na;
					state.carbon = p.carbon;
					state.debris = p.debris;
					state.h2he = p.h2he;

					state.naActive = p.na > 0;
					state.carbonActive = p.carbon > 0;
					state.debrisActive = p.debris > 0;
					state.h2heActive = p.h2he > 0;

					if (sliderNa) sliderNa.value = p.na;
					if (sliderCarbon) sliderCarbon.value = p.carbon;
					if (sliderDebris) sliderDebris.value = p.debris;
					if (sliderH2he) sliderH2he.value = p.h2he;

					if (badgeNa) badgeNa.textContent = `${p.na}%`;
					if (badgeCarbon) badgeCarbon.textContent = `${p.carbon}%`;
					if (badgeDebris) badgeDebris.textContent = `${p.debris}%`;
					if (badgeH2he) badgeH2he.textContent = `${p.h2he}%`;

					updateToggleBtn("na");
					updateToggleBtn("carbon");
					updateToggleBtn("debris");
					updateToggleBtn("h2he");

					highlightActivePreset(presetKey);
					updateStarPainter();
				}

				function highlightActivePreset(activeKey) {
					presetButtons.forEach((btn) => {
						const key = btn.dataset.preset;
						if (key === activeKey) {
							btn.className = "preset-btn px-2.5 py-2 rounded-lg text-xs font-mono font-bold border transition text-left cursor-pointer active:scale-95 bg-lime-950/80 border-lime-400 text-lime-300 shadow-[0_0_12px_rgba(132,204,22,0.3)]";
						} else {
							btn.className = "preset-btn px-2.5 py-2 rounded-lg text-xs font-mono font-bold border transition text-left cursor-pointer active:scale-95 bg-slate-900 text-slate-300 border-slate-700 hover:border-slate-500";
						}
					});
				}

				presetButtons.forEach((btn) => {
					btn.addEventListener("click", () => {
						applyPreset(btn.dataset.preset);
					}, { signal: lifecycle.signal });
				});

				// Initialize with WD J1330+6435
				applyPreset("wd1330");

				// ==========================================
				// 2. "WHY IS NO STAR GREEN?" BLACKBODY ENGINE
				// ==========================================
				const bbSlider = document.getElementById("bb-temp-slider");
				const bbTempReadout = document.getElementById("bb-temp-readout");
				const bbWienPeak = document.getElementById("bb-wien-peak");
				const bbCurvePath = document.getElementById("bb-curve-path");
				const bbPeakMarker = document.getElementById("bb-peak-marker");
				const bbColorSwatch = document.getElementById("bb-color-swatch");
				const bbColorName = document.getElementById("bb-color-name");
				const bbColorHex = document.getElementById("bb-color-hex");
				const coneL = document.getElementById("cone-l");
				const coneM = document.getElementById("cone-m");
				const coneS = document.getElementById("cone-s");
				const bbChips = document.querySelectorAll(".bb-chip");

				function computeBlackbody(T) {
					const temp = T / 100.0;
					let r = 255;
					let g = 255;
					let b = 255;

					// Red
					if (temp <= 66) {
						r = 255;
					} else {
						r = temp - 60;
						r = 329.698727446 * Math.pow(r, -0.1332047592);
						r = Math.max(0, Math.min(255, r));
					}

					// Green
					if (temp <= 66) {
						g = temp;
						g = 99.4708025861 * Math.log(g) - 161.1195681661;
						g = Math.max(0, Math.min(255, g));
					} else {
						g = temp - 60;
						g = 288.1221695283 * Math.pow(g, -0.0755148492);
						g = Math.max(0, Math.min(255, g));
					}

					// Blue
					if (temp >= 66) {
						b = 255;
					} else if (temp <= 19) {
						b = 0;
					} else {
						b = temp - 10;
						b = 138.5177312231 * Math.log(b) - 305.0447927307;
						b = Math.max(0, Math.min(255, b));
					}

					r = Math.round(r);
					g = Math.round(g);
					b = Math.round(b);

					const hex = `#${((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1).toUpperCase()}`;
					const peakNm = Math.round(2897772 / T);

					// Color naming
					let name = "暖白光 (Warm White)";
					if (T < 3500) name = "深橙红 (Red / Orange)";
					else if (T < 4800) name = "暖橙光 (Warm Orange-Yellow)";
					else if (T <= 6200) name = "耀眼暖白光 (Yellow-White / Sun)";
					else if (T <= 8500) name = "纯白光 (Pure White / Sirius)";
					else name = "炽烈蓝白光 (Blue-White)";

					return { r, g, b, hex, peakNm, name };
				}

				function updateBlackbody(T) {
					const bb = computeBlackbody(T);
					const cDeg = Math.round(T - 273.15);

					if (bbTempReadout) {
						bbTempReadout.textContent = `${T.toLocaleString()} K (~${cDeg.toLocaleString()} °C)`;
					}
					if (bbWienPeak) {
						let band = "红外区 (Infrared)";
						if (bb.peakNm < 380) band = "紫外区 (UV)";
						else if (bb.peakNm < 450) band = "紫光区 (Violet)";
						else if (bb.peakNm < 490) band = "蓝光区 (Blue)";
						else if (bb.peakNm < 560) band = "绿光区 (Green)";
						else if (bb.peakNm < 590) band = "黄光区 (Yellow)";
						else if (bb.peakNm < 620) band = "橙光区 (Orange)";
						else if (bb.peakNm <= 750) band = "红光区 (Red)";

						bbWienPeak.textContent = `λ_max = ${bb.peakNm} nm (${band})`;
					}

					if (bbColorSwatch) {
						bbColorSwatch.style.backgroundColor = bb.hex;
						bbColorSwatch.style.boxShadow = `0 0 20px ${bb.hex}`;
					}
					if (bbColorName) bbColorName.textContent = bb.name;
					if (bbColorHex) bbColorHex.textContent = bb.hex;

					// Retinal Cone responses
					if (coneL) coneL.style.width = `${Math.min(100, Math.round((bb.r / 255) * 100))}%`;
					if (coneM) coneM.style.width = `${Math.min(100, Math.round((bb.g / 255) * 100))}%`;
					if (coneS) coneS.style.width = `${Math.min(100, Math.round((bb.b / 255) * 100))}%`;

					// Update Planck Curve SVG in 500x120 viewBox
					if (bbCurvePath && bbPeakMarker) {
						const points = [];
						let maxVal = 0;
						const vals = [];

						// Visible range 380 to 750 mapped to x: 0 to 500
						for (let i = 0; i <= 50; i++) {
							const lam = 380 + (i / 50) * 370;
							// Planck formula simplified relative
							const xNorm = lam / bb.peakNm;
							// Form: (1/x^5) / (exp(5/x) - 1)
							const v = (1 / Math.pow(xNorm, 5)) / (Math.exp(Math.min(60, 5 / xNorm)) - 1);
							vals.push({ lam, v });
							if (v > maxVal) maxVal = v;
						}

						for (let i = 0; i <= 50; i++) {
							const x = (i / 50) * 500;
							const normV = vals[i].v / (maxVal || 1);
							const y = 110 - normV * 95;
							points.push(`${x.toFixed(1)},${y.toFixed(1)}`);
						}

						bbCurvePath.setAttribute("d", `M ${points.join(" L ")}`);

						// Peak marker placement
						const peakX = ((bb.peakNm - 380) / 370) * 500;
						const clampedX = Math.max(10, Math.min(490, peakX));
						bbPeakMarker.setAttribute("cx", clampedX.toFixed(1));
						bbPeakMarker.setAttribute("cy", (15).toFixed(1));
					}
				}

				if (bbSlider) {
					bbSlider.addEventListener("input", (e) => {
						const val = parseInt(e.target.value, 10);
						updateBlackbody(val);
					}, { signal: lifecycle.signal });
				}

				bbChips.forEach((chip) => {
					chip.addEventListener("click", () => {
						const val = parseInt(chip.dataset.bbSet, 10);
						if (bbSlider) bbSlider.value = val;
						updateBlackbody(val);
					}, { signal: lifecycle.signal });
				});

				// Initialize at Sun's temperature (5,800 K)
				updateBlackbody(5800);

				// ==========================================
				// 3. WHITE DWARF CENSUS (151 + 1 OUTLIER)
				// ==========================================
				const censusDotsGrid = document.getElementById("census-dots-grid");
				const inspectDotPreview = document.getElementById("inspect-dot-preview");
				const inspectName = document.getElementById("inspect-name");
				const inspectCategory = document.getElementById("inspect-category");
				const inspectDist = document.getElementById("inspect-dist");
				const inspectTemp = document.getElementById("inspect-temp");
				const inspectAtmo = document.getElementById("inspect-atmo");
				const inspectDesc = document.getElementById("inspect-desc");

				const specialGreenDot = document.getElementById("special-green-dot");
				const btnInspectGreen = document.getElementById("btn-inspect-green");
				const censusFilters = document.querySelectorAll(".census-filter-btn");

				// Generate 151 white dwarfs dataset
				// 146 white, 2 yellow, 3 pink
				const whiteDwarfs = [];
				for (let i = 1; i <= 151; i++) {
					if (i === 42) {
						whiteDwarfs.push({
							id: "WD J0644+375",
							type: "yellow",
							color: "#facc15",
							nameZh: "金黄碎屑星 (Debris-Polluted)",
							nameEn: "Debris-Polluted Yellow",
							dist: "52 ly (16 pc)",
							temp: "~5,100 °C",
							atmoZh: "DZ 型 · 碎裂小行星重金属污染（铁、钙、镁）",
							atmoEn: "DZ Type · Accreted rocky asteroid debris (Fe, Ca, Mg)",
							descZh: "吸积了被引力撕碎的岩石行星或小行星碎片，重金属吸收蓝紫光，使其呈现温润的金黄色泽。",
							descEn: "Accreted heavy elements from disrupted rocky planetary bodies extinguish blue/UV light into yellow.",
						});
					} else if (i === 88) {
						whiteDwarfs.push({
							id: "WD J1953-011",
							type: "yellow",
							color: "#eab308",
							nameZh: "金黄碎屑星 (DZ Type)",
							nameEn: "Debris Yellow DZ",
							dist: "61 ly (18.7 pc)",
							temp: "~4,800 °C",
							atmoZh: "DAZ 型 · 氢主导叠加剧烈岩石碎屑污染",
							atmoEn: "DAZ Type · Hydrogen with rocky planetary pollution",
							descZh: "表面被剧烈的岩质小行星尘埃覆盖，是 65 光年内仅存的两颗金黄色白矮星之一。",
							descEn: "One of only two yellow white dwarfs within 65 light-years, polluted by asteroid fallout.",
						});
					} else if (i === 17) {
						whiteDwarfs.push({
							id: "WD J1011+2845",
							type: "pink",
							color: "#ff7b72",
							nameZh: "深肉粉色星 (Salmon Pink)",
							nameEn: "Salmon Pink Star",
							dist: "48 ly (14.7 pc)",
							temp: "~3,800 °C",
							atmoZh: "DQ 型 · 深层对流翻卷碳元素 (C₂ Swan)",
							atmoEn: "DQ Type · Convectively dredged carbon (C₂ Swan)",
							descZh: "深层对流把内核心的碳元素翻卷至表面，碳分子斯旺带彻底扼制 600nm 以下波长，呈现极为罕见的深肉粉色。",
							descEn: "Deep convective dredging brought carbon to the surface, where C₂ bands extinguish light < 600nm into salmon-pink.",
						});
					} else if (i === 73) {
						whiteDwarfs.push({
							id: "WD J1403-082",
							type: "pink",
							color: "#f43f5e",
							nameZh: "碳分子粉红星 (DQ Type)",
							nameEn: "Carbon Pink Star",
							dist: "59 ly (18.1 pc)",
							temp: "~4,100 °C",
							atmoZh: "DQ 型 · 碳斯旺分子吸收带",
							atmoEn: "DQ Type · Molecular Carbon Swan Bands",
							descZh: "65 光年样本圈内的第 2 颗碳吸收粉红星，光谱在绿黄端被大幅削弱。",
							descEn: "Second carbon-dredged pink star in the local 65 ly sample, heavily suppressed in green/yellow.",
						});
					} else if (i === 120) {
						whiteDwarfs.push({
							id: "WD J2140+189",
							type: "pink",
							color: "#fb7185",
							nameZh: "冷碳粉红星 (DQ Cold)",
							nameEn: "Cool Carbon Pink",
							dist: "64 ly (19.6 pc)",
							temp: "~3,600 °C",
							atmoZh: "DQ 混合型 · 冷却深粉色调",
							atmoEn: "DQ Mixed · Cool deep pink tone",
							descZh: "位于 65 光年普查边界附近的第 3 颗粉红白矮星，表面碳分子丰度极高。",
							descEn: "Third pink star lying near the 65 ly boundary with prominent molecular carbon signatures.",
						});
					} else {
						// Normal white stars (146 of them)
						const distLy = (8 + (i * 0.38)).toFixed(1);
						const tempC = Math.round(4000 + ((i * 137) % 8000));
						whiteDwarfs.push({
							id: `WD J${String(i).padStart(4, "0")}+${String((i * 17) % 90).padStart(2, "0")}`,
							type: "white",
							color: "#e2e8f0",
							nameZh: "常规白色白矮星 (Normal White)",
							nameEn: "Ordinary White Star",
							dist: `${distLy} ly (${(distLy / 3.26).toFixed(1)} pc)`,
							temp: `~${tempC.toLocaleString()} °C`,
							atmoZh: i % 2 === 0 ? "DA 型 · 纯净氢大气" : "DB 型 · 纯净氦大气",
							atmoEn: i % 2 === 0 ? "DA Type · Pure Hydrogen" : "DB Type · Pure Helium",
							descZh: "65 光年内典型的白矮星，表面纯净，黑体热辐射在人眼中混合为平凡的白色光芒。",
							descEn: "A typical white dwarf within 65 light-years. Broad continuum mixes into ordinary white.",
						});
					}
				}

				// The Green Outlier Data
				const greenStarData = {
					id: "WD J1330+6435",
					type: "green",
					color: "#8fee40",
					nameZh: "幽绿星 (Chartreuse Green)",
					nameEn: "Verdant Star (Chartreuse)",
					dist: "~280 ly (86 pc)",
					temp: "~4,000 °C",
					atmoZh: "超致密富氦 + 钠碰撞致宽 (超高压碰撞)",
					atmoEn: "Ultra-dense Helium + Collisional Na Broadening",
					descZh: "人类已知唯一确认呈现绿色的恒星！高密富氦大气中钠原子受到疯狂碰撞扰动，将原本狭窄的橙线展宽为横跨黄橙红的深巨吸收带，唯独透出幽绿之光。",
					descEn: "Humanity's first confirmed green star! In ultra-dense helium, sodium collisional broadening carves out yellow-orange-red to unveil a chartreuse green glow.",
				};

				function inspectStar(star) {
					if (!inspectDotPreview) return;
					inspectDotPreview.style.backgroundColor = star.color;
					inspectDotPreview.style.boxShadow = `0 0 15px ${star.color}`;
					if (inspectName) inspectName.textContent = star.id;
					if (inspectCategory) {
						inspectCategory.textContent = star.nameZh;
						inspectCategory.style.color = star.color;
					}
					if (inspectDist) inspectDist.textContent = star.dist;
					if (inspectTemp) inspectTemp.textContent = star.temp;
					if (inspectAtmo) inspectAtmo.textContent = star.atmoZh;
					if (inspectDesc) inspectDesc.textContent = star.descZh;
				}

				// Render 151 dots in grid
				function renderCensusGrid(filter = "all") {
					if (!censusDotsGrid) return;
					censusDotsGrid.innerHTML = "";

					whiteDwarfs.forEach((star) => {
						const dot = document.createElement("button");
						dot.type = "button";
						dot.className = "w-3 h-3 rounded-full transition-all duration-200 cursor-pointer active:scale-75 hover:scale-125 focus:outline-none";
						dot.style.backgroundColor = star.color;

						// Apply filter opacity
						if (filter !== "all" && star.type !== filter) {
							dot.style.opacity = "0.15";
						} else {
							dot.style.opacity = "0.9";
							if (star.type === "yellow" || star.type === "pink") {
								dot.style.boxShadow = `0 0 6px ${star.color}`;
							}
						}

						dot.setAttribute("title", `${star.id} (${star.nameZh})`);
						dot.addEventListener("mouseenter", () => inspectStar(star), { signal: lifecycle.signal });
						dot.addEventListener("click", () => inspectStar(star), { signal: lifecycle.signal });

						censusDotsGrid.appendChild(dot);
					});
				}

				censusFilters.forEach((btn) => {
					btn.addEventListener("click", () => {
						const filter = btn.dataset.filter;
						censusFilters.forEach((b) => {
							b.className = "census-filter-btn px-2 py-0.5 rounded bg-slate-950 text-slate-400 hover:text-white cursor-pointer";
						});
						btn.className = "census-filter-btn px-2 py-0.5 rounded bg-slate-800 text-white font-bold cursor-pointer";

						if (filter === "green") {
							renderCensusGrid("none");
							inspectStar(greenStarData);
						} else {
							renderCensusGrid(filter);
						}
					}, { signal: lifecycle.signal });
				});

				if (specialGreenDot) {
					specialGreenDot.addEventListener("click", () => inspectStar(greenStarData), { signal: lifecycle.signal });
				}
				if (btnInspectGreen) {
					btnInspectGreen.addEventListener("click", () => inspectStar(greenStarData), { signal: lifecycle.signal });
				}

				// Initial render of census
				renderCensusGrid("all");
				inspectStar(greenStarData);
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initVerdantStar);
			} else {
				initVerdantStar();
			}
			document.addEventListener("astro:page-load", initVerdantStar);
		})();
	</script>
</MainGridLayout>
