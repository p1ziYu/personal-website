				{
					id: "egg",
					name: "鸡蛋",
					subtitle: "完美水煮蛋",
					mass: 0.06,
					c: 3.2,
					targetTemp: 70,
					svg: `
						<svg viewBox="0 0 200 200" class="w-full h-full">
							<defs>
								<radialGradient id="egg-grad" cx="40%" cy="35%" r="60%">
