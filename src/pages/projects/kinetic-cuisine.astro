			];

			// Constants
			const HAND_MASS = 0.4; // kg
			const STORAGE_KEY = "kc_slaps_v1";

			// State
			let currentFoodIndex = 0; // whole-chicken by default
			let startTemp = 4; // fridge by default
			let slapSpeed = 7.9; // m/s default (calibrated so whole-chicken = ~23,034)
			let slapRate = 2; // slaps / sec

			// Load counts from localStorage
			let foodSlapCounts = {};
			try {
				const stored = localStorage.getItem(STORAGE_KEY);
				if (stored) foodSlapCounts = JSON.parse(stored);
			} catch (e) {
				foodSlapCounts = {};
			}

			// DOM Elements
			const foodPresetsContainer = document.getElementById("food-presets");
			const tempFridgeBtn = document.getElementById("temp-fridge");
			const tempRoomBtn = document.getElementById("temp-room");
			const startTempBadge = document.getElementById("start-temp-badge");
			const slapSpeedInput = document.getElementById("slap-speed");
			const slapSpeedVal = document.getElementById("slap-speed-val");
			const slapSpeedKmh = document.getElementById("slap-speed-kmh");
			const slapRateInput = document.getElementById("slap-rate");
			const slapRateVal = document.getElementById("slap-rate-val");

			// Result Elements
			const resSlapCount = document.getElementById("res-slap-count");
			const resMemeNote = document.getElementById("res-meme-note");
			const resTotalEnergy = document.getElementById("res-total-energy");
			const resEnergySub = document.getElementById("res-energy-sub");
			const resTotalTime = document.getElementById("res-total-time");
			const resTimeSub = document.getElementById("res-time-sub");
			const resDeltaTemp = document.getElementById("res-delta-temp");
			const resTempSub = document.getElementById("res-temp-sub");

			// One-slap Elements
			const oneSlapMs = document.getElementById("one-slap-ms");
			const oneSlapKmh = document.getElementById("one-slap-kmh");
			const oneSlapMph = document.getElementById("one-slap-mph");

			// Simulator Elements
			const foodStage = document.getElementById("food-stage");
			const foodSvgWrap = document.getElementById("food-svg-wrap");
			const slapFx = document.getElementById("slap-fx");
			const slapFloats = document.getElementById("slap-floats");
			const steamContainer = document.getElementById("steam-container");
			const simCurrentTemp = document.getElementById("sim-current-temp");
			const simTargetTemp = document.getElementById("sim-target-temp");
			const simProgressPct = document.getElementById("sim-progress-pct");
			const tempProgressBar = document.getElementById("temp-progress-bar");
			const simSlapCount = document.getElementById("sim-slap-count");
			const simEnergyAdded = document.getElementById("sim-energy-added");
			const cookStatusText = document.getElementById("cook-status-text");
			const statusIcon = document.getElementById("status-icon");

			const btnSlap = document.getElementById("btn-slap");
			const btnSlap10 = document.getElementById("btn-slap-10");
			const btnSlap100 = document.getElementById("btn-slap-100");
			const btnResetFood = document.getElementById("btn-reset-food");

			// Milestone Toast Elements
			const toastEl = document.getElementById("milestone-toast");
			const toastIcon = document.getElementById("toast-icon");
			const toastText = document.getElementById("toast-text");
			let toastTimer = null;

			function saveCounts() {
				try {
					localStorage.setItem(STORAGE_KEY, JSON.stringify(foodSlapCounts));
				} catch (e) {}
			}

			function getAccumulatedSlaps(foodId) {
				return foodSlapCounts[foodId] || 0;
			}

			function setAccumulatedSlaps(foodId, count) {
				foodSlapCounts[foodId] = Math.max(0, count);
				saveCounts();
			}

			function showToast(icon, message) {
				if (toastTimer) clearTimeout(toastTimer);
				toastIcon.textContent = icon;
				toastText.textContent = message;
				toastEl.classList.remove("-translate-y-12", "opacity-0", "pointer-events-none");
				toastEl.classList.add("translate-y-0", "opacity-100");

				toastTimer = setTimeout(() => {
					toastEl.classList.add("-translate-y-12", "opacity-0", "pointer-events-none");
					toastEl.classList.remove("translate-y-0", "opacity-100");
				}, 3500);
			}

			function formatTime(seconds) {
				if (seconds < 60) return `${Math.round(seconds)} 秒`;
				if (seconds < 3600) {
					const m = Math.floor(seconds / 60);
					const s = Math.round(seconds % 60);
					return `${m} 分 ${s} 秒`;
				}
				const h = Math.floor(seconds / 3600);
				const m = Math.round((seconds % 3600) / 60);
				return `${h} 小时 ${m} 分`;
			}

			function renderPresets() {
				foodPresetsContainer.innerHTML = "";
				FOOD_PRESETS.forEach((food, idx) => {
					const btn = document.createElement("button");
					btn.type = "button";
					const isActive = idx === currentFoodIndex;
					btn.className = `p-3 rounded-xl border text-left transition active:scale-95 flex flex-col justify-between ${
						isActive
							? "bg-[var(--primary)] text-white border-transparent shadow-sm"
							: "border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 opacity-80"
					}`;
					btn.innerHTML = `
						<div class="font-bold text-sm leading-snug">${food.name}</div>
						<div class="text-[11px] opacity-75 mt-1 font-mono">${food.mass} kg · ${food.targetTemp}°C</div>
					`;
					btn.addEventListener("click", () => {
						currentFoodIndex = idx;
						renderPresets();
						updateCalculations();
					});
					foodPresetsContainer.appendChild(btn);
				});
			}

			function updateCalculations() {
				const food = FOOD_PRESETS[currentFoodIndex];
				const deltaT = Math.max(1, food.targetTemp - startTemp);
				// Q = m * c * ΔT (Joules)
				const eNeededJoules = food.mass * (food.c * 1000) * deltaT;
				const eNeededKj = eNeededJoules / 1000;

				// E_per_slap = 0.5 * m_hand * v^2
				const ePerSlapJoules = 0.5 * HAND_MASS * Math.pow(slapSpeed, 2);

				// Required Slaps
				const requiredSlaps = Math.ceil(eNeededJoules / ePerSlapJoules);

				// Live Results Update
				resSlapCount.textContent = requiredSlaps.toLocaleString();
				if (food.id === "whole-chicken" && startTemp === 4) {
					resMemeNote.textContent = `≈ 23,034 掌（与迷因仅差 ${Math.abs(requiredSlaps - 23034)} 掌）`;
				} else {
					resMemeNote.textContent = `按当前速度 (${slapSpeed.toFixed(1)} m/s) 计算`;
				}

				resTotalEnergy.textContent = `${eNeededKj.toFixed(1)} kJ`;
				resEnergySub.textContent = `单掌动能: ${ePerSlapJoules.toFixed(2)} J (手重 ${HAND_MASS}kg)`;

				const totalSeconds = requiredSlaps / slapRate;
				resTotalTime.textContent = formatTime(totalSeconds);
				resTimeSub.textContent = `按 ${slapRate} 掌/秒连续拍击`;

				resDeltaTemp.textContent = `${deltaT.toFixed(1)} °C`;
				resTempSub.textContent = `${startTemp}°C 升至 ${food.targetTemp}°C 熟透`;

				// One-Slap Calculation: v = sqrt(2 * E_needed / m_hand)
				const oneSlapSpeedMs = Math.sqrt((2 * eNeededJoules) / HAND_MASS);
				const oneSlapSpeedKmh = oneSlapSpeedMs * 3.6;
				const oneSlapSpeedMph = oneSlapSpeedMs * 2.236936;

				oneSlapMs.textContent = Math.round(oneSlapSpeedMs).toLocaleString();
				oneSlapKmh.textContent = Math.round(oneSlapSpeedKmh).toLocaleString();
				oneSlapMph.textContent = Math.round(oneSlapSpeedMph).toLocaleString();

				// Simulator Stage Update
				foodSvgWrap.innerHTML = food.svg;
				simTargetTemp.textContent = food.targetTemp.toFixed(1);

				updateSimulatorProgress(food, requiredSlaps, ePerSlapJoules);
			}

			function updateSimulatorProgress(food, requiredSlaps, ePerSlapJoules) {
				const currentCount = getAccumulatedSlaps(food.id);
				simSlapCount.textContent = currentCount.toLocaleString();

				const accumulatedEnergyJoules = currentCount * ePerSlapJoules;
				simEnergyAdded.textContent = accumulatedEnergyJoules < 1000
					? `${accumulatedEnergyJoules.toFixed(1)}`
					: `${(accumulatedEnergyJoules / 1000).toFixed(2)} k`;

				const tempRise = accumulatedEnergyJoules / (food.mass * (food.c * 1000));
				const currentTemp = Math.min(food.targetTemp, startTemp + tempRise);
				simCurrentTemp.textContent = currentTemp.toFixed(1);

				const pct = Math.min(100, (currentCount / requiredSlaps) * 100);
				simProgressPct.textContent = `${pct.toFixed(2)}%`;
				tempProgressBar.style.width = `${Math.min(100, Math.max(2, pct))}%`;

				// Status badges and color shift
				if (pct >= 100) {
					cookStatusText.textContent = "外焦里嫩 · 大功告成！";
					statusIcon.textContent = "🍗";
					steamContainer.style.opacity = "1";
					foodSvgWrap.style.filter = "sepia(40%) saturate(140%) brightness(95%)";
				} else if (pct >= 50) {
					cookStatusText.textContent = "滋滋冒气 · 半熟状态";
					statusIcon.textContent = "🔥";
					steamContainer.style.opacity = "0.85";
					foodSvgWrap.style.filter = "sepia(25%) saturate(120%)";
				} else if (pct >= 15) {
					cookStatusText.textContent = "温热回暖 · 渐入佳境";
					statusIcon.textContent = "♨️";
					steamContainer.style.opacity = "0.4";
					foodSvgWrap.style.filter = "sepia(10%)";
				} else {
					cookStatusText.textContent = startTemp === 4 ? "冰凉生鲜" : "常温待烤";
					statusIcon.textContent = startTemp === 4 ? "❄️" : "🌡️";
					steamContainer.style.opacity = "0";
					foodSvgWrap.style.filter = "none";
				}
			}

			function triggerSlap(count = 1) {
				const food = FOOD_PRESETS[currentFoodIndex];
				const deltaT = Math.max(1, food.targetTemp - startTemp);
				const eNeededJoules = food.mass * (food.c * 1000) * deltaT;
				const ePerSlapJoules = 0.5 * HAND_MASS * Math.pow(slapSpeed, 2);
				const requiredSlaps = Math.ceil(eNeededJoules / ePerSlapJoules);

				const oldCount = getAccumulatedSlaps(food.id);
				const newCount = oldCount + count;
				setAccumulatedSlaps(food.id, newCount);

				// Visual squash on food
				foodStage.classList.remove("slap-squash");
				void foodStage.offsetWidth; // trigger reflow
				foodStage.classList.add("slap-squash");

				// Flash streak FX
				slapFx.style.opacity = "1";
				slapFx.style.transform = `scale(${1 + Math.random() * 0.2 - 0.1}) rotate(${(Math.random() - 0.5) * 15}deg)`;
				setTimeout(() => {
					slapFx.style.opacity = "0";
				}, 120);

				// Floating slap indicator text
				const floatEl = document.createElement("div");
				floatEl.className = "float-text text-amber-500 dark:text-amber-400";
				floatEl.textContent = count > 1 ? `+${count} 连击!` : `+1 啪!`;
				floatEl.style.left = `${50 + (Math.random() - 0.5) * 30}%`;
				slapFloats.appendChild(floatEl);
				setTimeout(() => floatEl.remove(), 650);

				// Check Funny Milestone Toasts
				checkMilestones(oldCount, newCount, requiredSlaps);

				// Update Simulator UI
				updateSimulatorProgress(food, requiredSlaps, ePerSlapJoules);
			}

			function checkMilestones(before, after, required) {
				if (before < 10 && after >= 10) {
					showToast("👋", "热身完毕！手掌开始微微发烫…");
				} else if (before < 100 && after >= 100) {
					showToast("🔥", "手酸了吗？温度刚升了一丁点，麒麟臂正在充能！");
				} else if (before < 1000 && after >= 1000) {
					showToast("💪", "千掌达成！掌风呼啸，肉质感受到了热烈的诚意！");
				} else if (before < 10000 && after >= 10000) {
					showToast("⚡", "万掌归宗！手掌可能快熟了，食材正在冲向全熟终点！");
				} else if (before < required && after >= required) {
					showToast("🎉", "叮！不可思议！你真的亲手拍熟了它！物理学的奇迹！");
				}
			}

			// Event Listeners
			tempFridgeBtn.addEventListener("click", () => {
				startTemp = 4;
				tempFridgeBtn.className = "py-1.5 text-xs font-medium rounded-lg transition active:scale-95 bg-[var(--primary)] text-white shadow-xs";
				tempRoomBtn.className = "py-1.5 text-xs font-medium rounded-lg transition active:scale-95 text-inherit opacity-70 hover:opacity-100";
				startTempBadge.textContent = "4°C (冷藏)";
				updateCalculations();
			});

			tempRoomBtn.addEventListener("click", () => {
				startTemp = 20;
				tempRoomBtn.className = "py-1.5 text-xs font-medium rounded-lg transition active:scale-95 bg-[var(--primary)] text-white shadow-xs";
				tempFridgeBtn.className = "py-1.5 text-xs font-medium rounded-lg transition active:scale-95 text-inherit opacity-70 hover:opacity-100";
				startTempBadge.textContent = "20°C (常温)";
				updateCalculations();
			});

			slapSpeedInput.addEventListener("input", (e) => {
				slapSpeed = parseFloat(e.target.value);
				slapSpeedVal.textContent = `${slapSpeed.toFixed(1)} m/s`;
				slapSpeedKmh.textContent = `${(slapSpeed * 3.6).toFixed(1)} km/h`;
				updateCalculations();
			});

			slapRateInput.addEventListener("input", (e) => {
				slapRate = parseInt(e.target.value, 10);
				slapRateVal.textContent = `${slapRate} 掌/秒`;
				updateCalculations();
			});

			btnSlap.addEventListener("click", () => triggerSlap(1));
			btnSlap10.addEventListener("click", () => triggerSlap(10));
			btnSlap100.addEventListener("click", () => triggerSlap(100));

			foodStage.addEventListener("click", () => triggerSlap(1));

			btnResetFood.addEventListener("click", () => {
				const food = FOOD_PRESETS[currentFoodIndex];
				setAccumulatedSlaps(food.id, 0);
				updateCalculations();
				showToast("↺", `已重置【${food.name}】的拍击计数`);
			});

			// Spacebar to slap
			window.addEventListener("keydown", (e) => {
				if (e.code === "Space" && e.target === document.body) {
					e.preventDefault();
					triggerSlap(1);
				}
			});

			// Init
			renderPresets();
			updateCalculations();
		})();
	</script>
</MainGridLayout>
