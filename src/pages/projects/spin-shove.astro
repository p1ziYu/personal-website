					const cx = parseFloat(el.getAttribute("data-cx") || "70");
					const cy = parseFloat(el.getAttribute("data-cy") || "70");
					const defaultAngle = parseFloat(el.getAttribute("data-angle") || "0");
					spinElements.push({ el, cx, cy, defaultAngle });
				});

				function updateSpinVisuals() {
					// Update polarization text and fill bar
					if (polarizationBadge) {
						if (polarization > 0) {
							polarizationBadge.textContent = `POLARIZATION: +${polarization}%`;
							polarizationBadge.className = "px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-emerald-950/80 text-emerald-300 border border-emerald-500/50";
						} else if (polarization < 0) {
							polarizationBadge.textContent = `POLARIZATION: ${polarization}%`;
							polarizationBadge.className = "px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-amber-950/80 text-amber-300 border border-amber-500/50";
						} else {
							polarizationBadge.textContent = "POLARIZATION: 0%";
							polarizationBadge.className = "px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-800 text-slate-400 border border-slate-700";
						}
					}

					if (polarizationFillBar) {
						if (polarization === 0) {
							polarizationFillBar.style.width = "0%";
							polarizationFillBar.style.marginLeft = "50%";
							polarizationFillBar.style.backgroundColor = "#64748b";
						} else if (polarization > 0) {
							polarizationFillBar.style.width = `${polarization / 2}%`;
							polarizationFillBar.style.marginLeft = "50%";
							polarizationFillBar.style.backgroundColor = "#22ff88";
						} else {
							polarizationFillBar.style.width = `${Math.abs(polarization) / 2}%`;
							polarizationFillBar.style.marginLeft = `${50 - Math.abs(polarization) / 2}%`;
							polarizationFillBar.style.backgroundColor = "#f59e0b";
						}
					}

					if (spinStateText) {
						if (polarization === 100) {
							spinStateText.innerHTML = '<span class="text-emerald-400 font-bold">态：|↑⟩ 纯态极化 (+100%)</span>';
						} else if (polarization === -100) {
							spinStateText.innerHTML = '<span class="text-amber-400 font-bold">态：|↓⟩ 翻转极化 (−100%)</span>';
						} else {
							spinStateText.innerHTML = '<span class="text-slate-400">态：热退相干（随机自旋）</span>';
						}
					}

					// Update arrow orientations
					spinElements.forEach((item) => {
						const shaft = item.el.querySelector("line");
						const head = item.el.querySelector("polygon");
						if (polarization === 100) {
							item.el.setAttribute("transform", `translate(${item.cx}, ${item.cy}) rotate(0)`);
							if (shaft) shaft.setAttribute("stroke", "#22ff88");
							if (head) head.setAttribute("fill", "#22ff88");
						} else if (polarization === -100) {
							item.el.setAttribute("transform", `translate(${item.cx}, ${item.cy}) rotate(180)`);
							if (shaft) shaft.setAttribute("stroke", "#f59e0b");
							if (head) head.setAttribute("fill", "#f59e0b");
						} else {
							item.el.setAttribute("transform", `translate(${item.cx}, ${item.cy}) rotate(${item.defaultAngle})`);
							if (shaft) shaft.setAttribute("stroke", "#94a3b8");
							if (head) head.setAttribute("fill", "#94a3b8");
						}
					});

					// Update bench status label
					if (benchStateLabel) {
						if (polarization === 100) {
							benchStateLabel.textContent = "STATE: OPTICALLY POLARIZED (+100%)";
							benchStateLabel.className = "text-emerald-400 font-bold";
						} else if (polarization === -100) {
							benchStateLabel.textContent = "STATE: MICROWAVE FLIPPED (-100%)";
							benchStateLabel.className = "text-amber-400 font-bold";
						} else {
							benchStateLabel.textContent = "STATE: IDLE (DECOHERED)";
							benchStateLabel.className = "text-cyan-400 font-bold";
						}
					}
				}

