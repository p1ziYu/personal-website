				// 2. SPIN BUTTON HANDLERS
				// ----------------------------------------------------
				if (btnLaserInit) {
					btnLaserInit.addEventListener("click", () => {
						if (isPushing) return;
						// Flash laser beam
						if (benchLaserBeam) benchLaserBeam.style.opacity = "1";
						if (laserLensDot) laserLensDot.setAttribute("fill", "#22ff88");

						setTimeout(() => {
							polarization = 100;
							updateSpinVisuals();
							if (benchLaserBeam) benchLaserBeam.style.opacity = "0";
						}, 300);
					});
				}

				if (btnMicrowaveFlip) {
					btnMicrowaveFlip.addEventListener("click", () => {
						if (isPushing) return;
						if (polarization === 0) {
							showPushHint("⚠️ 自旋当前处于退相干无序态，请先点击 532nm 激光进行极化，再施加微波脉冲！", "⚠️ Spins are decohered. Please initialize with the 532nm laser first!");
							return;
						}
						// Flash microwave pulse ring
						if (mwPulseRing) mwPulseRing.style.opacity = "1";
						setTimeout(() => {
							polarization = polarization === 100 ? -100 : 100;
							updateSpinVisuals();
							if (mwPulseRing) mwPulseRing.style.opacity = "0";
						}, 350);
					});
				}

				if (btnDecohere) {
					btnDecohere.addEventListener("click", () => {
						if (isPushing) return;
						polarization = 0;
						updateSpinVisuals();
					});
				}

				// ----------------------------------------------------
				// 3. PUSH MAGNET DISTANCE TRACKING & DRAGGING
				// ----------------------------------------------------
				function setMagnetDistance(dist) {
					magnetDistance = Math.max(1.0, Math.min(10.0, dist));
					if (sliderDistVal) sliderDistVal.textContent = `${magnetDistance.toFixed(1)} mm`;
					if (benchMagnetDistLabel) benchMagnetDistLabel.textContent = `MAGNET DISTANCE: ${magnetDistance.toFixed(1)} mm`;
					if (magnetDistSlider) magnetDistSlider.value = String(magnetDistance);

					// Update status badge
					if (sliderDistStatus) {
						if (magnetDistance <= 3.0) {
							sliderDistStatus.className = "px-2 py-0.5 rounded text-[11px] bg-emerald-500/10 border border-emerald-500/30 text-emerald-400";
							sliderDistStatus.innerHTML = '<span class="lang-zh">极近有效（梯度力充足）</span><span class="lang-en">Effective Range (Strong Gradient)</span>';
						} else {
							sliderDistStatus.className = "px-2 py-0.5 rounded text-[11px] bg-amber-500/10 border border-amber-500/30 text-amber-400";
							sliderDistStatus.innerHTML = '<span class="lang-zh">过远（拖近以产生推力）</span><span class="lang-en">Too far (drag closer)</span>';
						}
					}

					// Update SVG push magnet group horizontal position
					// 10mm -> x = 680, 1mm -> x = 460
					if (benchPushMagnetGroup) {
						const posX = 430 + (magnetDistance / 10.0) * 230;
						benchPushMagnetGroup.setAttribute("transform", `translate(${posX}, 195)`);
					}
				}

				if (magnetDistSlider) {
					magnetDistSlider.addEventListener("input", (e) => {
						setMagnetDistance(parseFloat(e.target.value));
					});
				}

				// Optional SVG drag interaction on the push magnet
				if (benchPushMagnetGroup && labBenchSvg) {
					let isDragging = false;
					let startX = 0;
					let initialDist = 6.0;

					const startDrag = (clientX) => {
						isDragging = true;
						startX = clientX;
						initialDist = magnetDistance;
						benchPushMagnetGroup.style.cursor = "grabbing";
					};

					const moveDrag = (clientX) => {
						if (!isDragging) return;
						const deltaX = clientX - startX;
						// Scale pixels to mm
						const newDist = initialDist + deltaX * 0.03;
						setMagnetDistance(newDist);
					};

					const endDrag = () => {
						isDragging = false;
						benchPushMagnetGroup.style.cursor = "grab";
					};

					benchPushMagnetGroup.addEventListener("mousedown", (e) => startDrag(e.clientX));
					window.addEventListener("mousemove", (e) => moveDrag(e.clientX), { signal: lifecycle.signal });
					window.addEventListener("mouseup", endDrag, { signal: lifecycle.signal });

					benchPushMagnetGroup.addEventListener("touchstart", (e) => {
						if (e.touches.length > 0) startDrag(e.touches[0].clientX);
					}, { passive: true });
					window.addEventListener("touchmove", (e) => {
						if (e.touches.length > 0) moveDrag(e.touches[0].clientX);
					}, { passive: true, signal: lifecycle.signal });
					window.addEventListener("touchend", endDrag, { signal: lifecycle.signal });
				}

				// Initialize magnet position
				setMagnetDistance(6.0);
				updateSpinVisuals();

				// ----------------------------------------------------
				// 4. PUSH SEQUENCE ENGINE & CHOREOGRAPHY
				// ----------------------------------------------------
				function showPushHint(msgZh, msgEn) {
					if (!pushHintBox) return;
					pushHintBox.innerHTML = `<div><span class="lang-zh">${msgZh}</span><span class="lang-en">${msgEn}</span></div>`;
					pushHintBox.classList.remove("hidden");
					pushHintBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
					setTimeout(() => {
						pushHintBox.classList.add("hidden");
					}, 4500);
				}

				if (btnRunPush) {
					btnRunPush.addEventListener("click", () => {
						if (isPushing) return;

						// Interaction rule:
						// Must have polarization != 0 AND magnetDistance <= 3.5 mm
						if (polarization === 0) {
							showPushHint(
								"⚠️ 自旋未极化——外磁场无可作用的磁矩（请先点击“532 nm 激光”完成极化）！",
								"⚠️ Spins not polarized — the magnet has nothing to grab (click 532 nm laser to initialize first)!"
							);
							return;
						}

						if (magnetDistance > 3.5) {
							showPushHint(
								"⚠️ 推力磁铁距离过远——请将右侧推力磁铁滑块拉至靠近金刚石（≤ 3.0 mm）！",
								"⚠️ Push magnet too far away — drag the magnet slider closer (≤ 3.0 mm)!"
							);
							return;
						}

						// Preconditions met: run the push choreography
						isPushing = true;
						btnRunPush.disabled = true;
						btnRunPush.classList.add("opacity-50", "cursor-not-allowed");

						// 1. Fire laser beam pulse
						if (benchLaserBeam) benchLaserBeam.style.opacity = "1";
						if (laserLensDot) laserLensDot.setAttribute("fill", "#22ff88");

						setTimeout(() => {
							if (benchLaserBeam) benchLaserBeam.style.opacity = "0";

							// 2. Flash motion arrow & push assembly
							if (motionIndicatorArrow) motionIndicatorArrow.style.opacity = "1";

							// Honest shift on bench view: just 6 visible pixels (barely moves!)
							const benchShift = polarization > 0 ? -6 : 6;
							if (benchLevitatingAssembly) {
								benchLevitatingAssembly.style.transform = `translateX(${benchShift}px)`;
							}

							// 3. Animate Microscope counter from 0 to 100 nm (or -100 nm)
							const targetDisplacement = 100.0;
							const startTime = performance.now();
							const duration = 1200; // ms

							function animateDisplacement(now) {
								const elapsed = now - startTime;
								const progress = Math.min(1, elapsed / duration);
								// Ease out cubic
								const easeProgress = 1 - Math.pow(1 - progress, 3);
								currentDisplacement = (easeProgress * targetDisplacement);

								if (microscopeDigits) {
									microscopeDigits.textContent = `${currentDisplacement.toFixed(1)} nm`;
								}

								if (microscopeNeedle) {
									microscopeNeedle.style.left = `${(easeProgress * 100).toFixed(1)}%`;
								}

								if (progress < 1) {
									requestAnimationFrame(animateDisplacement);
								} else {
									// Completion
									isPushing = false;
									btnRunPush.disabled = false;
									btnRunPush.classList.remove("opacity-50", "cursor-not-allowed");

									if (microscopeHairRatio) {
										microscopeHairRatio.innerHTML = `
											<span class="text-emerald-400 font-bold">
												<span class="lang-zh">🎉 100 nm 达成——约一根头发直径的千分之一！</span>
												<span class="lang-en">🎉 100 nm reached — one thousandth of a hair!</span>
											</span>
										`;
									}
								}
							}

							requestAnimationFrame(animateDisplacement);
						}, 300);
					});
				}

				if (btnResetBench) {
					btnResetBench.addEventListener("click", () => {
						if (isPushing) return;
						if (benchLevitatingAssembly) {
							benchLevitatingAssembly.style.transform = "translateX(0px)";
						}
						if (motionIndicatorArrow) motionIndicatorArrow.style.opacity = "0";
						currentDisplacement = 0;
						if (microscopeDigits) microscopeDigits.textContent = "0.0 nm";
						if (microscopeNeedle) microscopeNeedle.style.left = "0%";
						if (microscopeHairRatio) {
							microscopeHairRatio.innerHTML = `
								<span class="lang-zh">等待启动量子推力实验...</span>
								<span class="lang-en">Awaiting quantum shove trigger...</span>
							`;
						}
					});
				}

				// ----------------------------------------------------
				// 5. SCALE LEAP LOG-SLIDER INTERACTIVE
				// ----------------------------------------------------
				const scaleData = [
					{
						maxLog: -20,
						regimeZh: "亚原子与原子微观界",
						regimeEn: "Subatomic & Atomic Regime",
						descZh: "量子力学原生领地，单个粒子自旋无经典对应物理实体。",
						descEn: "Native realm of quantum mechanics; single particle spins have no classical equivalent.",
					},
					{
						maxLog: -10,
						regimeZh: "介观与纳克微结构（以往纪录极限）",
						regimeEn: "Mesoscopic & Nanogram Cantilevers",
						descZh: "以往光镊与微悬臂自旋力学的极限范围（约 10⁻¹³ kg）。",
						descEn: "Previous state-of-the-art cantilever and optical trap spin mechanics (≈ 10⁻¹³ kg).",
					},
					{
						maxLog: -3.5,
						regimeZh: "宏观经典物体 · OIST 自旋力学组件",
						regimeEn: "Macroscopic Classical Object · OIST Assembly",
						descZh: "128 毫克（1.28×10⁻⁴ kg），重约数粒大米，人类肉眼清晰可见的宏观经典世界！",
						descEn: "128 milligrams (1.28×10⁻⁴ kg), several grains of rice — fully macroscopic and eye-visible!",
					},
					{
						maxLog: 0,
						regimeZh: "日常宏观日用品尺度",
						regimeEn: "Household Macroscopic Objects",
						descZh: "一枚回形针（约 1 克），经典力学与重力完全主导的日常生活世界。",
						descEn: "A metal paperclip (≈ 1 gram); gravity and classical mechanics dominate.",
					},
				];

				function updateScaleLeap(logVal) {
					// 10^logVal kg
					const massKg = Math.pow(10, logVal);
					
					let formattedValue = "";
					let commonUnit = "";

					if (logVal < -24) {
						formattedValue = `${(massKg * 1e27).toFixed(2)} × 10⁻²⁷ kg`;
						commonUnit = "≈ 氢原子 / 单核子尺度";
					} else if (logVal < -18) {
						formattedValue = `${(massKg * 1e21).toFixed(2)} × 10⁻²¹ kg`;
						commonUnit = "≈ 大分子 / 病毒尺度 (zg)";
					} else if (logVal < -12) {
						formattedValue = `${(massKg * 1e15).toFixed(2)} × 10⁻¹⁵ kg (fg)`;
						commonUnit = "≈ 细菌 / 纳克级悬臂梁（以往纪录）";
					} else if (logVal < -6) {
						formattedValue = `${(massKg * 1e9).toFixed(2)} µg (微克)`;
						commonUnit = `≈ ${(massKg * 1e6).toFixed(3)} mg`;
					} else if (logVal < -3) {
						formattedValue = `${(massKg * 1e3).toFixed(1)} mg (毫克)`;
						commonUnit = logVal >= -4.2 && logVal <= -3.6 ? "★ OIST 128 mg 悬浮石墨板组件！" : "≈ 粒级物体（数粒大米）";
					} else {
						formattedValue = `${(massKg * 1e3).toFixed(2)} g (克)`;
						commonUnit = "≈ 金属回形针 / 纸张重量";
					}

					if (scaleMassValue) scaleMassValue.textContent = formattedValue;
					if (scaleCommonUnit) scaleCommonUnit.textContent = commonUnit;

					// Match regime info
					const regime = scaleData.find(item => logVal <= item.maxLog) || scaleData[scaleData.length - 1];
					if (scaleRegimeTitle) {
						scaleRegimeTitle.innerHTML = `<span class="lang-zh">${regime.regimeZh}</span><span class="lang-en">${regime.regimeEn}</span>`;
					}
					if (scaleRegimeDesc) {
						scaleRegimeDesc.innerHTML = `<span class="lang-zh">${regime.descZh}</span><span class="lang-en">${regime.descEn}</span>`;
					}
				}

				if (scaleLeapSlider) {
					scaleLeapSlider.addEventListener("input", (e) => {
						updateScaleLeap(parseFloat(e.target.value));
					});
				}

				scaleMilestoneBtns.forEach((btn) => {
					btn.addEventListener("click", () => {
						const targetLog = parseFloat(btn.getAttribute("data-target") || "-3.89");
						if (scaleLeapSlider) scaleLeapSlider.value = String(targetLog);
						updateScaleLeap(targetLog);
					});
				});

				// Initialize scale slider at OIST value
				updateScaleLeap(-3.89);
			}

			// Run on DOMContentLoaded or immediate if loaded
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initSpinShove);
			} else {
				initSpinShove();
			}
		})();
	</script>
</MainGridLayout>
