				// Spin control DOM
				const polarizationBadge = document.getElementById("polarization-badge");
				const polarizationFillBar = document.getElementById("polarization-fill-bar");
				const spinStateText = document.getElementById("spin-state-text");
				const btnLaserInit = document.getElementById("btn-laser-init");
				const btnMicrowaveFlip = document.getElementById("btn-microwave-flip");
				const btnDecohere = document.getElementById("btn-decohere");

				// Microscope DOM
				const microscopeDigits = document.getElementById("microscope-digits");
				const microscopeHairRatio = document.getElementById("microscope-hair-ratio");
				const microscopeNeedle = document.getElementById("microscope-needle");
				const pushHintBox = document.getElementById("push-hint-box");
