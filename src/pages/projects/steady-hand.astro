---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

interface Props {
	lang?: string;
}

const { lang = Astro.url.pathname.startsWith("/en") ? "en" : "zh_CN" } =
	Astro.props;
const isEn = lang === "en";

const title = isEn
	? "Steady Hand · Taming Boom and Bust"
	: "稳住波动 · STEADY HAND";
const description = isEn
	? "Steady Hand: Exploring the microeconomic foundations of macroeconomic stabilisation. Interactive New Keynesian control room modeling shocks, forward guidance, and expectation dynamics honoring the 2026 Nobel Memorial Prize in Economic Sciences."
	: "稳住波动 · STEADY HAND：探索宏观经济稳定的微观基础。致敬 2026 诺贝尔经济学奖（Robert E. Hall 与 Michael Woodford），通过交互式控制室模拟经济冲击、前瞻性指引与预期管理机制。";
---

<MainGridLayout title={title} description={description} lang={lang}>
	<div id="steady-hand-root" class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mb-8">
		<div class="z-10 px-4 sm:px-8 py-8 relative w-full rounded-(--radius-large) overflow-hidden bg-[#070c14] text-slate-100 border border-slate-800/80 shadow-2xl selection:bg-teal-500/30 selection:text-teal-200">
			<!-- Control Room Grid Background & Ambient Glow -->
			<div class="absolute inset-0 pointer-events-none opacity-15 bg-[radial-gradient(#14b8a6_1px,transparent_1px)] [background-size:24px_24px] overflow-hidden"></div>
			<div class="absolute -top-32 -left-32 w-80 h-80 bg-teal-600/10 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute top-1/4 -right-32 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute bottom-10 left-1/3 w-96 h-96 bg-cyan-600/10 rounded-full blur-3xl pointer-events-none"></div>

			<!-- HERO CARD CONTAINER (Target for Cover & Visual Centerpiece) -->
			<div id="hero-showcase-box" class="relative z-10 mb-8 pb-6 border-b border-slate-800/80">
				<!-- Header Badges & Date -->
				<div class="flex flex-wrap items-center justify-between gap-3 mb-3">
					<div class="flex flex-wrap items-center gap-2">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono font-semibold tracking-wide">
							<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
							<span class="lang-zh">★ 2026 诺贝尔经济学奖 · HALL & WOODFORD</span>
							<span class="lang-en">★ 2026 NOBEL IN ECONOMIC SCIENCES · HALL & WOODFORD</span>
						</div>
						<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-400 text-xs font-mono">
							<span>📡</span>
							<span class="lang-zh">宏观稳定微观基础 · 2026 诺奖系列终章</span>
							<span class="lang-en">MICRO-FOUNDATIONS OF STABILISATION · FINALE</span>
						</div>
					</div>
					<div class="text-xs font-mono text-slate-400">
						<span class="lang-zh">2026-10-12 斯德哥尔摩宣布 · 瑞典皇家科学院</span>
						<span class="lang-en">Announced 2026-10-12 in Stockholm</span>
					</div>
				</div>

				<!-- Main Title & Subtitle -->
				<h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-2 font-sans">
					<span class="lang-zh">稳住波动 · STEADY HAND</span>
					<span class="lang-en">Steady Hand · Taming Boom and Bust</span>
				</h1>

				<p class="text-base sm:text-xl font-bold text-teal-400 mb-3 tracking-wide font-mono">
					<span class="lang-zh">经济在繁荣与萧条间摇摆；预期在今天重塑未来。</span>
					<span class="lang-en">Economies swing between boom and bust; expectations reshape tomorrow today.</span>
				</p>

				<!-- Concise Context Summary -->
				<p class="text-xs sm:text-sm text-slate-300 max-w-3xl leading-relaxed mb-4">
					<span class="lang-zh">
						2026 年 10 月 12 日，瑞典皇家科学院授予罗伯特·E·霍尔与迈克尔·伍德福德诺贝尔经济学奖，表彰其为宏观经济稳定政策奠定的微观经济学基础。当传统凯恩斯总杠杆在 70 年代滞胀中失效，他们证明：前瞻性主体的预期管理才是平抑经济波动的关键。
					</span>
					<span class="lang-en">
						On October 12, 2026, the Royal Swedish Academy of Sciences awarded the Nobel Prize in Economic Sciences to Robert E. Hall and Michael Woodford for microeconomic foundations of macroeconomic stabilisation. Rebuilding policy on forward-looking expectations, they showed how central-bank communication anchors inflation and cushions shocks.
					</span>
				</p>

				<!-- Section 1 Header & Seismograph Wave Canvas -->
				<div class="flex flex-wrap items-center justify-between gap-3 mb-3">
					<div class="flex items-center gap-2">
						<span class="text-teal-400 font-mono text-sm font-bold">SECTION 1</span>
						<span class="text-slate-600">/</span>
						<h2 class="text-lg sm:text-xl font-bold text-white tracking-tight">
							<span class="lang-zh">冲击缓冲舱 · The Shock Absorber</span>
							<span class="lang-en">The Shock Absorber · Macro Seismograph</span>
						</h2>
					</div>

					<!-- Legend Badges -->
					<div class="flex flex-wrap items-center gap-2 text-xs font-mono">
						<div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-slate-900 border border-teal-500/40 text-teal-300">
							<span class="w-2 h-2 rounded-full bg-teal-400 shadow-[0_0_6px_rgba(45,212,191,0.8)]"></span>
							<span class="lang-zh">产出缺口 Output Gap (%)</span>
							<span class="lang-en">Output Gap (%)</span>
						</div>
						<div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-slate-900 border border-amber-500/40 text-amber-300">
							<span class="w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_6px_rgba(251,191,36,0.8)]"></span>
							<span class="lang-zh">通胀偏离 Inflation (%)</span>
							<span class="lang-en">Inflation (%)</span>
						</div>
						<div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-slate-400">
							<span class="w-2.5 border-b-2 border-dashed border-slate-400 inline-block"></span>
							<span class="lang-zh">无政策对照 (No Policy Ghost)</span>
							<span class="lang-en">No Policy Ghost</span>
						</div>
					</div>
				</div>

				<!-- Seismograph Canvas Container -->
				<div class="relative w-full rounded-2xl bg-[#050810] border border-slate-800 p-3 sm:p-5 shadow-2xl">
					<div class="relative w-full h-[260px] sm:h-[300px]">
						<canvas id="seismograph-canvas" class="w-full h-full block rounded-xl"></canvas>
					</div>

					<!-- Real-Time Scorecard Readout -->
					<div class="mt-3 pt-3 border-t border-slate-800/80 grid grid-cols-1 sm:grid-cols-3 gap-3 font-mono">
						<div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800">
							<div class="text-[10px] text-slate-400 uppercase tracking-wider mb-0.5">
								<span class="lang-zh">无干预波动率 (No Policy Volatility)</span>
								<span class="lang-en">No Policy Volatility (Std Dev)</span>
							</div>
							<div class="flex items-baseline gap-2">
								<span id="score-baseline-std" class="text-lg sm:text-xl font-bold text-slate-300">5.49%</span>
								<span class="text-xs text-slate-500">σ(y)</span>
							</div>
						</div>

						<div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800">
							<div class="text-[10px] text-teal-400 uppercase tracking-wider mb-0.5">
								<span class="lang-zh">政策干预后波动率 (With Policy)</span>
								<span class="lang-en">With Policy Volatility (Std Dev)</span>
							</div>
							<div class="flex items-baseline gap-2">
								<span id="score-policy-std" class="text-lg sm:text-xl font-bold text-teal-300">1.57%</span>
								<span class="text-xs text-teal-500/80">σ(y)</span>
							</div>
						</div>

						<div class="p-2.5 rounded-xl bg-teal-950/30 border border-teal-500/40">
							<div class="text-[10px] text-teal-300 uppercase tracking-wider mb-0.5">
								<span class="lang-zh">平抑成效裁决 (Stabilisation Verdict)</span>
								<span class="lang-en">Stabilisation Verdict</span>
							</div>
							<div id="score-verdict" class="text-xs sm:text-sm font-bold text-teal-200 leading-snug">
								<span class="lang-zh">政策将经济摆动幅度削减了 71.4%</span>
								<span class="lang-en">Policy cut the swing by 71.4%</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- SECTION 1 (CONT.) — CONTROL CONSOLE -->
			<section class="relative z-10 mb-12">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 bg-slate-900/50 p-5 rounded-2xl border border-slate-800">
					<!-- Shocks Column (4 cols) -->
					<div class="lg:col-span-4 space-y-3">
						<div class="text-xs font-mono font-bold uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
							<span>⚡</span>
							<span class="lang-zh">1. 触发外部冲击 (Select Shock)</span>
							<span class="lang-en">1. Trigger Shock</span>
						</div>
						<div class="grid grid-cols-1 gap-2.5">
							<button
								type="button"
								id="shock-energy"
								class="shock-btn active px-3.5 py-2.5 rounded-xl border border-amber-500/60 bg-amber-500/20 text-white font-medium text-xs text-left transition-all active:scale-95 flex items-center justify-between"
							>
								<div>
									<div class="font-bold flex items-center gap-1.5">
										<span>🛢️</span>
										<span class="lang-zh">能源危机 (Energy Crisis)</span>
										<span class="lang-en">Energy Crisis</span>
									</div>
									<div class="text-[11px] text-slate-300 opacity-80 mt-0.5">
										<span class="lang-zh">供给负冲击：通胀急升，产出衰退</span>
										<span class="lang-en">Supply shock: inflation jumps, output falls</span>
									</div>
								</div>
								<span class="text-amber-400 text-xs font-mono">STAGFLATION</span>
							</button>

							<button
								type="button"
								id="shock-slump"
								class="shock-btn px-3.5 py-2.5 rounded-xl border border-slate-700 bg-slate-800/60 text-slate-300 hover:text-white font-medium text-xs text-left transition-all active:scale-95 flex items-center justify-between"
							>
								<div>
									<div class="font-bold flex items-center gap-1.5">
										<span>📉</span>
										<span class="lang-zh">消费骤缩 (Consumption Slump)</span>
										<span class="lang-en">Consumption Slump</span>
									</div>
									<div class="text-[11px] text-slate-400 mt-0.5">
										<span class="lang-zh">需求负冲击：产出与通胀双双暴跌</span>
										<span class="lang-en">Demand shock: output & inflation plunge</span>
									</div>
								</div>
								<span class="text-cyan-400 text-xs font-mono">DEMAND DROP</span>
							</button>

							<button
								type="button"
								id="shock-boom"
								class="shock-btn px-3.5 py-2.5 rounded-xl border border-slate-700 bg-slate-800/60 text-slate-300 hover:text-white font-medium text-xs text-left transition-all active:scale-95 flex items-center justify-between"
							>
								<div>
									<div class="font-bold flex items-center gap-1.5">
										<span>🔥</span>
										<span class="lang-zh">过热繁荣 (Overheating Boom)</span>
										<span class="lang-en">Boom / Overheating</span>
									</div>
									<div class="text-[11px] text-slate-400 mt-0.5">
										<span class="lang-zh">需求过载：产出高企并推高物价压力</span>
										<span class="lang-en">Overheating: output & inflation surge</span>
									</div>
								</div>
								<span class="text-rose-400 text-xs font-mono">OVERHEAT</span>
							</button>
						</div>
					</div>

					<!-- Policy Levers Column (5 cols) -->
					<div class="lg:col-span-5 space-y-4">
						<div class="text-xs font-mono font-bold uppercase tracking-wider text-teal-400 flex items-center gap-1.5">
							<span>🎚️</span>
							<span class="lang-zh">2. 宏观调控杠杆 (Policy Levers)</span>
							<span class="lang-en">2. Policy Levers</span>
						</div>

						<!-- Rate Slider -->
						<div class="p-3 rounded-xl bg-slate-800/40 border border-slate-800">
							<div class="flex items-center justify-between text-xs mb-1.5">
								<span class="text-slate-300 font-medium flex items-center gap-1">
									<span>🏦</span>
									<span class="lang-zh">基准利率调节 (Interest Rate Δi)</span>
									<span class="lang-en">Interest Rate Move (Δi)</span>
								</span>
								<span id="rate-slider-badge" class="font-mono font-bold px-2 py-0.5 rounded bg-teal-950 text-teal-300 border border-teal-800/60 text-xs">
									+1.50%
								</span>
							</div>
							<input
								id="rate-slider"
								type="range"
								min="-1.0"
								max="3.0"
								step="0.25"
								value="1.50"
								class="w-full accent-teal-400 cursor-pointer h-1.5 bg-slate-700 rounded-lg appearance-none"
							/>
							<div class="flex justify-between text-[10px] font-mono text-slate-500 mt-1">
								<span>-1.0% (刺激/降息)</span>
								<span>0.0% (中性)</span>
								<span>+3.0% (紧缩/加息)</span>
							</div>
						</div>

						<!-- Forward Guidance Toggle & Fiscal Button -->
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
							<!-- Forward Guidance Toggle -->
							<div class="p-3 rounded-xl bg-slate-800/40 border border-slate-800 flex flex-col justify-between">
								<div class="text-xs font-medium text-slate-300 mb-1 flex items-center gap-1">
									<span>📢</span>
									<span class="lang-zh">前瞻性指引</span>
									<span class="lang-en">Forward Guidance</span>
								</div>
								<div class="text-[11px] text-slate-400 mb-2 leading-tight">
									<span class="lang-zh">央行可信承诺，迅速锚定未来预期</span>
									<span class="lang-en">Credible commitment anchors market expectations</span>
								</div>
								<button
									type="button"
									id="btn-guidance-toggle"
									class="px-3 py-1.5 rounded-lg border border-teal-500/60 bg-teal-500/20 text-teal-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer"
								>
									<span class="lang-zh">状态：已开启 (ON)</span>
									<span class="lang-en">Credible: ON</span>
									<span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>
								</button>
							</div>

							<!-- Fiscal Stimulus Button -->
							<div class="p-3 rounded-xl bg-slate-800/40 border border-slate-800 flex flex-col justify-between">
								<div class="text-xs font-medium text-slate-300 mb-1 flex items-center gap-1">
									<span>🏛️</span>
									<span class="lang-zh">财政刺激注入</span>
									<span class="lang-en">Fiscal Stimulus</span>
								</div>
								<div class="text-[11px] text-slate-400 mb-2 leading-tight">
									<span class="lang-zh">一次性财政开支扩充托举总需求</span>
									<span class="lang-en">One-shot demand injection to support output</span>
								</div>
								<button
									type="button"
									id="btn-fiscal-boost"
									class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer active:scale-95"
								>
									<span class="lang-zh">触发财政扩充</span>
									<span class="lang-en">Fire Boost</span>
									<span id="fiscal-indicator">OFF</span>
								</button>
							</div>
						</div>
					</div>

					<!-- Execution Column (3 cols) -->
					<div class="lg:col-span-3 flex flex-col justify-between space-y-3">
						<div class="text-xs font-mono font-bold uppercase tracking-wider text-slate-300 flex items-center gap-1.5">
							<span>▶️</span>
							<span class="lang-zh">3. 执行与推演</span>
							<span class="lang-en">3. Simulation Execution</span>
						</div>

						<div class="p-3 rounded-xl bg-slate-800/30 border border-slate-800/60 text-xs text-slate-400 space-y-1.5">
							<div class="flex items-center gap-1.5 text-teal-300 font-semibold font-mono">
								<span>💡</span>
								<span class="lang-zh">简化教学玩具说明：</span>
								<span class="lang-en">Teaching Toy Note:</span>
							</div>
							<p class="leading-relaxed text-[11px]">
								<span class="lang-zh">本模拟器基于新凯恩斯 3 方程教学速写构建（动态 IS、菲利普斯曲线与利率反应），用于直观呈现前瞻指引与预期锚定效应，非央行复杂 DSGE 预测模型。数值已被数学钳位以确保稳定。</span>
								<span class="lang-en">This simulator is an honest teaching toy based on a simplified New Keynesian 3-equation sketch (IS, Phillips curve, rate rule) illustrating expectations and forward guidance, not a central-bank DSGE model. Values are clamped for numerical stability.</span>
							</p>
						</div>

						<div class="flex flex-col sm:flex-row lg:flex-col gap-2">
							<button
								type="button"
								id="btn-run-sim"
								class="w-full py-2.5 px-4 rounded-xl bg-teal-500 hover:bg-teal-400 active:scale-95 text-slate-950 font-bold font-mono text-xs shadow-lg shadow-teal-900/30 transition-all flex items-center justify-center gap-2 cursor-pointer"
							>
								<span>🚀</span>
								<span class="lang-zh">重演推演动态 (Run Wave)</span>
								<span class="lang-en">Animate 20 Quarters</span>
							</button>
							<button
								type="button"
								id="btn-reset-sim"
								class="w-full py-2 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-300 font-mono text-xs border border-slate-700 transition-all flex items-center justify-center gap-2 cursor-pointer"
							>
								<span>↺</span>
								<span class="lang-zh">重置所有设定 (Reset)</span>
								<span class="lang-en">Reset Controls</span>
							</button>
						</div>
					</div>
				</div>
			</section>

			<!-- SECTION 2 — WHY EXPECTATIONS MOVE THE ECONOMY (Micro-Foundations) -->
			<section class="relative z-10 mb-12">
				<div class="mb-6">
					<div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-teal-400 mb-1">
						<span>🧩</span>
						<span>·</span>
						<span class="lang-zh">微观经济学基础三支柱</span>
						<span class="lang-en">Microeconomic Foundations</span>
					</div>
					<h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
						<span class="lang-zh">预期何以决定宏观大局 · Three Mini-Demos</span>
						<span class="lang-en">Why Expectations Move the Economy · Three Mini-Demos</span>
					</h2>
					<p class="text-xs sm:text-sm text-slate-400 mt-1">
						<span class="lang-zh">霍尔与伍德福德将宏观经济的宏大叙事，拆解为家庭、企业与央行在微观层面的理性互动。</span>
						<span class="lang-en">Hall and Woodford unpacked aggregate macroeconomic movements into forward-looking decisions by households, firms, and the central bank.</span>
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<!-- DEMO 1: THE HOUSEHOLD (Hall's Consumption Smoothing) -->
					<div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between mb-3">
								<div class="text-xs font-mono text-teal-400 font-bold uppercase tracking-wider flex items-center gap-1.5">
									<span>🏠</span>
									<span class="lang-zh">1. 家庭主体 · 霍尔假说</span>
									<span class="lang-en">1. The Household · Hall</span>
								</div>
								<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-teal-950 text-teal-300 border border-teal-800/60">
									CONSUMPTION
								</span>
							</div>

							<h3 class="text-base font-bold text-white mb-1">
								<span class="lang-zh">未来预期决定今日消费</span>
								<span class="lang-en">Future Outlook Shapes Today's Spending</span>
							</h3>
							<p class="text-xs text-slate-300 mb-4 leading-relaxed">
								<span class="lang-zh">即便当前收入完全不变，当人们对未来预期发生变化时，今日的消费支出就会立即跳变。</span>
								<span class="lang-en">Even when current paycheck stays fixed, expected future earnings immediately shift today's consumption.</span>
							</p>

							<!-- Household Slider & Readouts -->
							<div class="space-y-3 bg-slate-950/60 p-3.5 rounded-xl border border-slate-800 mb-4">
								<div>
									<div class="flex items-center justify-between text-xs mb-1">
										<span class="text-slate-400">
											<span class="lang-zh">预期未来收入变化：</span>
