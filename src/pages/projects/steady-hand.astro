				<!-- Prize Facts Banner -->
				<div class="p-4 rounded-xl bg-slate-900/90 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono text-slate-300">
					<div class="flex items-center gap-2">
						<span class="text-amber-400 text-base">👑</span>
						<div>
							<span class="text-white font-bold">
								<span class="lang-zh">瑞典国家银行纪念阿尔弗雷德·诺贝尔经济学奖</span>
								<span class="lang-en">The Sveriges Riksbank Prize in Economic Sciences in Memory of Alfred Nobel</span>
							</span>
							<div class="text-slate-400 text-[11px]">
								<span class="lang-zh">2026-10-12 斯德哥尔摩宣布 · 奖金 1200 万瑞典克朗（两人各获 600 万克朗）</span>
								<span class="lang-en">Announced 2026-10-12 in Stockholm · 12M SEK total, 6M SEK each</span>
							</div>
						</div>
