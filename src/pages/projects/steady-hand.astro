			<!-- FOOTER SECTION -->
			<div class="pt-6 border-t border-slate-800/80 text-xs font-mono text-slate-400 flex flex-col sm:flex-row items-center justify-between gap-3">
				<div>
					<span class="lang-zh">参考来源：基于瑞典皇家科学院 2026 诺贝尔经济学奖新闻公报与学术背景资料意译</span>
					<span class="lang-en">Sources: Paraphrased from Royal Swedish Academy of Sciences official release & background papers</span>
				</div>
				<div class="text-slate-500">
					p1ziyu.com · 2026-10-13
				</div>
			</div>

			<hr class="my-6 border-slate-800" />
			<blockquote class="text-xs opacity-50 border-l-2 border-teal-500/40 pl-3 py-1 my-4 italic">
				<span class="lang-zh">本文由 AI 生成。</span>
				<span class="lang-en">Generated by AI.</span>
			</blockquote>
		</div>
	</div>

	<!-- CLIENT-SIDE SIMULATION & INTERACTIVE ENGINE -->
	<script is:inline>
		(() => {
			function initSteadyHand() {
				const root = document.getElementById("steady-hand-root");
				if (!root || root.dataset.labReady === "true") return;
				root.dataset.labReady = "true";

				const lifecycle = new AbortController();
				document.addEventListener("astro:before-swap", () => {
					lifecycle.abort();
					if (animFrameId) cancelAnimationFrame(animFrameId);
				}, { once: true });

				function isEn() {
					return document.documentElement.lang === "en" || document.documentElement.getAttribute("data-lang") === "en";
				}

				let animFrameId = null;

				// ==========================================
				// 1. HERO SEISMOGRAPH CANVASES & SIMULATION
				// ==========================================
				const canvas = document.getElementById("seismograph-canvas");
				if (!canvas) return;
				const ctx = canvas.getContext("2d");

				// Simulation State
				let currentShock = "energy"; // "energy" | "slump" | "boom"
				let rateDelta = 1.5;         // -1.0 to 3.0
				let guidanceOn = true;       // boolean
				let fiscalBoost = false;     // boolean
				let animProgress = 1.0;      // 0 to 1 during run animation
				let animStartTime = 0;

				function runSimulation(shockType, rate, guidance, fiscal) {
					const N = 20;
					const output = new Array(N).fill(0);
					const inflation = new Array(N).fill(0);

					let supplyShock = 0;
					let demandShock = 0;
					if (shockType === "energy") {
						supplyShock = 3.6;
						demandShock = -1.8;
					} else if (shockType === "slump") {
						supplyShock = 0;
						demandShock = -4.0;
					} else if (shockType === "boom") {
						supplyShock = 0;
						demandShock = 3.8;
					}

					let prevY = 0;
					let prevPi = 0;
					let s_t = supplyShock;
					let d_t = demandShock;

					for (let t = 0; t < N; t++) {
						const fBoost = (fiscal && t < 3) ? (t === 0 ? 2.5 : t === 1 ? 1.4 : 0.6) : 0;
						let expPi = 0;
						let expY = 0;
						if (guidance) {
							expPi = prevPi * 0.25;
							expY = prevY * 0.20;
						} else {
							expPi = prevPi * 0.75;
							expY = prevY * 0.60;
						}

						const sigma = 0.65;
						const realRateGap = rate - expPi;
						let y = expY - sigma * realRateGap + d_t + fBoost;

						const beta = 0.85;
						const kappa = 0.35;
						let pi = beta * expPi + kappa * y + s_t;

						// Math stabilization clamping
						y = Math.max(-8, Math.min(8, y));
						pi = Math.max(-8, Math.min(8, pi));

						output[t] = y;
						inflation[t] = pi;

						prevY = y;
						prevPi = pi;
						s_t *= 0.65;
						d_t *= 0.65;
					}

					const stdY = Math.sqrt(output.reduce((sum, v) => sum + v * v, 0) / N);
					return { output, inflation, stdY };
				}

				// DOM Elements for Hero
				const scoreBaselineEl = document.getElementById("score-baseline-std");
				const scorePolicyEl = document.getElementById("score-policy-std");
				const scoreVerdictEl = document.getElementById("score-verdict");
				const rateSlider = document.getElementById("rate-slider");
				const rateSliderBadge = document.getElementById("rate-slider-badge");
				const guidanceToggleBtn = document.getElementById("btn-guidance-toggle");
				const fiscalBoostBtn = document.getElementById("btn-fiscal-boost");
				const fiscalIndicator = document.getElementById("fiscal-indicator");
				const shockEnergyBtn = document.getElementById("shock-energy");
				const shockSlumpBtn = document.getElementById("shock-slump");
				const shockBoomBtn = document.getElementById("shock-boom");
				const runSimBtn = document.getElementById("btn-run-sim");
				const resetSimBtn = document.getElementById("btn-reset-sim");

				function updateScorecard(noPolicyResult, policyResult) {
					if (scoreBaselineEl) scoreBaselineEl.textContent = noPolicyResult.stdY.toFixed(2) + "%";
					if (scorePolicyEl) scorePolicyEl.textContent = policyResult.stdY.toFixed(2) + "%";

					if (scoreVerdictEl) {
						const cut = ((noPolicyResult.stdY - policyResult.stdY) / noPolicyResult.stdY) * 100;
						const en = isEn();
						if (cut > 0) {
							scoreVerdictEl.className = "text-xs sm:text-sm font-bold text-teal-200 leading-snug";
							scoreVerdictEl.textContent = en
								? `Policy cut the swing by ${cut.toFixed(1)}%`
								: `政策将经济摆动幅度削减了 ${cut.toFixed(1)}%`;
						} else {
							const amplified = Math.abs(cut).toFixed(1);
							scoreVerdictEl.className = "text-xs sm:text-sm font-bold text-amber-300 leading-snug";
							scoreVerdictEl.textContent = en
								? `Policy magnified the swing by ${amplified}%`
								: `政策使波动幅度放大了 ${amplified}%`;
						}
					}
				}

				function resizeCanvas() {
					const rect = canvas.getBoundingClientRect();
					const dpr = window.devicePixelRatio || 1;
					canvas.width = rect.width * dpr;
					canvas.height = rect.height * dpr;
					drawSeismograph();
				}

				function drawSeismograph() {
					if (!ctx) return;
					const w = canvas.width;
					const h = canvas.height;
					ctx.clearRect(0, 0, w, h);

					const paddingLeft = 55;
					const paddingRight = 30;
					const paddingTop = 25;
					const paddingBottom = 35;
					const chartW = w - paddingLeft - paddingRight;
					const chartH = h - paddingTop - paddingBottom;

					// Seismograph Grid Lines
					ctx.strokeStyle = "rgba(30, 41, 59, 0.7)";
					ctx.lineWidth = 1;

					// Y Axis ticks (-8% to +8%)
					const yTicks = [-8, -4, 0, 4, 8];
					ctx.font = `${Math.max(10, Math.floor(chartH * 0.045))}px ui-monospace, monospace`;
					ctx.fillStyle = "rgba(148, 163, 184, 0.7)";
					ctx.textAlign = "right";
					ctx.textBaseline = "middle";

					for (const tick of yTicks) {
						const yPos = paddingTop + chartH * (1 - (tick + 8) / 16);
						ctx.beginPath();
						ctx.moveTo(paddingLeft, yPos);
						ctx.lineTo(w - paddingRight, yPos);
						ctx.stroke();

						ctx.fillText(`${tick > 0 ? "+" : ""}${tick}%`, paddingLeft - 10, yPos);
					}

					// Zero baseline highlight
					const zeroY = paddingTop + chartH * 0.5;
					ctx.strokeStyle = "rgba(148, 163, 184, 0.35)";
					ctx.lineWidth = 1.5;
					ctx.setLineDash([4, 4]);
					ctx.beginPath();
					ctx.moveTo(paddingLeft, zeroY);
					ctx.lineTo(w - paddingRight, zeroY);
					ctx.stroke();
					ctx.setLineDash([]);

					// X Axis ticks (Q1 to Q20)
					ctx.strokeStyle = "rgba(30, 41, 59, 0.4)";
					ctx.textAlign = "center";
					ctx.textBaseline = "top";
					for (let q = 0; q < 20; q++) {
						const xPos = paddingLeft + (q / 19) * chartW;
						if (q % 2 === 0 || q === 19) {
							ctx.beginPath();
							ctx.moveTo(xPos, paddingTop);
							ctx.lineTo(xPos, paddingTop + chartH);
							ctx.stroke();
							ctx.fillText(`Q${q + 1}`, xPos, paddingTop + chartH + 6);
						}
					}

					// Fetch Simulation Data
					const noPolicyData = runSimulation(currentShock, 0, false, false);
					const policyData = runSimulation(currentShock, rateDelta, guidanceOn, fiscalBoost);
					updateScorecard(noPolicyData, policyData);

					const pointsToDraw = Math.floor(animProgress * 19) + 1;
					const partialT = (animProgress * 19) - Math.floor(animProgress * 19);

					function getCoords(dataArr, idx) {
						const clampedIdx = Math.min(19, Math.max(0, idx));
						const val = dataArr[clampedIdx];
						const x = paddingLeft + (clampedIdx / 19) * chartW;
						const y = paddingTop + chartH * (1 - (val + 8) / 16);
						return { x, y };
					}

					// 1. Draw "No Policy" Ghost Lines (Dashed Gray)
					ctx.save();
					ctx.setLineDash([5, 5]);
					ctx.lineWidth = 1.8;

					// Ghost Output Gap
					ctx.strokeStyle = "rgba(45, 212, 191, 0.28)";
					ctx.beginPath();
					for (let i = 0; i < 20; i++) {
						const pt = getCoords(noPolicyData.output, i);
						if (i === 0) ctx.moveTo(pt.x, pt.y);
						else ctx.lineTo(pt.x, pt.y);
					}
					ctx.stroke();

					// Ghost Inflation
					ctx.strokeStyle = "rgba(251, 191, 36, 0.28)";
					ctx.beginPath();
					for (let i = 0; i < 20; i++) {
						const pt = getCoords(noPolicyData.inflation, i);
						if (i === 0) ctx.moveTo(pt.x, pt.y);
						else ctx.lineTo(pt.x, pt.y);
					}
					ctx.stroke();
					ctx.restore();

					// 2. Draw Active Policy Waves (Glowing Solid Lines)
					// Teal: Output Gap
					ctx.save();
					ctx.shadowColor = "rgba(45, 212, 191, 0.7)";
					ctx.shadowBlur = 10;
					ctx.strokeStyle = "#2dd4bf";
					ctx.lineWidth = 3;
					ctx.beginPath();
					for (let i = 0; i < pointsToDraw; i++) {
						const pt = getCoords(policyData.output, i);
						if (i === 0) ctx.moveTo(pt.x, pt.y);
						else ctx.lineTo(pt.x, pt.y);
					}
					if (pointsToDraw < 20 && partialT > 0) {
						const ptA = getCoords(policyData.output, pointsToDraw - 1);
						const ptB = getCoords(policyData.output, pointsToDraw);
						ctx.lineTo(ptA.x + (ptB.x - ptA.x) * partialT, ptA.y + (ptB.y - ptA.y) * partialT);
					}
					ctx.stroke();
					ctx.restore();

					// Amber: Inflation Deviation
					ctx.save();
					ctx.shadowColor = "rgba(251, 191, 36, 0.7)";
					ctx.shadowBlur = 10;
					ctx.strokeStyle = "#fbbf24";
					ctx.lineWidth = 3;
					ctx.beginPath();
					for (let i = 0; i < pointsToDraw; i++) {
						const pt = getCoords(policyData.inflation, i);
						if (i === 0) ctx.moveTo(pt.x, pt.y);
						else ctx.lineTo(pt.x, pt.y);
					}
					if (pointsToDraw < 20 && partialT > 0) {
						const ptA = getCoords(policyData.inflation, pointsToDraw - 1);
						const ptB = getCoords(policyData.inflation, pointsToDraw);
						ctx.lineTo(ptA.x + (ptB.x - ptA.x) * partialT, ptA.y + (ptB.y - ptA.y) * partialT);
					}
					ctx.stroke();
					ctx.restore();

					// Active Head Pulse Dots
					const lastIdx = Math.min(19, pointsToDraw - 1);
					const headOut = getCoords(policyData.output, lastIdx);
					const headInf = getCoords(policyData.inflation, lastIdx);

					ctx.fillStyle = "#2dd4bf";
					ctx.beginPath();
					ctx.arc(headOut.x, headOut.y, 5, 0, Math.PI * 2);
					ctx.fill();

					ctx.fillStyle = "#fbbf24";
					ctx.beginPath();
					ctx.arc(headInf.x, headInf.y, 5, 0, Math.PI * 2);
					ctx.fill();
				}

				function animateSim(timestamp) {
					if (!animStartTime) animStartTime = timestamp;
					const elapsed = timestamp - animStartTime;
					const duration = 1200; // ms
					animProgress = Math.min(1, elapsed / duration);
					drawSeismograph();

					if (animProgress < 1) {
						animFrameId = requestAnimationFrame(animateSim);
					} else {
						animFrameId = null;
					}
				}

				function triggerSimRun() {
					if (animFrameId) cancelAnimationFrame(animFrameId);
					animProgress = 0;
					animStartTime = 0;
					animFrameId = requestAnimationFrame(animateSim);
				}

				// Listeners for Hero Controls
				if (rateSlider && rateSliderBadge) {
					rateSlider.addEventListener("input", (e) => {
						rateDelta = parseFloat(e.target.value);
						rateSliderBadge.textContent = (rateDelta >= 0 ? "+" : "") + rateDelta.toFixed(2) + "%";
						drawSeismograph();
					}, { signal: lifecycle.signal });
				}

				if (guidanceToggleBtn) {
					guidanceToggleBtn.addEventListener("click", () => {
						guidanceOn = !guidanceOn;
						const en = isEn();
						if (guidanceOn) {
							guidanceToggleBtn.className = "px-3 py-1.5 rounded-lg border border-teal-500/60 bg-teal-500/20 text-teal-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer";
							guidanceToggleBtn.innerHTML = en
								? `<span>Credible: ON</span><span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>`
								: `<span>状态：已开启 (ON)</span><span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>`;
						} else {
							guidanceToggleBtn.className = "px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800 text-slate-400 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer";
							guidanceToggleBtn.innerHTML = en
								? `<span>Credible: OFF</span><span class="w-2 h-2 rounded-full bg-slate-600"></span>`
								: `<span>状态：未开启 (OFF)</span><span class="w-2 h-2 rounded-full bg-slate-600"></span>`;
						}
						drawSeismograph();
					}, { signal: lifecycle.signal });
				}

				if (fiscalBoostBtn && fiscalIndicator) {
					fiscalBoostBtn.addEventListener("click", () => {
						fiscalBoost = !fiscalBoost;
						if (fiscalBoost) {
							fiscalBoostBtn.className = "px-3 py-1.5 rounded-lg border border-teal-500/60 bg-teal-500/20 text-teal-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer";
							fiscalIndicator.textContent = "ACTIVE";
							fiscalIndicator.className = "text-teal-400";
						} else {
							fiscalBoostBtn.className = "px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer active:scale-95";
							fiscalIndicator.textContent = "OFF";
							fiscalIndicator.className = "text-slate-400";
						}
						drawSeismograph();
					}, { signal: lifecycle.signal });
				}

				function setShock(type) {
					currentShock = type;
					const btns = [shockEnergyBtn, shockSlumpBtn, shockBoomBtn];
					btns.forEach(btn => {
						if (!btn) return;
						btn.classList.remove("active", "border-amber-500/60", "bg-amber-500/20", "text-white");
						btn.classList.add("border-slate-700", "bg-slate-800/60", "text-slate-300");
					});
					const activeBtn = type === "energy" ? shockEnergyBtn : (type === "slump" ? shockSlumpBtn : shockBoomBtn);
					if (activeBtn) {
						activeBtn.classList.remove("border-slate-700", "bg-slate-800/60", "text-slate-300");
						activeBtn.classList.add("active", "border-amber-500/60", "bg-amber-500/20", "text-white");
					}
					triggerSimRun();
				}

				if (shockEnergyBtn) shockEnergyBtn.addEventListener("click", () => setShock("energy"), { signal: lifecycle.signal });
				if (shockSlumpBtn) shockSlumpBtn.addEventListener("click", () => setShock("slump"), { signal: lifecycle.signal });
				if (shockBoomBtn) shockBoomBtn.addEventListener("click", () => setShock("boom"), { signal: lifecycle.signal });

				if (runSimBtn) runSimBtn.addEventListener("click", triggerSimRun, { signal: lifecycle.signal });

				if (resetSimBtn) {
					resetSimBtn.addEventListener("click", () => {
						rateDelta = 1.5;
						if (rateSlider) rateSlider.value = "1.50";
						if (rateSliderBadge) rateSliderBadge.textContent = "+1.50%";
						guidanceOn = true;
						if (guidanceToggleBtn) {
							guidanceToggleBtn.className = "px-3 py-1.5 rounded-lg border border-teal-500/60 bg-teal-500/20 text-teal-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer";
							guidanceToggleBtn.innerHTML = isEn()
								? `<span>Credible: ON</span><span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>`
								: `<span>状态：已开启 (ON)</span><span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>`;
						}
						fiscalBoost = false;
						if (fiscalBoostBtn && fiscalIndicator) {
							fiscalBoostBtn.className = "px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono text-xs font-bold transition-all flex items-center justify-between cursor-pointer active:scale-95";
							fiscalIndicator.textContent = "OFF";
							fiscalIndicator.className = "text-slate-400";
						}
						setShock("energy");
					}, { signal: lifecycle.signal });
				}

				window.addEventListener("resize", resizeCanvas, { signal: lifecycle.signal });
				resizeCanvas();

				// ==========================================
				// 2. MINI-DEMO 1: THE HOUSEHOLD (HALL)
				// ==========================================
				const demo1Slider = document.getElementById("demo1-exp-slider");
				const demo1ExpBadge = document.getElementById("demo1-exp-badge");
				const demo1SpendingVal = document.getElementById("demo1-spending-val");

				if (demo1Slider && demo1ExpBadge && demo1SpendingVal) {
					demo1Slider.addEventListener("input", (e) => {
						const val = parseInt(e.target.value, 10);
						const en = isEn();
						demo1ExpBadge.textContent = (val > 0 ? "+" : "") + val + "% " + (val > 0 ? (en ? "(Optimistic)" : "(乐观)") : (val < 0 ? (en ? "(Pessimistic)" : "(悲观)") : (en ? "(Neutral)" : "(中性)")));
						if (val > 0) demo1ExpBadge.className = "font-mono font-bold text-teal-300";
						else if (val < 0) demo1ExpBadge.className = "font-mono font-bold text-amber-300";
						else demo1ExpBadge.className = "font-mono font-bold text-slate-300";

						// Permanent Income consumption response
						const spending = Math.round(10000 * (1 + (val / 100) * 0.65));
						demo1SpendingVal.textContent = "$" + spending.toLocaleString();
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 3. MINI-DEMO 2: THE FIRM (CALVO STICKY PRICES)
				// ==========================================
				const firmGrid = document.getElementById("demo2-firm-grid");
				const demo2Ratio = document.getElementById("demo2-adjusted-ratio");
				const demo2Price = document.getElementById("demo2-price-level");
				const demo2AdvBtn = document.getElementById("btn-demo2-advance");
				const demo2ResetBtn = document.getElementById("btn-demo2-reset");

				const TOTAL_FIRMS = 24;
				let adjustedFirmCount = 0;
				let currentQ = 0;

				function renderFirmGrid() {
					if (!firmGrid) return;
					firmGrid.innerHTML = "";
					for (let i = 0; i < TOTAL_FIRMS; i++) {
						const isAdjusted = i < adjustedFirmCount;
						const tile = document.createElement("div");
						tile.className = `p-1 text-center rounded text-[10px] font-mono font-bold transition-all duration-300 ${
							isAdjusted
								? "bg-amber-500/20 border border-amber-500/60 text-amber-300 shadow-[0_0_8px_rgba(251,191,36,0.2)]"
								: "bg-slate-900 border border-slate-800 text-slate-500"
						}`;
						tile.textContent = isAdjusted ? "120" : "100";
						tile.title = isAdjusted ? (isEn() ? "Price Adjusted to 120" : "已调价至 120") : (isEn() ? "Price Sticky at 100" : "价格黏性锁定在 100");
						firmGrid.appendChild(tile);
					}

					const pct = Math.round((adjustedFirmCount / TOTAL_FIRMS) * 100);
					if (demo2Ratio) demo2Ratio.textContent = `${adjustedFirmCount} / ${TOTAL_FIRMS} (${pct}%)`;

					const priceLevel = 100 + (adjustedFirmCount / TOTAL_FIRMS) * 20;
					if (demo2Price) demo2Price.textContent = priceLevel.toFixed(1);
				}

				if (demo2AdvBtn) {
					demo2AdvBtn.addEventListener("click", () => {
						if (adjustedFirmCount < TOTAL_FIRMS) {
							const unadjusted = TOTAL_FIRMS - adjustedFirmCount;
							const newAdjusted = Math.max(1, Math.min(unadjusted, Math.round(unadjusted * 0.35)));
							adjustedFirmCount += newAdjusted;
							currentQ++;
							renderFirmGrid();
						}
					}, { signal: lifecycle.signal });
				}

				if (demo2ResetBtn) {
					demo2ResetBtn.addEventListener("click", () => {
						adjustedFirmCount = 0;
						currentQ = 0;
						renderFirmGrid();
					}, { signal: lifecycle.signal });
				}

				renderFirmGrid();

				// ==========================================
				// 4. MINI-DEMO 3: CENTRAL BANK GUIDANCE
				// ==========================================
				const demo3SurpriseBtn = document.getElementById("demo3-mode-surprise");
				const demo3AnnouncedBtn = document.getElementById("demo3-mode-announced");
				const demo3PeakLoss = document.getElementById("demo3-peak-loss");
				const demo3Sacrifice = document.getElementById("demo3-sacrifice");
				const demo3AnchorSpeed = document.getElementById("demo3-anchor-speed");

				function setDemo3Mode(mode) {
					const en = isEn();
					if (mode === "surprise") {
						demo3SurpriseBtn.className = "py-1 px-2 rounded font-bold bg-amber-500 text-slate-950 shadow transition-all cursor-pointer";
						demo3AnnouncedBtn.className = "py-1 px-2 rounded font-bold text-slate-400 hover:text-white transition-all cursor-pointer";

						if (demo3PeakLoss) {
							demo3PeakLoss.textContent = "-3.6%";
							demo3PeakLoss.className = "font-bold text-rose-400";
						}
						if (demo3Sacrifice) {
							demo3Sacrifice.textContent = en ? "Severe (High Pain)" : "严峻 (深度衰退)";
							demo3Sacrifice.className = "font-bold text-rose-400";
						}
						if (demo3AnchorSpeed) {
							demo3AnchorSpeed.textContent = en ? "Sluggish Inertia" : "滞后缓慢，通胀黏性强";
						}
					} else {
						demo3AnnouncedBtn.className = "py-1 px-2 rounded font-bold bg-teal-500 text-slate-950 shadow transition-all cursor-pointer";
						demo3SurpriseBtn.className = "py-1 px-2 rounded font-bold text-slate-400 hover:text-white transition-all cursor-pointer";

						if (demo3PeakLoss) {
							demo3PeakLoss.textContent = "-1.2%";
							demo3PeakLoss.className = "font-bold text-teal-300";
						}
						if (demo3Sacrifice) {
							demo3Sacrifice.textContent = en ? "Minimal (Low Pain)" : "极小 (低痛苦平稳)";
							demo3Sacrifice.className = "font-bold text-teal-300";
						}
						if (demo3AnchorSpeed) {
							demo3AnchorSpeed.textContent = en ? "Rapid Anchor to Target" : "迅速锁定目标";
						}
					}
				}

				if (demo3SurpriseBtn) demo3SurpriseBtn.addEventListener("click", () => setDemo3Mode("surprise"), { signal: lifecycle.signal });
				if (demo3AnnouncedBtn) demo3AnnouncedBtn.addEventListener("click", () => setDemo3Mode("announced"), { signal: lifecycle.signal });
			}

			// Initialize when DOM is ready or after swup navigation
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initSteadyHand);
			} else {
				initSteadyHand();
			}
			document.addEventListener("astro:page-load", initSteadyHand);
		})();
	</script>
</MainGridLayout>
