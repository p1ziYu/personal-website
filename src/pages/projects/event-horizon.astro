---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "事件视界 · 黑洞粒子游乐场";
const description =
	"上千颗粒子围着黑洞打转，拖出星轨：移动鼠标搅动粒子流，点击画布扔临时黑洞，一发冲击波把内圈全部甩飞。灵感来自 Threads 上的 Event horizon 粒子玩具。";
---

<MainGridLayout title={title} description={description}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<h1 class="text-2xl font-bold mb-2">事件视界</h1>
			<p class="text-sm opacity-70 mb-1">
				上千颗粒子围着黑洞打转，拖尾拉出星轨。灵感来自 Threads 上 @cat_ronin 分享的
				"Event horizon" 粒子玩具，我做了个可玩的网页版：你也可以亲手往里面扔黑洞。
			</p>
			<p class="text-sm opacity-70 mb-4">
				玩法：移动鼠标搅动粒子流；点击画布放一个临时黑洞（持续 6 秒）；冲击波把内圈粒子全部甩飞。
			</p>

			<div class="relative rounded-xl overflow-hidden bg-black">
				<canvas
					id="eh-canvas"
					class="block w-full touch-none select-none cursor-crosshair"
					style="height: min(62vh, 560px); min-height: 380px;"
				></canvas>
				<div class="absolute top-2 left-3 text-xs text-white/70 font-mono pointer-events-none">
					被吞噬 <span id="eh-eaten" class="text-white">0</span>
					<span class="mx-1 opacity-40">·</span>
					<span id="eh-fps" class="text-white">--</span> fps
				</div>
				<div class="absolute top-2 right-3 text-xs text-white/50 pointer-events-none hidden sm:block">
					点击画布 = 扔临时黑洞
				</div>
			</div>

			<div class="grid sm:grid-cols-3 gap-4 mt-5">
				<label class="block text-sm">
					<span class="flex justify-between mb-1"><span class="opacity-70">引力强度</span><span id="eh-g-val" class="font-mono opacity-80">9000</span></span>
					<input id="eh-g" type="range" min="3000" max="18000" step="500" value="9000" class="w-full accent-[var(--primary)]" />
				</label>
				<label class="block text-sm">
					<span class="flex justify-between mb-1"><span class="opacity-70">粒子数量</span><span id="eh-n-val" class="font-mono opacity-80">1200</span></span>
					<input id="eh-n" type="range" min="200" max="2500" step="100" value="1200" class="w-full accent-[var(--primary)]" />
				</label>
				<label class="block text-sm">
					<span class="flex justify-between mb-1"><span class="opacity-70">拖尾长度</span><span id="eh-t-val" class="font-mono opacity-80">0.22</span></span>
					<input id="eh-t" type="range" min="0.05" max="0.5" step="0.01" value="0.22" class="w-full accent-[var(--primary)]" />
				</label>
			</div>

			<div class="flex flex-wrap items-center gap-2 mt-4">
				<span class="text-sm opacity-70 mr-1">配色</span>
				<button data-eh-theme="268" class="eh-theme px-3 py-1.5 rounded-xl text-sm font-medium border border-black/15 dark:border-white/15 bg-[var(--primary)] text-white">紫</button>
				<button data-eh-theme="188" class="eh-theme px-3 py-1.5 rounded-xl text-sm font-medium border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5">青</button>
				<button data-eh-theme="18" class="eh-theme px-3 py-1.5 rounded-xl text-sm font-medium border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5">焰</button>
				<span class="mx-1 opacity-30">|</span>
				<button id="eh-shock" class="px-4 py-1.5 rounded-xl bg-[var(--primary)] text-white text-sm font-medium hover:opacity-90 active:scale-95 transition">💥 冲击波</button>
				<button id="eh-pause" class="px-4 py-1.5 rounded-xl border border-black/15 dark:border-white/15 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition">⏸ 暂停</button>
				<button id="eh-reset" class="px-4 py-1.5 rounded-xl border border-black/15 dark:border-white/15 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition">↺ 重置</button>
			</div>

			<hr class="my-6 border-black/10 dark:border-white/10" />
			<p class="text-xs opacity-50">
				实现：Canvas 2D + 简单牛顿引力，粒子进视界半径就被吞噬并在外圈重生；
				冲击波给全场粒子一个径向脉冲。手机上也可以点按游玩。本页面由 AI 生成。
			</p>
		</div>
	</div>

	<script>
		(() => {
			const canvas = document.getElementById("eh-canvas");
			const ctx = canvas.getContext("2d");
			const eatenEl = document.getElementById("eh-eaten");
			const fpsEl = document.getElementById("eh-fps");

			const HORIZON = 16;
			let W = 0, H = 0;
			const hole = { x: 0, y: 0 };
			const mouse = { x: null, y: null };
			let particles = [];
			let tempHoles = [];
			let waves = [];
			let eaten = 0;
			let running = true;
			let last = performance.now();
			let fpsT = performance.now(), fpsAcc = 0, fpsN = 0;

			const cfg = { G: 9000, count: 1200, trail: 0.22, theme: 268 };

			function resize() {
				const dpr = Math.min(2, window.devicePixelRatio || 1);
				const r = canvas.getBoundingClientRect();
				W = r.width; H = r.height;
				canvas.width = Math.max(1, Math.round(W * dpr));
				canvas.height = Math.max(1, Math.round(H * dpr));
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				hole.x = W / 2; hole.y = H / 2;
				ctx.fillStyle = "#04040a";
				ctx.fillRect(0, 0, W, H);
			}

			function spawn(p, edge) {
				const maxR = Math.hypot(W, H) / 2;
				const a = Math.random() * Math.PI * 2;
				const r = edge
					? maxR * (0.95 + Math.random() * 0.15)
					: HORIZON * 3 + Math.random() * Math.min(W, H) * 0.45;
				p.x = hole.x + Math.cos(a) * r;
				p.y = hole.y + Math.sin(a) * r;
				const v = Math.sqrt(cfg.G / Math.max(r, 40)) * (0.9 + Math.random() * 0.25);
				p.vx = -Math.sin(a) * v;
				p.vy = Math.cos(a) * v;
				p.tw = Math.random() * Math.PI * 2;
				p.hueJ = Math.random() * 36 - 18;
			}

			function rebuild() {
				particles = [];
				for (let i = 0; i < cfg.count; i++) {
					const p = {};
					spawn(p, false);
					particles.push(p);
				}
				tempHoles = [];
				waves = [];
				ctx.fillStyle = "#04040a";
				ctx.fillRect(0, 0, W, H);
			}

			function step(dt) {
				const maxR = Math.hypot(W, H) / 2 + 80;
				for (const p of particles) {
					let dvx = 0, dvy = 0;
					// 主黑洞
					{
						const dx = hole.x - p.x, dy = hole.y - p.y;
						const r2 = dx * dx + dy * dy + 400;
						const r = Math.sqrt(r2);
						if (r < HORIZON + 6) { eaten++; spawn(p, true); continue; }
						const acc = Math.min(cfg.G / r2, 6000);
						dvx += (dx / r) * acc * dt;
						dvy += (dy / r) * acc * dt;
					}
					// 临时黑洞
					for (const th of tempHoles) {
						const dx = th.x - p.x, dy = th.y - p.y;
						const r2 = dx * dx + dy * dy + 900;
						const r = Math.sqrt(r2);
						const acc = Math.min((cfg.G * 0.35) / r2, 3000);
						dvx += (dx / r) * acc * dt;
						dvy += (dy / r) * acc * dt;
					}
					// 鼠标搅动：切向扰动
					if (mouse.x !== null) {
						const dx = p.x - mouse.x, dy = p.y - mouse.y;
						const d2 = dx * dx + dy * dy;
						if (d2 < 14400) {
							const d = Math.sqrt(d2) + 1;
							const f = ((120 - d) / 120) * 260 * dt;
							dvx += (-dy / d) * f;
							dvy += (dx / d) * f;
						}
					}
					p.vx += dvx; p.vy += dvy;
					p.x += p.vx * dt; p.y += p.vy * dt;
					p.tw += dt * 3;
					const ox = p.x - hole.x, oy = p.y - hole.y;
					if (ox * ox + oy * oy > maxR * maxR) spawn(p, true);
				}
				for (let i = tempHoles.length - 1; i >= 0; i--) {
					tempHoles[i].ttl -= dt;
					if (tempHoles[i].ttl <= 0) tempHoles.splice(i, 1);
				}
			}

			function drawHole(x, y, R, theme, alpha) {
				const diskR = R * 3.2;
				const g = ctx.createRadialGradient(x, y, R * 0.8, x, y, diskR);
				g.addColorStop(0, "rgba(0,0,0,0)");
				g.addColorStop(0.45, `hsla(${theme}, 90%, 60%, ${0.2 * alpha})`);
				g.addColorStop(1, "rgba(0,0,0,0)");
				ctx.fillStyle = g;
				ctx.beginPath(); ctx.arc(x, y, diskR, 0, 7); ctx.fill();
				ctx.fillStyle = "#000";
				ctx.beginPath(); ctx.arc(x, y, R, 0, 7); ctx.fill();
				ctx.strokeStyle = `hsla(${theme}, 95%, 75%, ${0.85 * alpha})`;
				ctx.lineWidth = 1.6;
				ctx.beginPath(); ctx.arc(x, y, R * 1.45, 0, 7); ctx.stroke();
			}

			function render(now) {
				ctx.globalCompositeOperation = "source-over";
				ctx.fillStyle = `rgba(4,4,10,${cfg.trail})`;
				ctx.fillRect(0, 0, W, H);
				ctx.globalCompositeOperation = "lighter";
				for (const p of particles) {
					const sp = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
					const l = Math.max(45, Math.min(85, 50 + sp * 0.03));
					const tw = 0.75 + 0.25 * Math.sin(p.tw);
					ctx.fillStyle = `hsla(${cfg.theme + p.hueJ}, 90%, ${l}%, ${tw})`;
					ctx.fillRect(p.x, p.y, 1.7, 1.7);
				}
				// 冲击波圆环
				for (let i = waves.length - 1; i >= 0; i--) {
					const wv = waves[i];
					wv.r += 900 * (1 / 60);
					wv.a -= 0.03;
					if (wv.a <= 0) { waves.splice(i, 1); continue; }
					ctx.strokeStyle = `hsla(${cfg.theme}, 90%, 70%, ${wv.a})`;
					ctx.lineWidth = 3;
					ctx.beginPath(); ctx.arc(hole.x, hole.y, wv.r, 0, 7); ctx.stroke();
				}
				// 临时黑洞
				for (const th of tempHoles) {
					drawHole(th.x, th.y, 8, cfg.theme, Math.min(1, th.ttl / 2));
				}
				// 主黑洞 + 旋转光子环
				const diskR = HORIZON * 3.2;
				const g = ctx.createRadialGradient(hole.x, hole.y, HORIZON * 0.8, hole.x, hole.y, diskR);
				g.addColorStop(0, "rgba(0,0,0,0)");
				g.addColorStop(0.45, `hsla(${cfg.theme}, 90%, 60%, 0.22)`);
				g.addColorStop(1, "rgba(0,0,0,0)");
				ctx.fillStyle = g;
				ctx.beginPath(); ctx.arc(hole.x, hole.y, diskR, 0, 7); ctx.fill();
				ctx.save();
				ctx.translate(hole.x, hole.y);
				ctx.rotate(now * 0.0006);
				ctx.strokeStyle = `hsla(${cfg.theme}, 95%, 75%, 0.9)`;
				ctx.lineWidth = 1.6;
				ctx.setLineDash([6, 10]);
				ctx.beginPath(); ctx.arc(0, 0, HORIZON * 1.45, 0, 7); ctx.stroke();
				ctx.restore();
				ctx.setLineDash([]);
				ctx.fillStyle = "#000";
				ctx.beginPath(); ctx.arc(hole.x, hole.y, HORIZON, 0, 7); ctx.fill();
			}

			function frame(now) {
				const dt = Math.min(0.05, (now - last) / 1000);
				last = now;
				if (running) { step(dt); render(now); }
				fpsAcc += 1 / Math.max(dt, 1e-4); fpsN++;
				if (now - fpsT > 500) {
					fpsEl.textContent = Math.round(fpsAcc / Math.max(1, fpsN));
					eatenEl.textContent = eaten;
					fpsAcc = 0; fpsN = 0; fpsT = now;
				}
				requestAnimationFrame(frame);
			}

			function shockwave() {
				waves.push({ r: HORIZON, a: 0.9 });
				for (const p of particles) {
					const dx = p.x - hole.x, dy = p.y - hole.y;
					const r = Math.sqrt(dx * dx + dy * dy) + 1;
					const imp = Math.min(90000 / r, 1500);
					p.vx += (dx / r) * imp;
					p.vy += (dy / r) * imp;
				}
			}

			// 事件
			function canvasPos(e) {
				const r = canvas.getBoundingClientRect();
				return [e.clientX - r.left, e.clientY - r.top];
			}
			canvas.addEventListener("pointermove", (e) => {
				const [x, y] = canvasPos(e);
				mouse.x = x; mouse.y = y;
			});
			canvas.addEventListener("pointerleave", () => { mouse.x = null; mouse.y = null; });
			canvas.addEventListener("pointerdown", (e) => {
				const [x, y] = canvasPos(e);
				tempHoles.push({ x, y, ttl: 6 });
				if (tempHoles.length > 5) tempHoles.shift();
			});

			const gInput = document.getElementById("eh-g");
			const nInput = document.getElementById("eh-n");
			const tInput = document.getElementById("eh-t");
			gInput.addEventListener("input", () => {
				cfg.G = +gInput.value;
				document.getElementById("eh-g-val").textContent = gInput.value;
			});
			nInput.addEventListener("input", () => {
				cfg.count = +nInput.value;
				document.getElementById("eh-n-val").textContent = nInput.value;
				rebuild();
			});
			tInput.addEventListener("input", () => {
				cfg.trail = +tInput.value;
				document.getElementById("eh-t-val").textContent = (+tInput.value).toFixed(2);
			});

			const themeBtns = document.querySelectorAll(".eh-theme");
			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					cfg.theme = +btn.dataset.ehTheme;
					themeBtns.forEach((b) => {
						const on = b === btn;
						b.classList.toggle("bg-[var(--primary)]", on);
						b.classList.toggle("text-white", on);
					});
					ctx.fillStyle = "#04040a";
					ctx.fillRect(0, 0, W, H);
				});
			});

			document.getElementById("eh-shock").addEventListener("click", shockwave);
			const pauseBtn = document.getElementById("eh-pause");
			pauseBtn.addEventListener("click", () => {
				running = !running;
				pauseBtn.textContent = running ? "⏸ 暂停" : "▶ 继续";
				last = performance.now();
			});
			document.getElementById("eh-reset").addEventListener("click", () => {
				eaten = 0;
				rebuild();
			});

			let rszT;
			window.addEventListener("resize", () => {
				clearTimeout(rszT);
				rszT = setTimeout(resize, 150);
			});

			resize();
			rebuild();
			requestAnimationFrame(frame);
		})();
	</script>
</MainGridLayout>
