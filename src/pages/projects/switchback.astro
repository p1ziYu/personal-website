---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

interface Props {
	lang?: string;
}

const { lang = Astro.url.pathname.startsWith("/en") ? "en" : "zh_CN" } =
	Astro.props;
const isEn = lang === "en";

const title = isEn
	? "Switchback · The Flattest Path Laboratory"
	: "之字路 · 最平路线实验室";
const description = isEn
	? "Find the flattest route across hilly terrain by trading off distance vs elevation gain. Interactive Dijkstra pathfinding on procedural hillshade terrain with Pareto frontier analysis."
	: "在起伏山地中权衡距离与爬升，寻找最平坦路线。基于程序化地形与 Dijkstra 算法的之字路交互实验室，实时探索帕累托最优前沿。";
---

<MainGridLayout title={title} description={description} lang={lang}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-4 sm:px-8 py-6 relative w-full">
			<!-- 头部标题区 -->
			<div class="mb-6">
				<div class="flex items-center gap-2 mb-2">
					<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--primary)] text-white">Daily Lab</span>
					<span class="text-xs opacity-60 font-mono">Pareto Topography · 2026</span>
				</div>
				<h1 class="text-2xl sm:text-3xl font-bold mb-3 tracking-tight">
					<span class="lang-zh">之字路 · 最平路线实验室</span>
					<span class="lang-en">Switchback · The Flattest Path Lab</span>
				</h1>
				<p class="text-sm opacity-80 leading-relaxed mb-1.5">
					<span class="lang-zh">
						在山地城市出行中，纯几何最短的直线往往逼迫行人和骑手翻越陡峭的绝壁。现实中的登山步道与盘山公路，会利用「之字折返」（Switchbacks）沿等高线斜切，以多走平路的代价换取平缓的坡度。
					</span>
					<span class="lang-en">
						In hilly cities, the shortest straight-line route often forces walkers and cyclists up punishing slopes. Mountain roads and trail switchbacks make a deliberate trade-off: traveling farther horizontally to maintain a comfortable, manageable grade.
					</span>
				</p>
				<p class="text-sm opacity-70 leading-relaxed">
					<span class="lang-zh">
						本实验室在程序化山丘地貌上运行加权 Dijkstra 最短路算法。拖拽起点（A）与终点（B），调节爬升惩罚系数 λ，实时探索距离与爬升的帕累托最优前沿（Pareto Frontier）。
					</span>
					<span class="lang-en">
						This laboratory runs weighted Dijkstra pathfinding across procedural hillshade terrain. Drag Start (A) and Finish (B), adjust the climb penalty λ, and explore the Pareto frontier trading off distance against total elevation gain.
					</span>
				</p>
			</div>

			<!-- 控制预设条 -->
			<div class="flex flex-wrap items-center justify-between gap-3 p-3.5 mb-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
				<!-- 预设路线按钮 -->
				<div class="flex flex-wrap items-center gap-2">
					<span class="text-xs font-medium opacity-60 mr-1">
						<span class="lang-zh">寻路预设:</span>
						<span class="lang-en">Presets:</span>
					</span>
					<button
						id="preset-shortest"
						type="button"
						class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition"
					>
						<span class="lang-zh">🏃 最短直线 (λ = 0)</span>
						<span class="lang-en">🏃 Shortest (λ = 0)</span>
					</button>
					<button
						id="preset-balanced"
						type="button"
						class="preset-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[var(--primary)] text-white shadow-sm active:scale-95 transition"
					>
						<span class="lang-zh">⚖️ 舒适之字 (λ = 16)</span>
						<span class="lang-en">⚖️ Balanced (λ = 16)</span>
					</button>
					<button
						id="preset-flattest"
						type="button"
						class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition"
					>
						<span class="lang-zh">🚲 极致避坡 (λ = 200)</span>
						<span class="lang-en">🚲 Flattest (λ = 200)</span>
					</button>
				</div>

				<!-- 地形切换与起终点互换 -->
				<div class="flex items-center gap-2">
					<button
						id="btn-swap"
						type="button"
						class="px-3 py-1.5 rounded-xl text-xs font-medium border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition flex items-center gap-1.5"
						title="Swap Start and Finish"
					>
						<span>⇄</span>
						<span class="lang-zh">互换起终点</span>
						<span class="lang-en">Swap A ↔ B</span>
					</button>
					<button
						id="btn-reseed"
						type="button"
						class="px-3 py-1.5 rounded-xl text-xs font-semibold border border-[var(--primary)]/40 text-[var(--primary)] bg-[var(--primary)]/10 hover:bg-[var(--primary)]/20 active:scale-95 transition flex items-center gap-1.5"
					>
						<span>🎲</span>
						<span class="lang-zh">切换地形</span>
						<span class="lang-en">New Terrain</span>
						<span id="terrain-badge" class="font-mono text-[11px] opacity-75">(1/4)</span>
					</button>
				</div>
			</div>

			<!-- 爬升惩罚滑块控制面板 -->
			<div class="p-4 sm:p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 mb-5">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
					<div>
						<div class="flex items-center gap-2">
							<span class="text-xs font-bold uppercase tracking-wider opacity-60">
								<span class="lang-zh">爬升惩罚系数</span>
								<span class="lang-en">Climb Penalty Factor</span>
							</span>
							<span class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-[var(--primary)]/15 text-[var(--primary)] border border-[var(--primary)]/30">
								λ = <span id="lambda-value-text">16.0</span>
							</span>
						</div>
						<p id="lambda-desc-text" class="text-xs opacity-75 mt-1">
							<span class="lang-zh">每爬升 1 米相当于多走 16 米平路：沿等高线之字蜿蜒，主动避开险坡。</span>
							<span class="lang-en">1 meter of climb equals 16 meters extra walking: winding along contours to avoid sheer cliffs.</span>
						</p>
					</div>
					<div class="text-[11px] font-mono opacity-50 sm:text-right">
						<div>Cost = Distance + λ × ElevationGain</div>
						<div>Dijkstra · 8-connected grid</div>
					</div>
				</div>

				<!-- 滑块本体 -->
				<div class="relative pt-1 pb-1">
					<input
						type="range"
						id="lambda-slider"
						min="0"
						max="100"
						step="1"
						value="45"
						class="w-full h-2 bg-black/20 dark:bg-white/15 rounded-lg appearance-none cursor-pointer accent-[var(--primary)]"
					/>
					<div class="flex justify-between text-[11px] font-mono opacity-50 mt-1 px-1">
						<span>0 (<span class="lang-zh">不计坡度</span><span class="lang-en">Pure Distance</span>)</span>
						<span>1 (<span class="lang-zh">轻度避坡</span><span class="lang-en">Gentle</span>)</span>
						<span>16 (<span class="lang-zh">舒适骑行</span><span class="lang-en">Balanced</span>)</span>
						<span>60 (<span class="lang-zh">强力避坡</span><span class="lang-en">Strong</span>)</span>
						<span>200 (<span class="lang-zh">宁绕勿爬</span><span class="lang-en">Max Flat</span>)</span>
					</div>
				</div>
			</div>

			<!-- 关键指标实时看板 (4 指标) -->
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-5">
				<!-- 指标 1: 总路程 -->
				<div class="p-3.5 sm:p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 flex flex-col justify-between">
					<div class="text-xs font-semibold opacity-60">
						<span class="lang-zh">总路程</span>
						<span class="lang-en">Total Distance</span>
					</div>
					<div class="my-1.5 flex items-baseline gap-1.5">
						<span id="stat-dist" class="text-2xl sm:text-3xl font-extrabold font-mono text-[var(--primary)]">--</span>
						<span class="text-xs font-mono opacity-60">m</span>
					</div>
					<div id="stat-dist-diff" class="text-[11px] font-mono opacity-60 truncate">
						vs 最短: +0m (+0%)
					</div>
				</div>

				<!-- 指标 2: 累计爬升 -->
				<div class="p-3.5 sm:p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 flex flex-col justify-between">
					<div class="text-xs font-semibold opacity-60">
						<span class="lang-zh">累计爬升</span>
						<span class="lang-en">Elevation Gain</span>
					</div>
					<div class="my-1.5 flex items-baseline gap-1.5">
						<span id="stat-climb" class="text-2xl sm:text-3xl font-extrabold font-mono text-emerald-500">--</span>
						<span class="text-xs font-mono opacity-60">m</span>
					</div>
					<div id="stat-climb-diff" class="text-[11px] font-mono opacity-60 truncate">
						vs 最短: -0m (-0%)
					</div>
				</div>

				<!-- 指标 3: 最大坡度 -->
				<div class="p-3.5 sm:p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 flex flex-col justify-between">
					<div class="text-xs font-semibold opacity-60">
						<span class="lang-zh">最大坡度</span>
						<span class="lang-en">Max Grade</span>
					</div>
					<div class="my-1.5 flex items-baseline gap-1.5">
						<span id="stat-grade" class="text-2xl sm:text-3xl font-extrabold font-mono text-amber-500">--</span>
						<span class="text-xs font-mono opacity-60">%</span>
					</div>
					<div id="stat-grade-desc" class="text-[11px] opacity-60 truncate">
						<span class="lang-zh">缓和路段</span>
						<span class="lang-en">Gentle slope</span>
					</div>
				</div>

				<!-- 指标 4: 之字拐点数 -->
				<div class="p-3.5 sm:p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 flex flex-col justify-between">
					<div class="text-xs font-semibold opacity-60">
						<span class="lang-zh">之字折返次数</span>
						<span class="lang-en">Switchback Turns</span>
					</div>
					<div class="my-1.5 flex items-baseline gap-1.5">
						<span id="stat-turns" class="text-2xl sm:text-3xl font-extrabold font-mono text-teal-500">0</span>
						<span class="text-xs font-mono opacity-60">
							<span class="lang-zh">次折返</span>
							<span class="lang-en">turns</span>
						</span>
					</div>
					<div class="text-[11px] opacity-60 truncate">
						<span class="lang-zh">沿坡面蜿蜒盘旋</span>
						<span class="lang-en">Contour winding</span>
					</div>
				</div>
			</div>

			<!-- 主地图画布与右侧前沿图布局 -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-5 mb-5">
				<!-- 地形阴影地图 (占 8 列) -->
				<div class="lg:col-span-8 flex flex-col">
					<div class="relative rounded-2xl overflow-hidden bg-[#0c131a] border border-black/15 dark:border-white/15 shadow-xl">
						<canvas
							id="map-canvas"
							class="block w-full touch-none select-none cursor-crosshair"
							style="aspect-ratio: 16/10; min-height: 340px; max-height: 520px;"
						></canvas>

						<!-- 地图操作提示浮层 -->
						<div class="absolute top-3 left-3 flex flex-wrap items-center gap-2 pointer-events-none">
							<span class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-black/70 text-emerald-300 border border-emerald-500/30 backdrop-blur-md">
								🟢 <span class="lang-zh">起点 A (可拖拽)</span><span class="lang-en">Start A (Draggable)</span>
							</span>
							<span class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-black/70 text-rose-300 border border-rose-500/30 backdrop-blur-md">
								🔴 <span class="lang-zh">终点 B (可拖拽)</span><span class="lang-en">Finish B (Draggable)</span>
							</span>
						</div>

						<!-- 坡度色阶图例 -->
						<div class="absolute bottom-3 right-3 flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-black/80 text-white/80 border border-white/10 backdrop-blur-md text-[10px] font-mono pointer-events-none">
							<span class="opacity-60 mr-1"><span class="lang-zh">坡度:</span><span class="lang-en">Slope:</span></span>
							<span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500"></span> 0-4%
							<span class="inline-block w-2.5 h-2.5 rounded-full bg-lime-500 ml-1"></span> 4-8%
							<span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500 ml-1"></span> 8-12%
							<span class="inline-block w-2.5 h-2.5 rounded-full bg-rose-500 ml-1"></span> &gt;12%
						</div>

						<!-- 地形名称标签 -->
						<div id="terrain-name-tag" class="absolute bottom-3 left-3 text-[11px] font-mono px-2.5 py-1 rounded-lg bg-black/75 text-white/70 border border-white/10 backdrop-blur-md pointer-events-none">
							双峰山口与中央马鞍谷 · 3.2km × 2.4km
						</div>
					</div>
				</div>

				<!-- 帕累托前沿图卡片 (占 4 列) -->
				<div class="lg:col-span-4 flex flex-col justify-between p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
					<div>
						<div class="flex items-center justify-between mb-2">
							<div class="font-bold text-xs uppercase tracking-wider opacity-80 flex items-center gap-1.5">
								<span>🎯</span>
								<span class="lang-zh">帕累托最优前沿</span>
								<span class="lang-en">Pareto Frontier</span>
							</div>
							<span class="text-[10px] font-mono opacity-50">Distance vs Climb</span>
						</div>
						<p class="text-[11px] opacity-70 leading-relaxed mb-3">
							<span class="lang-zh">
								每一个散点都代表一条在距离与爬升综合考量下无可超越的最优路线。点击图中散点可直接切换至对应方案。
							</span>
							<span class="lang-en">
								Every dot is a route nothing else beats on both counts. Click any dot on the frontier curve to inspect its route.
							</span>
						</p>

						<!-- 帕累托图画布 -->
						<div class="relative rounded-xl overflow-hidden bg-[#0c131a] border border-black/15 dark:border-white/15 p-1 mb-2">
							<canvas
								id="pareto-canvas"
								class="block w-full cursor-pointer touch-none select-none"
								style="height: 220px;"
							></canvas>
						</div>
					</div>

					<div class="text-[11px] font-mono opacity-60 p-2.5 rounded-xl bg-black/10 dark:bg-white/5 border border-black/5 dark:border-white/5 space-y-1">
						<div class="flex justify-between">
							<span><span class="lang-zh">当前方案:</span><span class="lang-en">Current:</span></span>
							<span id="pareto-current-info" class="font-bold text-[var(--primary)]">λ = 16.0</span>
						</div>
						<div class="flex justify-between text-[10px]">
							<span class="opacity-70"><span class="lang-zh">前沿有效采样:</span><span class="lang-en">Sampled routes:</span></span>
							<span id="pareto-points-count" class="opacity-70">12 组路线</span>
						</div>
					</div>
				</div>
			</div>

			<!-- 地形剖面高度图 (Profile Chart) -->
			<div class="p-4 sm:p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 mb-8">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
					<div>
						<h3 class="text-sm font-bold flex items-center gap-2">
							<span>📈</span>
							<span class="lang-zh">路线地形剖面图 (Elevation Profile)</span>
							<span class="lang-en">Route Elevation Profile</span>
						</h3>
						<p class="text-xs opacity-60 mt-0.5">
							<span class="lang-zh">在剖面图上滑动悬停，可在上方地图中同步查看对应的实时地形位置与瞬时坡度。</span>
							<span class="lang-en">Hover across the profile to trace the elevation curve and inspect the matching spot on the map.</span>
						</p>
					</div>

					<!-- 剖面实时悬停读数 -->
					<div id="profile-hover-data" class="text-xs font-mono px-3 py-1.5 rounded-xl bg-black/10 dark:bg-white/10 border border-black/10 dark:border-white/10 flex items-center gap-3">
						<span class="opacity-60"><span class="lang-zh">悬停检视:</span><span class="lang-en">Hover:</span></span>
						<span id="hover-dist" class="font-bold">-- m</span>
						<span id="hover-elev" class="text-emerald-500 font-bold">▲ -- m</span>
						<span id="hover-grade" class="text-amber-500 font-bold">--%</span>
					</div>
				</div>

				<div class="relative rounded-xl overflow-hidden bg-[#0c131a] border border-black/15 dark:border-white/15 p-1">
					<canvas
						id="profile-canvas"
						class="block w-full touch-none select-none cursor-crosshair"
						style="height: 140px;"
					></canvas>
				</div>
			</div>

			<!-- 深度科普卡片区 (三类路线设计境界) -->
			<div class="mb-8">
				<h2 class="text-lg font-bold mb-4 flex items-center gap-2">
					<span>🏔️</span>
					<span class="lang-zh">山路寻径的智慧：三种典型的路线哲学</span>
					<span class="lang-en">Three Topographic Philosophies: Distance vs Effort</span>
				</h2>
				<div class="grid sm:grid-cols-3 gap-4">
					<!-- 卡片 1: 几何最短 -->
					<div class="p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 flex flex-col justify-between">
						<div>
							<div class="text-2xl mb-2">🏃</div>
							<div class="font-bold text-sm mb-1 text-rose-500">
								<span class="lang-zh">几何最短 (Shortest: λ = 0)</span>
								<span class="lang-en">Direct Euclidean (λ = 0)</span>
							</div>
							<p class="text-xs font-medium opacity-90 leading-relaxed mb-2">
								<span class="lang-zh">纯直线翻山越岭，遭遇令人窒息的断崖陡坡。</span>
								<span class="lang-en">Straight-line ascent: blindly scales steep peaks, tackling punishing inclines.</span>
							</p>
						</div>
						<p class="text-[11px] opacity-60 leading-normal">
							<span class="lang-zh">算法完全不顾坡度代价，哪怕是 25% 的绝壁也照直冲上去。距离虽短，但行人和骑手的体力消耗成倍激增，在真实世界中难以通行。</span>
							<span class="lang-en">Ignores topography entirely. While horizontal distance is minimized, climbing energy scales brutally, rendering it impractical for everyday commuters.</span>
						</p>
					</div>

					<!-- 卡片 2: 之字折返 -->
					<div class="p-4 rounded-2xl bg-[var(--primary)]/10 border border-[var(--primary)]/30 flex flex-col justify-between">
						<div>
							<div class="text-2xl mb-2">⚖️</div>
							<div class="font-bold text-sm mb-1 text-[var(--primary)]">
								<span class="lang-zh">之字折返 (Switchback: Balanced)</span>
								<span class="lang-en">Balanced Switchback</span>
							</div>
							<p class="text-xs font-medium opacity-90 leading-relaxed mb-2">
								<span class="lang-zh">沿山脊等高线蜿蜒，以适量距离代价换取舒适平缓的坡度。</span>
								<span class="lang-en">Traversing contour lines: trading modest distance for gentle, sustainable grades.</span>
							</p>
						</div>
						<p class="text-[11px] opacity-70 leading-normal">
							<span class="lang-zh">土木工程与登山步道的黄金标准。通过「之字形」盘旋或寻找山坳垭口，将陡坡拆解为舒适的 4%~7% 缓坡，总耗能处于帕累托最优平衡点。</span>
							<span class="lang-en">The gold standard of mountain engineering. Winding back and forth keeps heart rates steady and pedal cadence smooth, hitting the true Pareto sweet spot.</span>
						</p>
					</div>

					<!-- 卡片 3: 极致避坡 -->
					<div class="p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 flex flex-col justify-between">
						<div>
							<div class="text-2xl mb-2">🚲</div>
							<div class="font-bold text-sm mb-1 text-emerald-500">
								<span class="lang-zh">极致避坡 (Flattest: λ = 200)</span>
								<span class="lang-en">Flattest Detour (λ = 200)</span>
							</div>
							<p class="text-xs font-medium opacity-90 leading-relaxed mb-2">
								<span class="lang-zh">宁愿绕远多走几倍平路，也绝不向上多爬升 1 米。</span>
								<span class="lang-en">Zero-climb priority: detouring around valleys to eliminate vertical ascent.</span>
