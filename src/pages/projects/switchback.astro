				document.documentElement.getAttribute("data-lang") === "en";

			// 网格系统规格 (64 x 48 = 3072 节点, 单元步长 50m)
			const GRID_W = 64;
			const GRID_H = 48;
			const CELL_SIZE_M = 50.0;
			const DIAG_SIZE_M = 50.0 * Math.SQRT2;

			// 精心编排的 4 组经典地貌预设
			const TERRAINS: TerrainPreset[] = [
				{
					nameZh: "双峰山口与中央马鞍谷 · 3.2km × 2.4km",
