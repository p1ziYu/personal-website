<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>贪吃蛇</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  body { background:#0b1020; color:#e8ecf8; font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif; min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:16px; overflow:hidden; }
  h1 { font-size:28px; margin-bottom:4px; letter-spacing:4px; }
  .sub { color:#8b93b0; font-size:13px; margin-bottom:12px; }
  .scorebar { display:flex; gap:24px; margin-bottom:12px; font-size:16px; }
  .scorebar b { color:#7CFF6B; font-size:20px; }
  .wrap { position:relative; }
  canvas { background:#11162e; border:2px solid #2a3358; border-radius:12px; touch-action:none; display:block; }
  .overlay { position:absolute; inset:0; background:rgba(8,11,26,.85); border-radius:12px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; }
  .overlay.hidden { display:none; }
  .overlay h2 { font-size:30px; }
  .overlay p { color:#8b93b0; }
  .btn { background:#4f7cff; color:#fff; border:none; border-radius:10px; padding:12px 36px; font-size:17px; cursor:pointer; }
  .btn:active { transform:scale(.96); }
  .controls { display:flex; gap:10px; margin-top:14px; align-items:center; }
  .dpad { display:grid; grid-template-columns:repeat(3,52px); grid-template-rows:repeat(3,52px); gap:4px; }
  .dpad button { background:#1c2342; color:#e8ecf8; border:1px solid #2a3358; border-radius:10px; font-size:20px; cursor:pointer; }
  .dpad button:active { background:#2a3358; }
  .dpad .empty { visibility:hidden; }
  .sidebtns { display:flex; flex-direction:column; gap:10px; }
  .sidebtns button { background:#1c2342; color:#e8ecf8; border:1px solid #2a3358; border-radius:10px; padding:14px 18px; font-size:15px; cursor:pointer; }
  .hint { margin-top:10px; color:#5a6285; font-size:12px; text-align:center; line-height:1.8; }
</style>
</head>
<body>
  <h1>贪吃蛇</h1>
  <div class="sub">经典重制 · 越吃越快</div>
  <div class="scorebar"><span>分数 <b id="score">0</b></span><span>最高 <b id="best">0</b></span></div>
  <div class="wrap">
    <canvas id="cv" width="400" height="400"></canvas>
    <div class="overlay" id="ov">
      <h2 id="ovTitle">贪吃蛇</h2>
      <p id="ovMsg">点击开始，吃掉所有食物！</p>
      <button class="btn" id="startBtn">开始游戏</button>
    </div>
  </div>
  <div class="controls">
    <div class="dpad">
      <span class="empty"></span><button data-d="up">▲</button><span class="empty"></span>
      <button data-d="left">◀</button><button data-d="down">▼</button><button data-d="right">▶</button>
      <span class="empty"></span><button data-d="down2" style="visibility:hidden"></button><span class="empty"></span>
    </div>
    <div class="sidebtns">
      <button id="pauseBtn">⏸ 暂停</button>
      <button id="restartBtn">↻ 重开</button>
    </div>
  </div>
  <div class="hint">桌面：方向键 / WASD 移动，空格暂停<br>手机：滑动屏幕或点方向键</div>
<script>
(function(){
  var cv=document.getElementById('cv'), ctx=cv.getContext('2d');
  var N=20, CELL=400/N;
  var snake, dir, nextDir, food, score, best=+(localStorage.getItem('snake-best')||0);
  var timer=null, speed=140, running=false, paused=false;
  document.getElementById('best').textContent=best;

  function place(){ snake=[{x:9,y:10},{x:8,y:10},{x:7,y:10}]; dir={x:1,y:0}; nextDir=dir; score=0; speed=140; spawnFood(); updateScore(); }
  function spawnFood(){ while(true){ var f={x:(Math.random()*N)|0, y:(Math.random()*N)|0}; var ok=true;
    for(var i=0;i<snake.length;i++) if(snake[i].x===f.x&&snake[i].y===f.y){ok=false;break;}
    if(ok){food=f;return;} } }
  function updateScore(){ document.getElementById('score').textContent=score;
    if(score>best){best=score;localStorage.setItem('snake-best',best);document.getElementById('best').textContent=best;} }
  function step(){
    dir=nextDir;
    var h={x:snake[0].x+dir.x, y:snake[0].y+dir.y};
    if(h.x<0||h.y<0||h.x>=N||h.y>=N){ return gameOver(); }
    for(var i=0;i<snake.length;i++) if(snake[i].x===h.x&&snake[i].y===h.y){ return gameOver(); }
    snake.unshift(h);
    if(h.x===food.x&&h.y===food.y){ score+=10; updateScore(); speed=Math.max(60,140-score*0.8); spawnFood(); restartTimer(); }
    else snake.pop();
    draw();
  }
  function draw(){
    ctx.fillStyle='#11162e'; ctx.fillRect(0,0,400,400);
    ctx.strokeStyle='#1a2140'; ctx.lineWidth=1;
    for(var i=1;i<N;i++){ ctx.beginPath();ctx.moveTo(i*CELL,0);ctx.lineTo(i*CELL,400);ctx.stroke(); ctx.beginPath();ctx.moveTo(0,i*CELL);ctx.lineTo(400,i*CELL);ctx.stroke(); }
    ctx.fillStyle='#ff5d5d'; ctx.beginPath(); ctx.arc(food.x*CELL+CELL/2, food.y*CELL+CELL/2, CELL*0.38, 0, 7); ctx.fill();
    for(var j=0;j<snake.length;j++){ var s=snake[j];
      ctx.fillStyle=j===0?'#7CFF6B':'#3ecf4e';
      var p=2; ctx.fillRect(s.x*CELL+p, s.y*CELL+p, CELL-p*2, CELL-p*2); }
  }
  function restartTimer(){ if(timer)clearInterval(timer); timer=setInterval(function(){ if(!paused) step(); },speed); }
  function start(){ place(); running=true; paused=false;
    document.getElementById('ov').classList.add('hidden');
    document.getElementById('pauseBtn').textContent='⏸ 暂停'; draw(); restartTimer(); }
  function gameOver(){ running=false; clearInterval(timer);
    document.getElementById('ovTitle').textContent='游戏结束';
    document.getElementById('ovMsg').textContent='本局得分 '+score+' 分，再来一局？';
    document.getElementById('ov').classList.remove('hidden'); }
  function togglePause(){ if(!running)return; paused=!paused;
    document.getElementById('pauseBtn').textContent=paused?'▶ 继续':'⏸ 暂停'; }
  function setDir(x,y){ if(!running||paused)return;
    if(x===-dir.x&&y===-dir.y)return; nextDir={x:x,y:y}; }

  document.getElementById('startBtn').onclick=start;
  document.getElementById('restartBtn').onclick=start;
  document.getElementById('pauseBtn').onclick=togglePause;
  document.querySelectorAll('.dpad button[data-d]').forEach(function(b){ b.onclick=function(){
    var d=b.getAttribute('data-d');
    if(d==='up')setDir(0,-1); else if(d==='down'||d==='down2')setDir(0,1);
    else if(d==='left')setDir(-1,0); else if(d==='right')setDir(1,0); }; });
  document.addEventListener('keydown',function(e){
    if(e.key==='ArrowUp'||e.key==='w'||e.key==='W')setDir(0,-1);
    else if(e.key==='ArrowDown'||e.key==='s'||e.key==='S')setDir(0,1);
    else if(e.key==='ArrowLeft'||e.key==='a'||e.key==='A')setDir(-1,0);
    else if(e.key==='ArrowRight'||e.key==='d'||e.key==='D')setDir(1,0);
    else if(e.key===' '){ e.preventDefault(); togglePause(); }
    if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].indexOf(e.key)>=0)e.preventDefault(); });
  var tx=0,ty=0;
  cv.addEventListener('touchstart',function(e){ var t=e.changedTouches[0]; tx=t.clientX; ty=t.clientY; },{passive:true});
  cv.addEventListener('touchend',function(e){ var t=e.changedTouches[0]; var dx=t.clientX-tx, dy=t.clientY-ty;
    if(Math.abs(dx)<24&&Math.abs(dy)<24)return;
    if(Math.abs(dx)>Math.abs(dy))setDir(dx>0?1:-1,0); else setDir(0,dy>0?1:-1); e.preventDefault(); },{passive:false});

  place(); draw();
})();
</script>
</body>
</html>
