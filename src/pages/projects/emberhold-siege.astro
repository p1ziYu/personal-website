;color:#a4b09a;padding:0;background:none}.overlay,.pause-overlay{position:absolute;inset:0;background:#101c1ae8;display:flex;align-items:center;justify-content:center;text-align:center;backdrop-filter:blur(3px)}.intro-card{width:min(390px,85%);padding:16px 0}.overline{font-size:10px;letter-spacing:5px;color:#b4a681}.intro-symbol{font-size:56px;color:#dfb370;line-height:1.3;margin:10px}.intro-card h2{font-family:serif;font-size:40px;line-height:1.35;font-weight:500;letter-spacing:5px;margin:0 0 15px}.intro-card h2 span{color:#dfb980}.intro-card>p{font-size:12px;color:#9dab98;line-height:1.9}.instructions{display:grid;gap:9px;text-align:left;max-width:265px;margin:22px auto;color:#bec5af;font-size:11px}.instructions b{color:#ba9c68;font-size:10px;letter-spacing:1px;margin-right:15px}.intro-card .primary{max-width:270px;margin:20px auto 0}.intro-card .intro-foot{font-size:9px;letter-spacing:1px;margin-bottom:0;color:#708570}.pause-overlay{background:#101c1adc}.pause-overlay span{font-size:35px;color:#dbb67e}.pause-overlay h2{font-family:serif;letter-spacing:5px;font-weight:400;font-size:30px}.pause-overlay p{color:#9dac99;font-size:12px}.pause-overlay .primary{margin-top:25px}.result-stats{padding:14px;border:1px solid #bdad762d;color:#d5c39a;line-height:2}.manual{border:1px solid #84977920;border-radius:6px;color:#879c83;font-size:11px;padding:14px;margin-top:8px}.manual summary{cursor:pointer}.manual-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:28px;line-height:1.9}.manual h3{color:#c5c5ab;font-weight:500}.manual p{margin-bottom:0}dialog{background:#1b2a25;border:1px solid #8d977357;border-radius:10px;color:#dcd8c4;padding:28px;max-width:calc(100% - 32px)}dialog::backdrop{background:#08120de0}dialog h2{font-family:serif;font-weight:400}dialog p{color:#a3af98;font-size:12px}dialog>div{display:flex;gap:12px;margin-top:25px}dialog button{padding:0 16px}dialog .primary{width:auto}
	@media(min-width:1400px){#emberhold{padding-top:15px}.masthead{height:120px}.command-bar{padding:26px 0}}
	@media(max-width:1100px){.score-resource{display:none}}
	@media(max-width:1000px){#emberhold{padding:0 18px 20px}.game-layout{grid-template-columns:minmax(0,1fr) 250px;gap:12px}.panel{padding:14px}.command-bar{gap:23px}.intro-card h2{font-size:30px}.intro-symbol{font-size:36px;margin:3px}.instructions{margin:14px auto}.intro-card .primary{margin-top:14px}.edition-number{display:none}.map-heading b{display:none}.wordmark h1{font-size:24px}}
	@media(max-width:760px){.game-layout{grid-template-columns:1fr}.sidebar{display:grid;grid-template-columns:1fr 1fr;align-items:start}.field-note{grid-column:1/-1}.masthead{height:88px}.edition{display:none}.wordmark{margin-left:auto}.wordmark h1{font-size:23px}.wordmark p{font-size:9px;letter-spacing:3px}.sigil{font-size:38px}.command-bar{gap:14px;flex-wrap:wrap;padding:17px 0}.resource{min-width:0;flex:1;gap:8px}.score-resource{display:flex}.score-resource .resource-icon{display:none}.resource strong{font-size:23px}.resource-icon{font-size:23px}.toolbar{width:100%;margin:0;justify-content:flex-end}.toolbar button{flex:1}.map-heading{padding:12px 14px}.map-heading b{display:inline}.bottom{align-items:flex-start;gap:10px;flex-wrap:wrap}.bottom>div{gap:15px}.manual-grid{grid-template-columns:1fr;gap:5px}.intro-card h2{font-size:35px}.intro-symbol{font-size:42px;margin:8px}.instructions{margin:18px auto}.intro-card .primary{margin-top:18px}}
