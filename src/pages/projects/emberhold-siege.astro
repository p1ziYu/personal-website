	@media(min-width:1000px) and (max-height:760px){#emberhold{max-width:1080px;padding:0 24px 12px}.masthead{height:70px}.command-bar{padding:12px 0;gap:20px}.resource{min-width:90px}.resource strong{font-size:21px}.resource-icon{font-size:25px}.game-layout{grid-template-columns:minmax(0,1fr) 260px;gap:14px}.map-heading{padding:10px 14px}.map-footer{padding:9px 14px}.panel{padding:13px}.wave-panel h2{margin:9px 0 5px;font-size:21px}.composition{margin:10px 0}.wave-meta{margin:7px 0 10px}.tower-palette{margin-top:12px}.tower-palette :global(button){min-height:66px;padding:5px 0}.tower-palette :global(.tower-icon){font-size:21px;margin-bottom:3px}.selection-panel{margin-top:12px;padding-top:12px}.selection-panel p{margin:7px 0;font-size:10px;min-height:34px}.tower-stats{margin-bottom:10px}.field-note{display:none}.sidebar{gap:10px}.dispatch{min-height:37px;padding:8px 0}.bottom{padding:10px 0}.manual{margin-top:0}.score-resource{display:flex}.score-resource .resource-icon{display:none}.wordmark h1{font-size:24px}.wordmark p{font-size:9px}.sigil{font-size:39px}.intro-symbol{font-size:38px;margin:6px}.intro-card h2{font-size:32px}.instructions{margin:16px auto}.intro-card .primary{margin-top:14px}}
	@media(prefers-reduced-motion:reduce){:global(*){transition:none!important;scroll-behavior:auto!important}}
</style>
