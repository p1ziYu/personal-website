---
const isEn = Astro.props.lang === "en" || Astro.url.pathname.startsWith("/en");
const title = isEn
	? "Emberhold Siege · Hold the Last Flame"
	: "余烬防线 · 守住最后一束火光";
---
<!doctype html>
<html lang={isEn ? "en" : "zh-CN"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={isEn ? "Emberhold Siege: Three converging paths, five defensive towers, fifteen waves. Defend the embers in your browser." : "余烬防线：三路围城、五种防御塔、十五波攻势。无需下载，在浏览器里守护最后的余烬。"} />
		<meta name="theme-color" content="#111b1a" />
		<title>{title}</title>
	</head>
	<body>
		<main id="emberhold">
			<header class="masthead">
				<a class="back" href={isEn ? "/en/projects/" : "/projects/"} aria-label={isEn ? "Return to Projects" : "返回项目列表"}>← <span>{isEn ? "Back to Projects" : "返回项目"}</span></a>
				<div class="wordmark"><span class="sigil">✧</span><div><h1>{isEn ? "Emberhold" : "余烬防线"}</h1><p>{isEn ? "Hold the Last Flame" : "守住最后一束火光"}</p></div></div>
				<div class="edition"><span class="live-dot"></span> {isEn ? "Tactical Tower Defense" : "独立战术塔防"} <span class="edition-number">{isEn ? "／ No. 01" : "／ 第零一号"}</span></div>
			</header>
			<section class="command-bar" aria-label={isEn ? "Command Bar" : "战局状态"}>
				<div class="resource"><span class="resource-icon gold">◇</span><div><small>{isEn ? "Available Gold" : "可用金币"}</small><strong id="gold">300</strong></div></div>
				<div class="resource"><span class="resource-icon heart">♡</span><div><small>{isEn ? "Core Health" : "核心耐久"}</small><strong><span id="lives">20</span><em> / 20</em></strong></div></div>
				<div class="resource"><span class="resource-icon wave">≋</span><div><small>{isEn ? "Current Wave" : "当前波次"}</small><strong><span id="wave">00</span><em> / 15</em></strong></div></div>
				<div class="resource score-resource"><span class="resource-icon gold">✧</span><div><small>{isEn ? "Watch Score" : "守望得分"}</small><strong id="score">0</strong></div></div>
				<div class="toolbar">
					<button id="pause" aria-label={isEn ? "Pause game" : "暂停游戏"}>Ⅱ <span>{isEn ? "Pause" : "暂停"}</span></button>
					<button id="speed" aria-label={isEn ? "Toggle speed" : "切换游戏速度"}>1×</button>
					<button id="mute" aria-label={isEn ? "Toggle mute" : "切换静音"} aria-pressed="false">♪ <span>{isEn ? "Sound On" : "音效开"}</span></button>
					<button id="restart" aria-label={isEn ? "Restart game" : "重新开始游戏"}>↻</button>
				</div>
			</section>
			<div class="game-layout">
				<section class="battlefield" aria-label={isEn ? "Battlefield" : "战场"}>
					<div class="map-heading"><span><i></i> {isEn ? "Ashen Frontier" : "灰烬边境"} <b>{isEn ? "／ Three-Way Pass" : "／ 三岔隘口"}</b></span><span id="phase-label">{isEn ? "Awaiting Orders" : "等待指挥"}</span></div>
					<div class="canvas-wrap">
						<canvas id="battle-canvas" width="768" height="576" tabindex="0" aria-label={isEn ? "16x12 grid battlefield. Arrow keys move cursor, Enter confirms; right panel selects tower type." : "16 列 12 行战场。方向键移动地块，回车选择；右侧选择塔型并建造。"}>{isEn ? "Your browser must support HTML5 Canvas to run this game." : "浏览器需要支持画布才能运行游戏。"}</canvas>
						<div id="overlay" class="overlay">
							<div class="intro-card">
								<div class="overline">{isEn ? "Three Paths Besieged · One Ray of Hope" : "三路围城 · 一线生机"}</div>
								<div class="intro-symbol">✧</div>
								<h2 id="overlay-title">{isEn ? <Fragment>The Long Night Approaches<br /><span>The Embers Endure.</span></Fragment> : <Fragment>长夜将至<br /><span>余烬不灭。</span></Fragment>}</h2>
								<p id="overlay-description">{isEn ? <Fragment>The horde closes through the mist. Rally your defense<br />and keep the sanctuary's last flame burning.</Fragment> : <Fragment>敌军正从雾中逼近。筑起防线，<br />让这座要塞的最后一束火光继续燃烧。</Fragment>}</p>
								<div id="instructions" class="instructions">{isEn ? <Fragment><span><b>01</b> Tap grass plots to deploy towers</span><span><b>02</b> Upgrade firepower to hold 3 paths</span><span><b>03</b> Survive 15 waves to protect the core</span></Fragment> : <Fragment><span><b>01</b> 点击草地，部署防御塔</span><span><b>02</b> 升级火力，守住三条道路</span><span><b>03</b> 撑过十五波，守住余烬核心</span></Fragment>}</div>
								<div id="result-stats" class="result-stats" hidden></div>
								<button id="begin" class="primary">{isEn ? "Ignite the Beacon" : "点燃烽火"} <span>→</span></button>
								<p class="intro-foot" id="overlay-foot">{isEn ? "Initial 300 Gold · 20 Core Health · Zero Downloads" : "初始 300 金币 · 20 点耐久 · 无需联网"}</p>
							</div>
						</div>
						<div id="pause-overlay" class="pause-overlay" hidden><div><span>Ⅱ</span><h2>{isEn ? "A Lull in the Battle" : "烽火暂歇"}</h2><p>{isEn ? "Battle is paused. Resume when ready." : "战局已暂停，准备好后继续。"}</p><button id="resume" class="primary">{isEn ? "Resume Defense →" : "继续防守 →"}</button></div></div>
					</div>
					<div class="map-footer"><span><i class="legend-road"></i> {isEn ? "Enemy Route" : "敌军路线"} <i class="legend-build"></i> {isEn ? "Buildable Plot" : "可建造地块"} <i class="legend-core"></i> {isEn ? "Ember Core" : "余烬核心"}</span><span>16 × 12</span></div>
				</section>
				<aside class="sidebar">
					<section class="panel wave-panel">
						<div class="section-label"><span>{isEn ? "Wave Intel" : "攻势情报"}</span><span id="next-index">01 / 15</span></div>
						<h2 id="wave-name">{isEn ? "Mist Walkers" : "雾中来客"}</h2><p class="muted" id="modifier">{isEn ? "Hold the three invasion routes" : "守住三条进攻路线"}</p>
						<div id="composition" class="composition"></div>
						<div class="wave-progress"><div id="wave-progress-fill"></div></div>
						<div class="wave-meta"><span id="wave-status">{isEn ? "Deploy your first defensive line" : "部署你的第一道防线"}</span><span id="wave-bonus">{isEn ? "Bonus +40" : "奖励 +40"}</span></div>
						<button id="send-wave" class="primary" disabled>{isEn ? "Start Next Wave" : "开始下一波"} <span>→</span></button>
					</section>
					<section class="panel arsenal">
						<div class="section-label"><span>{isEn ? "Arsenal" : "防御工事"}</span><span>{isEn ? "5 Tactics · 3 Tiers" : "五种战术 · 三级进阶"}</span></div>
						<div id="tower-palette" class="tower-palette"></div>
						<div class="selection-panel" id="selection-panel">
							<div class="selection-title"><strong id="selection-name">{isEn ? "Arrow Tower" : "箭塔"}</strong><span id="selection-level">{isEn ? "Rapid · Single Target" : "快速 · 单体"}</span></div>
							<p id="tower-description">{isEn ? "Rapid volleys, prioritizing enemies closest to the core." : "迅捷连射，优先攻击最接近核心的敌人。"}</p>
							<div class="tower-stats" id="tower-stats"></div>
							<button id="build-tower" class="build-button" disabled>{isEn ? "Click map to select build spot" : "点击地图选择建造位置"}</button>
							<div id="tower-actions" class="tower-actions" hidden><button id="upgrade" class="build-button">{isEn ? "Upgrade" : "升级"}</button><button id="sell" class="sell-button">{isEn ? "Sell" : "出售"}</button></div>
						</div>
					</section>
					<div class="field-note"><span>✦ {isEn ? "Commander's Field Note" : "指挥官手记"}</span><p id="tip">{isEn ? "Deploy Cannons and Frost Spires at intersections to halt dense swarms." : "交汇处部署炮塔与寒冰塔，让密集敌军寸步难行。"}</p></div>
				</aside>
			</div>
			<div class="dispatch"><span class="dispatch-label">{isEn ? "Field Dispatch" : "战场通讯"}</span><p id="notice" role="status" aria-live="polite">{isEn ? "Tap open ground to build your first defensive tower." : "点击空地，建立你的第一座防御塔。"}</p><span class="kills">{isEn ? "Kills " : "击破 "}<b id="kills">0</b></span></div>
			<footer class="bottom"><span>{isEn ? "Even a dying ember can pierce the longest night." : "一簇余烬，也能照亮长夜。"}</span><div><span>{isEn ? "Best Score " : "最佳得分 "}<b id="best-score">0</b></span><span>{isEn ? "Best Wave " : "最佳防守 "}<b id="best-wave">0</b> {isEn ? "waves" : "波"}</span><button id="help">{isEn ? "Field Manual" : "作战指南"}</button></div></footer>
			<details class="manual" id="manual"><summary>{isEn ? "Field Manual & Bestiary" : "作战指南与敌军图鉴"}</summary><div class="manual-grid">{isEn ? <Fragment><section><h3>Construction & Tactics</h3><p>Click grass plots, pick a tower type, and confirm construction; click placed towers to upgrade or sell. Selling refunds 70% of total invested gold. Preparation phase countdowns can be skipped. Gold mines produce income only during battle waves.</p><p>Arrow keys move cursor, Enter confirms, Space pauses, keys 1-5 select towers, Esc cancels. On mobile, tap ground then confirm construction in the arsenal panel.</p></section><section><h3>Know Thy Enemy</h3><p>Sprinter Beasts run fast; Armored Juggernauts boast massive health; Blight Crawlers attack in dense swarms; Pyre Clerics periodically heal nearby units. Flame Sentinels have durable shields—Snipers deal bonus shield damage.</p><p>Ember Lords arrive on waves 5, 10, and 15. Leaking a boss costs 5 health, normal enemies cost 1. Northern pass opens on wave 3.</p></section><section><h3>Watcher's Honor</h3><p>Final Score = Waves Defended × 1000 + Kills × 10 + Remaining Health × 50. High scores and records saved locally.</p><p id="achievements">Session Achievements: None unlocked</p></section></Fragment> : <Fragment><section><h3>建造与调度</h3><p>点击草地，选择塔型后确认建造；点击已有塔可升级或出售。出售返还累计投入的 70%。准备阶段可跳过倒计时。金矿仅在战斗中产出，暂停时全部计时冻结。</p><p>方向键移动选中地块，回车选定，空格暂停，数字 1—5 选择塔型，Esc 取消选择。手机上点选地块后，在下方工事面板确认建造。</p></section><section><h3>知己知彼</h3><p>疾行兽速度快，重甲卫血量高；蚀火虫成群出现，祈火者会周期治疗附近敌军。盾焰卫先消耗护盾，狙击塔对护盾造成额外伤害。</p><p>第 5、10、15 波出现领主，漏防扣除 5 点耐久，普通敌人扣除 1 点。第三波起北侧入口加入进攻。后期有急袭、虫潮与铁壁攻势。</p></section><section><h3>守望者的荣誉</h3><p>最终得分 = 守住波数 × 1000 + 击破数 × 10 + 剩余耐久 × 50。最佳得分与完整守住的波数保存在本机。</p><p id="achievements">本局成就：尚未解锁</p></section></Fragment>}</div></details>
			<dialog id="restart-dialog"><h2>{isEn ? "Relight the Beacon?" : "重新点燃烽火？"}</h2><p>{isEn ? "Current battle will reset, but high scores will be preserved." : "当前战局将重置，历史最佳纪录会保留。"}</p><div><button id="cancel-restart">{isEn ? "Resume Current" : "继续本局"}</button><button id="confirm-restart" class="primary">{isEn ? "Restart" : "重新开始"}</button></div></dialog>
		</main>
		<script>
			import { mount } from "@/lib/emberhold-siege/ui.js";
			mount();
		</script>
	</body>
</html>
<style>
	:global(*){box-sizing:border-box} :global(body){margin:0;background:#101918;color:#e5e2cf;font-family:system-ui,-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;font-size:13px} :global(button),:global(a){-webkit-tap-highlight-color:transparent} :global(button){font:inherit;cursor:pointer} :global(button:disabled){cursor:not-allowed;opacity:.4} :global(button:focus-visible),:global(a:focus-visible),:global(canvas:focus-visible){outline:2px solid #ebbb74;outline-offset:3px} :global([hidden]){display:none!important} :global(button){min-height:42px;color:inherit;background:#ffffff04;border:1px solid #ffffff13;border-radius:5px;transition:background .15s,border-color .15s} :global(button:hover:not(:disabled)){background:#ffffff0c;border-color:#d5b57d70} :global(a){color:inherit;text-decoration:none}
	#emberhold{max-width:1250px;margin:0 auto;padding:0 30px 20px}.masthead{height:110px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #c9c5a014}.back{font-size:12px;color:#99a39a;min-height:44px;display:flex;align-items:center;gap:10px}.wordmark{display:flex;align-items:center;gap:14px}.sigil{font-size:48px;color:#e3b878;text-shadow:0 0 24px #edb36b30}.wordmark h1{margin:0;font-family:serif;font-size:28px;letter-spacing:8px;font-weight:600}.wordmark p{color:#959d8d;font-size:10px;letter-spacing:5px;margin:7px 0 0}.edition{font-size:10px;letter-spacing:2px;color:#8b968c}.live-dot{display:inline-block;width:5px;height:5px;background:#b9c699;border-radius:50%;margin-right:7px}.edition-number{color:#58665d}.command-bar{display:flex;align-items:center;gap:30px;padding:22px 0}.resource{display:flex;gap:13px;align-items:center;min-width:110px}.resource-icon{font-size:29px}.gold{color:#ebc478}.heart{color:#d5947f}.wave{color:#b5c2a6}.resource small{display:block;font-size:10px;letter-spacing:2px;color:#89978c;margin-bottom:3px}.resource strong{font-weight:500;font-variant-numeric:tabular-nums;font-size:25px;line-height:1.15}.resource em{font-size:12px;font-style:normal;color:#748174}.toolbar{margin-left:auto;display:flex;gap:7px}.toolbar button{padding:0 12px;min-width:42px;font-size:12px;color:#b8c0b2}.game-layout{display:grid;grid-template-columns:minmax(0,1fr) 296px;gap:18px}.battlefield{border:1px solid #73847530;border-radius:8px;overflow:hidden;background:#182522;align-self:start}.map-heading{display:flex;justify-content:space-between;padding:15px 17px;font-size:11px;color:#b5bfab;letter-spacing:1px;background:#1b2925}.map-heading i{display:inline-block;height:5px;width:5px;background:#e9b471;transform:rotate(45deg);margin-right:8px}.map-heading b{font-weight:400;color:#758578}.map-heading>span:last-child{font-size:10px;color:#b8b291}.canvas-wrap{position:relative;isolation:isolate}canvas{width:100%;height:auto;display:block;touch-action:manipulation;cursor:crosshair}.map-footer{padding:13px 16px;display:flex;justify-content:space-between;font-size:10px;color:#798b7d;border-top:1px solid #9aaa7c15}.map-footer i{display:inline-block;width:6px;height:6px;margin:0 5px 0 13px}.map-footer i:first-child{margin-left:0}.legend-road{background:#7f7a5f}.legend-build{background:#516750}.legend-core{background:#e8bb70;transform:rotate(45deg)}.sidebar{display:flex;flex-direction:column;gap:14px}.panel{border:1px solid #7183732b;border-radius:8px;background:#182320;padding:18px}.section-label{display:flex;justify-content:space-between;align-items:center;font-size:10px;letter-spacing:1px;color:#b8c0ae}.section-label span+span{color:#728575;font-size:9px;letter-spacing:0}.wave-panel h2{font-family:serif;font-size:23px;font-weight:500;letter-spacing:2px;margin:16px 0 6px}.muted{font-size:10px;color:#8a998a;margin:0;min-height:15px}.composition{display:flex;gap:6px;flex-wrap:wrap;margin:16px 0;min-height:26px}.composition :global(span){padding:5px 8px;border:1px solid #c3b89c1a;background:#c4bc9d05;font-size:10px;border-radius:3px;color:#c9c8ae}.composition :global(b){color:#e1b984;font-weight:500;padding-left:4px}.wave-progress{height:3px;background:#3c4535;border-radius:3px;overflow:hidden}.wave-progress>div{height:100%;background:#d1b27c;width:0;transition:width .2s}.wave-meta{display:flex;justify-content:space-between;color:#839181;font-size:9px;margin:9px 0 15px}.primary{display:flex;align-items:center;justify-content:space-between;padding:0 16px;min-height:44px;width:100%;background:#dcb77c;color:#22281e;border:1px solid #edc993;font-weight:600;letter-spacing:1px}.primary:hover:not(:disabled){background:#edca90;color:#1e251c}.primary span{font-size:20px;font-weight:400}.tower-palette{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;margin-top:18px}.tower-palette :global(button){padding:6px 2px;min-width:0;border:1px solid #667b6738;border-radius:5px;background:#12201d;min-height:76px;display:flex;flex-direction:column;align-items:center;justify-content:center}.tower-palette :global(button.selected){border-color:#d5b57d;background:#d5b57d10}.tower-palette :global(.tower-icon){display:block;font-size:24px;line-height:1.2;margin-bottom:5px}.tower-palette :global(.tower-name){display:block;font-size:8.5px;color:#b4beaa;white-space:normal;line-height:1.15;word-break:break-word;text-align:center;padding:0 1px}.tower-palette :global(.tower-price){display:block;font-size:10px;margin-top:5px;color:#d5b57d}.selection-panel{border-top:1px solid #71837324;margin-top:16px;padding-top:15px}.selection-title{display:flex;align-items:center;justify-content:space-between}.selection-title strong{font-size:14px;font-weight:500;letter-spacing:2px}.selection-title span{font-size:9px;color:#8d9d89}.selection-panel p{color:#8e9e8e;font-size:11px;line-height:1.8;margin:8px 0 12px;min-height:40px}.tower-stats{display:flex;justify-content:space-between;margin-bottom:14px}.tower-stats :global(span){font-size:9px;color:#7c8f7c}.tower-stats :global(b){display:block;color:#cecbb2;font-size:14px;font-weight:500;margin-top:4px}.build-button{width:100%;color:#d9c295;border-color:#b19a613e;background:#c7ab6810;font-size:11px;padding:0 8px}.tower-actions{display:flex;gap:7px}.sell-button{white-space:nowrap;font-size:10px;padding:0 9px;color:#b3a99a}.field-note{font-size:10px;padding:0 4px;color:#839781}.field-note span{color:#b3b592}.field-note p{line-height:1.8;margin:5px 0 0}.dispatch{display:flex;align-items:center;gap:16px;min-height:49px;padding:10px 0;border-bottom:1px solid #c9c5a014;font-size:11px}.dispatch-label{font-size:9px;letter-spacing:2px;color:#b6a377;white-space:nowrap}.dispatch p{color:#94a18e;margin:0;line-height:1.6}.kills{margin-left:auto;color:#748571;white-space:nowrap}.kills b{color:#d3cdb3;font-weight:500;margin-left:8px}.bottom{display:flex;justify-content:space-between;align-items:center;padding:16px 0;color:#687d6b;font-size:10px;letter-spacing:1px}.bottom>div{display:flex;gap:20px;align-items:center}.bottom b{font-weight:500;color:#b9bfa6;letter-spacing:0}.bottom button{border:none;min-height:32px;font-size:10px;color:#a4b09a;padding:0;background:none}.overlay,.pause-overlay{position:absolute;inset:0;background:#101c1ae8;display:flex;align-items:center;justify-content:center;text-align:center;backdrop-filter:blur(3px)}.intro-card{width:min(390px,85%);padding:16px 0}.overline{font-size:10px;letter-spacing:5px;color:#b4a681}.intro-symbol{font-size:56px;color:#dfb370;line-height:1.3;margin:10px}.intro-card h2{font-family:serif;font-size:40px;line-height:1.35;font-weight:500;letter-spacing:5px;margin:0 0 15px}.intro-card h2 span{color:#dfb980}.intro-card>p{font-size:12px;color:#9dab98;line-height:1.9}.instructions{display:grid;gap:9px;text-align:left;max-width:265px;margin:22px auto;color:#bec5af;font-size:11px}.instructions b{color:#ba9c68;font-size:10px;letter-spacing:1px;margin-right:15px}.intro-card .primary{max-width:270px;margin:20px auto 0}.intro-card .intro-foot{font-size:9px;letter-spacing:1px;margin-bottom:0;color:#708570}.pause-overlay{background:#101c1adc}.pause-overlay span{font-size:35px;color:#dbb67e}.pause-overlay h2{font-family:serif;letter-spacing:5px;font-weight:400;font-size:30px}.pause-overlay p{color:#9dac99;font-size:12px}.pause-overlay .primary{margin-top:25px}.result-stats{padding:14px;border:1px solid #bdad762d;color:#d5c39a;line-height:2}.manual{border:1px solid #84977920;border-radius:6px;color:#879c83;font-size:11px;padding:14px;margin-top:8px}.manual summary{cursor:pointer}.manual-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:28px;line-height:1.9}.manual h3{color:#c5c5ab;font-weight:500}.manual p{margin-bottom:0}dialog{background:#1b2a25;border:1px solid #8d977357;border-radius:10px;color:#dcd8c4;padding:28px;max-width:calc(100% - 32px)}dialog::backdrop{background:#08120de0}dialog h2{font-family:serif;font-weight:400}dialog p{color:#a3af98;font-size:12px}dialog>div{display:flex;gap:12px;margin-top:25px}dialog button{padding:0 16px}dialog .primary{width:auto}
