	<!-- CLIENT-SIDE SIMULATION ENGINE -->
	<script is:inline>
		(() => {
			let cleanup = null;

			function initStreakHunter() {
				if (cleanup) {
					cleanup();
					cleanup = null;
				}

				const lifecycle = new AbortController();
				let animFrameIds = [];
				let timerIds = [];

				cleanup = () => {
					lifecycle.abort();
					animFrameIds.forEach((id) => cancelAnimationFrame(id));
					timerIds.forEach((id) => clearInterval(id));
				};

				const isEnPage = window.location.pathname.startsWith("/en");

				// ==========================================
				// 1. CENTERPIECE: STREAK HUNTER GAME
				// ==========================================
				const gameCanvas = document.getElementById("canvas-game");
				const gameRoundBadge = document.getElementById("game-round-badge");
				const gameScoreBadge = document.getElementById("game-score-badge");
				const btnGameNext = document.getElementById("btn-game-next");
				const btnGameHint = document.getElementById("btn-game-hint");
				const btnGameReset = document.getElementById("btn-game-reset");
				const feedbackBanner = document.getElementById("game-feedback-banner");
				const feedbackPill = document.getElementById("game-feedback-pill");
				const feedbackIcon = document.getElementById("game-feedback-icon");
				const feedbackText = document.getElementById("game-feedback-text");
				const hudFieldId = document.getElementById("hud-field-id");

				const verdictOverlay = document.getElementById("game-verdict-overlay");
				const verdictRankTitle = document.getElementById("verdict-rank-title");
				const verdictHits = document.getElementById("verdict-hits");
				const verdictScore = document.getElementById("verdict-score");
				const verdictTime = document.getElementById("verdict-time");
				const verdictDesc = document.getElementById("verdict-description");
				const btnGameReplay = document.getElementById("btn-game-replay");

				let currentRound = 1;
				const maxRounds = 5;
				let totalScore = 0;
				let roundAnswered = false;
				let roundStartTime = performance.now();
				let roundReactionTimes = [];
				let totalHits = 0;
				let hintActive = false;

				// Procedural field data
				let stars = [];
				let galaxies = [];
				let cometStreak = {
					x: 0,
					y: 0,
					len: 0,
					angle: 0,
					alpha: 0.6,
					revealed: false,
					hit: false,
					guessX: 0,
					guessY: 0,
				};

				function generateField(roundNum) {
					roundAnswered = false;
					roundStartTime = performance.now();
					if (btnGameNext) btnGameNext.disabled = true;
					if (gameRoundBadge) gameRoundBadge.textContent = `${roundNum} / ${maxRounds}`;
					if (hudFieldId) hudFieldId.textContent = roundNum < 10 ? `0${roundNum}` : `${roundNum}`;
					if (feedbackBanner) feedbackBanner.classList.add("opacity-0", "translate-y-[-8px]");

					// Generate 140 background stars
					stars = [];
					for (let i = 0; i < 150; i++) {
						stars.push({
							x: Math.random(),
							y: Math.random(),
							radius: Math.random() < 0.85 ? Math.random() * 0.9 + 0.5 : Math.random() * 1.6 + 1.2,
							alpha: Math.random() * 0.7 + 0.3,
							color: Math.random() < 0.2 ? "rgba(186, 230, 253, " : Math.random() < 0.15 ? "rgba(254, 240, 138, " : "rgba(248, 250, 252, ",
						});
					}

					// Generate 14 faint distant galaxies (ellipses/fuzzies)
					galaxies = [];
					for (let i = 0; i < 14; i++) {
						galaxies.push({
							x: Math.random() * 0.85 + 0.07,
							y: Math.random() * 0.85 + 0.07,
							rx: Math.random() * 5 + 3,
							ry: Math.random() * 3 + 1.5,
							angle: Math.random() * Math.PI,
							alpha: Math.random() * 0.22 + 0.08,
							isSpiral: Math.random() < 0.4,
						});
					}

					// Generate ONE subtle comet streak
					// Difficulty adjusted: faint, thin, but visible if looked at attentively
					const angle = (Math.random() * 50 + 20) * (Math.random() < 0.5 ? 1 : -1) * (Math.PI / 180);
					cometStreak = {
						x: Math.random() * 0.7 + 0.15,
						y: Math.random() * 0.7 + 0.15,
						len: Math.random() * 16 + 26, // 26 to 42 px
						angle: angle,
						alpha: Math.random() * 0.15 + 0.55, // faint!
						revealed: false,
						hit: false,
						guessX: 0,
						guessY: 0,
					};

					renderGame();
				}

				function renderGame() {
					if (!gameCanvas) return;
					const rect = gameCanvas.getBoundingClientRect();
					const dpr = window.devicePixelRatio || 1;
					const w = rect.width;
					const h = rect.height;

					if (gameCanvas.width !== Math.round(w * dpr) || gameCanvas.height !== Math.round(h * dpr)) {
						gameCanvas.width = Math.round(w * dpr);
						gameCanvas.height = Math.round(h * dpr);
					}

					const ctx = gameCanvas.getContext("2d");
					ctx.save();
					ctx.scale(dpr, dpr);

					// Background: Deep Field Dark Void
					ctx.fillStyle = hintActive ? "#1e293b" : "#02040b";
					ctx.fillRect(0, 0, w, h);

					// Subtle sensor noise grid
					ctx.fillStyle = hintActive ? "rgba(255, 255, 255, 0.04)" : "rgba(255, 255, 255, 0.015)";
					for (let i = 0; i < 60; i++) {
						const nx = Math.random() * w;
						const ny = Math.random() * h;
						ctx.fillRect(nx, ny, 1, 1);
					}

					// Draw galaxies
					galaxies.forEach((g) => {
						ctx.save();
						ctx.translate(g.x * w, g.y * h);
						ctx.rotate(g.angle);
						const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, Math.max(g.rx, g.ry) * 2);
						grad.addColorStop(0, `rgba(224, 231, 255, ${g.alpha * (hintActive ? 1.8 : 1)})`);
						grad.addColorStop(0.5, `rgba(165, 180, 252, ${g.alpha * 0.4 * (hintActive ? 1.8 : 1)})`);
						grad.addColorStop(1, "rgba(99, 102, 241, 0)");
						ctx.fillStyle = grad;
						ctx.beginPath();
						ctx.ellipse(0, 0, g.rx * 2, g.ry * 2, 0, 0, Math.PI * 2);
						ctx.fill();
						ctx.restore();
					});

					// Draw background stars
					stars.forEach((s) => {
						const sx = s.x * w;
						const sy = s.y * h;
						ctx.fillStyle = `${s.color}${s.alpha * (hintActive ? 1.5 : 1)})`;
						ctx.beginPath();
						ctx.arc(sx, sy, s.radius, 0, Math.PI * 2);
						ctx.fill();

						// Tiny diffraction spike for brighter stars
						if (s.radius > 1.8 && !hintActive) {
							ctx.strokeStyle = `rgba(255, 255, 255, 0.25)`;
							ctx.lineWidth = 0.5;
							ctx.beginPath();
							ctx.moveTo(sx - 4, sy);
							ctx.lineTo(sx + 4, sy);
							ctx.moveTo(sx, sy - 4);
							ctx.lineTo(sx, sy + 4);
							ctx.stroke();
						}
					});

					// Draw THE COMET STREAK
					const cx = cometStreak.x * w;
					const cy = cometStreak.y * h;
					const halfL = cometStreak.len / 2;
					const dx = Math.cos(cometStreak.angle) * halfL;
					const dy = Math.sin(cometStreak.angle) * halfL;
					const x1 = cx - dx;
					const y1 = cy - dy;
					const x2 = cx + dx;
					const y2 = cy + dy;

					// Faint diffuse coma envelope along the streak
					const comaGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, halfL * 1.3);
					comaGrad.addColorStop(0, `rgba(186, 230, 253, ${cometStreak.alpha * 0.4 * (hintActive ? 2.5 : 1)})`);
					comaGrad.addColorStop(0.6, `rgba(125, 211, 252, ${cometStreak.alpha * 0.15 * (hintActive ? 2.5 : 1)})`);
					comaGrad.addColorStop(1, "rgba(56, 189, 248, 0)");
					ctx.fillStyle = comaGrad;
					ctx.beginPath();
					ctx.ellipse(cx, cy, halfL * 1.2, 7, cometStreak.angle, 0, Math.PI * 2);
					ctx.fill();

					// Moving nucleus streak line
					ctx.strokeStyle = hintActive ? "#38bdf8" : `rgba(224, 242, 254, ${cometStreak.alpha})`;
					ctx.lineWidth = hintActive ? 2.4 : 1.3;
					ctx.beginPath();
					ctx.moveTo(x1, y1);
					ctx.lineTo(x2, y2);
					ctx.stroke();

					// If revealed (by guess or round completion): Draw Pöntinen software detection box
					if (cometStreak.revealed) {
						const boxColor = cometStreak.hit ? "#34d399" : "#fbbf24";
						ctx.strokeStyle = boxColor;
						ctx.lineWidth = 1.5;
						ctx.setLineDash([4, 3]);

						const pad = halfL + 12;
						ctx.strokeRect(cx - pad, cy - pad, pad * 2, pad * 2);
						ctx.setLineDash([]);

						// Corner brackets
						const cLen = 6;
						ctx.strokeStyle = boxColor;
						ctx.lineWidth = 2;
						// Top Left
						ctx.beginPath();
						ctx.moveTo(cx - pad, cy - pad + cLen);
						ctx.lineTo(cx - pad, cy - pad);
						ctx.lineTo(cx - pad + cLen, cy - pad);
						ctx.stroke();
						// Top Right
						ctx.beginPath();
						ctx.moveTo(cx + pad - cLen, cy - pad);
						ctx.lineTo(cx + pad, cy - pad);
						ctx.lineTo(cx + pad, cy - pad + cLen);
						ctx.stroke();
						// Bottom Left
						ctx.beginPath();
						ctx.moveTo(cx - pad, cy + pad - cLen);
						ctx.lineTo(cx - pad, cy + pad);
						ctx.lineTo(cx - pad + cLen, cy + pad);
						ctx.stroke();
						// Bottom Right
						ctx.beginPath();
						ctx.moveTo(cx + pad - cLen, cy + pad);
						ctx.lineTo(cx + pad, cy + pad);
						ctx.lineTo(cx + pad, cy + pad - cLen);
						ctx.stroke();

						// Detection flag label
						ctx.fillStyle = boxColor;
						ctx.font = "10px monospace";
						const tagText = cometStreak.hit
							? (isEnPage ? "[FLAGGED: TRANSIENT STREAK HIT]" : "[算法锁定: 移动天体拖影命中]")
							: (isEnPage ? "[SOFTWARE REVEAL: MISSED]" : "[算法标记: 目标拖影在此]");
						ctx.fillText(tagText, cx - pad, cy - pad - 6);

						// If missed, draw an arrow from user click to the comet
						if (!cometStreak.hit && cometStreak.guessX) {
							ctx.strokeStyle = "rgba(244, 63, 94, 0.7)";
							ctx.lineWidth = 1.2;
							ctx.setLineDash([3, 3]);
							ctx.beginPath();
							ctx.moveTo(cometStreak.guessX, cometStreak.guessY);
							ctx.lineTo(cx, cy);
							ctx.stroke();
							ctx.setLineDash([]);

							ctx.fillStyle = "#f43f5e";
							ctx.beginPath();
							ctx.arc(cometStreak.guessX, cometStreak.guessY, 3, 0, Math.PI * 2);
							ctx.fill();
						}
					}

					ctx.restore();
				}

				function distToSegment(px, py, x1, y1, x2, y2) {
					const l2 = (x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1);
					if (l2 === 0) return Math.hypot(px - x1, py - y1);
					let t = ((px - x1) * (x2 - x1) + (py - y1) * (y2 - y1)) / l2;
					t = Math.max(0, Math.min(1, t));
					const projX = x1 + t * (x2 - x1);
					const projY = y1 + t * (y2 - y1);
					return Math.hypot(px - projX, py - projY);
				}

				if (gameCanvas) {
					gameCanvas.addEventListener("click", (e) => {
						if (roundAnswered) return;
						const rect = gameCanvas.getBoundingClientRect();
						const clickX = e.clientX - rect.left;
						const clickY = e.clientY - rect.top;
						const w = rect.width;
						const h = rect.height;

						const cx = cometStreak.x * w;
						const cy = cometStreak.y * h;
						const halfL = cometStreak.len / 2;
						const dx = Math.cos(cometStreak.angle) * halfL;
						const dy = Math.sin(cometStreak.angle) * halfL;
						const x1 = cx - dx;
						const y1 = cy - dy;
						const x2 = cx + dx;
						const y2 = cy + dy;

						const dist = distToSegment(clickX, clickY, x1, y1, x2, y2);
						const reactionTimeSec = (performance.now() - roundStartTime) / 1000;
						roundReactionTimes.push(reactionTimeSec);
						roundAnswered = true;
						cometStreak.revealed = true;
						cometStreak.guessX = clickX;
						cometStreak.guessY = clickY;

						// Hit threshold: 38px
						if (dist <= 38) {
							cometStreak.hit = true;
							totalHits++;
							const speedBonus = Math.max(0, Math.round((10 - Math.min(10, reactionTimeSec)) * 50));
							const accuracyBonus = Math.round((38 - dist) * 10);
							const earnedScore = 800 + speedBonus + accuracyBonus;
							totalScore += earnedScore;

							if (feedbackPill) {
								feedbackPill.className = "px-3.5 py-2 rounded-xl backdrop-blur-md text-xs font-mono border shadow-lg inline-flex items-center gap-2 bg-emerald-950/90 border-emerald-500/50 text-emerald-300";
							}
							if (feedbackIcon) feedbackIcon.textContent = "🎯";
							if (feedbackText) {
								feedbackText.textContent = isEnPage
									? `HIT! Transient streak flagged! +${earnedScore} pts (${reactionTimeSec.toFixed(1)}s)`
									: `精准锁定！软件标记出移动拖影！+${earnedScore} 分 (${reactionTimeSec.toFixed(1)} 秒)`;
							}
						} else {
							cometStreak.hit = false;
							if (feedbackPill) {
								feedbackPill.className = "px-3.5 py-2 rounded-xl backdrop-blur-md text-xs font-mono border shadow-lg inline-flex items-center gap-2 bg-rose-950/90 border-rose-500/50 text-rose-300";
							}
							if (feedbackIcon) feedbackIcon.textContent = "🔍";
							if (feedbackText) {
								feedbackText.textContent = isEnPage
									? `MISSED by ${Math.round(dist)}px. The comet was flagged in green.`
									: `偏差 ${Math.round(dist)} 像素。已用标记框标出彗星真实位置。`;
							}
						}

						if (feedbackBanner) feedbackBanner.classList.remove("opacity-0", "translate-y-[-8px]");
						if (gameScoreBadge) gameScoreBadge.textContent = `${totalScore}`;
						if (btnGameNext) {
							btnGameNext.disabled = false;
							btnGameNext.focus();
						}

						renderGame();
					}, { signal: lifecycle.signal });
				}

				if (btnGameNext) {
					btnGameNext.addEventListener("click", () => {
						if (currentRound < maxRounds) {
							currentRound++;
							generateField(currentRound);
						} else {
							showVerdict();
						}
					}, { signal: lifecycle.signal });
				}

				if (btnGameHint) {
					btnGameHint.addEventListener("click", () => {
						hintActive = true;
						renderGame();
						const tId = setTimeout(() => {
							hintActive = false;
							renderGame();
						}, 1200);
						timerIds.push(tId);
					}, { signal: lifecycle.signal });
				}

				if (btnGameReset) {
					btnGameReset.addEventListener("click", () => {
						currentRound = 1;
						totalScore = 0;
						totalHits = 0;
						roundReactionTimes = [];
						if (gameScoreBadge) gameScoreBadge.textContent = "0";
						generateField(1);
					}, { signal: lifecycle.signal });
				}

				if (btnGameReplay) {
					btnGameReplay.addEventListener("click", () => {
						if (verdictOverlay) verdictOverlay.classList.add("hidden");
						currentRound = 1;
						totalScore = 0;
						totalHits = 0;
						roundReactionTimes = [];
						if (gameScoreBadge) gameScoreBadge.textContent = "0";
						generateField(1);
					}, { signal: lifecycle.signal });
				}

				function showVerdict() {
					if (!verdictOverlay) return;
					verdictOverlay.classList.remove("hidden");
					if (verdictHits) verdictHits.textContent = `${totalHits} / ${maxRounds}`;
					if (verdictScore) verdictScore.textContent = `${totalScore}`;
					const avgTime = roundReactionTimes.length > 0
						? (roundReactionTimes.reduce((a, b) => a + b, 0) / roundReactionTimes.length).toFixed(1)
						: "0.0";
					if (verdictTime) verdictTime.textContent = `${avgTime}s`;

					let rank = "";
					let desc = "";
					if (totalHits === 5) {
						rank = isEnPage ? "[ RANK: CHIEF COMET INVESTIGATOR ]" : "[ 评级：首席彗星探测专家 ]";
						desc = isEnPage
							? "Flawless detection across all 5 fields! You matched Mikko Pöntinen's custom detection pipeline, isolating the faint comet streak among thousands of static stars."
							: "五组深空视场全中！你的肉眼识别敏锐度足以媲美米科·彭蒂宁的自动化巡天算法，在万千恒星与星系中精准锁定了那道暗弱的彗星拖影。";
					} else if (totalHits >= 3) {
						rank = isEnPage ? "[ RANK: SENIOR DEEP-FIELD ASTRONOMER ]" : "[ 评级：资深深空巡天科学家 ]";
						desc = isEnPage
							? "Strong observation skills! You identified the majority of fields despite the ultra-faint signature and long exposure smearing."
							: "极为出色的观测水准！在极端暗弱与长曝光弥散下成功识别出了多数视场中的移动目标。";
					} else {
						rank = isEnPage ? "[ RANK: ALGORITHM TRAINEE ]" : "[ 评级：巡天算法见习研究员 ]";
						desc = isEnPage
							? "Hunting comets in deep space is notoriously difficult. Notice how the comet forms a soft elongated coma compared to stationary stars."
							: "在百亿光年深空背景里抓捕太阳系小天体确实困难重重。注意辨识其区别于恒星的弥散气团（彗发）与线状位移！";
					}

					if (verdictRankTitle) verdictRankTitle.textContent = rank;
					if (verdictDesc) verdictDesc.textContent = desc;
				}

				// ==========================================
				// 2. BLINK COMPARATOR
				// ==========================================
				const blinkCanvas = document.getElementById("canvas-blink");
				const blinkIndicator = document.getElementById("blink-frame-indicator");
				const blinkTimestamp = document.getElementById("blink-timestamp");
				const btnBlinkAuto = document.getElementById("btn-blink-auto");
				const btnBlinkManual = document.getElementById("btn-blink-manual");
				const btnBlinkReveal = document.getElementById("btn-blink-reveal");
				const sliderBlinkSpeed = document.getElementById("slider-blink-speed");
				const txtBlinkSpeed = document.getElementById("txt-blink-speed");
				const textBlinkPlay = document.getElementById("text-blink-play");
				const textBlinkPlayEn = document.getElementById("text-blink-play-en");
				const blinkJumpAnnotation = document.getElementById("blink-jump-annotation");

				let blinkActiveFrame = 0; // 0 for A, 1 for B
				let blinkAutoPlaying = true;
				let blinkIntervalMs = 500;
				let blinkRevealHighlight = false;
				let blinkTimer = null;

				// Fixed stars and galaxies for the comparator
				const compStars = [];
				for (let i = 0; i < 110; i++) {
					compStars.push({
						x: Math.random(),
						y: Math.random(),
						r: Math.random() < 0.8 ? Math.random() * 0.9 + 0.5 : Math.random() * 1.5 + 1.2,
						a: Math.random() * 0.7 + 0.3,
					});
				}
				const compGalaxies = [];
				for (let i = 0; i < 9; i++) {
					compGalaxies.push({
						x: Math.random() * 0.85 + 0.07,
						y: Math.random() * 0.85 + 0.07,
						rx: Math.random() * 6 + 3,
						ry: Math.random() * 3 + 1.5,
						angle: Math.random() * Math.PI,
						a: Math.random() * 0.25 + 0.08,
					});
				}

				// The jumper: Frame A vs Frame B positions
				const jumperA = { x: 0.36, y: 0.55, len: 32, angle: 0.65 };
				const jumperB = { x: 0.58, y: 0.38, len: 32, angle: 0.62 };

				function renderBlink() {
					if (!blinkCanvas) return;
					const rect = blinkCanvas.getBoundingClientRect();
					const dpr = window.devicePixelRatio || 1;
					const w = rect.width;
					const h = rect.height;

					if (blinkCanvas.width !== Math.round(w * dpr) || blinkCanvas.height !== Math.round(h * dpr)) {
						blinkCanvas.width = Math.round(w * dpr);
						blinkCanvas.height = Math.round(h * dpr);
					}

					const ctx = blinkCanvas.getContext("2d");
					ctx.save();
					ctx.scale(dpr, dpr);

					// Dark background
					ctx.fillStyle = "#02040b";
					ctx.fillRect(0, 0, w, h);

					// Draw fixed galaxies (identically in both frames!)
					compGalaxies.forEach((g) => {
						ctx.save();
						ctx.translate(g.x * w, g.y * h);
						ctx.rotate(g.angle);
						const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, Math.max(g.rx, g.ry) * 2);
						grad.addColorStop(0, `rgba(224, 231, 255, ${g.a})`);
						grad.addColorStop(0.5, `rgba(165, 180, 252, ${g.a * 0.4})`);
						grad.addColorStop(1, "rgba(99, 102, 241, 0)");
						ctx.fillStyle = grad;
						ctx.beginPath();
						ctx.ellipse(0, 0, g.rx * 2, g.ry * 2, 0, 0, Math.PI * 2);
						ctx.fill();
						ctx.restore();
					});

					// Draw fixed stars (identically in both frames!)
					compStars.forEach((s) => {
						ctx.fillStyle = `rgba(248, 250, 252, ${s.a})`;
						ctx.beginPath();
						ctx.arc(s.x * w, s.y * h, s.r, 0, Math.PI * 2);
						ctx.fill();
					});

					// Draw the moving comet in active frame position
					const j = blinkActiveFrame === 0 ? jumperA : jumperB;
					const jx = j.x * w;
					const jy = j.y * h;
					const halfL = j.len / 2;
					const dx = Math.cos(j.angle) * halfL;
					const dy = Math.sin(j.angle) * halfL;

					// Coma
					const comaGrad = ctx.createRadialGradient(jx, jy, 0, jx, jy, halfL * 1.4);
					comaGrad.addColorStop(0, "rgba(186, 230, 253, 0.4)");
					comaGrad.addColorStop(0.6, "rgba(56, 189, 248, 0.15)");
					comaGrad.addColorStop(1, "rgba(56, 189, 248, 0)");
					ctx.fillStyle = comaGrad;
					ctx.beginPath();
					ctx.ellipse(jx, jy, halfL * 1.3, 7, j.angle, 0, Math.PI * 2);
					ctx.fill();

					// Core streak
					ctx.strokeStyle = "rgba(240, 249, 255, 0.95)";
					ctx.lineWidth = 1.6;
					ctx.beginPath();
					ctx.moveTo(jx - dx, jy - dy);
					ctx.lineTo(jx + dx, jy + dy);
					ctx.stroke();

					// If highlight enabled: show movement jump vector and pulsing circle
					if (blinkRevealHighlight) {
						// Ring around current position
						ctx.strokeStyle = "#38bdf8";
						ctx.lineWidth = 2;
						ctx.beginPath();
						ctx.arc(jx, jy, halfL + 10, 0, Math.PI * 2);
						ctx.stroke();

						// Ring around alternate position (ghost)
						const altJ = blinkActiveFrame === 0 ? jumperB : jumperA;
						ctx.strokeStyle = "rgba(251, 191, 36, 0.5)";
						ctx.setLineDash([3, 3]);
						ctx.beginPath();
						ctx.arc(altJ.x * w, altJ.y * h, halfL + 10, 0, Math.PI * 2);
						ctx.stroke();

						// Connecting displacement arrow
						ctx.strokeStyle = "#fbbf24";
						ctx.lineWidth = 1.5;
						ctx.beginPath();
						ctx.moveTo(jumperA.x * w, jumperA.y * h);
						ctx.lineTo(jumperB.x * w, jumperB.y * h);
						ctx.stroke();
						ctx.setLineDash([]);
					}

					ctx.restore();
				}

				function updateBlinkUI() {
					if (blinkActiveFrame === 0) {
						if (blinkIndicator) blinkIndicator.className = "w-2 h-2 rounded-full bg-cyan-400 animate-pulse";
						if (blinkTimestamp) {
							blinkTimestamp.className = "text-cyan-300 font-bold";
							blinkTimestamp.textContent = isEnPage ? "2026-09-20 02:15 UTC (FRAME A)" : "2026-09-20 02:15 UTC (第 1 帧)";
						}
					} else {
						if (blinkIndicator) blinkIndicator.className = "w-2 h-2 rounded-full bg-indigo-400 animate-pulse";
						if (blinkTimestamp) {
							blinkTimestamp.className = "text-indigo-300 font-bold";
							blinkTimestamp.textContent = isEnPage ? "2026-09-20 06:40 UTC (FRAME B)" : "2026-09-20 06:40 UTC (第 2 帧 · 4.4h 后)";
						}
					}
					renderBlink();
				}

				function resetBlinkTimer() {
					if (blinkTimer) clearInterval(blinkTimer);
					if (blinkAutoPlaying) {
						blinkTimer = setInterval(() => {
							blinkActiveFrame = blinkActiveFrame === 0 ? 1 : 0;
							updateBlinkUI();
						}, blinkIntervalMs);
						timerIds.push(blinkTimer);
					}
				}

				if (btnBlinkAuto) {
					btnBlinkAuto.addEventListener("click", () => {
						blinkAutoPlaying = !blinkAutoPlaying;
						if (blinkAutoPlaying) {
							resetBlinkTimer();
							if (textBlinkPlay) textBlinkPlay.textContent = "暂停自动交替闪烁";
							if (textBlinkPlayEn) textBlinkPlayEn.textContent = "Pause Auto Blink";
						} else {
							if (blinkTimer) clearInterval(blinkTimer);
							if (textBlinkPlay) textBlinkPlay.textContent = "启动自动交替闪烁";
							if (textBlinkPlayEn) textBlinkPlayEn.textContent = "Resume Auto Blink";
						}
					}, { signal: lifecycle.signal });
				}

				if (btnBlinkManual) {
					btnBlinkManual.addEventListener("click", () => {
						blinkAutoPlaying = false;
						if (blinkTimer) clearInterval(blinkTimer);
						if (textBlinkPlay) textBlinkPlay.textContent = "启动自动交替闪烁";
						if (textBlinkPlayEn) textBlinkPlayEn.textContent = "Resume Auto Blink";
						blinkActiveFrame = blinkActiveFrame === 0 ? 1 : 0;
						updateBlinkUI();
					}, { signal: lifecycle.signal });
				}

				if (btnBlinkReveal) {
					btnBlinkReveal.addEventListener("click", () => {
						blinkRevealHighlight = !blinkRevealHighlight;
						if (blinkJumpAnnotation) {
							blinkJumpAnnotation.classList.toggle("hidden", !blinkRevealHighlight);
						}
						renderBlink();
					}, { signal: lifecycle.signal });
				}

				if (sliderBlinkSpeed) {
					sliderBlinkSpeed.addEventListener("input", (e) => {
						blinkIntervalMs = parseInt(e.target.value, 10);
						if (txtBlinkSpeed) txtBlinkSpeed.textContent = `${blinkIntervalMs}ms`;
						resetBlinkTimer();
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 3. EXPOSURE SLIDER SIMULATION
				// ==========================================
				const expCanvas = document.getElementById("canvas-exposure");
				const sliderExp = document.getElementById("slider-exposure");
				const dispExpSeconds = document.getElementById("disp-exp-seconds");
				const metricTrailLen = document.getElementById("metric-trail-len");
				const metricComaSnr = document.getElementById("metric-coma-snr");
				const metricStatusVerdict = document.getElementById("metric-status-verdict");
				const btnExpSnap30 = document.getElementById("btn-exp-snap-30");
				const btnExpSnap180 = document.getElementById("btn-exp-snap-180");
				const btnExpSnapReal = document.getElementById("btn-exp-snap-real");

				let simExposureSec = 560.52;

				function updateExposureMetrics(seconds) {
					simExposureSec = seconds;
					if (dispExpSeconds) dispExpSeconds.textContent = `${seconds.toFixed(2)} s`;

					// Physical scaling: velocity ~ 0.083 px/s
					const lenPx = Math.max(2.5, seconds * 0.083);
					if (metricTrailLen) metricTrailLen.textContent = `${lenPx.toFixed(1)} px`;

					// Coma integration SNR scales roughly with sqrt(t)
					const comaSnr = (Math.sqrt(seconds / 560.52) * 8.9).toFixed(1);
					if (metricComaSnr) {
						if (seconds < 60) {
							metricComaSnr.textContent = `< 2.1 σ (${isEnPage ? "Below noise" : "被背景淹没"})`;
						} else {
							metricComaSnr.textContent = `${comaSnr} σ (${isEnPage ? "Prominent halo" : "显著包层"})`;
						}
					}

					if (metricStatusVerdict) {
						if (seconds < 50) {
							metricStatusVerdict.textContent = isEnPage ? "Point-like (Undifferentiated)" : "点状像质 (无法甄别)";
							metricStatusVerdict.className = "font-bold text-slate-400";
						} else if (seconds < 250) {
							metricStatusVerdict.textContent = isEnPage ? "Slight trail (Suspicious body)" : "轻微拉伸 (可疑移动体)";
							metricStatusVerdict.className = "font-bold text-cyan-300";
						} else {
							metricStatusVerdict.textContent = isEnPage ? "Definitive Active Comet" : "活跃彗星 (彗发明确)";
							metricStatusVerdict.className = "font-bold text-amber-300";
						}
					}

					renderExposureCanvas();
				}

				function renderExposureCanvas() {
					if (!expCanvas) return;
					const rect = expCanvas.getBoundingClientRect();
					const dpr = window.devicePixelRatio || 1;
					const w = rect.width;
					const h = rect.height;

					if (expCanvas.width !== Math.round(w * dpr) || expCanvas.height !== Math.round(h * dpr)) {
						expCanvas.width = Math.round(w * dpr);
						expCanvas.height = Math.round(h * dpr);
					}

					const ctx = expCanvas.getContext("2d");
					ctx.save();
					ctx.scale(dpr, dpr);

					ctx.fillStyle = "#02040b";
					ctx.fillRect(0, 0, w, h);

					// Draw Reference Fixed Star (on the left side)
					const starX = w * 0.28;
					const starY = h * 0.5;

					// Star brightness grows with exposure, but stays point-like
					const starIntensity = Math.min(1, 0.4 + (simExposureSec / 700) * 0.6);
					const starGrad = ctx.createRadialGradient(starX, starY, 0, starX, starY, 14);
					starGrad.addColorStop(0, `rgba(255, 255, 255, ${starIntensity})`);
					starGrad.addColorStop(0.2, `rgba(186, 230, 253, ${starIntensity * 0.7})`);
					starGrad.addColorStop(1, "rgba(56, 189, 248, 0)");
					ctx.fillStyle = starGrad;
					ctx.beginPath();
					ctx.arc(starX, starY, 14, 0, Math.PI * 2);
					ctx.fill();

					ctx.fillStyle = "#ffffff";
					ctx.beginPath();
					ctx.arc(starX, starY, 1.8, 0, Math.PI * 2);
					ctx.fill();

					// Fixed star diffraction spikes (visible at long exposure)
					if (simExposureSec > 120) {
						const spikeAlpha = Math.min(0.6, (simExposureSec - 120) / 600);
						ctx.strokeStyle = `rgba(255, 255, 255, ${spikeAlpha})`;
						ctx.lineWidth = 0.8;
						ctx.beginPath();
						ctx.moveTo(starX - 18, starY);
						ctx.lineTo(starX + 18, starY);
						ctx.moveTo(starX, starY - 18);
						ctx.lineTo(starX, starY + 18);
						ctx.stroke();
					}

					// Label for Star
					ctx.fillStyle = "rgba(148, 163, 184, 0.8)";
					ctx.font = "11px monospace";
					ctx.textAlign = "center";
					ctx.fillText(isEnPage ? "STATIONARY STAR" : "参考静止恒星 (点源)", starX, starY + 32);
					ctx.font = "9px monospace";
					ctx.fillStyle = "rgba(100, 116, 139, 0.7)";
					ctx.fillText(isEnPage ? "PSF preserved regardless of t" : "像质始终保持凝聚", starX, starY + 44);

					// Draw Moving Comet (on the right side)
					const cometX = w * 0.72;
					const cometY = h * 0.5;
					const trailLen = Math.max(3, simExposureSec * 0.083);
					const angle = -0.55; // diagonal
					const halfL = trailLen / 2;
					const dx = Math.cos(angle) * halfL;
					const dy = Math.sin(angle) * halfL;

					// Coma envelope fades in and elongates with exposure
					const comaNorm = Math.min(1, simExposureSec / 560.52);
					if (simExposureSec > 40) {
						const comaRadius = 12 + comaNorm * 8;
						const comaGrad = ctx.createRadialGradient(cometX, cometY, 0, cometX, cometY, halfL + comaRadius);
						comaGrad.addColorStop(0, `rgba(186, 230, 253, ${0.15 + comaNorm * 0.35})`);
						comaGrad.addColorStop(0.5, `rgba(56, 189, 248, ${0.05 + comaNorm * 0.2})`);
						comaGrad.addColorStop(1, "rgba(56, 189, 248, 0)");
						ctx.fillStyle = comaGrad;
						ctx.beginPath();
						ctx.ellipse(cometX, cometY, halfL + comaRadius, 10 + comaNorm * 4, angle, 0, Math.PI * 2);
						ctx.fill();
					}

					// Linear Nucleus Streak
					ctx.strokeStyle = `rgba(240, 249, 255, ${0.4 + comaNorm * 0.6})`;
					ctx.lineWidth = 1.8;
					ctx.beginPath();
					ctx.moveTo(cometX - dx, cometY - dy);
					ctx.lineTo(cometX + dx, cometY + dy);
					ctx.stroke();

					// Label for Comet
					ctx.fillStyle = "#38bdf8";
					ctx.font = "11px monospace";
					ctx.textAlign = "center";
					ctx.fillText(isEnPage ? "COMET C/2026 S1" : "彗星 C/2026 S1 (Euclid)", cometX, cometY + 32);
					ctx.font = "9px monospace";
					ctx.fillStyle = "#fbbf24";
					const subtext = simExposureSec >= 500
						? (isEnPage ? "Streak + Coma clearly revealed!" : "拖影 + 弥散彗发完全显现！")
						: (isEnPage ? "Short exposure: smears less" : "短曝光：位移微弱未弥散");
					ctx.fillText(subtext, cometX, cometY + 44);

					ctx.restore();
				}

				if (sliderExp) {
					sliderExp.addEventListener("input", (e) => {
						updateExposureMetrics(parseFloat(e.target.value));
					}, { signal: lifecycle.signal });
				}

				if (btnExpSnap30) {
					btnExpSnap30.addEventListener("click", () => {
						if (sliderExp) sliderExp.value = "30";
						updateExposureMetrics(30);
					}, { signal: lifecycle.signal });
				}

				if (btnExpSnap180) {
					btnExpSnap180.addEventListener("click", () => {
						if (sliderExp) sliderExp.value = "180";
						updateExposureMetrics(180);
					}, { signal: lifecycle.signal });
				}

				if (btnExpSnapReal) {
					btnExpSnapReal.addEventListener("click", () => {
						if (sliderExp) sliderExp.value = "560.52";
						updateExposureMetrics(560.52);
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 4. "COMET OR NOT?" CLASSIFICATION QUIZ
				// ==========================================
				const quizButtons = document.querySelectorAll(".btn-quiz");

				function renderQuizCanvas(canvasId, type) {
					const canvas = document.getElementById(canvasId);
					if (!canvas) return;
					const rect = canvas.getBoundingClientRect();
					const dpr = window.devicePixelRatio || 1;
					const w = rect.width;
					const h = rect.height;

					canvas.width = Math.round(w * dpr);
					canvas.height = Math.round(h * dpr);

					const ctx = canvas.getContext("2d");
					ctx.scale(dpr, dpr);
					ctx.fillStyle = "#010308";
					ctx.fillRect(0, 0, w, h);

					// A few dim stars
					for (let i = 0; i < 15; i++) {
						ctx.fillStyle = "rgba(255, 255, 255, 0.4)";
						ctx.beginPath();
						ctx.arc(Math.random() * w, Math.random() * h, Math.random() * 0.8 + 0.4, 0, Math.PI * 2);
						ctx.fill();
					}

					const cx = w * 0.5;
					const cy = h * 0.5;

					if (type === "comet") {
						// Streak + Coma
						const coma = ctx.createRadialGradient(cx, cy, 0, cx, cy, 26);
						coma.addColorStop(0, "rgba(186, 230, 253, 0.45)");
						coma.addColorStop(0.6, "rgba(56, 189, 248, 0.15)");
						coma.addColorStop(1, "rgba(56, 189, 248, 0)");
						ctx.fillStyle = coma;
						ctx.beginPath();
						ctx.ellipse(cx, cy, 28, 12, -0.6, 0, Math.PI * 2);
						ctx.fill();

						ctx.strokeStyle = "#f0f9ff";
						ctx.lineWidth = 1.8;
						ctx.beginPath();
						ctx.moveTo(cx - 16, cy + 10);
						ctx.lineTo(cx + 16, cy - 10);
						ctx.stroke();
					} else if (type === "asteroid") {
						// Sharp streak with ZERO coma fuzz
						ctx.strokeStyle = "#fef08a";
						ctx.lineWidth = 1.4;
						ctx.beginPath();
						ctx.moveTo(cx - 20, cy + 12);
						ctx.lineTo(cx + 20, cy - 12);
						ctx.stroke();
					} else if (type === "cosmic") {
						// Single frame sharp cluster / artifact
						ctx.fillStyle = "#ffffff";
						ctx.fillRect(cx - 1, cy - 1, 3, 3);
						ctx.fillStyle = "rgba(244, 63, 94, 0.8)";
						ctx.fillRect(cx - 2, cy, 2, 2);
						ctx.fillRect(cx + 1, cy - 2, 2, 2);
					}
				}

				quizButtons.forEach((btn) => {
					btn.addEventListener("click", () => {
						const card = btn.getAttribute("data-card");
						const choice = btn.getAttribute("data-choice");
						const feedbackEl = document.getElementById(`feedback-cand-${card}`);

						let isCorrect = false;
						let explZh = "";
						let explEn = "";

						if (card === "a") {
							isCorrect = choice === "comet";
							explZh = isCorrect
								? "✅ 完全正确！拖影周围具有明显的弥散彗发（coma），这是冰雪升华转化为气体的铁证——活跃彗星！"
								: "❌ 错误：注意拖影外围明显的雾状晕轮（彗发），这证明它正在释放气体，绝非光裸小行星或噪声。";
							explEn = isCorrect
								? "✅ Correct! A distinct fuzzy coma encloses the streak — conclusive proof of active volatile outgassing."
								: "❌ Incorrect: The surrounding nebulous coma proves active sublimation, distinguishing it from bare rocks.";
						} else if (card === "b") {
							isCorrect = choice === "asteroid";
							explZh = isCorrect
								? "✅ 完全正确！拖影极其锋利锐利，周围毫无弥散气团，属于典型的光裸无挥发性小行星岩石！"
								: "❌ 错误：边缘没有任何彗发晕轮，它未在喷发气体，因此是一颗光裸的小行星。";
							explEn = isCorrect
								? "✅ Correct! A razor-sharp track with zero coma fuzz denotes a bare rocky asteroid."
								: "❌ Incorrect: The lack of diffuse gas cloud rules out an active comet.";
						} else if (card === "c") {
							isCorrect = choice === "cosmic";
							explZh = isCorrect
								? "✅ 完全正确！仅在单帧图像中出现、无法在下一帧复测验证的突变亮斑属于宇宙线击中像素噪声！"
								: "❌ 错误：如果天体在下一帧消失，表明它并非真实天文目标，而是相机 CCD 受宇宙线粒子撞击的伪像。";
							explEn = isCorrect
								? "✅ Correct! An anomaly present in only one exposure is a cosmic ray hit, not a real celestial body."
								: "❌ Incorrect: Transient single-frame spikes are camera detector noise, which is why Euclid requires 16 exposures.";
						}

						if (feedbackEl) {
							feedbackEl.className = isCorrect
								? "text-[11px] p-2.5 rounded-xl bg-emerald-950/80 border border-emerald-500/50 text-emerald-300 min-h-[58px] flex items-center leading-relaxed"
								: "text-[11px] p-2.5 rounded-xl bg-rose-950/80 border border-rose-500/50 text-rose-300 min-h-[58px] flex items-center leading-relaxed";
							feedbackEl.textContent = isEnPage ? explEn : explZh;
						}
					}, { signal: lifecycle.signal });
				});

				// ==========================================
				// 5. "OVER THE TOP" ORBIT SIMULATION
				// ==========================================
				const orbitCanvas = document.getElementById("canvas-orbit");
				const btnOrbitTogglePlay = document.getElementById("btn-orbit-toggle-play");
				const btnOrbitResetPos = document.getElementById("btn-orbit-reset-pos");
				const btnOrbitViewSide = document.getElementById("btn-orbit-view-side");
				const btnOrbitViewIso = document.getElementById("btn-orbit-view-iso");
				const sliderOrbitSpeed = document.getElementById("slider-orbit-speed");
				const txtOrbitSpeed = document.getElementById("txt-orbit-speed");
				const textOrbitPlay = document.getElementById("text-orbit-play");
				const textOrbitPlayEn = document.getElementById("text-orbit-play-en");

				let orbitViewMode = "side"; // "side" or "iso"
				let orbitPlaying = true;
				let orbitSpeedMult = 1.0;
				let cometOrbitT = 0.35; // 0 to 1 along its arched trajectory

				function renderOrbit() {
					if (!orbitCanvas) return;
					const rect = orbitCanvas.getBoundingClientRect();
					const dpr = window.devicePixelRatio || 1;
					const w = rect.width;
					const h = rect.height;

					if (orbitCanvas.width !== Math.round(w * dpr) || orbitCanvas.height !== Math.round(h * dpr)) {
						orbitCanvas.width = Math.round(w * dpr);
						orbitCanvas.height = Math.round(h * dpr);
					}

					const ctx = orbitCanvas.getContext("2d");
					ctx.save();
					ctx.scale(dpr, dpr);

					ctx.fillStyle = "#02040b";
					ctx.fillRect(0, 0, w, h);

					const sunX = w * 0.45;
					const sunY = orbitViewMode === "side" ? h * 0.72 : h * 0.65;

					// Draw Ecliptic Plane (Flat Disc / Grid)
					const eclipticRadius = w * 0.42;
					const eclipticHeight = orbitViewMode === "side" ? 6 : h * 0.22;

					// Ecliptic disc fill
					const discGrad = ctx.createRadialGradient(sunX, sunY, 0, sunX, sunY, eclipticRadius);
					discGrad.addColorStop(0, "rgba(56, 189, 248, 0.08)");
					discGrad.addColorStop(0.8, "rgba(99, 102, 241, 0.03)");
					discGrad.addColorStop(1, "rgba(99, 102, 241, 0)");
					ctx.fillStyle = discGrad;
					ctx.beginPath();
					ctx.ellipse(sunX, sunY, eclipticRadius, eclipticHeight, 0, 0, Math.PI * 2);
					ctx.fill();

					// Ecliptic plane reference line / ellipse
					ctx.strokeStyle = "rgba(148, 163, 184, 0.3)";
					ctx.lineWidth = 1;
					ctx.setLineDash([3, 3]);
					ctx.beginPath();
					ctx.ellipse(sunX, sunY, eclipticRadius, eclipticHeight, 0, 0, Math.PI * 2);
					ctx.stroke();
					ctx.setLineDash([]);

					// Ecliptic Label
					ctx.fillStyle = "rgba(148, 163, 184, 0.7)";
					ctx.font = "10px monospace";
					ctx.textAlign = "right";
					ctx.fillText(isEnPage ? "ECLIPTIC PLANE (PLANETARY DISC)" : "黄道面 (行星公转平坦盘面)", sunX + eclipticRadius - 8, sunY - 4);

					// Planetary Orbits on Ecliptic Plane
					// 1. Earth (1 AU)
					const rEarth = eclipticRadius * 0.15;
					ctx.strokeStyle = "rgba(56, 189, 248, 0.5)";
					ctx.beginPath();
					ctx.ellipse(sunX, sunY, rEarth, rEarth * (eclipticHeight / eclipticRadius), 0, 0, Math.PI * 2);
					ctx.stroke();

					// 2. Jupiter (5.2 AU)
					const rJup = eclipticRadius * 0.52;
					ctx.strokeStyle = "rgba(34, 211, 238, 0.6)";
					ctx.beginPath();
					ctx.ellipse(sunX, sunY, rJup, rJup * (eclipticHeight / eclipticRadius), 0, 0, Math.PI * 2);
					ctx.stroke();
					ctx.fillStyle = "rgba(34, 211, 238, 0.8)";
					ctx.fillText(isEnPage ? "Jupiter (5.2 AU)" : "木星轨道 (5.2 AU)", sunX - rJup - 6, sunY - 2);

					// 3. Saturn (9.5 AU)
					const rSat = eclipticRadius * 0.88;
					ctx.strokeStyle = "rgba(251, 191, 36, 0.5)";
					ctx.beginPath();
					ctx.ellipse(sunX, sunY, rSat, rSat * (eclipticHeight / eclipticRadius), 0, 0, Math.PI * 2);
					ctx.stroke();
					ctx.fillStyle = "rgba(251, 191, 36, 0.8)";
					ctx.fillText(isEnPage ? "Saturn (9.5 AU)" : "土星轨道 (9.5 AU)", sunX + rSat + 4, sunY - 2);

					// Sun at center
					const sunGrad = ctx.createRadialGradient(sunX, sunY, 0, sunX, sunY, 18);
					sunGrad.addColorStop(0, "#ffffff");
					sunGrad.addColorStop(0.3, "#fef08a");
					sunGrad.addColorStop(0.7, "#f59e0b");
					sunGrad.addColorStop(1, "rgba(245, 158, 11, 0)");
					ctx.fillStyle = sunGrad;
					ctx.beginPath();
					ctx.arc(sunX, sunY, 18, 0, Math.PI * 2);
					ctx.fill();
					ctx.fillStyle = "#ffffff";
					ctx.beginPath();
					ctx.arc(sunX, sunY, 3.5, 0, Math.PI * 2);
					ctx.fill();

					// COMET ORBIT: Steeply inclined parabola arching "straight up"
					// Parametric arch over the sun
					const archSpan = w * 0.6;
					const archApexH = h * 0.54; // arcs high above sun
					ctx.strokeStyle = "#a855f7";
					ctx.lineWidth = 2;
					ctx.beginPath();
					for (let i = 0; i <= 60; i++) {
						const norm = i / 60; // 0 to 1
						const px = sunX - archSpan * 0.5 + norm * archSpan;
						// Parabolic arch
						const hNorm = 4 * norm * (1 - norm); // 0 at ends, 1 at apex
						const py = sunY - hNorm * archApexH;
						if (i === 0) ctx.moveTo(px, py);
						else ctx.lineTo(px, py);
					}
					ctx.stroke();

					// Comet current position on the arch
					const cx = sunX - archSpan * 0.5 + cometOrbitT * archSpan;
					const chNorm = 4 * cometOrbitT * (1 - cometOrbitT);
					const cy = sunY - chNorm * archApexH;

					// Projection line down to ecliptic plane
					ctx.strokeStyle = "rgba(168, 85, 247, 0.4)";
					ctx.lineWidth = 1;
					ctx.setLineDash([3, 3]);
					ctx.beginPath();
					ctx.moveTo(cx, cy);
					ctx.lineTo(cx, sunY);
					ctx.stroke();
					ctx.setLineDash([]);

					// Projection ground shadow dot
					ctx.fillStyle = "rgba(168, 85, 247, 0.6)";
					ctx.beginPath();
					ctx.arc(cx, sunY, 2.5, 0, Math.PI * 2);
					ctx.fill();

					// Comet object with glow & tail
					const cometGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, 14);
					cometGrad.addColorStop(0, "#ffffff");
					cometGrad.addColorStop(0.4, "#d8b4fe");
					cometGrad.addColorStop(1, "rgba(168, 85, 247, 0)");
					ctx.fillStyle = cometGrad;
					ctx.beginPath();
					ctx.arc(cx, cy, 14, 0, Math.PI * 2);
					ctx.fill();

					ctx.fillStyle = "#ffffff";
					ctx.beginPath();
					ctx.arc(cx, cy, 2.8, 0, Math.PI * 2);
					ctx.fill();

					// Comet label & distance indicator
					ctx.fillStyle = "#e9d5ff";
					ctx.font = "bold 11px monospace";
					ctx.textAlign = "left";
					ctx.fillText("☄️ C/2026 S1 (Euclid)", cx + 12, cy - 6);
					ctx.font = "10px monospace";
					ctx.fillStyle = "#a855f7";
					ctx.fillText(isEnPage ? "Discovery: ~1.3B km from Earth" : "发现时距离：~13 亿公里", cx + 12, cy + 8);
					ctx.fillStyle = "rgba(216, 180, 254, 0.8)";
					ctx.fillText(isEnPage ? "Arching 'straight up' above ecliptic" : "高倾角直立拱起于黄道之上", cx + 12, cy + 20);

					ctx.restore();
				}

				function animateOrbit() {
					if (orbitPlaying) {
						cometOrbitT += 0.0015 * orbitSpeedMult;
						if (cometOrbitT > 0.88) cometOrbitT = 0.12;
						renderOrbit();
					}
					const req = requestAnimationFrame(animateOrbit);
					animFrameIds.push(req);
				}

				if (btnOrbitTogglePlay) {
					btnOrbitTogglePlay.addEventListener("click", () => {
						orbitPlaying = !orbitPlaying;
						if (textOrbitPlay) textOrbitPlay.textContent = orbitPlaying ? "暂停轨道公转动画" : "启动轨道公转动画";
						if (textOrbitPlayEn) textOrbitPlayEn.textContent = orbitPlaying ? "Pause Orbit Sim" : "Resume Orbit Sim";
					}, { signal: lifecycle.signal });
				}

				if (btnOrbitResetPos) {
					btnOrbitResetPos.addEventListener("click", () => {
						cometOrbitT = 0.35; // Discovery position (~1.3 billion km)
						renderOrbit();
					}, { signal: lifecycle.signal });
				}

				if (btnOrbitViewSide) {
					btnOrbitViewSide.addEventListener("click", () => {
						orbitViewMode = "side";
						btnOrbitViewSide.className = "px-2.5 py-1 rounded bg-slate-900/90 hover:bg-slate-800 border border-purple-500/50 text-purple-300 font-mono text-[10px] transition cursor-pointer";
						if (btnOrbitViewIso) btnOrbitViewIso.className = "px-2.5 py-1 rounded bg-slate-900/90 hover:bg-slate-800 border border-slate-700 text-slate-400 font-mono text-[10px] transition cursor-pointer";
						renderOrbit();
					}, { signal: lifecycle.signal });
				}

				if (btnOrbitViewIso) {
					btnOrbitViewIso.addEventListener("click", () => {
						orbitViewMode = "iso";
						btnOrbitViewIso.className = "px-2.5 py-1 rounded bg-slate-900/90 hover:bg-slate-800 border border-purple-500/50 text-purple-300 font-mono text-[10px] transition cursor-pointer";
						if (btnOrbitViewSide) btnOrbitViewSide.className = "px-2.5 py-1 rounded bg-slate-900/90 hover:bg-slate-800 border border-slate-700 text-slate-400 font-mono text-[10px] transition cursor-pointer";
						renderOrbit();
					}, { signal: lifecycle.signal });
				}

				if (sliderOrbitSpeed) {
					sliderOrbitSpeed.addEventListener("input", (e) => {
						orbitSpeedMult = parseFloat(e.target.value);
						if (txtOrbitSpeed) txtOrbitSpeed.textContent = `${orbitSpeedMult.toFixed(1)}×`;
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// INITIALIZATION RUNNER
				// ==========================================
				generateField(1);
				resetBlinkTimer();
				updateExposureMetrics(560.52);
				renderQuizCanvas("canvas-cand-a", "comet");
				renderQuizCanvas("canvas-cand-b", "asteroid");
				renderQuizCanvas("canvas-cand-c", "cosmic");
				renderOrbit();
				animateOrbit();

				window.addEventListener("resize", () => {
					renderGame();
					renderBlink();
					renderExposureCanvas();
					renderQuizCanvas("canvas-cand-a", "comet");
					renderQuizCanvas("canvas-cand-b", "asteroid");
					renderQuizCanvas("canvas-cand-c", "cosmic");
					renderOrbit();
				}, { signal: lifecycle.signal });
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initStreakHunter);
			} else {
				initStreakHunter();
			}
			document.addEventListener("astro:page-load", initStreakHunter);
		})();
	</script>
</MainGridLayout>
