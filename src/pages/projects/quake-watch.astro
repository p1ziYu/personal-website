		crossorigin=""
	></script>

	<!-- CLIENT-SIDE ENGINE SCRIPT -->
	<script is:inline>
		(() => {
			let cleanup = null;

			// Common geographic names dictionary for Chinese translation
			const GEO_MAP = {
				"Japan": "日本",
				"Hokkaido": "北海道",
				"Honshu": "本州",
				"Tokyo": "东京",
				"Okinawa": "冲绳",
				"Kushiro": "钏路",
				"Taiwan": "台湾",
				"Hualien": "花莲",
				"Yilan": "宜兰",
				"Taitung": "台东",
				"Taipei": "台北",
				"Philippines": "菲律宾",
				"Indonesia": "印度尼西亚",
				"Papua New Guinea": "巴布亚新几内亚",
				"New Britain": "新不列颠",
				"Vanuatu": "瓦努阿图",
				"Fiji": "斐济",
				"Tonga": "汤加",
				"Samoa": "萨摩亚",
				"Solomon Islands": "所罗门群岛",
				"New Zealand": "新西兰",
				"Kermadec Islands": "克马德克群岛",
				"Kuril Islands": "千岛群岛",
				"Kamchatka": "堪察加半岛",
				"Russia": "俄罗斯",
				"Alaska": "阿拉斯加",
