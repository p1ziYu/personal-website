				"Chile": "智利",
				"Peru": "秘鲁",
				"Ecuador": "厄瓜多尔",
				"Colombia": "哥伦比亚",
				"Argentina": "阿根廷",
				"Turkey": "土耳其",
				"Greece": "希腊",
				"Crete": "克里特岛",
				"Italy": "意大利",
				"Sicily": "西西里",
				"Iceland": "冰岛",
				"China": "中国",
				"Sichuan": "四川",
				"Xinjiang": "新疆",
				"Tibet": "西藏",
				"Xizang": "西藏",
				"Qinghai": "青海",
				"Yunnan": "云南",
				"Gansu": "甘肃",
				"Pakistan": "巴基斯坦",
				"Iran": "伊朗",
				"Afghanistan": "阿富汗",
				"India": "印度",
				"Myanmar": "缅甸",
				"Nepal": "尼泊尔"
			};

			function translateLocation(enPlace) {
				if (!enPlace) return "未知地点";
				let zh = enPlace;
				for (const [enKey, zhVal] of Object.entries(GEO_MAP)) {
					const regex = new RegExp(`\\b${enKey}\\b`, "i");
					if (regex.test(zh)) {
						zh = zh.replace(regex, zhVal);
					}
				}
				// Standard nautical / direction terms
				zh = zh.replace(/\bkm\s+(N|S|E|W|NE|NW|SE|SW)\s+of\b/gi, (_, dir) => {
					const dirMap = {
						"N": "以北", "S": "以南", "E": "以东", "W": "以西",
						"NE": "东北", "NW": "西北", "SE": "东南", "SW": "西南"
					};
					return `公里 (${dirMap[dir.toUpperCase()] || dir})`;
				});
				zh = zh.replace(/\boff the coast of\b/gi, "近海");
				zh = zh.replace(/\bregion\b/gi, "地区");
				return zh;
			}

			function formatRelativeTime(timeMs) {
				const diffSec = Math.max(0, Math.floor((Date.now() - timeMs) / 1000));
				if (diffSec < 60) {
					return { zh: "刚刚", en: "Just now" };
				}
				const diffMin = Math.floor(diffSec / 60);
				if (diffMin < 60) {
					return { zh: `${diffMin} 分钟前`, en: `${diffMin} min ago` };
				}
				const diffHours = Math.floor(diffMin / 60);
				if (diffHours < 24) {
					return { zh: `${diffHours} 小时前`, en: `${diffHours} hr${diffHours > 1 ? "s" : ""} ago` };
				}
				const diffDays = Math.floor(diffHours / 24);
				return { zh: `${diffDays} 天前`, en: `${diffDays} day${diffDays > 1 ? "s" : ""} ago` };
			}

			function getMagColor(mag) {
				if (mag < 5.0) return "#10b981"; // green
				if (mag < 6.0) return "#eab308"; // yellow
				if (mag < 7.0) return "#f97316"; // orange
				return "#ef4444"; // red
			}

			function getMagRadius(mag) {
				return Math.max(5, Math.min(32, Math.round(Math.pow(Math.max(mag, 4.0) - 2.5, 1.8) * 2.2)));
			}

			function initQuakeWatch() {
				if (cleanup) {
					cleanup();
					cleanup = null;
				}

				const lifecycle = new AbortController();
				cleanup = () => {
					lifecycle.abort();
					if (autoRefreshTimer) {
						clearInterval(autoRefreshTimer);
						autoRefreshTimer = null;
					}
					if (map) {
						try {
							map.remove();
						} catch (e) {
							// ignore map cleanup errors
						}
						map = null;
					}
				};

				// DOM references
				const statTotalCount = document.getElementById("stat-total-count");
				const statMaxMag = document.getElementById("stat-max-mag");
				const statMaxPlace = document.getElementById("stat-max-place");
				const statM6Count = document.getElementById("stat-m6-count");
				const badgeUsgs = document.getElementById("badge-usgs");
				const badgeJma = document.getElementById("badge-jma");
				const badgeEmsc = document.getElementById("badge-emsc");
				const syncIndicator = document.getElementById("sync-indicator");
				const lastUpdatedText = document.getElementById("last-updated-text");
				const btnManualRefresh = document.getElementById("btn-manual-refresh");
				const refreshIcon = document.getElementById("refresh-icon");
				const chipUsgs = document.getElementById("chip-usgs");
				const chipJma = document.getElementById("chip-jma");
				const chipEmsc = document.getElementById("chip-emsc");
				const sliderMinMag = document.getElementById("slider-min-mag");
				const labelMinMag = document.getElementById("label-min-mag");
				const inputSearch = document.getElementById("input-search");
				const toggleNotifications = document.getElementById("toggle-notifications");
				const mapEl = document.getElementById("quake-map");
				const mapFallbackEl = document.getElementById("quake-map-fallback");
				const btnResetMapView = document.getElementById("btn-reset-map-view");
				const tableBody = document.getElementById("quake-table-body");
				const emptyState = document.getElementById("quake-empty-state");
				const filteredCountBadge = document.getElementById("filtered-count-badge");

				// App State
				let allMergedEvents = [];
				let seenEventIds = new Set();
				let newlyArrivedIds = new Set();
				let isFirstLoad = true;
				let activeSources = new Set(["USGS", "JMA", "EMSC"]);
				let minMagFilter = 4.0;
				let searchQuery = "";
				let autoRefreshTimer = null;
				let isFetching = false;

				// Leaflet Map state
				let map = null;
				let markersLayer = null;
				let leafletReady = false;
				const markerMap = new Map();

				// Initialize Leaflet Map
				function initMap() {
					if (typeof window.L === "undefined" || !mapEl) {
						if (mapFallbackEl) mapFallbackEl.classList.remove("hidden");
						return;
					}
					try {
						map = L.map(mapEl, {
							center: [20, 140],
							zoom: 2,
							minZoom: 2,
							maxZoom: 10,
							worldCopyJump: true
						});

						L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png", {
							attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a>',
							subdomains: "abcd",
							maxZoom: 19
						}).addTo(map);

						markersLayer = L.layerGroup().addTo(map);
						leafletReady = true;
						if (mapFallbackEl) mapFallbackEl.classList.add("hidden");
					} catch (err) {
						console.error("Leaflet init failed:", err);
						leafletReady = false;
						if (mapFallbackEl) mapFallbackEl.classList.remove("hidden");
					}
				}

				initMap();

				// Reset Map View
				if (btnResetMapView && map) {
					btnResetMapView.addEventListener("click", () => {
						if (map) {
							map.setView([20, 140], 2, { animate: true });
						}
					}, { signal: lifecycle.signal });
				}

				// Data Fetchers
				async function fetchUsgs() {
					const urls = [
						"https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_day.geojson",
						"https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/significant_month.geojson"
					];
					const events = [];
					const seenUids = new Set();

					await Promise.allSettled(urls.map(async (url) => {
						try {
							const res = await fetch(url, { signal: lifecycle.signal });
							if (!res.ok) return;
							const data = await res.json();
							const features = data.features || [];
							for (const f of features) {
								const id = f.id || f.properties?.code;
								if (id && seenUids.has(id)) continue;
								if (id) seenUids.add(id);

								const props = f.properties || {};
								const geom = f.geometry || {};
								const coords = geom.coordinates || [0, 0, 0];
								const mag = typeof props.mag === "number" ? props.mag : parseFloat(props.mag) || 0;
								const time = props.time || 0;
								const placeEn = props.place || "Unknown location";
								const placeZh = translateLocation(placeEn);

								events.push({
									source: "USGS",
									sources: ["USGS"],
									id: `usgs_${id || time}`,
									time: time,
									mag: mag,
									place: placeEn,
									placeZh: placeZh,
									placeEn: placeEn,
									lat: coords[1] || 0,
									lon: coords[0] || 0,
									depth: Math.round((coords[2] || 0) * 10) / 10,
									tsunami: props.tsunami === 1,
									url: props.url || `https://earthquake.usgs.gov/earthquakes/eventpage/${id}`,
									maxi: null
								});
							}
						} catch (e) {
							console.warn("USGS fetch failed for", url, e);
						}
					}));

					return events;
				}

				async function fetchJma() {
					const events = [];
					try {
						const res = await fetch("https://www.jma.go.jp/bosai/quake/data/list.json", { signal: lifecycle.signal });
						if (!res.ok) return events;
						const list = await res.json();
						if (!Array.isArray(list)) return events;

						const now = Date.now();
						const jmaCodRe = /^([+-]\d+(?:\.\d+)?)([+-]\d+(?:\.\d+)?)(?:([+-]\d+))?\//;

						// Pre-fetch detail json files in background for the newest 20 entries without blocking
						const newest20 = list.slice(0, 20);
						Promise.allSettled(newest20.filter(item => item.json).map(item =>
							fetch(`https://www.jma.go.jp/bosai/quake/data/${item.json}`, { signal: lifecycle.signal }).catch(() => null)
						));

						for (const item of list) {
							if (!item.at) continue;
							const dt = new Date(item.at);
							const time = dt.getTime();
							if (isNaN(time)) continue;

							// Only catalog items within past 24 hours
							if (now - time > 24 * 3600 * 1000) continue;

							let lat = 0, lon = 0, depth = 0;
							if (item.cod) {
								const m = jmaCodRe.exec(item.cod);
								if (m) {
									lat = parseFloat(m[1]) || 0;
									lon = parseFloat(m[2]) || 0;
									depth = m[3] ? Math.abs(parseFloat(m[3])) / 1000.0 : 0;
								}
							}

							const mag = item.mag ? (parseFloat(item.mag) || 0) : 0;
							const anm = item.anm || "日本近海";
							const enAnm = item.en_anm || anm;
							const maxi = item.maxi || null;

							events.push({
								source: "JMA",
								sources: ["JMA"],
								id: `jma_${item.eid || time}`,
								time: time,
								mag: mag,
								place: anm,
								placeZh: anm,
								placeEn: enAnm,
								lat: lat,
								lon: lon,
								depth: Math.round(depth * 10) / 10,
								tsunami: false,
								url: item.json ? `https://www.jma.go.jp/bosai/quake/data/${item.json}` : "https://www.jma.go.jp/bosai/quake/",
								maxi: maxi
							});
						}
					} catch (e) {
						console.warn("JMA fetch failed:", e);
					}
					return events;
				}

				async function fetchEmsc() {
					const events = [];
					try {
						const iso24hAgo = new Date(Date.now() - 24 * 3600 * 1000).toISOString();
						const url = `https://www.seismicportal.eu/fdsnws/event/1/query?starttime=${encodeURIComponent(iso24hAgo)}&minmagnitude=4&format=json&limit=200&orderby=time`;
						const res = await fetch(url, { signal: lifecycle.signal });
						if (!res.ok) return events;
						const data = await res.json();
						const features = data.features || [];

						for (const f of features) {
							const props = f.properties || {};
							const tStr = props.time;
							if (!tStr) continue;
							const dt = new Date(tStr);
							const time = dt.getTime();
							if (isNaN(time)) continue;

							const mag = typeof props.mag === "number" ? props.mag : parseFloat(props.mag) || 0;
							const lat = typeof props.lat === "number" ? props.lat : parseFloat(props.lat) || 0;
							const lon = typeof props.lon === "number" ? props.lon : parseFloat(props.lon) || 0;
							const depth = typeof props.depth === "number" ? props.depth : parseFloat(props.depth) || 0;
							const regionEn = props.flynn_region || "Unknown region";
							const regionZh = translateLocation(regionEn);
							const unid = props.unid || f.id || `${time}`;

							events.push({
								source: "EMSC",
								sources: ["EMSC"],
								id: `emsc_${unid}`,
								time: time,
								mag: mag,
								place: regionEn,
								placeZh: regionZh,
								placeEn: regionEn,
								lat: lat,
								lon: lon,
								depth: Math.round(depth * 10) / 10,
								tsunami: false,
								url: `https://www.seismicportal.eu/event/${unid}`,
								maxi: null
							});
						}
					} catch (e) {
						console.warn("EMSC fetch failed:", e);
					}
					return events;
				}

				// Merge and Spatio-temporal Deduplication
				function mergeAndDedupe(events) {
					// Sort all events newest first
					events.sort((a, b) => b.time - a.time);

					const merged = [];
					for (const ev of events) {
						let matched = false;
						for (const target of merged) {
							const dt = Math.abs(ev.time - target.time) / 1000; // seconds
							const dlat = Math.abs(ev.lat - target.lat);
							let dlon = Math.abs(ev.lon - target.lon);
							if (dlon > 180) dlon = 360 - dlon;

							// Merge threshold: |Δtime| <= 120s AND |Δlat| <= 1.0° AND |Δlon| <= 1.0°
							if (dt <= 120 && dlat <= 1.0 && dlon <= 1.0) {
								matched = true;
								for (const s of ev.sources) {
									if (!target.sources.includes(s)) {
										target.sources.push(s);
									}
								}
								target.mag = Math.max(target.mag, ev.mag);
								if (ev.tsunami) target.tsunami = true;
								if (ev.maxi && !target.maxi) target.maxi = ev.maxi;
								if (target.depth === 0 && ev.depth > 0) target.depth = ev.depth;

								// Prefer USGS location description if available
								if (ev.source === "USGS") {
									target.place = ev.place;
									target.placeZh = ev.placeZh;
									target.placeEn = ev.placeEn;
									target.url = ev.url;
								}
								break;
							}
						}
						if (!matched) {
							merged.push({
								...ev,
								sources: [...ev.sources]
							});
						}
					}

					// Sort newest first
					merged.sort((a, b) => b.time - a.time);
					return merged;
				}

				// Check & Trigger Opt-in Desktop Notification
				function checkNotifications(mergedEvents) {
					if (!toggleNotifications || !toggleNotifications.checked) return;
					if (typeof window.Notification === "undefined") return;
					if (Notification.permission !== "granted") return;

					for (const ev of mergedEvents) {
						// Only notify for newly arrived events since page was opened, with mag >= 6.5
						if (!seenEventIds.has(ev.id) && ev.mag >= 6.5) {
							try {
								const title = `⚠️ M${ev.mag.toFixed(1)} ${ev.placeEn}`;
								const body = `${ev.placeZh} · 深度 ${ev.depth} km · 来源: ${ev.sources.join(" / ")}`;
								new Notification(title, {
									body: body,
									tag: ev.id
								});
							} catch (err) {
								console.warn("Notification error:", err);
							}
						}
					}
				}

				// Render stats cards
				function renderStats(mergedEvents, rawUsgsCount, rawJmaCount, rawEmscCount) {
					const now = Date.now();
					const past24hEvents = mergedEvents.filter(e => (now - e.time) <= 24 * 3600 * 1000);

					if (statTotalCount) {
						statTotalCount.textContent = `${past24hEvents.length}`;
					}

					let maxMagEvent = null;
					let m6Count = 0;
					for (const e of past24hEvents) {
						if (!maxMagEvent || e.mag > maxMagEvent.mag) {
							maxMagEvent = e;
						}
						if (e.mag >= 6.0) {
							m6Count++;
						}
					}

					if (statMaxMag) {
						statMaxMag.textContent = maxMagEvent && maxMagEvent.mag > 0 ? `M${maxMagEvent.mag.toFixed(1)}` : "None";
					}

					if (statMaxPlace) {
						if (maxMagEvent && maxMagEvent.mag > 0) {
							statMaxPlace.innerHTML = `<span class="lang-zh">${maxMagEvent.placeZh}</span><span class="lang-en">${maxMagEvent.placeEn}</span>`;
						} else {
							statMaxPlace.innerHTML = `<span class="lang-zh">暂无大震</span><span class="lang-en">No significant</span>`;
						}
					}

					if (statM6Count) {
						statM6Count.textContent = `${m6Count}`;
					}

					if (badgeUsgs) badgeUsgs.textContent = `USGS: ${rawUsgsCount}`;
					if (badgeJma) badgeJma.textContent = `JMA: ${rawJmaCount}`;
					if (badgeEmsc) badgeEmsc.textContent = `EMSC: ${rawEmscCount}`;
				}

				// Filter events
				function getFilteredEvents() {
					return allMergedEvents.filter(ev => {
						// Source filter: event must have at least one source in activeSources
						const hasActiveSource = ev.sources.some(s => activeSources.has(s));
						if (!hasActiveSource) return false;

						// Magnitude filter
						if (ev.mag < minMagFilter) return false;

						// Text search
						if (searchQuery.trim().length > 0) {
							const q = searchQuery.toLowerCase();
							const matchZh = ev.placeZh.toLowerCase().includes(q);
							const matchEn = ev.placeEn.toLowerCase().includes(q);
							if (!matchZh && !matchEn) return false;
						}

						return true;
					});
				}

				// Update Leaflet Map Markers
				function updateMapMarkers(filteredEvents) {
					if (!leafletReady || !markersLayer || !map) return;
					markersLayer.clearLayers();
					markerMap.clear();

					filteredEvents.forEach(ev => {
						if (!ev.lat && !ev.lon) return;

						const color = getMagColor(ev.mag);
						const radius = getMagRadius(ev.mag);

						const marker = L.circleMarker([ev.lat, ev.lon], {
							radius: radius,
							color: color,
							weight: 1.5,
							fillColor: color,
							fillOpacity: 0.65
						});

						const dateObj = new Date(ev.time);
						const localTimeStr = dateObj.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" });
						const rel = formatRelativeTime(ev.time);

						const shindoHtml = ev.maxi
							? `<div class="mt-1 text-xs text-rose-300 font-mono">
									<span class="lang-zh">最大震度: <strong>${ev.maxi}</strong> (日本震度阶)</span>
									<span class="lang-en">Max Shindo: <strong>${ev.maxi}</strong> (JMA Intensity)</span>
								</div>`
							: "";

						const tsunamiHtml = ev.tsunami
							? `<div class="mt-1 text-xs text-amber-300 font-bold">
									<span class="lang-zh">🌊 海啸预警已发布</span>
									<span class="lang-en">🌊 Tsunami Warning Active</span>
								</div>`
							: "";

						const sourcesHtml = ev.sources.map(s => `<span class="px-1.5 py-0.5 rounded bg-slate-800 text-[10px] font-mono mr-1">${s}</span>`).join("");

						const popupContent = `
							<div class="p-2 text-slate-100 font-sans max-w-[240px]">
								<div class="flex items-center justify-between gap-2 mb-1">
									<span class="text-base font-black font-mono" style="color: ${color}">M ${ev.mag.toFixed(1)}</span>
									<div class="text-[10px] text-slate-400 font-mono">
										<span class="lang-zh">${rel.zh}</span>
										<span class="lang-en">${rel.en}</span>
									</div>
								</div>
								<div class="text-xs font-bold text-white mb-1">
									<span class="lang-zh">${ev.placeZh}</span>
									<span class="lang-en">${ev.placeEn}</span>
								</div>
								<div class="text-[11px] text-slate-300 font-mono space-y-0.5">
									<div>
										<span class="lang-zh">深度: ${ev.depth} km</span>
										<span class="lang-en">Depth: ${ev.depth} km</span>
									</div>
									<div>
										<span class="lang-zh">时间: ${localTimeStr}</span>
										<span class="lang-en">Time: ${localTimeStr}</span>
									</div>
								</div>
								${shindoHtml}
								${tsunamiHtml}
								<div class="mt-2 pt-1 border-t border-slate-700/60 flex items-center justify-between text-[10px]">
									<div>${sourcesHtml}</div>
									<a href="${ev.url}" target="_blank" rel="noopener" class="text-cyan-400 hover:underline">
										<span class="lang-zh">详情 ↗</span>
										<span class="lang-en">Detail ↗</span>
									</a>
								</div>
							</div>
						`;

						marker.bindPopup(popupContent, {
							className: "quake-custom-popup",
							maxWidth: 280
						});

						markersLayer.addLayer(marker);
						markerMap.set(ev.id, marker);
					});
				}

				// Render Event List Table
				function renderTable(filteredEvents) {
					if (!tableBody) return;

					if (filteredCountBadge) {
						filteredCountBadge.textContent = `${filteredEvents.length} / ${allMergedEvents.length}`;
					}

					if (filteredEvents.length === 0) {
						tableBody.innerHTML = "";
						if (emptyState) emptyState.classList.remove("hidden");
						return;
					}

					if (emptyState) emptyState.classList.add("hidden");

					const rowsHtml = filteredEvents.map(ev => {
						const color = getMagColor(ev.mag);
						const rel = formatRelativeTime(ev.time);
						const dateObj = new Date(ev.time);
						const localTimeStr = dateObj.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" });
						const dateDateStr = dateObj.toLocaleDateString([], { month: "2-digit", day: "2-digit" });

						const isNewlyArrived = newlyArrivedIds.has(ev.id);
						const newBadgeHtml = isNewlyArrived
							? `<span class="ml-1.5 px-1 py-0.2 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-[9px] animate-pulse">
									<span class="lang-zh">新</span><span class="lang-en">NEW</span>
								</span>`
							: "";

						const shindoText = ev.maxi
							? `<div class="text-[10px] text-rose-300 font-mono mt-0.5">
									<span class="lang-zh">最大震度 ${ev.maxi}</span>
									<span class="lang-en">Max Shindo ${ev.maxi}</span>
								</div>`
							: "";

						const tsunamiBadge = ev.tsunami
							? `<span class="inline-flex items-center gap-0.5 ml-1 px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[10px]" title="Tsunami Warning">
									🌊 <span class="lang-zh">海啸预警</span><span class="lang-en">Tsunami</span>
								</span>`
							: "";

						const sourceBadges = ev.sources.map(s => {
							let badgeCls = "bg-slate-800 text-slate-300 border-slate-700";
							if (s === "USGS") badgeCls = "bg-blue-950/70 text-blue-300 border-blue-800";
							if (s === "JMA") badgeCls = "bg-rose-950/70 text-rose-300 border-rose-800";
							if (s === "EMSC") badgeCls = "bg-purple-950/70 text-purple-300 border-purple-800";
							return `<span class="px-1.5 py-0.5 rounded border text-[10px] ${badgeCls}">${s}</span>`;
						}).join(" ");

						return `
							<tr
								class="quake-row hover:bg-slate-900/80 transition cursor-pointer ${isNewlyArrived ? 'bg-emerald-950/15' : ''}"
								data-ev-id="${ev.id}"
								data-lat="${ev.lat}"
								data-lon="${ev.lon}"
							>
								<td class="py-3 px-3 whitespace-nowrap">
									<div class="flex items-center gap-1.5">
										<span class="px-2 py-0.5 rounded font-black text-xs font-mono" style="background-color: ${color}20; color: ${color}; border: 1px solid ${color}40;">
											M ${ev.mag.toFixed(1)}
										</span>
										${newBadgeHtml}
									</div>
									${shindoText}
								</td>
								<td class="py-3 px-3 whitespace-nowrap text-slate-300">
									<div class="font-bold text-slate-200">
										<span class="lang-zh">${rel.zh}</span>
										<span class="lang-en">${rel.en}</span>
									</div>
									<div class="text-[10px] text-slate-500">${dateDateStr} ${localTimeStr}</div>
								</td>
								<td class="py-3 px-3">
									<div class="font-bold text-slate-100 flex items-center">
										<span class="lang-zh">${ev.placeZh}</span>
										<span class="lang-en">${ev.placeEn}</span>
										${tsunamiBadge}
									</div>
									<div class="text-[10px] text-slate-500 font-mono">
										${ev.lat.toFixed(2)}°, ${ev.lon.toFixed(2)}°
									</div>
								</td>
								<td class="py-3 px-3 whitespace-nowrap text-slate-400">
									<span class="lang-zh">${ev.depth} 千米</span>
									<span class="lang-en">${ev.depth} km</span>
								</td>
								<td class="py-3 px-3 whitespace-nowrap">
									<div class="flex items-center gap-1">
										${sourceBadges}
									</div>
								</td>
								<td class="py-3 px-3 whitespace-nowrap text-right">
									<button
										type="button"
										class="btn-locate-row px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-rose-300 hover:text-white transition cursor-pointer active:scale-95 text-xs font-mono"
									>
										<span class="lang-zh">定位 📍</span>
										<span class="lang-en">Locate 📍</span>
									</button>
								</td>
							</tr>
						`;
					}).join("");

					tableBody.innerHTML = rowsHtml;

					// Attach Row Click handlers for map pan/highlight
					const rows = tableBody.querySelectorAll(".quake-row");
					rows.forEach(row => {
						const evId = row.dataset.evId;
						const lat = parseFloat(row.dataset.lat);
						const lon = parseFloat(row.dataset.lon);

						row.addEventListener("click", () => {
							// Remove active highlight from other rows
							rows.forEach(r => r.classList.remove("bg-rose-950/40", "border-l-2", "border-rose-500"));
							row.classList.add("bg-rose-950/40", "border-l-2", "border-rose-500");

							if (leafletReady && map && !isNaN(lat) && !isNaN(lon)) {
								map.flyTo([lat, lon], Math.max(map.getZoom(), 5), {
									duration: 0.8
								});
								const marker = markerMap.get(evId);
								if (marker) {
									setTimeout(() => {
										marker.openPopup();
									}, 850);
								}
							}
						}, { signal: lifecycle.signal });
					});
				}

				function refreshUI() {
					const filtered = getFilteredEvents();
					renderTable(filtered);
					updateMapMarkers(filtered);
				}

				// Synchronize Data from All Sources
				async function syncAllSources() {
					if (isFetching) return;
					isFetching = true;

					if (refreshIcon) refreshIcon.classList.add("animate-spin");
					if (syncIndicator) {
						syncIndicator.className = "w-2 h-2 rounded-full bg-amber-400 animate-ping";
					}

					try {
						const [usgsRes, jmaRes, emscRes] = await Promise.allSettled([
							fetchUsgs(),
							fetchJma(),
							fetchEmsc()
						]);

						const rawUsgs = usgsRes.status === "fulfilled" ? usgsRes.value : [];
						const rawJma = jmaRes.status === "fulfilled" ? jmaRes.value : [];
						const rawEmsc = emscRes.status === "fulfilled" ? emscRes.value : [];

						const rawTotal = [...rawUsgs, ...rawJma, ...rawEmsc];
						const merged = mergeAndDedupe(rawTotal);

						// Determine newly arrived events
						newlyArrivedIds.clear();
						if (!isFirstLoad) {
							for (const ev of merged) {
								if (!seenEventIds.has(ev.id)) {
									newlyArrivedIds.add(ev.id);
								}
							}
						}

						// Check opt-in notification for newly seen quakes >= M6.5
						checkNotifications(merged);

						// Update seen events set
						for (const ev of merged) {
							seenEventIds.add(ev.id);
						}
						isFirstLoad = false;

						allMergedEvents = merged;

						// Render stats & update UI
						renderStats(merged, rawUsgs.length, rawJma.length, rawEmsc.length);
						refreshUI();

						// Update Last Updated timestamp
						const nowStr = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" });
						if (lastUpdatedText) {
							lastUpdatedText.innerHTML = `<span class="lang-zh">更新于: ${nowStr}</span><span class="lang-en">Updated: ${nowStr}</span>`;
						}

						if (syncIndicator) {
							syncIndicator.className = "w-2 h-2 rounded-full bg-emerald-400";
						}
					} catch (err) {
						console.error("Sync error:", err);
						if (syncIndicator) {
							syncIndicator.className = "w-2 h-2 rounded-full bg-rose-500";
						}
					} finally {
						isFetching = false;
						if (refreshIcon) refreshIcon.classList.remove("animate-spin");
					}
				}

				// Manual refresh button listener
				if (btnManualRefresh) {
					btnManualRefresh.addEventListener("click", () => {
						syncAllSources();
					}, { signal: lifecycle.signal });
				}

				// Filter Listeners: Source Chips
				[chipUsgs, chipJma, chipEmsc].forEach(chip => {
					if (!chip) return;
					const src = chip.dataset.source;
					chip.addEventListener("click", () => {
						if (activeSources.has(src)) {
							// Prevent unchecking all
							if (activeSources.size > 1) {
								activeSources.delete(src);
								chip.classList.remove("active", "bg-blue-950/60", "bg-rose-950/60", "bg-purple-950/60", "border-blue-600", "border-rose-600", "border-purple-600");
								chip.classList.add("bg-slate-900", "border-slate-800", "text-slate-500");
								chip.textContent = `○ ${src}`;
							}
						} else {
							activeSources.add(src);
							chip.classList.add("active");
							chip.classList.remove("bg-slate-900", "border-slate-800", "text-slate-500");
							if (src === "USGS") {
								chip.classList.add("bg-blue-950/60", "border-blue-600", "text-blue-300");
								chip.textContent = `✓ USGS`;
							} else if (src === "JMA") {
								chip.classList.add("bg-rose-950/60", "border-rose-600", "text-rose-300");
								chip.textContent = `✓ JMA (日本)`;
							} else if (src === "EMSC") {
								chip.classList.add("bg-purple-950/60", "border-purple-600", "text-purple-300");
								chip.textContent = `✓ EMSC (欧洲)`;
							}
						}
						refreshUI();
					}, { signal: lifecycle.signal });
				});

				// Min Magnitude Slider
				if (sliderMinMag && labelMinMag) {
					sliderMinMag.addEventListener("input", (e) => {
						minMagFilter = parseFloat(e.target.value);
						labelMinMag.textContent = `≥ M${minMagFilter.toFixed(1)}`;
						refreshUI();
					}, { signal: lifecycle.signal });
				}

				// Search query
				if (inputSearch) {
					inputSearch.addEventListener("input", (e) => {
						searchQuery = e.target.value;
						refreshUI();
					}, { signal: lifecycle.signal });
				}

				// Notification toggle
				if (toggleNotifications) {
					toggleNotifications.addEventListener("change", async () => {
						if (toggleNotifications.checked) {
							if (typeof window.Notification === "undefined") {
								alert("This browser does not support notifications.");
								toggleNotifications.checked = false;
								return;
							}
							if (Notification.permission === "default") {
								const perm = await Notification.requestPermission();
								if (perm !== "granted") {
									toggleNotifications.checked = false;
								}
							} else if (Notification.permission === "denied") {
								alert("Notification permission is blocked in browser settings.");
								toggleNotifications.checked = false;
							}
						}
					}, { signal: lifecycle.signal });
				}

				// Initial sync and start 60s auto-refresh
				syncAllSources();
				autoRefreshTimer = setInterval(syncAllSources, 60000);
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initQuakeWatch);
			} else {
				initQuakeWatch();
			}
			document.addEventListener("astro:page-load", initQuakeWatch);
		})();
	</script>

	<!-- Custom styling for Leaflet Dark Mode Popup -->
	<style is:global>
		.quake-custom-popup .leaflet-popup-content-wrapper {
			background: rgba(10, 15, 30, 0.95) !important;
			border: 1px solid rgba(51, 65, 85, 0.8) !important;
			border-radius: 12px !important;
			box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.7), 0 8px 10px -6px rgba(0, 0, 0, 0.7) !important;
			backdrop-filter: blur(8px);
			padding: 0 !important;
		}
		.quake-custom-popup .leaflet-popup-content {
			margin: 0 !important;
			line-height: 1.4 !important;
		}
		.quake-custom-popup .leaflet-popup-tip {
			background: rgba(10, 15, 30, 0.95) !important;
			border: 1px solid rgba(51, 65, 85, 0.8) !important;
		}
		.quake-custom-popup a.leaflet-popup-close-button {
			color: #94a3b8 !important;
			padding: 4px 6px 0 0 !important;
		}
		.quake-custom-popup a.leaflet-popup-close-button:hover {
			color: #ffffff !important;
		}
	</style>
</MainGridLayout>
