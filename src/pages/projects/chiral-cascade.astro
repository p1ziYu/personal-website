							x: Math.random() * (w - 40) + 20,
							y: Math.random() * (h - 40) + 20,
							vx: (Math.random() - 0.5) * 0.45,
							vy: (Math.random() - 0.5) * 0.45,
							angle: Math.random() * Math.PI * 2,
							vAngle: (Math.random() - 0.5) * 0.02,
							hand: hands[i], // -1 = Left (S cyan), +1 = Right (R amber)
							pulse: 0,
							scheduledFlip: null,
						});
					}

					cycleHistory = [{
						cycle: 0,
						ee: eePercent,
						dominantHand: preferredHand,
						numLeft: numLeft,
						numRight: numRight,
					}];

					waveFronts = [];
					updateTelemetry();
					renderChart();
				}

				// Calculate live telemetry numbers
				function updateTelemetry() {
					let leftCount = 0;
					let rightCount = 0;
					for (const p of particles) {
						if (p.hand === -1) leftCount++;
						else rightCount++;
					}

					const total = particles.length;
					let liveEe = (Math.abs(leftCount - rightCount) / total) * 100;

					// If in cycle 0 with microscopic seed and 200/200, preserve the microscopic seed in readout
					if (currentCycle === 0 && leftCount === 200 && rightCount === 200) {
						liveEe = microscopicSeed;
					}

					// Update ee display
					let eeStr = "";
					if (liveEe < 0.001) {
						eeStr = liveEe.toFixed(5) + "% ee";
					} else if (liveEe < 0.1) {
						eeStr = liveEe.toFixed(4) + "% ee";
					} else if (liveEe < 10) {
						eeStr = liveEe.toFixed(2) + "% ee";
					} else {
						eeStr = liveEe.toFixed(1) + "% ee";
					}
					if (statEe) statEe.textContent = eeStr;

					// Major hand tag
					if (statDomTag) {
						if (leftCount > rightCount || (leftCount === rightCount && dominantHand === -1 && microscopicSeed > 0)) {
							statDomTag.textContent = "(S) Dominant · 左手性";
							statDomTag.className = "text-xs font-mono font-bold px-2.5 py-1 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/60";
							if (statEe) statEe.className = "font-mono text-3xl sm:text-5xl font-black text-cyan-300 tracking-wider drop-shadow-[0_0_15px_rgba(6,182,212,0.7)]";
						} else if (rightCount > leftCount || (leftCount === rightCount && dominantHand === 1 && microscopicSeed > 0)) {
							statDomTag.textContent = "(R) Dominant · 右手性";
							statDomTag.className = "text-xs font-mono font-bold px-2.5 py-1 rounded bg-amber-950 text-amber-300 border border-amber-800/60";
							if (statEe) statEe.className = "font-mono text-3xl sm:text-5xl font-black text-amber-300 tracking-wider drop-shadow-[0_0_15px_rgba(245,158,11,0.7)]";
						} else {
							statDomTag.textContent = "Racemic · 外消旋 50:50";
							statDomTag.className = "text-xs font-mono font-bold px-2.5 py-1 rounded bg-zinc-900 text-zinc-400 border border-zinc-700";
							if (statEe) statEe.className = "font-mono text-3xl sm:text-5xl font-black text-zinc-300 tracking-wider";
						}
					}

					if (statCycleBadge) statCycleBadge.textContent = `CYCLE ${currentCycle}`;
					if (statHandBadge) {
						if (leftCount > rightCount) {
							statHandBadge.textContent = `${((leftCount / total) * 100).toFixed(1)}% (S)`;
							statHandBadge.className = "text-cyan-400";
						} else if (rightCount > leftCount) {
							statHandBadge.textContent = `${((rightCount / total) * 100).toFixed(1)}% (R)`;
							statHandBadge.className = "text-amber-400";
						} else {
							statHandBadge.textContent = "50:50 RACEMIC";
							statHandBadge.className = "text-zinc-400";
						}
					}

					if (statLeftCount) statLeftCount.textContent = `${leftCount} (S)`;
					if (statRightCount) statRightCount.textContent = `${rightCount} (R)`;

					const leftPct = ((leftCount / total) * 100).toFixed(1);
					const rightPct = ((rightCount / total) * 100).toFixed(1);
					if (barLeftPct) barLeftPct.textContent = `${leftPct}%`;
					if (barRightPct) barRightPct.textContent = `${rightPct}%`;
					if (barFillLeft) barFillLeft.style.width = `${leftPct}%`;
					if (barFillRight) barFillRight.style.width = `${rightPct}%`;

					// Amplification factor
					if (statAmplification) {
						if (microscopicSeed > 0) {
							const factor = Math.max(1.0, liveEe / microscopicSeed);
							if (factor > 100000) {
								statAmplification.textContent = (factor / 1000000).toFixed(2) + "M×";
							} else if (factor > 1000) {
								statAmplification.textContent = factor.toFixed(0) + "×";
							} else {
								statAmplification.textContent = factor.toFixed(1) + "×";
							}
						} else {
							statAmplification.textContent = "1.0× (Noise)";
						}
					}
				}

				// Execute 1 Autocatalytic Cycle
				function runCycle() {
					currentCycle++;

					let numLeft = 0;
					let numRight = 0;
					for (const p of particles) {
						if (p.hand === -1) numLeft++;
						else numRight++;
					}

					// Check symmetry condition
					if (numLeft === numRight) {
						if (dominantHand === 0 && microscopicSeed === 0) {
							// Exact 50/50 with zero noise: field stays balanced!
							showToast("⚖️", "对称态停滞：50/50 且无噪声下无偏向。请点击‘热涨落扰动’或使用预设。");
							cycleHistory.push({
								cycle: currentCycle,
								ee: 0,
								dominantHand: 0,
								numLeft: 200,
								numRight: 200,
							});
							updateTelemetry();
							renderChart();
							return;
						}
					}

					// Determine majority hand
					let winHand = dominantHand;
					if (numLeft > numRight) winHand = -1;
					else if (numRight > numLeft) winHand = 1;
					else if (winHand === 0) {
						// Random spontaneous symmetry break
						winHand = Math.random() < 0.5 ? -1 : 1;
					}
					dominantHand = winHand;

					// Target ee progression for Soai / non-linear autocatalytic model
					let targetEe = 0;
					if (currentPreset === "soai" && microscopicSeed === 0.00005) {
						// Faithful 1995 Soai reaction exponential cascade
						if (currentCycle === 1) targetEe = 3.2; // 206 vs 194
						else if (currentCycle === 2) targetEe = 31.5; // 263 vs 137
						else if (currentCycle === 3) targetEe = 86.4; // 373 vs 27
						else if (currentCycle === 4) targetEe = 99.6; // 399 vs 1
						else targetEe = 100.0;
					} else {
						// General Kagan-Soai non-linear dimer amplification model
						const currentFrac = Math.max(numLeft, numRight) / NUM_PARTICLES;
						// Dimeric non-linear cooperative recruitment
						const nextMajorityFrac = Math.min(1.0, Math.pow(currentFrac, 1.8) / (Math.pow(currentFrac, 1.8) + Math.pow(1 - currentFrac, 1.8)) + 0.05);
						targetEe = (nextMajorityFrac - (1 - nextMajorityFrac)) * 100;
					}

					// Calculate how many minority particles must flip to majority
					const targetMajorityCount = Math.min(NUM_PARTICLES, Math.round(NUM_PARTICLES * (0.5 + targetEe / 200)));
					const currentMajorityCount = winHand === -1 ? numLeft : numRight;
					const flipsNeeded = Math.max(0, targetMajorityCount - currentMajorityCount);

					// Candidate particles that have the minority hand
					const candidates = particles.filter((p) => p.hand !== winHand);

					if (candidates.length === 0 || flipsNeeded === 0) {
						showToast("🎉", "单一手性完成：已达到 100% 绝对纯手性 (>99.5% ee)！");
						if (isAutoRunning) toggleAutoRun();
						return;
					}

					// Catalytic epicenter (center of canvas or centroid of majority)
					const rect = canvas.getBoundingClientRect();
					const centerX = rect.width / 2;
					const centerY = rect.height / 2;

					// Trigger expanding visual wave
					waveFronts.push({
						x: centerX,
						y: centerY,
						radius: 0,
						maxRadius: Math.hypot(centerX, centerY) * 1.2,
						alpha: 1.0,
						color: winHand === -1 ? "#06b6d4" : "#f59e0b",
					});

					// Sort candidates by proximity to center to simulate a catalytic wave outward
					candidates.sort((a, b) => {
						const distA = Math.hypot(a.x - centerX, a.y - centerY);
						const distB = Math.hypot(b.x - centerX, b.y - centerY);
						return distA - distB;
					});

					const flipBatch = candidates.slice(0, flipsNeeded);
					const maxDelay = 750; // ms wave duration

					flipBatch.forEach((p, idx) => {
						const delay = (idx / flipBatch.length) * maxDelay;
						setTimeout(() => {
							p.hand = winHand;
							p.pulse = 1.0;
							updateTelemetry();
						}, delay);
					});

					// Complete cycle recording
					setTimeout(() => {
						let finalLeft = 0;
						let finalRight = 0;
						for (const p of particles) {
							if (p.hand === -1) finalLeft++;
							else finalRight++;
						}
						const finalEe = (Math.abs(finalLeft - finalRight) / NUM_PARTICLES) * 100;

						cycleHistory.push({
							cycle: currentCycle,
							ee: finalEe,
							dominantHand: winHand,
							numLeft: finalLeft,
							numRight: finalRight,
						});

						updateTelemetry();
						renderChart();

						const handLabel = winHand === -1 ? "(S) 左手性" : "(R) 右手性";
						showToast(
							"⚡",
							`循环 ${currentCycle} 完成：自催化招募 +${flipsNeeded} 分子 · ee 跃升至 ${finalEe.toFixed(1)}% (${handLabel})`,
						);

						if (finalEe >= 99.5 && isAutoRunning) {
							toggleAutoRun();
							showToast("🏆", `雪崩达标：在第 ${currentCycle} 轮成功超越 >99.5% ee 单一手性纯度！`);
						}
					}, maxDelay + 50);
				}

				// Auto-run toggle
				function toggleAutoRun() {
					isAutoRunning = !isAutoRunning;
					if (isAutoRunning) {
						if (autoRunIcon) autoRunIcon.textContent = "⏸️";
						btnAutoRun.classList.add("border-cyan-400", "bg-cyan-950/60", "text-cyan-300");
						autoRunTimer = setInterval(() => {
							runCycle();
						}, 1400);
					} else {
						if (autoRunIcon) autoRunIcon.textContent = "▶️";
						btnAutoRun.classList.remove("border-cyan-400", "bg-cyan-950/60", "text-cyan-300");
						if (autoRunTimer) {
							clearInterval(autoRunTimer);
							autoRunTimer = null;
						}
					}
				}

				// Inject random thermal noise
				function injectNoise() {
					if (particles.length === 0) return;
					// Pick 1 random particle and flip it
					const p = particles[Math.floor(Math.random() * particles.length)];
					p.hand = -p.hand;
					p.pulse = 1.0;
					showToast("🎲", `热涨落扰动：单分子偶然翻转，微观打破对称平衡！`);
					updateTelemetry();
				}

				// Render ee vs cycle chart
				function renderChart() {
					const rect = chartCanvas.getBoundingClientRect();
					const w = rect.width;
					const h = rect.height;
					if (w === 0 || h === 0) return;

					chartCtx.clearRect(0, 0, w, h);

					const padLeft = 28;
					const padRight = 14;
					const padTop = 14;
					const padBottom = 22;
					const plotW = w - padLeft - padRight;
					const plotH = h - padTop - padBottom;

					// Background grid lines
					chartCtx.strokeStyle = "rgba(255, 255, 255, 0.08)";
					chartCtx.lineWidth = 1;

					// 0%, 50%, 100% lines
					[0, 0.5, 1.0].forEach((yFrac) => {
						const y = padTop + plotH * (1 - yFrac);
						chartCtx.beginPath();
						chartCtx.moveTo(padLeft, y);
						chartCtx.lineTo(padLeft + plotW, y);
						chartCtx.stroke();

						chartCtx.fillStyle = "rgba(161, 161, 170, 0.6)";
						chartCtx.font = "9px monospace";
						chartCtx.fillText(`${Math.round(yFrac * 100)}%`, 2, y + 3);
					});

					// 99.5% threshold line (dashed amber)
					const y99 = padTop + plotH * (1 - 0.995);
					chartCtx.save();
					chartCtx.setLineDash([3, 3]);
					chartCtx.strokeStyle = "rgba(245, 158, 11, 0.5)";
					chartCtx.beginPath();
					chartCtx.moveTo(padLeft, y99);
					chartCtx.lineTo(padLeft + plotW, y99);
					chartCtx.stroke();
					chartCtx.restore();

					if (cycleHistory.length === 0) return;

					// Max cycle for x-axis scale
					const maxC = Math.max(5, currentCycle, cycleHistory.length - 1);
					const maxCycleEl = document.getElementById("chart-max-cycle");
					if (maxCycleEl) maxCycleEl.textContent = `Cycle ${maxC}`;

					// X-axis coordinate mapper
					const getX = (c) => padLeft + (c / maxC) * plotW;
					const getY = (ee) => padTop + plotH * (1 - Math.min(100, ee) / 100);

					// Draw connecting line
					chartCtx.beginPath();
					cycleHistory.forEach((pt, i) => {
						const x = getX(pt.cycle);
						const y = getY(pt.ee);
						if (i === 0) chartCtx.moveTo(x, y);
						else chartCtx.lineTo(x, y);
					});

					const lastPt = cycleHistory[cycleHistory.length - 1];
					const strokeColor = lastPt && lastPt.dominantHand === 1 ? "#f59e0b" : "#06b6d4";
					chartCtx.strokeStyle = strokeColor;
					chartCtx.lineWidth = 2.5;
					chartCtx.stroke();

					// Draw glowing points
					cycleHistory.forEach((pt, i) => {
						const x = getX(pt.cycle);
						const y = getY(pt.ee);

						chartCtx.fillStyle = pt.dominantHand === 1 ? "#f59e0b" : "#06b6d4";
						chartCtx.beginPath();
						chartCtx.arc(x, y, i === cycleHistory.length - 1 ? 4.5 : 3, 0, Math.PI * 2);
						chartCtx.fill();

						if (i === cycleHistory.length - 1) {
							// Outer ring
							chartCtx.strokeStyle = "#ffffff";
							chartCtx.lineWidth = 1.5;
							chartCtx.beginPath();
							chartCtx.arc(x, y, 6, 0, Math.PI * 2);
							chartCtx.stroke();
						}
					});
				}

				// Draw a single handed molecule glyph
				function drawMolecule(p) {
					ctx.save();
					ctx.translate(p.x, p.y);
					ctx.rotate(p.angle);

					const isLeft = p.hand === -1;
					const accentColor = isLeft ? "#06b6d4" : "#f59e0b";
					const coreColor = isLeft ? "#67e8f9" : "#fbbf24";
					const haloColor = isLeft ? "rgba(6, 182, 212, 0.28)" : "rgba(245, 158, 11, 0.28)";

					// Flaring pulse during flip
					if (p.pulse > 0) {
						const s = 1.0 + p.pulse * 0.45;
						ctx.scale(s, s);

						// White flash core
						ctx.fillStyle = `rgba(255, 255, 255, ${p.pulse * 0.8})`;
						ctx.beginPath();
						ctx.arc(0, 0, 7, 0, Math.PI * 2);
						ctx.fill();
					}

					// Ambient soft halo
					ctx.fillStyle = haloColor;
					ctx.beginPath();
					ctx.arc(0, 0, 4.5, 0, Math.PI * 2);
					ctx.fill();

					// Handed 3-blade curved pinwheel / spiral
					// Curvature sign: -1 for Left (CCW), +1 for Right (CW)
					const curvature = isLeft ? -1 : 1;
					const armColor = p.pulse > 0.4 ? "#ffffff" : accentColor;
					const beadColor = p.pulse > 0.4 ? "#ffffff" : coreColor;

					ctx.strokeStyle = armColor;
					ctx.lineWidth = 1.6;

					for (let k = 0; k < 3; k++) {
						const phi = (k * 2 * Math.PI) / 3;
						const r0 = 2.4;
						const startX = r0 * Math.cos(phi);
						const startY = r0 * Math.sin(phi);

						// Quadratic curve control point bending in direction of chirality
						const cpAngle = phi + curvature * 0.65;
						const cpR = 5.6;
						const cpX = cpR * Math.cos(cpAngle);
						const cpY = cpR * Math.sin(cpAngle);

						// Arm tip
						const endAngle = phi + curvature * 0.98;
						const endR = 8.2;
						const endX = endR * Math.cos(endAngle);
						const endY = endR * Math.sin(endAngle);

						ctx.beginPath();
						ctx.moveTo(startX, startY);
						ctx.quadraticCurveTo(cpX, cpY, endX, endY);
						ctx.stroke();

						// Tip atom sphere
						ctx.fillStyle = beadColor;
						ctx.beginPath();
						ctx.arc(endX, endY, 1.3, 0, Math.PI * 2);
						ctx.fill();
					}

					// Center stereocenter nucleus
					ctx.fillStyle = p.pulse > 0.5 ? "#ffffff" : coreColor;
					ctx.beginPath();
					ctx.arc(0, 0, 2.2, 0, Math.PI * 2);
					ctx.fill();

					ctx.restore();

					// Expanding shockwave ripple ring during conversion
					if (p.pulse > 0) {
						ctx.strokeStyle = `rgba(255, 255, 255, ${p.pulse * 0.7})`;
						ctx.lineWidth = 1.4;
						ctx.beginPath();
						ctx.arc(p.x, p.y, (1.0 - p.pulse) * 22 + 5, 0, Math.PI * 2);
						ctx.stroke();

						p.pulse = Math.max(0, p.pulse - 0.024);
					}
				}

				// Main canvas animation loop
				function render() {
					const rect = canvas.getBoundingClientRect();
					const w = rect.width;
					const h = rect.height;

					// Deep reaction vessel background
					ctx.fillStyle = "#030814";
					ctx.fillRect(0, 0, w, h);

					// Subtle grid lines inside canvas
					ctx.strokeStyle = "rgba(6, 182, 212, 0.05)";
					ctx.lineWidth = 1;
					const gridSize = 40;
					for (let x = 0; x < w; x += gridSize) {
						ctx.beginPath();
						ctx.moveTo(x, 0);
						ctx.lineTo(x, h);
						ctx.stroke();
					}
					for (let y = 0; y < h; y += gridSize) {
						ctx.beginPath();
						ctx.moveTo(0, y);
						ctx.lineTo(w, y);
						ctx.stroke();
					}

					// Render expanding catalytic wavefront rings
					for (let i = waveFronts.length - 1; i >= 0; i--) {
						const wf = waveFronts[i];
						wf.radius += 5.5;
						wf.alpha = Math.max(0, 1.0 - wf.radius / wf.maxRadius);

						ctx.save();
						ctx.strokeStyle = wf.color;
						ctx.globalAlpha = wf.alpha * 0.6;
						ctx.lineWidth = 3;
						ctx.shadowColor = wf.color;
						ctx.shadowBlur = 12;
						ctx.beginPath();
						ctx.arc(wf.x, wf.y, wf.radius, 0, Math.PI * 2);
						ctx.stroke();
						ctx.restore();

						if (wf.radius >= wf.maxRadius || wf.alpha <= 0) {
							waveFronts.splice(i, 1);
						}
					}

					// Update & draw particles
					for (const p of particles) {
						// Brownian drift
						p.x += p.vx;
						p.y += p.vy;
						p.angle += p.vAngle;

						// Soft boundary bounce
						if (p.x < 16) {
							p.x = 16;
							p.vx = -p.vx;
						} else if (p.x > w - 16) {
							p.x = w - 16;
							p.vx = -p.vx;
						}
						if (p.y < 16) {
							p.y = 16;
							p.vy = -p.vy;
						} else if (p.y > h - 16) {
							p.y = h - 16;
							p.vy = -p.vy;
						}

						drawMolecule(p);
					}

					animId = requestAnimationFrame(render);
				}

				// EVENT LISTENERS
				window.addEventListener("resize", resizeCanvases);

				if (btnRunCycle) {
					btnRunCycle.addEventListener("click", () => {
						runCycle();
					});
				}

				if (btnAutoRun) {
					btnAutoRun.addEventListener("click", () => {
						toggleAutoRun();
					});
				}

				if (btnReseed) {
					btnReseed.addEventListener("click", () => {
						const ee = sliderToEe(Number(sliderImbalance.value));
						seedParticles(ee, dominantHand || -1);
						showToast("🔄", `反应池重置完成：初始 ee = ${ee < 0.001 ? ee.toFixed(5) : ee.toFixed(2)}%`);
					});
				}

				if (btnNoise) {
					btnNoise.addEventListener("click", () => {
						injectNoise();
					});
				}

				// Presets click handlers
				function applyPreset(name) {
					currentPreset = name;
					if (name === "soai") {
						sliderImbalance.value = "0";
						if (sliderValBadge) sliderValBadge.textContent = "ee = 0.00005%";
						if (seedStateBadge) seedStateBadge.textContent = "🧪 Soai 1995 经典起点 (5 / 10,000,000)";
						presetSoai.className = "px-2.5 py-1 rounded-md bg-cyan-950 border border-cyan-400 text-cyan-200 transition active:scale-95";
						presetCoin.className = "px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-700 text-zinc-300 transition active:scale-95";
						presetLean.className = "px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-700 text-zinc-300 transition active:scale-95";
						seedParticles(0.00005, -1);
						showToast("🧪", "已载入 Soai 1995 经典起点：初始 ee 0.00005%（千万分之五）。点击 RUN CYCLE 见证数轮雪崩放大至 >99.5%！");
					} else if (name === "coin") {
						sliderImbalance.value = "0";
						if (sliderValBadge) sliderValBadge.textContent = "ee = 0.0% (50/50)";
						if (seedStateBadge) seedStateBadge.textContent = "🪙 纯对称外消旋态 (Coin flip)";
						presetSoai.className = "px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-700 text-zinc-300 transition active:scale-95";
						presetCoin.className = "px-2.5 py-1 rounded-md bg-zinc-800 border border-zinc-400 text-white transition active:scale-95";
						presetLean.className = "px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-700 text-zinc-300 transition active:scale-95";
						seedParticles(0.0, 0);
						showToast("🪙", "已载入 Coin flip 预设：严格 50/50 对称。自催化循环将依赖随机微观涨落决定胜出方向！");
					} else if (name === "lean") {
						sliderImbalance.value = String(eeToSlider(5.0));
						if (sliderValBadge) sliderValBadge.textContent = "ee = 5.0%";
						if (seedStateBadge) seedStateBadge.textContent = "📈 明显倾斜预设 (Slight lean 5%)";
						presetSoai.className = "px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-700 text-zinc-300 transition active:scale-95";
						presetCoin.className = "px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-700 text-zinc-300 transition active:scale-95";
						presetLean.className = "px-2.5 py-1 rounded-md bg-amber-950 border border-amber-400 text-amber-200 transition active:scale-95";
						seedParticles(5.0, -1);
						showToast("📈", "已载入 Slight lean 预设：初始 5% ee 优势，将在 2-3 轮内迅速接管全场。");
					}
				}

				if (presetSoai) presetSoai.addEventListener("click", () => applyPreset("soai"));
				if (presetCoin) presetCoin.addEventListener("click", () => applyPreset("coin"));
				if (presetLean) presetLean.addEventListener("click", () => applyPreset("lean"));

				// Slider changes
				if (sliderImbalance) {
					sliderImbalance.addEventListener("input", (e) => {
						currentPreset = "custom";
						const ee = sliderToEe(Number(e.target.value));
						if (sliderValBadge) {
							sliderValBadge.textContent = `ee = ${ee < 0.001 ? ee.toFixed(5) : ee.toFixed(2)}%`;
						}
						if (seedStateBadge) {
							seedStateBadge.textContent = `自定义初始偏量: ${ee < 0.001 ? ee.toFixed(5) : ee.toFixed(2)}%`;
						}
					});

					sliderImbalance.addEventListener("change", (e) => {
						const ee = sliderToEe(Number(e.target.value));
						seedParticles(ee, dominantHand || -1);
					});
				}

				// Quick ee buttons
				if (quickEeSoai) quickEeSoai.addEventListener("click", () => applyPreset("soai"));
				if (quickEeCoin) quickEeCoin.addEventListener("click", () => applyPreset("coin"));
				if (quickEePoint1) {
					quickEePoint1.addEventListener("click", () => {
						currentPreset = "custom";
						sliderImbalance.value = String(eeToSlider(0.1));
						if (sliderValBadge) sliderValBadge.textContent = "ee = 0.1%";
						seedParticles(0.1, -1);
					});
				}
				if (quickEe1) {
					quickEe1.addEventListener("click", () => {
						currentPreset = "custom";
						sliderImbalance.value = String(eeToSlider(1.0));
						if (sliderValBadge) sliderValBadge.textContent = "ee = 1.0%";
						seedParticles(1.0, -1);
					});
				}
				if (quickEe5) quickEe5.addEventListener("click", () => applyPreset("lean"));
				if (quickEe25) {
					quickEe25.addEventListener("click", () => {
						currentPreset = "custom";
						sliderImbalance.value = String(eeToSlider(25.0));
						if (sliderValBadge) sliderValBadge.textContent = "ee = 25.0%";
						seedParticles(25.0, -1);
					});
				}

				// INITIALIZATION
				resizeCanvases();
				applyPreset("soai");
				render();
			}

			// Clean up animation on Astro page swap
			window.addEventListener(
				"astro:before-swap",
				() => {
					if (animId) cancelAnimationFrame(animId);
					if (autoRunTimer) clearInterval(autoRunTimer);
				},
				{ once: true },
			);

			// Init on current load and future Swup page transitions
			initChiralCascade();
			document.addEventListener("astro:page-load", initChiralCascade);
		})();
	</script>
</MainGridLayout>
