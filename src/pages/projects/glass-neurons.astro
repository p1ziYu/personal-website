				const tlBtns = [
					document.getElementById("tl-btn-0"),
					document.getElementById("tl-btn-1"),
					document.getElementById("tl-btn-2"),
					document.getElementById("tl-btn-3"),
					document.getElementById("tl-btn-4"),
					document.getElementById("tl-btn-5")
				];

				const tlBadge = document.getElementById("tl-detail-badge");
				const tlMeta = document.getElementById("tl-detail-meta");
				const tlTitle = document.getElementById("tl-detail-title");
				const tlBody = document.getElementById("tl-detail-body");
				const tlQuote = document.getElementById("tl-detail-quote");

				function selectTimelineNode(idx) {
					tlBtns.forEach((btn, i) => {
						if (!btn) return;
						if (i === idx) {
							btn.className = "tl-btn p-3 rounded-xl bg-slate-950 border border-emerald-500 text-left cursor-pointer transition active:scale-95 shadow-[0_0_15px_rgba(16,185,129,0.15)]";
							const dot = btn.querySelector(".tl-dot");
							if (dot) dot.className = "w-2 h-2 rounded-full bg-emerald-400 animate-pulse tl-dot";
						} else {
							btn.className = "tl-btn p-3 rounded-xl bg-slate-950 border border-slate-800 text-left cursor-pointer transition active:scale-95 hover:border-slate-700";
							const dot = btn.querySelector(".tl-dot");
							if (dot) dot.className = "w-2 h-2 rounded-full bg-slate-600 tl-dot";
						}
					});

					const item = timelineMilestones[idx];
					if (tlBadge) tlBadge.innerHTML = `<span class="lang-zh">${item.dateZh}</span><span class="lang-en">${item.dateEn}</span>`;
					if (tlMeta) tlMeta.innerHTML = `<span class="lang-zh">${item.metaZh}</span><span class="lang-en">${item.metaEn}</span>`;
					if (tlTitle) tlTitle.innerHTML = `<span class="lang-zh">${item.titleZh}</span><span class="lang-en">${item.titleEn}</span>`;
					if (tlBody) tlBody.innerHTML = `<span class="lang-zh">${item.bodyZh}</span><span class="lang-en">${item.bodyEn}</span>`;
					if (tlQuote) tlQuote.textContent = `"${item.quote}"`;
				}

				tlBtns.forEach((btn, i) => {
					if (btn) {
						btn.addEventListener("click", () => selectTimelineNode(i), { signal: lifecycle.signal });
					}
				});

				// ==========================================
