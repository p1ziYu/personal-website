				};

				const treeDetailTier = document.getElementById("tree-detail-tier");
				const treeDetailTitle = document.getElementById("tree-detail-title");
				const treeDetailBody = document.getElementById("tree-detail-body");
				const treeDetailTokens = document.getElementById("tree-detail-tokens");
				const treeDetailTakeaway = document.getElementById("tree-detail-takeaway");

				function selectTreeNode(key) {
					const data = treeData[key];
					if (!data) return;

					if (treeDetailTier) {
						treeDetailTier.innerHTML = `<span class="lang-zh">${data.tierZh}</span><span class="lang-en">${data.tierEn}</span>`;
					}
					if (treeDetailTitle) {
						treeDetailTitle.textContent = data.title;
					}
					if (treeDetailBody) {
						treeDetailBody.innerHTML = `<span class="lang-zh">${data.bodyZh}</span><span class="lang-en">${data.bodyEn}</span>`;
					}
					if (treeDetailTokens) {
						treeDetailTokens.innerHTML = data.tokens.map(t =>
							`<span class="px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800">${t}</span>`
						).join("");
					}
					if (treeDetailTakeaway) {
						treeDetailTakeaway.innerHTML = `<span class="lang-zh">${data.takeawayZh}</span><span class="lang-en">${data.takeawayEn}</span>`;
