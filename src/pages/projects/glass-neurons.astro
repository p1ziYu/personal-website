				const nodeIy = document.getElementById("tree-node-iy");
				const nodeDiy = document.getElementById("tree-node-diy");
				const nodeFull = document.getElementById("tree-node-full");
				const nodeCrafts = document.getElementById("tree-node-crafts");
				const nodeIty = document.getElementById("tree-node-ity");
				const nodePhoneticLeaf = document.getElementById("tree-node-phonetic-leaf");

				if (nodeIy) nodeIy.addEventListener("click", () => selectTreeNode("iy"), { signal: lifecycle.signal });
				if (nodeDiy) nodeDiy.addEventListener("click", () => selectTreeNode("diy"), { signal: lifecycle.signal });
				if (nodeFull) nodeFull.addEventListener("click", () => selectTreeNode("full"), { signal: lifecycle.signal });
				if (nodeCrafts) nodeCrafts.addEventListener("click", () => selectTreeNode("crafts"), { signal: lifecycle.signal });
				if (nodeIty) nodeIty.addEventListener("click", () => selectTreeNode("ity"), { signal: lifecycle.signal });
				if (nodePhoneticLeaf) nodePhoneticLeaf.addEventListener("click", () => selectTreeNode("ity"), { signal: lifecycle.signal });

				// ==========================================
				// 5. THE DEBATE TIMELINE
				// ==========================================
				const timelineMilestones = [
