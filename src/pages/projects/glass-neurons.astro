				const biasV = -0.8;

				// Detector 2: O-Circle
				// Ring: (1,2),(1,3),(1,4) [9,10,11], (2,1)[15],(2,5)[19], (3,1)[22],(3,5)[26], (4,1)[29],(4,5)[33], (5,2)[37],(5,3)[38],(5,4)[39]
				// Center (3,3)[24] has heavy negative weight
				const weightsO = new Array(49).fill(-0.5);
				[9, 10, 11, 15, 19, 22, 26, 29, 33, 37, 38, 39].forEach(idx => {
					weightsO[idx] = 1.1;
				});
				weightsO[24] = -1.5; // Hole in the middle
				const biasO = -1.0;

				// Detector 3: Diagonal line
				// (0,0)[0], (1,1)[8], (2,2)[16], (3,3)[24], (4,4)[32], (5,5)[40], (6,6)[48]
				const weightsDiag = new Array(49).fill(-0.4);
				[0, 8, 16, 24, 32, 40, 48].forEach(idx => {
					weightsDiag[idx] = 1.3;
				});
				const biasDiag = -0.8;

				// Populate 49 DOM cells
				const cellElements = [];
				if (pixelGridContainer) {
					pixelGridContainer.innerHTML = "";
					for (let i = 0; i < 49; i++) {
						const cell = document.createElement("div");
						cell.className = "w-full h-full rounded bg-slate-950 border border-slate-800 transition-colors duration-150 cursor-pointer";
						cell.setAttribute("data-cell-idx", i.toString());

						cell.addEventListener("pointerdown", () => {
							isPointerDown = true;
							togglePixel(i);
						}, { signal: lifecycle.signal });

						cell.addEventListener("pointerenter", () => {
							if (isPointerDown) {
								setPixel(i, 1);
							}
						}, { signal: lifecycle.signal });

						pixelGridContainer.appendChild(cell);
						cellElements.push(cell);
					}
				}

				window.addEventListener("pointerup", () => {
					isPointerDown = false;
				}, { signal: lifecycle.signal });

				function togglePixel(idx) {
					pixels[idx] = pixels[idx] === 1 ? 0 : 1;
					refreshLab();
				}

				function setPixel(idx, val) {
					if (pixels[idx] !== val) {
						pixels[idx] = val;
						refreshLab();
					}
				}

				function renderMiniHeatmap(canvasId, weights) {
					const canvas = document.getElementById(canvasId);
					if (!canvas) return;
					const ctx = canvas.getContext("2d");
					if (!ctx) return;
					const cellSize = 7; // 49x49 canvas => 7px per cell
					for (let r = 0; r < 7; r++) {
						for (let c = 0; c < 7; c++) {
							const idx = r * 7 + c;
							const w = weights[idx];
							if (w > 0) {
								ctx.fillStyle = `rgba(16, 185, 129, ${Math.min(1, w / 1.2)})`;
							} else {
								ctx.fillStyle = `rgba(244, 63, 94, ${Math.min(1, Math.abs(w) / 1.2)})`;
							}
							ctx.fillRect(c * cellSize, r * cellSize, cellSize - 1, cellSize - 1);
						}
					}
				}

				// Readout DOM elements
				const scoreL1V = document.getElementById("score-l1-v");
				const barL1V = document.getElementById("bar-l1-v");
				const scoreL1O = document.getElementById("score-l1-o");
				const barL1O = document.getElementById("bar-l1-o");
				const scoreL1Diag = document.getElementById("score-l1-diag");
				const barL1Diag = document.getElementById("bar-l1-diag");

				const scoreL2Arrow = document.getElementById("score-l2-arrow");
				const barL2Arrow = document.getElementById("bar-l2-arrow");
				const badgeL2ArrowStatus = document.getElementById("badge-l2-arrow-status");
				const scoreL2Ring = document.getElementById("score-l2-ring");
				const barL2Ring = document.getElementById("bar-l2-ring");
				const badgeL2RingStatus = document.getElementById("badge-l2-ring-status");

				function computeLinear(weights, bias) {
					let sum = bias;
					for (let i = 0; i < 49; i++) {
						sum += weights[i] * pixels[i];
					}
					return sum;
				}

				function relu(val) {
					return Math.max(0, val);
				}

				function refreshLab() {
					// 1. Update Grid Cells Visuals
					let activeCount = 0;
					cellElements.forEach((cell, idx) => {
						if (!cell) return;
						if (currentInspectingNeuron) {
							// Highlight weights mode
							let w = 0;
							if (currentInspectingNeuron === "v") w = weightsV[idx];
							if (currentInspectingNeuron === "o") w = weightsO[idx];
							if (currentInspectingNeuron === "diag") w = weightsDiag[idx];

							if (w > 0.5) {
								cell.className = "w-full h-full rounded bg-emerald-500/80 border border-emerald-400";
							} else if (w < -0.2) {
								cell.className = "w-full h-full rounded bg-rose-950/80 border border-rose-800/80";
							} else {
								cell.className = "w-full h-full rounded bg-slate-950 border border-slate-900";
							}
						} else {
							// Normal interactive draw mode
							if (pixels[idx] === 1) {
								activeCount++;
								cell.className = "w-full h-full rounded bg-emerald-400 border border-emerald-300 shadow-[0_0_8px_rgba(16,185,129,0.5)]";
							} else {
								cell.className = "w-full h-full rounded bg-slate-950 border border-slate-800 hover:border-slate-700";
							}
						}
					});

					if (canvasActivePixelCount) {
						canvasActivePixelCount.textContent = `${activeCount} 像素点亮 / ${activeCount} Active`;
					}

					// 2. Layer 1 Computation: ReLU(w·x + b)
					const rawL1V = computeLinear(weightsV, biasV);
					const actL1V = relu(rawL1V);

					const rawL1O = computeLinear(weightsO, biasO);
					const actL1O = relu(rawL1O);

					const rawL1Diag = computeLinear(weightsDiag, biasDiag);
					const actL1Diag = relu(rawL1Diag);

					if (scoreL1V) scoreL1V.textContent = actL1V.toFixed(2);
					if (barL1V) barL1V.style.width = `${Math.min(100, (actL1V / 8) * 100)}%`;

					if (scoreL1O) scoreL1O.textContent = actL1O.toFixed(2);
					if (barL1O) barL1O.style.width = `${Math.min(100, (actL1O / 8) * 100)}%`;

					if (scoreL1Diag) scoreL1Diag.textContent = actL1Diag.toFixed(2);
					if (barL1Diag) barL1Diag.style.width = `${Math.min(100, (actL1Diag / 8) * 100)}%`;

					// 3. Layer 2 Computation
					// Concept 1: Arrow = ReLU(1.5*V + 1.0*Diag - 2.0*O - 0.5)
					const rawL2Arrow = 1.5 * actL1V + 1.0 * actL1Diag - 2.0 * actL1O - 0.5;
					const actL2Arrow = relu(rawL2Arrow);

					// Concept 2: Ring = ReLU(2.0*O - 1.5*V - 1.0*Diag - 0.5)
					const rawL2Ring = 2.0 * actL1O - 1.5 * actL1V - 1.0 * actL1Diag - 0.5;
					const actL2Ring = relu(rawL2Ring);

					if (scoreL2Arrow) scoreL2Arrow.textContent = actL2Arrow.toFixed(2);
					if (barL2Arrow) barL2Arrow.style.width = `${Math.min(100, (actL2Arrow / 10) * 100)}%`;
					if (badgeL2ArrowStatus) {
						if (actL2Arrow > 2.0) {
							badgeL2ArrowStatus.className = "text-[11px] font-mono text-emerald-400 font-bold";
							badgeL2ArrowStatus.innerHTML = '<span class="lang-zh">🔥 箭形概念强烈放电激活！</span><span class="lang-en">🔥 Arrow concept firing!</span>';
						} else {
							badgeL2ArrowStatus.className = "text-[11px] font-mono text-slate-500";
							badgeL2ArrowStatus.innerHTML = '<span class="lang-zh">静息基线</span><span class="lang-en">Resting baseline</span>';
						}
					}

					if (scoreL2Ring) scoreL2Ring.textContent = actL2Ring.toFixed(2);
					if (barL2Ring) barL2Ring.style.width = `${Math.min(100, (actL2Ring / 10) * 100)}%`;
					if (badgeL2RingStatus) {
						if (actL2Ring > 2.0) {
							badgeL2RingStatus.className = "text-[11px] font-mono text-cyan-400 font-bold";
							badgeL2RingStatus.innerHTML = '<span class="lang-zh">🌀 环形概念强烈放电激活！</span><span class="lang-en">🌀 Ring concept firing!</span>';
						} else {
							badgeL2RingStatus.className = "text-[11px] font-mono text-slate-500";
							badgeL2RingStatus.innerHTML = '<span class="lang-zh">静息基线</span><span class="lang-en">Resting baseline</span>';
						}
					}
				}

				// Presets handlers
				if (btnPresetV) {
					btnPresetV.addEventListener("click", () => {
						currentInspectingNeuron = null;
						pixels = new Array(49).fill(0);
						[8, 12, 15, 19, 23, 25, 30, 32, 38, 45].forEach(i => { pixels[i] = 1; });
						refreshLab();
					}, { signal: lifecycle.signal });
				}

				if (btnPresetO) {
					btnPresetO.addEventListener("click", () => {
						currentInspectingNeuron = null;
						pixels = new Array(49).fill(0);
						[9, 10, 11, 15, 19, 22, 26, 29, 33, 37, 38, 39].forEach(i => { pixels[i] = 1; });
						refreshLab();
					}, { signal: lifecycle.signal });
				}

				if (btnPresetDiag) {
					btnPresetDiag.addEventListener("click", () => {
						currentInspectingNeuron = null;
						pixels = new Array(49).fill(0);
						[0, 8, 16, 24, 32, 40, 48].forEach(i => { pixels[i] = 1; });
						refreshLab();
					}, { signal: lifecycle.signal });
				}

				if (btnPresetClear) {
					btnPresetClear.addEventListener("click", () => {
						currentInspectingNeuron = null;
						pixels = new Array(49).fill(0);
						refreshLab();
					}, { signal: lifecycle.signal });
				}

				// Inspect Neuron Weights Mode
				const cardNeuronL1V = document.getElementById("card-neuron-l1-v");
				const cardNeuronL1O = document.getElementById("card-neuron-l1-o");
				const cardNeuronL1Diag = document.getElementById("card-neuron-l1-diag");

				function inspectNeuron(type, nameZh, nameEn) {
					currentInspectingNeuron = type;
					if (selectedNeuronInfo) {
						selectedNeuronInfo.innerHTML = `<span class="lang-zh text-amber-300 font-bold">正在检视权重：${nameZh}（绿色=正权兴奋，红色=负权抑制）</span><span class="lang-en text-amber-300 font-bold">Inspecting Weights: ${nameEn} (Green=Positive, Red=Inhibition)</span>`;
					}
					refreshLab();
				}

				if (cardNeuronL1V) {
					cardNeuronL1V.addEventListener("click", () => inspectNeuron("v", "V形探测器", "V-Detector"), { signal: lifecycle.signal });
				}
				if (cardNeuronL1O) {
					cardNeuronL1O.addEventListener("click", () => inspectNeuron("o", "O圆环探测器", "O-Detector"), { signal: lifecycle.signal });
				}
				if (cardNeuronL1Diag) {
					cardNeuronL1Diag.addEventListener("click", () => inspectNeuron("diag", "对角线探测器", "Diagonal-Detector"), { signal: lifecycle.signal });
				}

				if (btnResetInspect) {
					btnResetInspect.addEventListener("click", () => {
						currentInspectingNeuron = null;
						if (selectedNeuronInfo) {
							selectedNeuronInfo.innerHTML = `<span class="lang-zh">提示：点击上方任意神经元卡片，画布将切换显示其专属权重分布。</span><span class="lang-en">Tip: Click any neuron card above to preview its target weight heatmap.</span>`;
						}
						refreshLab();
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 4. RECURSIVE GENERALIZATION: "IY" TREE
				// ==========================================
				const treeData = {
					"iy": {
						tierZh: "根部基础：音素与词尾碎片探测器",
