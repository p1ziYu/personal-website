				// ==========================================
				renderMiniHeatmap("mini-heatmap-v", weightsV);
				renderMiniHeatmap("mini-heatmap-o", weightsO);
				renderMiniHeatmap("mini-heatmap-diag", weightsDiag);
				refreshLab();
				selectTreeNode("iy");
				selectTimelineNode(4); // Default to 15 Oct 2026 essay milestone
