				const resRawSurvivalEl = document.getElementById("res-raw-survival");
				const barRawSurvivalEl = document.getElementById("bar-raw-survival");
				const badgeRawVerdict = document.getElementById("badge-raw-verdict");
				const resHeliosFailEl = document.getElementById("res-helios-fail");
				const resHeliosSurvivalEl = document.getElementById("res-helios-survival");
				const barHeliosSurvivalEl = document.getElementById("bar-helios-survival");
				const canvasDecoherence = document.getElementById("canvas-decoherence");

				let waveOffset = 0;

				function updateDecoherence() {
					if (!sliderOps || !sliderErr) return;
					const n = Number.parseFloat(sliderOps.value);
					const p = Number.parseFloat(sliderErr.value) / 100.0; // convert percentage to prob

					if (opsValEl) opsValEl.textContent = `${n.toLocaleString()} 步 / ops`;
					if (errValEl) errValEl.textContent = `${(p * 100).toFixed(3)}% (${p.toExponential(2)})`;

					// Raw uncorrected: P_fail = 1 - (1 - p)^n
					// For very small p and large n, use Math.exp(-n * p) for numerical stability
					const survivalRaw = Math.pow(Math.max(0, 1 - p), n);
					const failRaw = Math.max(0, Math.min(1, 1 - survivalRaw));

					// Helios logical rate: p_helios = 5.0e-6
					const pHelios = 5.0e-6;
					const survivalHelios = Math.pow(Math.max(0, 1 - pHelios), n);
					const failHelios = Math.max(0, Math.min(1, 1 - survivalHelios));

					if (resRawFailEl) {
						resRawFailEl.textContent = `${(failRaw * 100).toFixed(failRaw > 0.999 ? 3 : 2)}%`;
					}
					if (resRawSurvivalEl) {
						resRawSurvivalEl.textContent = `${(survivalRaw * 100).toFixed(survivalRaw < 0.001 ? 4 : 2)}%`;
					}
					if (barRawSurvivalEl) {
						barRawSurvivalEl.style.width = `${Math.min(100, Math.max(0, survivalRaw * 100))}%`;
					}

					if (badgeRawVerdict) {
						if (survivalRaw < 0.05) {
							badgeRawVerdict.className = "mt-2 text-[10px] font-mono px-2 py-0.5 rounded bg-red-950/80 border border-red-800 text-red-300 inline-block";
							badgeRawVerdict.innerHTML = '<span class="lang-zh">⚠️ 计算结果已退相干为噪声</span><span class="lang-en">⚠️ Scrambled into pure entropy</span>';
						} else if (survivalRaw < 0.5) {
							badgeRawVerdict.className = "mt-2 text-[10px] font-mono px-2 py-0.5 rounded bg-amber-950/80 border border-amber-800 text-amber-300 inline-block";
							badgeRawVerdict.innerHTML = '<span class="lang-zh">⚠️ 严重相干衰减 (>50% 错误率)</span><span class="lang-en">⚠️ Severe decay (&gt;50% error rate)</span>';
						} else {
							badgeRawVerdict.className = "mt-2 text-[10px] font-mono px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-slate-300 inline-block";
							badgeRawVerdict.innerHTML = '<span class="lang-zh">ℹ️ 短步数保持有限相干</span><span class="lang-en">ℹ️ Marginal coherence preserved</span>';
						}
					}

					if (resHeliosFailEl) {
						resHeliosFailEl.textContent = `${(failHelios * 100).toFixed(failHelios < 0.01 ? 3 : 2)}%`;
					}
					if (resHeliosSurvivalEl) {
						resHeliosSurvivalEl.textContent = `${(survivalHelios * 100).toFixed(2)}%`;
					}
					if (barHeliosSurvivalEl) {
						barHeliosSurvivalEl.style.width = `${Math.min(100, Math.max(0, survivalHelios * 100))}%`;
					}
				}

				if (sliderOps) sliderOps.addEventListener("input", updateDecoherence, { signal: lifecycle.signal });
				if (sliderErr) sliderErr.addEventListener("input", updateDecoherence, { signal: lifecycle.signal });

				// Presets
				const btnClean = document.getElementById("preset-raw-clean");
				const btnTypical = document.getElementById("preset-raw-typical");
				const btnNoisy = document.getElementById("preset-raw-noisy");

				if (btnClean && sliderErr) {
					btnClean.addEventListener("click", () => {
						sliderErr.value = "0.05";
						updateDecoherence();
					}, { signal: lifecycle.signal });
				}
				if (btnTypical && sliderErr) {
					btnTypical.addEventListener("click", () => {
						sliderErr.value = "0.10";
						updateDecoherence();
					}, { signal: lifecycle.signal });
				}
				if (btnNoisy && sliderErr) {
					btnNoisy.addEventListener("click", () => {
						sliderErr.value = "0.50";
						updateDecoherence();
					}, { signal: lifecycle.signal });
				}

				// Decoherence Wave Animation
				function renderDecoherenceWave() {
					if (!canvasDecoherence) return;
					const ctx = canvasDecoherence.getContext("2d");
					if (!ctx) return;

					const dpr = window.devicePixelRatio || 1;
					const rect = canvasDecoherence.getBoundingClientRect();
					if (canvasDecoherence.width !== rect.width * dpr || canvasDecoherence.height !== rect.height * dpr) {
						canvasDecoherence.width = rect.width * dpr;
						canvasDecoherence.height = rect.height * dpr;
					}

					const w = canvasDecoherence.width;
					const h = canvasDecoherence.height;

					ctx.clearRect(0, 0, w, h);

					// Draw mid horizontal line
					const midY = h / 2;
					ctx.strokeStyle = "rgba(51, 65, 85, 0.4)";
					ctx.lineWidth = 1 * dpr;
					ctx.beginPath();
					ctx.moveTo(0, midY);
					ctx.lineTo(w, midY);
					ctx.stroke();

					const n = sliderOps ? Number.parseFloat(sliderOps.value) : 5000;
					const p = sliderErr ? Number.parseFloat(sliderErr.value) / 100.0 : 0.001;
					const rawSurvival = Math.pow(Math.max(0, 1 - p), n);

					// 1. Draw Raw Qubit (Red wave that attenuates and becomes noisy noise)
					ctx.beginPath();
					ctx.strokeStyle = "#f87171";
					ctx.lineWidth = 2 * dpr;

					const rawAttenuationRate = Math.min(1, (1 - rawSurvival) * 1.5);

					for (let x = 0; x <= w; x += 3 * dpr) {
						const progress = x / w; // 0 to 1
						// amplitude decays from 1 down to rawSurvival
						const amp = (h * 0.35) * Math.max(0.05, 1 - progress * rawAttenuationRate);
						// Noise increases as progress increases
						const noiseAmp = (1 - rawSurvival) * progress * (h * 0.25);
						const noise = (Math.random() - 0.5) * noiseAmp;
						const wave = Math.sin((x * 0.02) + waveOffset) * amp;
						const y = midY + wave + noise;

						if (x === 0) ctx.moveTo(x, y);
						else ctx.lineTo(x, y);
					}
					ctx.stroke();

					// 2. Draw Helios Logical Qubit (Cyan wave, protected and coherent)
					ctx.beginPath();
					ctx.strokeStyle = "#06b6d4";
					ctx.lineWidth = 2.5 * dpr;

					for (let x = 0; x <= w; x += 3 * dpr) {
						const progress = x / w;
						// Very slight decay (5e-6)
						const heliosAmp = (h * 0.36) * (1 - progress * 0.03);
						const y = midY + Math.sin((x * 0.02) + waveOffset + Math.PI * 0.5) * heliosAmp;

						if (x === 0) ctx.moveTo(x, y);
						else ctx.lineTo(x, y);
					}
					ctx.stroke();

					waveOffset += 0.04;
					const req = requestAnimationFrame(renderDecoherenceWave);
					animFrameIds.push(req);
				}

				// ==========================================
				// 2. FIVE IN A MILLION (CANVAS DOT FIELD)
				// ==========================================
				const canvasMillion = document.getElementById("canvas-million");
				const btnSeekError = document.getElementById("btn-seek-error");
				const dotCursorCoord = document.getElementById("dot-cursor-coord");
				const dotErrorIndex = document.getElementById("dot-error-index");

				// 5 error gate indices among 1,000,000 (fixed reproducible coordinates)
				const errorLocations = [
					{ id: 1, opIndex: 142857, gridX: 18, gridY: 24, label: "Gate #142,857" },
					{ id: 2, opIndex: 319402, gridX: 64, gridY: 15, label: "Gate #319,402" },
					{ id: 3, opIndex: 482910, gridX: 42, gridY: 67, label: "Gate #482,910" },
					{ id: 4, opIndex: 720513, gridX: 85, gridY: 78, label: "Gate #720,513" },
					{ id: 5, opIndex: 941038, gridX: 31, gridY: 91, label: "Gate #941,038" },
				];

				let currentFocusedErrorIdx = 2; // start focused on #3
				let pingRadius = 0;

				function renderMillionCanvas() {
					if (!canvasMillion) return;
					const ctx = canvasMillion.getContext("2d");
					if (!ctx) return;

					const dpr = window.devicePixelRatio || 1;
					const rect = canvasMillion.getBoundingClientRect();
					if (canvasMillion.width !== rect.width * dpr || canvasMillion.height !== rect.height * dpr) {
						canvasMillion.width = rect.width * dpr;
						canvasMillion.height = rect.height * dpr;
					}

					const w = canvasMillion.width;
					const h = canvasMillion.height;

					ctx.clearRect(0, 0, w, h);

					// Draw a fine matrix representing 10,000 macroscopic sample blocks (100x100 grid)
					const cols = 100;
					const rows = 100;
					const cellW = w / cols;
					const cellH = h / rows;

					// Background pristine dots
					ctx.fillStyle = "rgba(6, 182, 212, 0.25)";
					for (let i = 0; i < cols; i += 2) {
						for (let j = 0; j < rows; j += 2) {
							ctx.fillRect(i * cellW + 1, j * cellH + 1, cellW * 0.7, cellH * 0.7);
						}
					}

					// Draw the 5 error locations in glowing crimson
					for (let k = 0; k < errorLocations.length; k++) {
						const err = errorLocations[k];
						const ex = err.gridX * cellW + cellW * 0.5;
						const ey = err.gridY * cellH + cellH * 0.5;

						// Red dot
						ctx.beginPath();
						ctx.arc(ex, ey, 4 * dpr, 0, Math.PI * 2);
						ctx.fillStyle = "#ef4444";
						ctx.fill();

						// Halo
						ctx.beginPath();
						ctx.arc(ex, ey, 8 * dpr, 0, Math.PI * 2);
						ctx.strokeStyle = "rgba(239, 68, 68, 0.4)";
						ctx.lineWidth = 1.5 * dpr;
						ctx.stroke();

						// If currently focused, draw animated radar ring and crosshair
						if (k === currentFocusedErrorIdx) {
							ctx.beginPath();
							ctx.arc(ex, ey, pingRadius * dpr, 0, Math.PI * 2);
							ctx.strokeStyle = `rgba(239, 68, 68, ${Math.max(0, 1 - pingRadius / 28)})`;
							ctx.lineWidth = 2 * dpr;
							ctx.stroke();

							// Crosshair box
							const boxSize = 22 * dpr;
							ctx.strokeStyle = "#f43f5e";
							ctx.lineWidth = 1 * dpr;
							ctx.strokeRect(ex - boxSize / 2, ey - boxSize / 2, boxSize, boxSize);

							// Label
							ctx.fillStyle = "#ffffff";
							ctx.font = `bold ${10 * dpr}px monospace`;
							ctx.fillText(err.label, ex + boxSize / 2 + 5 * dpr, ey + 4 * dpr);
						}
					}

					pingRadius += 0.5;
					if (pingRadius > 28) pingRadius = 6;

					const req = requestAnimationFrame(renderMillionCanvas);
					animFrameIds.push(req);
				}

				function focusError(index) {
					currentFocusedErrorIdx = index % errorLocations.length;
					const err = errorLocations[currentFocusedErrorIdx];
					if (dotCursorCoord) dotCursorCoord.textContent = err.label;
					if (dotErrorIndex) dotErrorIndex.textContent = `${err.id} / 5`;
					pingRadius = 6;
				}

				if (btnSeekError) {
					btnSeekError.addEventListener("click", () => {
						focusError(currentFocusedErrorIdx + 1);
					}, { signal: lifecycle.signal });
				}

				if (canvasMillion) {
					canvasMillion.addEventListener("click", (e) => {
						const rect = canvasMillion.getBoundingClientRect();
						const clickX = e.clientX - rect.left;
						const clickY = e.clientY - rect.top;

						// Find closest error
						let closestIdx = 0;
						let minDist = Number.POSITIVE_INFINITY;

						for (let i = 0; i < errorLocations.length; i++) {
							const ex = (errorLocations[i].gridX / 100) * rect.width;
							const ey = (errorLocations[i].gridY / 100) * rect.height;
							const dist = Math.hypot(clickX - ex, clickY - ey);
							if (dist < minDist) {
								minDist = dist;
								closestIdx = i;
							}
						}
						focusError(closestIdx);
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 3. THE COST OF MEMORY (REDUNDANCY GRID)
				// ==========================================
				const sliderLogical = document.getElementById("slider-logical-qubits");
				const logicalValEl = document.getElementById("redundancy-logical-val");
				const helixTotalEl = document.getElementById("helix-physical-total");
				const heliosTotalEl = document.getElementById("helios-physical-total");
				const helixGridEl = document.getElementById("helix-grid-cells");
				const heliosGridEl = document.getElementById("helios-grid-cells");
				const helixOverflowEl = document.getElementById("helix-grid-overflow");
				const heliosOverflowEl = document.getElementById("helios-grid-overflow");

				function updateRedundancyGrids() {
					if (!sliderLogical) return;
					const N = Number.parseInt(sliderLogical.value, 10);
					if (logicalValEl) logicalValEl.textContent = `${N} 个逻辑比特 / ${N} logical qubits`;

					const helixTotal = N * 10;
					const heliosTotal = N * 37;

					if (helixTotalEl) helixTotalEl.textContent = helixTotal.toLocaleString();
					if (heliosTotalEl) heliosTotalEl.textContent = heliosTotal.toLocaleString();

					// Render Helix cells (cap visual render at 120 cells)
					if (helixGridEl) {
						helixGridEl.innerHTML = "";
						const maxRenderHelix = Math.min(helixTotal, 120);
						for (let i = 0; i < maxRenderHelix; i++) {
							const cell = document.createElement("div");
							cell.className = "w-full aspect-square rounded-xs bg-cyan-500/80 hover:bg-cyan-300 transition shadow-[0_0_4px_rgba(6,182,212,0.4)]";
							cell.title = `Helix Ion #${i + 1}`;
							helixGridEl.appendChild(cell);
						}
						if (helixOverflowEl) {
							if (helixTotal > 120) {
								helixOverflowEl.classList.remove("hidden");
								helixOverflowEl.textContent = `+ 剩余 ${helixTotal - 120} 个物理比特未绘制 (+${helixTotal - 120} more physical qubits)`;
							} else {
								helixOverflowEl.classList.add("hidden");
							}
						}
					}

					// Render Helios cells (cap visual render at 222 cells)
					if (heliosGridEl) {
						heliosGridEl.innerHTML = "";
						const maxRenderHelios = Math.min(heliosTotal, 222);
						// Color code tri-color lattice palette
						const colors = [
							"bg-red-400 hover:bg-red-200",
							"bg-emerald-400 hover:bg-emerald-200",
							"bg-blue-400 hover:bg-blue-200"
						];
						for (let i = 0; i < maxRenderHelios; i++) {
							const cell = document.createElement("div");
							const c = colors[i % 3];
							cell.className = `w-full aspect-square rounded-xs ${c} transition shadow-[0_0_3px_rgba(255,255,255,0.2)]`;
							cell.title = `Color Code Ion #${i + 1}`;
							heliosGridEl.appendChild(cell);
						}
						if (heliosOverflowEl) {
							if (heliosTotal > 222) {
								heliosOverflowEl.classList.remove("hidden");
								heliosOverflowEl.textContent = `+ 剩余 ${heliosTotal - 222} 个物理离子未绘制 (+${heliosTotal - 222} more physical qubits)`;
							} else {
								heliosOverflowEl.classList.add("hidden");
							}
						}
					}
				}

				if (sliderLogical) {
					sliderLogical.addEventListener("input", updateRedundancyGrids, { signal: lifecycle.signal });
				}

				// ==========================================
				// 4. TWELVE TIMES TWELVE (SUPPRESSION CURVE)
				// ==========================================
				const sliderCurveStep = document.getElementById("slider-curve-step");
				const curveStepDisplay = document.getElementById("curve-step-display");
				const curveActiveValEl = document.getElementById("curve-active-val");
				const statCurveD = document.getElementById("stat-curve-d");
				const statCurveFactor = document.getElementById("stat-curve-factor");
				const statCurveRate = document.getElementById("stat-curve-rate");
				const statCurveMttf = document.getElementById("stat-curve-mttf");
				const svgSuppression = document.getElementById("svg-suppression-chart");

				// Steps data: each step divides error rate by 12
				// Base physical error ~ 8.64e-3
				// Step 0: 8.64e-3 (1 in ~116)
				// Step 1: 7.20e-4 (1 in ~1,388)
				// Step 2: 6.00e-5 (1 in ~16,666)
				// Step 3 (Helios): 5.00e-6 (1 in 200,000 / 5 in 1,000,000)
				// Step 4: 4.17e-7 (1 in ~2,400,000)
				// Step 5: 3.47e-8 (1 in ~28,800,000)
				const curveData = [
					{ step: 0, d: "Base (d=1)", factor: "1× (基准裸比特)", rate: 8.64e-3, rateStr: "8.64 × 10⁻³", mttf: "~116 步", labelZh: "Step 0 · 裸物理比特 (未纠错基准)", labelEn: "Step 0 · Raw Physical Qubit (Unprotected)" },
					{ step: 1, d: "d = 3", factor: "12× (12¹)", rate: 7.20e-4, rateStr: "7.20 × 10⁻⁴", mttf: "~1,390 步", labelZh: "Step 1 · 距离 d=3 (初级容错)", labelEn: "Step 1 · Distance d=3 (Basic Fault-Tolerance)" },
					{ step: 2, d: "d = 5", factor: "144× (12²)", rate: 6.00e-5, rateStr: "6.00 × 10⁻⁵", mttf: "~16,700 步", labelZh: "Step 2 · 距离 d=5 (中级冗余)", labelEn: "Step 2 · Distance d=5 (Intermediate QEC)" },
					{ step: 3, d: "d = 7", factor: "1,728× (12³)", rate: 5.00e-6, rateStr: "5.00 × 10⁻⁶", mttf: "200,000 步 (5 in 1M)", labelZh: "Step 3 · 距离 d=7 (Helios 今日新纪录)", labelEn: "Step 3 · Distance d=7 (Helios Record Benchmark)" },
					{ step: 4, d: "d = 9", factor: "20,736× (12⁴)", rate: 4.17e-7, rateStr: "4.17 × 10⁻⁷", mttf: "~2.4 百万步", labelZh: "Step 4 · 距离 d=9 (高阶扩展规划)", labelEn: "Step 4 · Distance d=9 (Projected Scaling)" },
					{ step: 5, d: "d = 11", factor: "248,832× (12⁵)", rate: 3.47e-8, rateStr: "3.47 × 10⁻⁸", mttf: "~2,880 万步", labelZh: "Step 5 · 距离 d=11 (通用容错深水区)", labelEn: "Step 5 · Distance d=11 (Deep Fault-Tolerant Zone)" },
				];

				function updateSuppressionChart() {
					if (!sliderCurveStep || !svgSuppression) return;
					const curStep = Number.parseInt(sliderCurveStep.value, 10);
					const data = curveData[curStep];

					if (curveStepDisplay) curveStepDisplay.textContent = `${data.labelZh}`;
					if (curveActiveValEl) curveActiveValEl.textContent = `${data.rateStr} (${data.mttf})`;
					if (statCurveD) statCurveD.textContent = data.d;
					if (statCurveFactor) statCurveFactor.textContent = data.factor;
					if (statCurveRate) statCurveRate.textContent = data.rateStr;
					if (statCurveMttf) statCurveMttf.textContent = data.mttf;

					// SVG geometry: viewBox="0 0 700 320"
					// Margins: left=70, right=40, top=30, bottom=50
					const svgW = 700;
					const svgH = 320;
					const ml = 75;
					const mr = 40;
					const mt = 25;
					const mb = 50;
					const plotW = svgW - ml - mr;
					const plotH = svgH - mt - mb;

					// Y scale: log10 from 1e-2 (top, log = -2) down to 1e-8 (bottom, log = -8)
					const minY = -8;
					const maxY = -2;

					const getX = (stepIdx) => ml + (stepIdx / 5) * plotW;
					const getY = (rate) => {
						const logVal = Math.log10(rate);
						const norm = (logVal - maxY) / (minY - maxY); // 0 at top (1e-2), 1 at bottom (1e-8)
						return mt + norm * plotH;
					};

					// Build SVG inner content
					let svgHTML = "";

					// Y Gridlines and Labels
					for (let exp = -2; exp >= -8; exp--) {
						const yPos = mt + ((exp - maxY) / (minY - maxY)) * plotH;
						svgHTML += `
							<line x1="${ml}" y1="${yPos}" x2="${svgW - mr}" y2="${yPos}" stroke="#1e293b" stroke-dasharray="3,3" stroke-width="1" />
							<text x="${ml - 12}" y="${yPos + 4}" fill="#64748b" font-family="monospace" font-size="11" text-anchor="end">10^${exp}</text>
						`;
					}

					// X Gridlines and Labels
					for (let i = 0; i <= 5; i++) {
						const xPos = getX(i);
						svgHTML += `
							<line x1="${xPos}" y1="${mt}" x2="${xPos}" y2="${mt + plotH}" stroke="#1e293b" stroke-dasharray="3,3" stroke-width="1" />
							<text x="${xPos}" y="${mt + plotH + 20}" fill="#94a3b8" font-family="monospace" font-size="11" text-anchor="middle">Step ${i}</text>
							<text x="${xPos}" y="${mt + plotH + 34}" fill="#64748b" font-family="monospace" font-size="9" text-anchor="middle">${curveData[i].d}</text>
						`;
					}

					// Build path curve
					let pathD = `M ${getX(0)} ${getY(curveData[0].rate)}`;
					for (let i = 1; i <= 5; i++) {
						pathD += ` L ${getX(i)} ${getY(curveData[i].rate)}`;
					}

					// Path glow & line
					svgHTML += `
						<path d="${pathD}" fill="none" stroke="#6366f1" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
					`;

					// Highlighted active scan line
					const activeX = getX(curStep);
					const activeY = getY(data.rate);

					svgHTML += `
						<line x1="${activeX}" y1="${mt}" x2="${activeX}" y2="${mt + plotH}" stroke="#818cf8" stroke-dasharray="4,4" stroke-width="2" />
						<line x1="${ml}" y1="${activeY}" x2="${svgW - mr}" y2="${activeY}" stroke="#818cf8" stroke-dasharray="4,4" stroke-width="1.5" />
					`;

					// Dots
					for (let i = 0; i <= 5; i++) {
						const px = getX(i);
						const py = getY(curveData[i].rate);
						const isSelected = i === curStep;
						const isHelios = i === 3;

						if (isHelios) {
							// Special marker for Helios record
							svgHTML += `
								<circle cx="${px}" cy="${py}" r="${isSelected ? 9 : 7}" fill="#06b6d4" stroke="#ffffff" stroke-width="2" />
								<text x="${px}" y="${py - 14}" fill="#06b6d4" font-family="monospace" font-weight="bold" font-size="10" text-anchor="middle">Helios (5e-6)</text>
							`;
						} else {
							svgHTML += `
								<circle cx="${px}" cy="${py}" r="${isSelected ? 8 : 5}" fill="${isSelected ? '#a5b4fc' : '#4f46e5'}" stroke="#1e1b4b" stroke-width="2" />
							`;
						}

						// Factor label above points
						if (i > 0 && i !== 3) {
							svgHTML += `
								<text x="${px}" y="${py - 10}" fill="#818cf8" font-family="monospace" font-size="9" text-anchor="middle">÷12</text>
							`;
						}
					}

					svgSuppression.innerHTML = svgHTML;
				}

				if (sliderCurveStep) {
					sliderCurveStep.addEventListener("input", updateSuppressionChart, { signal: lifecycle.signal });
				}

				// ==========================================
				// 5. A MONTH OF PROGRESS (TIMELINE STRIP)
				// ==========================================
				const timelineNodes = [
					{
						id: 0,
						dateZh: "2026 年 9 月 · 前序基准",
						dateEn: "September 2026 · Prior Baseline",
						titleZh: "Helix 纠错方案：10 物理比特守护",
						titleEn: "Helix System: 10 Physical Qubits Protection",
						meta1: "Helix 拓扑 (10:1 冗余)",
						meta2: "~5.0 × 10⁻⁵ (50 in 1M)",
						meta3: "奠定高保真度基石",
						bodyZh: "Quantinuum 团队在 2026 年 9 月率先发布了代号为 Helix 的纠错成果，使用 10 个物理离子比特保护 1 个逻辑比特。该基准展示了离子阱在穿梭控制与相干性保持上的坚实底色，为 10 月更深层次的代码距离与色码验证积累了核心控制经验。",
						bodyEn: "Quantinuum released its Helix error-correction milestone in September 2026, pairing 10 physical ions to protect each logical qubit. This established ion shuttling and coherence control foundations, setting the stage for deeper color-code distances."
					},
					{
						id: 1,
						dateZh: "2026-10-21 · 全球纪录 (今日公布)",
						dateEn: "21 October 2026 · Global Record (Announced Today)",
						titleZh: "Helios 色码新纪录：99.9995% 逻辑保真度",
						titleEn: "Helios Color Code: 99.9995% Logical Fidelity",
						meta1: "2D Color Code (最高 37:1)",
						meta2: "5.0 × 10⁻⁶ (5 in 1M)",
						meta3: "确立 12 倍指数级距离抑制法则",
						bodyZh: "Quantinuum 在 Helios 离子阱机上实现了 99.9995% 逻辑保真度（百万次操作仅 5 次错误）。相比 9 月 Helix 实现了整整 10 倍的断崖式降错，并比竞品硬件公开发表的最强成果高出 100 倍。实验证明提升代码距离能以每步 12 倍的倍率指数级抑制错误，用 37:1 的物理冗余换取了极其稳健的相干记忆。",
						bodyEn: "Quantinuum demonstrated 99.9995% logical fidelity on Helios (5 errors per million operations) — a tenfold improvement over September's Helix and a hundredfold improvement over published rival approaches. It proved exponential scaling with a factor-of-12 error suppression per code distance step."
					},
					{
						id: 2,
						dateZh: "2029 目标 · 规划愿景 (严禁过度炒作)",
						dateEn: "2029 Target · Ambitious Roadmap (Not an established fact)",
						titleZh: "Apollo：规划中的通用容错量子计算机",
						titleEn: "Apollo: Planned Universal Fault-Tolerant System",
						meta1: "数百逻辑比特集群规划",
						meta2: "商业级长时算法容错目标",
						meta3: "公司战略路线规划 (非既成事实)",
						bodyZh: "Quantinuum 将 Helios 的破纪录成果与计划于 2029 年落地的 Apollo 系统直接挂钩。必须客观强调：这是 Quantinuum 官方立项的战略规划与攻关目标，绝非已完成的既成事实。从单个逻辑门纪录迈向长达数小时稳定运行商业算法的大规模容错系统，仍面临巨大工程考验。",
						bodyEn: "Quantinuum ties these Helios results directly to 'Apollo,' its planned universal fault-tolerant quantum computer targeted for 2029. Crucially, this is the company's stated development target, not an established fact. Scaling from record benchmark operations to running commercial algorithms across hundreds of logical qubits remains an enormous engineering endeavor."
					}
				];

				const tlBtns = [
					document.getElementById("tl-node-0"),
					document.getElementById("tl-node-1"),
					document.getElementById("tl-node-2")
				];

				const tlBadge = document.getElementById("tl-detail-badge");
				const tlTitle = document.getElementById("tl-detail-title");
				const tlBody = document.getElementById("tl-detail-body");
				const tlMeta1 = document.getElementById("tl-meta-1");
				const tlMeta2 = document.getElementById("tl-meta-2");
				const tlMeta3 = document.getElementById("tl-meta-3");

				function selectTimelineNode(idx) {
					tlBtns.forEach((btn, i) => {
						if (!btn) return;
						if (i === idx) {
							btn.className = "tl-btn active p-4 rounded-xl bg-slate-950 border border-cyan-500 text-left cursor-pointer transition active:scale-95 shadow-[0_0_15px_rgba(6,182,212,0.15)]";
							const dot = btn.querySelector(".tl-dot");
							if (dot) dot.className = "w-2 h-2 rounded-full bg-cyan-400 animate-pulse tl-dot";
						} else {
							btn.className = "tl-btn p-4 rounded-xl bg-slate-950 border border-slate-800 text-left cursor-pointer transition active:scale-95 hover:border-slate-700";
							const dot = btn.querySelector(".tl-dot");
							if (dot) dot.className = "w-2 h-2 rounded-full bg-slate-600 tl-dot";
						}
					});

					const item = timelineNodes[idx];
					if (tlBadge) tlBadge.textContent = item.dateZh;
					if (tlTitle) tlTitle.textContent = item.titleZh;
					if (tlBody) tlBody.textContent = item.bodyZh;
					if (tlMeta1) tlMeta1.textContent = item.meta1;
					if (tlMeta2) tlMeta2.textContent = item.meta2;
					if (tlMeta3) tlMeta3.textContent = item.meta3;
				}

				tlBtns.forEach((btn, i) => {
					if (btn) {
						btn.addEventListener("click", () => selectTimelineNode(i), { signal: lifecycle.signal });
					}
				});

				// ==========================================
				// INITIALIZATION RUNNER
				// ==========================================
				updateDecoherence();
				renderDecoherenceWave();
				renderMillionCanvas();
				focusError(2);
				updateRedundancyGrids();
				updateSuppressionChart();
				selectTimelineNode(1);

				window.addEventListener("resize", () => {
					updateSuppressionChart();
				}, { signal: lifecycle.signal });
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initFragileBits);
			} else {
				initFragileBits();
			}
			document.addEventListener("astro:page-load", initFragileBits);
		})();
	</script>
</MainGridLayout>
