---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

interface Props {
	lang?: string;
}

const { lang = Astro.url.pathname.startsWith("/en") ? "en" : "zh_CN" } =
	Astro.props;
const isEn = lang === "en";

const title = isEn
	? "Ghost Catcher · IceCube Neutrino Detector Lab"
	: "幽灵捕手 · 冰立方中微子探测器实验室";
const description = isEn
	? "A Neutrino Detector You Can Play With: Celebrating Francis Halzen's 2026 Nobel Prize in Physics for IceCube and astrophysical neutrinos. Interactive Cherenkov radiation, DOM charge-timing, and cosmic ghost particle tracking in Antarctic deep ice."
	: "幽灵捕手 · GHOST CATCHER：致敬弗朗西斯·哈尔岑荣获 2026 诺贝尔物理学奖。在南极千米深冰中交互式观测切伦科夫辐射蓝光锥、DOM 时序电荷与宇宙幽灵信使反向追踪。";
---

<MainGridLayout title={title} description={description} lang={lang}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mb-8">
		<div class="z-10 px-4 sm:px-8 py-8 relative w-full rounded-(--radius-large) overflow-hidden bg-[#050b14] text-zinc-100 border border-zinc-800/80 shadow-2xl selection:bg-cyan-500/30 selection:text-cyan-200">
			<!-- Background Ambient Glow & Grid -->
			<div class="absolute inset-0 pointer-events-none opacity-20 bg-[radial-gradient(#0ea5e9_1px,transparent_1px)] [background-size:24px_24px] overflow-hidden"></div>
			<div class="absolute -top-32 -left-32 w-80 h-80 bg-cyan-600/10 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute top-1/2 -right-32 w-80 h-80 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

			<!-- HERO HEADER SECTION -->
			<section class="relative z-10 mb-8 pb-8 border-b border-zinc-800/80">
				<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
					<div class="flex flex-wrap items-center gap-2">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono font-semibold tracking-wide">
							<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
							<span class="lang-zh">★ 2026 诺贝尔物理学奖 · FRANCIS HALZEN</span>
							<span class="lang-en">★ 2026 NOBEL PRIZE IN PHYSICS · FRANCIS HALZEN</span>
						</div>
						<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono">
							<span>🧊</span>
							<span>SOUTH POLE · 1 km³ ICE</span>
						</div>
					</div>
					<div class="text-xs font-mono text-zinc-400">
						<span class="lang-zh">2026-10-06 斯德哥尔摩宣布</span>
						<span class="lang-en">Announced 2026-10-06 in Stockholm</span>
					</div>
				</div>

				<h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-2">
					<span class="lang-zh">幽灵捕手 · 冰立方中微子探测器</span>
					<span class="lang-en">Ghost Catcher · IceCube Neutrino Lab</span>
				</h1>
				<p class="text-lg sm:text-xl font-bold text-cyan-400 mb-4 tracking-wide font-mono">
					<span class="lang-zh">幽灵捕手 · GHOST CATCHER — A Neutrino Detector You Can Play With</span>
					<span class="lang-en">GHOST CATCHER — A Neutrino Detector You Can Play With</span>
				</p>
				<p class="text-sm sm:text-base text-zinc-300/90 max-w-3xl leading-relaxed mb-3">
					<span class="lang-zh">
						2026 年 10 月 6 日，瑞典皇家科学院宣布将诺贝尔物理学奖授予弗朗西斯·哈尔岑（Francis Halzen，82 岁，威斯康星大学麦迪逊分校），表彰其对南极冰立方（IceCube）中微子天文台的决定性贡献及发现高能天体物理中微子。
					</span>
					<span class="lang-en">
						On October 6, 2026, the Royal Swedish Academy of Sciences awarded the Nobel Prize in Physics to Francis Halzen (82, University of Wisconsin-Madison) for decisive contributions to the IceCube Neutrino Observatory and the discovery of high-energy neutrinos of astrophysical origin.
					</span>
				</p>
				<p class="text-xs sm:text-sm text-zinc-400 max-w-3xl leading-relaxed">
					<span class="lang-zh">
						真实的冰立方拥有 86 根钢缆、5,160 个数字光学模块（DOMs），深埋在南极点 1,450 至 2,450 米的超纯净冰川中，占据整整一立方公里。中微子极偶尔与冰原子核相撞产生超光速次级粒子（在冰中速度超越光速 c / 1.31），激发出约 41° 的切伦科夫蓝光。DOM 记录纳秒级到达时序，逆向追踪并锁定百亿光年外的暴烈宇宙天体源。
					</span>
					<span class="lang-en">
						The real IceCube operates 86 strings with 60 DOMs each (5,160 optical sensors), buried 1,450–2,450 m deep inside a cubic kilometer of pristine South Pole glacial ice. Neutrinos occasionally collide with ice nuclei, producing secondary particles (like muons) moving faster than light in ice (v &gt; c / 1.31), radiating a ~41° blue Cherenkov light cone recorded with nanosecond precision.
					</span>
				</p>
			</section>

			<!-- BODY COUNTER BANNER -->
			<section class="relative z-10 mb-8">
				<div class="rounded-2xl bg-zinc-950/90 border border-cyan-500/30 p-5 sm:p-6 shadow-[0_0_25px_rgba(6,182,212,0.15)] relative overflow-hidden">
					<div class="absolute -right-16 -top-16 w-48 h-48 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none"></div>

					<div class="flex flex-wrap items-center justify-between gap-3 mb-3">
						<div class="flex items-center gap-2">
							<span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping"></span>
							<span class="text-xs font-mono uppercase tracking-widest text-cyan-300 font-bold">
								<span class="lang-zh">📡 太阳中微子实时穿透通量监测</span>
								<span class="lang-en">📡 Real-Time Solar Neutrino Flux Monitor</span>
							</span>
						</div>
						<div class="text-[11px] font-mono text-cyan-400/90 bg-cyan-950/60 px-2.5 py-1 rounded-md border border-cyan-800/60">
							~100 TRILLION / SEC · HUMAN BODY
						</div>
					</div>

					<div class="flex flex-col md:flex-row items-baseline md:items-center justify-between gap-4">
						<div>
							<div class="text-xs font-mono text-zinc-400 mb-1">
								<span class="lang-zh">自你打开本页面以来，穿透你身体的太阳中微子总数：</span>
								<span class="lang-en">Solar neutrinos passing through your body since opening this page:</span>
							</div>
							<div id="body-counter" class="font-mono text-3xl sm:text-5xl font-black text-cyan-300 tracking-wider drop-shadow-[0_0_15px_rgba(6,182,212,0.7)]">
								0.00 × 10¹⁴
							</div>
						</div>

						<div class="flex flex-col sm:flex-row gap-4 sm:gap-6 text-xs font-mono border-t md:border-t-0 md:border-l border-zinc-800 md:pl-6 pt-3 md:pt-0">
							<div>
								<span class="text-zinc-500 block">
									<span class="lang-zh">地面通量</span>
									<span class="lang-en">Earth Surface Flux</span>
								</span>
								<span class="text-zinc-200 font-bold">6.5 × 10¹⁰ / cm²·s</span>
							</div>
							<div>
								<span class="text-zinc-500 block">
									<span class="lang-zh">人体穿透速率</span>
									<span class="lang-en">Body Transit Rate</span>
								</span>
								<span class="text-cyan-400 font-bold">~1.0 × 10¹⁴ / s</span>
							</div>
							<div>
								<span class="text-zinc-500 block">
									<span class="lang-zh">80年体内碰撞期望</span>
									<span class="lang-en">80-Yr Body Collisions</span>
								</span>
								<span class="text-amber-400 font-bold">
									<span class="lang-zh">~1 次 (几乎完全透明)</span>
									<span class="lang-en">~1 Event (Nearly 100% Transparent)</span>
								</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- INTERACTIVE DETECTOR SANDBOX & CANVAS SECTION -->
			<section class="relative z-10 mb-10 pb-8 border-b border-zinc-800/80">
				<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
					<div>
						<h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2">
							<span class="text-cyan-400 font-mono text-xl">01/</span>
							<span class="lang-zh">南极深冰截面与交互沙盒</span>
							<span class="lang-en">Antarctic Ice Cross-Section & Sandbox</span>
						</h2>
						<p class="text-xs sm:text-sm text-zinc-400 mt-1">
							<span class="lang-zh">在 1,450–2,450 米深冰中发射中微子。观察罕见碰撞、切伦科夫蓝光锥 (~41°) 以及 DOM 光电倍增管的时序梯度响应。</span>
							<span class="lang-en">Fire neutrinos into deep ice (1,450–2,450 m). Witness rare collisions, ~41° Cherenkov light cones, and DOM timing gradients.</span>
						</p>
					</div>

					<!-- Historic presets -->
					<div class="flex flex-wrap items-center gap-1.5 text-xs font-mono">
						<span class="text-zinc-400 mr-1">
							<span class="lang-zh">著名真实事件:</span>
							<span class="lang-en">Real Events:</span>
						</span>
						<button id="preset-ernie" type="button" class="px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-700 hover:border-cyan-400 text-zinc-300 hover:text-white transition active:scale-95" title="2012 First PeV event">
							Ernie (1.14 PeV)
						</button>
						<button id="preset-bert" type="button" class="px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-700 hover:border-cyan-400 text-zinc-300 hover:text-white transition active:scale-95" title="2012 PeV event">
							Bert (1.04 PeV)
						</button>
						<button id="preset-blazar" type="button" class="px-2.5 py-1 rounded-md bg-zinc-900 border border-amber-500/50 text-amber-300 hover:text-white hover:border-amber-400 transition active:scale-95" title="2017 TXS 0506+056">
							TXS 0506+056 (290 TeV)
						</button>
						<button id="preset-ngc" type="button" class="px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-700 hover:border-cyan-400 text-zinc-300 hover:text-white transition active:scale-95" title="2022 Starburst galaxy">
							NGC 1068 (79 TeV)
						</button>
					</div>
				</div>

				<!-- DETECTOR CANVAS CONTAINER -->
				<div class="relative w-full rounded-2xl bg-[#030814] border border-zinc-800 shadow-[0_0_40px_rgba(0,0,0,0.8)] overflow-hidden mb-6">
					<!-- Canvas Overlay Toast Alert -->
					<div id="event-toast" class="absolute top-4 left-1/2 -translate-x-1/2 z-20 pointer-events-none transition-all duration-300 opacity-0 -translate-y-2">
						<div class="px-4 py-2 rounded-xl bg-zinc-950/90 border border-zinc-700 text-xs font-mono shadow-2xl flex items-center gap-2">
							<span id="toast-icon">👻</span>
							<span id="toast-msg" class="text-zinc-200"></span>
						</div>
					</div>

					<!-- Real-Time Reconstructed Source Badge pinned on canvas -->
					<div id="source-badge" class="absolute bottom-4 right-4 z-20 pointer-events-none transition-all duration-300 opacity-0">
						<div class="px-3.5 py-2 rounded-xl bg-zinc-950/90 border border-cyan-500/60 shadow-2xl text-xs font-mono flex items-center gap-2">
							<span class="text-amber-400">✦</span>
							<div>
								<div class="text-[10px] text-zinc-400 uppercase tracking-widest">
									<span class="lang-zh">反向追踪天体源</span>
									<span class="lang-en">Reconstructed Source</span>
								</div>
								<div id="source-name" class="text-cyan-300 font-bold">耀变体 TXS 0506+056</div>
							</div>
						</div>
					</div>

					<!-- Canvas Depth Scale Legend (Right Top) -->
					<div class="absolute top-3 right-3 z-10 pointer-events-none hidden sm:flex items-center gap-3 px-3 py-1.5 rounded-lg bg-black/60 border border-zinc-800 text-[11px] font-mono text-zinc-400">
						<div class="flex items-center gap-1.5">
							<span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
							<span class="lang-zh">率先到达 (0-40ns)</span>
							<span class="lang-en">Earliest (0-40ns)</span>
						</div>
						<div class="flex items-center gap-1.5">
							<span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
							<span class="lang-zh">中间时序</span>
							<span class="lang-en">Mid Timing</span>
						</div>
						<div class="flex items-center gap-1.5">
							<span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
							<span class="lang-zh">延迟光子</span>
							<span class="lang-en">Trailing</span>
						</div>
					</div>

					<canvas
						id="icecube-canvas"
						class="w-full h-[460px] sm:h-[540px] block cursor-crosshair touch-none select-none"
					></canvas>
				</div>

				<!-- INTERACTIVE CONTROLS DOCK -->
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
					<!-- PRIMARY CONTROLS (Left Col: 7 cols) -->
					<div class="lg:col-span-7 space-y-4">
						<!-- ZENITH SLIDER CARD -->
						<div class="p-4 sm:p-5 rounded-xl bg-zinc-950/80 border border-zinc-800/90 shadow-sm">
							<div class="flex flex-wrap items-center justify-between gap-2 mb-2">
								<div class="flex items-center gap-2">
									<span class="text-xs font-bold font-mono uppercase tracking-wider text-zinc-300">
										<span class="lang-zh">天顶入射角 (Zenith Angle θ)</span>
										<span class="lang-en">Zenith Angle θ</span>
									</span>
									<span id="zenith-angle-text" class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/60">
										θ = 34.0°
									</span>
								</div>
								<div id="zenith-channel-badge" class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded bg-zinc-900 border border-zinc-700 text-zinc-300">
									⬇️ 下行通道 (Down-going · 来自天空)
								</div>
							</div>

							<input
								id="slider-zenith"
								type="range"
								min="0"
								max="180"
								step="1"
								value="34"
								class="w-full h-2 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
							/>

							<div class="flex justify-between text-[11px] font-mono text-zinc-500 mt-2">
								<span>0° (天顶 / Sky)</span>
								<span>90° (地平线 / Horizon)</span>
								<span>180° (天底 / Nadir · 地心)</span>
							</div>

							<!-- Zenith Quick Angle Presets -->
							<div class="flex flex-wrap items-center gap-1.5 mt-3 pt-3 border-t border-zinc-800/80 text-xs font-mono">
								<span class="text-zinc-500 text-[11px]">
									<span class="lang-zh">快捷角度:</span>
									<span class="lang-en">Angles:</span>
								</span>
								<button id="ang-sky" type="button" class="px-2 py-0.5 rounded bg-zinc-900 border border-zinc-700 text-zinc-300 hover:text-white transition active:scale-95 text-[11px]">
									0° (直射)
								</button>
								<button id="ang-down" type="button" class="px-2 py-0.5 rounded bg-zinc-900 border border-zinc-700 text-zinc-300 hover:text-white transition active:scale-95 text-[11px]">
									34° (经典下行)
								</button>
								<button id="ang-horiz" type="button" class="px-2 py-0.5 rounded bg-zinc-900 border border-zinc-700 text-zinc-300 hover:text-white transition active:scale-95 text-[11px]">
									90° (水平切线)
								</button>
								<button id="ang-up" type="button" class="px-2 py-0.5 rounded bg-zinc-900 border border-zinc-700 text-zinc-300 hover:text-white transition active:scale-95 text-[11px]">
									142° (穿透地球)
								</button>
								<button id="ang-nadir" type="button" class="px-2 py-0.5 rounded bg-zinc-900 border border-zinc-700 text-zinc-300 hover:text-white transition active:scale-95 text-[11px]">
									180° (地心自底向上)
								</button>
							</div>
						</div>

						<!-- ENERGY LEVEL SELECTION CARD -->
						<div class="p-4 sm:p-5 rounded-xl bg-zinc-950/80 border border-zinc-800/90 shadow-sm">
							<div class="flex flex-wrap items-center justify-between gap-2 mb-3">
								<div class="flex items-center gap-2">
									<span class="text-xs font-bold font-mono uppercase tracking-wider text-zinc-300">
										<span class="lang-zh">中微子能量级别 (Energy Scale)</span>
										<span class="lang-en">Neutrino Energy Scale</span>
									</span>
									<span class="text-[11px] font-mono text-zinc-500">
										σ_ν ∝ E^0.5 (玩具截面 / Toy Simulation)
									</span>
								</div>
								<div id="energy-xsec-text" class="text-[11px] font-mono text-cyan-400">
									相对截面: 1.0×
								</div>
							</div>

							<div class="grid grid-cols-3 gap-2">
								<button
									id="btn-energy-1tev"
									type="button"
									class="energy-btn px-3 py-2 rounded-xl text-xs font-mono font-semibold border border-zinc-700 bg-zinc-900 text-zinc-300 hover:border-cyan-500/50 transition active:scale-95 text-center"
								>
									<div>1 TeV</div>
									<div class="text-[10px] font-normal text-zinc-500">
										<span class="lang-zh">低能天体 / P ~ 0.05%</span>
										<span class="lang-en">Low-E / P ~ 0.05%</span>
									</div>
								</button>
								<button
									id="btn-energy-100tev"
									type="button"
									class="energy-btn px-3 py-2 rounded-xl text-xs font-mono font-semibold border border-cyan-500 bg-cyan-950/40 text-cyan-300 shadow-sm transition active:scale-95 text-center"
								>
									<div>100 TeV</div>
									<div class="text-[10px] font-normal text-cyan-400/80">
										<span class="lang-zh">典型宇宙源 / P ~ 0.20%</span>
										<span class="lang-en">Astrophysical / P ~ 0.20%</span>
									</div>
								</button>
								<button
									id="btn-energy-10pev"
									type="button"
									class="energy-btn px-3 py-2 rounded-xl text-xs font-mono font-semibold border border-zinc-700 bg-zinc-900 text-zinc-300 hover:border-cyan-500/50 transition active:scale-95 text-center"
								>
									<div>10 PeV</div>
									<div class="text-[10px] font-normal text-zinc-500">
										<span class="lang-zh">极端巨能 / P ~ 2.0%</span>
										<span class="lang-en">Extreme PeV / P ~ 2.0%</span>
									</div>
								</button>
							</div>
						</div>

						<!-- ACTION BUTTONS -->
						<div class="flex flex-wrap items-center gap-3">
							<!-- FIRE SINGLE -->
							<button
								id="btn-fire-single"
								type="button"
								class="flex-1 min-w-[160px] px-5 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-zinc-950 font-bold text-sm tracking-wide shadow-[0_0_20px_rgba(6,182,212,0.4)] transition active:scale-95 flex items-center justify-center gap-2"
							>
								<span>🎯</span>
								<span>
									<span class="lang-zh">发射单颗中微子</span>
									<span class="lang-en">Fire Single Neutrino</span>
								</span>
							</button>

							<!-- TRIGGER EVENT -->
							<button
								id="btn-trigger-event"
								type="button"
								class="px-4 py-3 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/40 text-amber-300 font-bold text-xs tracking-wide transition active:scale-95 flex items-center gap-2"
								title="Guaranteed high-energy event for inspection"
							>
								<span>⚡</span>
								<span>
									<span class="lang-zh">必定捕获高能事例</span>
									<span class="lang-en">Force High-E Event</span>
								</span>
							</button>

							<!-- BARRAGE MODE -->
							<button
								id="btn-barrage"
								type="button"
								class="px-4 py-3 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-zinc-200 font-bold text-xs tracking-wide transition active:scale-95 flex items-center gap-2"
							>
								<span>🚀</span>
								<span>
									<span class="lang-zh">齐射模式 (N=2000)</span>
									<span class="lang-en">Barrage (N=2000)</span>
								</span>
							</button>

							<!-- CLEAR / RESET -->
							<button
								id="btn-clear"
								type="button"
								class="px-3.5 py-3 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-400 hover:text-zinc-200 text-xs transition active:scale-95"
								title="Clear Display"
							>
								<span>🔄</span>
							</button>
						</div>
					</div>

					<!-- EVENT INSPECTION & TELEMETRY PANEL (Right Col: 5 cols) -->
					<div class="lg:col-span-5 space-y-4">
						<!-- CAPTURED EVENT READOUT CARD -->
						<div class="p-4 sm:p-5 rounded-xl bg-zinc-950/80 border border-zinc-800/90 shadow-sm">
