				// BODY COUNTER TICKER
				function updateBodyCounter() {
					if (!bodyCounterEl) return;
					const elapsedSec = (Date.now() - pageStartTime) / 1000;
					// ~1.0 x 10^14 neutrinos per sec
					const totalNeutrinos = elapsedSec * 1.0e14;
					const exponent = Math.floor(Math.log10(totalNeutrinos || 1));
					const mantissa = totalNeutrinos / Math.pow(10, exponent);
					bodyCounterEl.textContent = `${mantissa.toFixed(2)} × 10¹⁴`;
				}
				tickerTimer = setInterval(updateBodyCounter, 80);
				updateBodyCounter();

				// RESIZE & DOM INITIALIZATION
				function resizeCanvas() {
					const rect = canvas.getBoundingClientRect();
					cw = rect.width;
					ch = rect.height || 480;
					dpr = Math.min(window.devicePixelRatio || 1, 2);

					canvas.width = Math.floor(cw * dpr);
					canvas.height = Math.floor(ch * dpr);
					ctx.setTransform(1, 0, 0, 1, 0, 0);
					ctx.scale(dpr, dpr);

					surfaceY = Math.floor(ch * 0.14);
					detTop = Math.floor(ch * 0.32); // 1,450 m
					detBottom = Math.floor(ch * 0.88); // 2,450 m
					detLeft = Math.floor(cw * 0.14);
					detRight = Math.floor(cw * 0.94);

					// Build DOM array
					domList = [];
					const xStep = (detRight - detLeft) / (NUM_STRINGS - 1);
					const yStep = (detBottom - detTop) / (DOMS_PER_STRING - 1);

					for (let s = 0; s < NUM_STRINGS; s++) {
						const sx = detLeft + s * xStep;
						for (let d = 0; d < DOMS_PER_STRING; d++) {
							const sy = detTop + d * yStep;
							// Depth in meters (1450m to 2450m)
							const depthM = 1450 + Math.round((d / (DOMS_PER_STRING - 1)) * 1000);
							domList.push({
								stringIndex: s + 1,
								domIndex: d + 1,
								x: sx,
								y: sy,
								depthM: depthM,
								// Dynamic hit lighting state
								litProgress: 0,
								charge: 0,
								timingColor: "#38bdf8",
								hitTimeNs: 0,
							});
						}
					}

					// Ambient snow particles
					ambientSnow = [];
					for (let i = 0; i < 40; i++) {
						ambientSnow.push({
							x: Math.random() * cw,
							y: Math.random() * surfaceY,
							vx: -0.4 - Math.random() * 0.8,
							vy: 0.1 + Math.random() * 0.3,
							size: 1 + Math.random() * 2,
							alpha: 0.3 + Math.random() * 0.5,
						});
					}
				}

				// COLOR SPECTRUM BASED ON ARRIVAL TIME
				// Early hits: Red-Orange (0-40ns) -> Yellow-Green (40-100ns) -> Cyan-Blue-Violet (>120ns)
				function getTimingColor(tRatio) {
					// tRatio 0.0 to 1.0
					if (tRatio <= 0.25) {
						const k = tRatio / 0.25;
						return `rgb(255, ${Math.round(60 + 120 * k)}, 40)`;
					} else if (tRatio <= 0.5) {
						const k = (tRatio - 0.25) / 0.25;
						return `rgb(${Math.round(255 - 130 * k)}, ${Math.round(180 + 50 * k)}, 50)`;
					} else if (tRatio <= 0.75) {
						const k = (tRatio - 0.5) / 0.25;
						return `rgb(34, 211, ${Math.round(238 - 80 * k)})`;
					} else {
						const k = (tRatio - 0.75) / 0.25;
						return `rgb(${Math.round(30 + 150 * k)}, 100, 255)`;
					}
				}

