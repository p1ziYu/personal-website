				// COMPUTE PARTICLE TRAJECTORY FROM ZENITH DEGREE
				function computeTrajectory(thetaDeg, isForceHit = false) {
					// theta = 0: from straight above (sky) moving downwards: (0, 1)
					// theta = 90: horizontal moving left to right: (1, 0)
					// theta = 180: from below (Earth core) moving upwards: (0, -1)
					const rad = (thetaDeg * Math.PI) / 180;
					const dirX = Math.sin(rad);
					const dirY = Math.cos(rad);

					// Entry & exit points through canvas bounds
					let x0, y0, x1, y1;
					const centerDetX = (detLeft + detRight) / 2;
					const centerDetY = (detTop + detBottom) / 2;

					// Ray casting through box center with offset
					const span = Math.hypot(cw, ch) * 1.5;
					const jitterX = (Math.random() - 0.5) * (detRight - detLeft) * 0.6;
					const midX = centerDetX + jitterX;
					const midY = centerDetY;

					x0 = midX - dirX * span;
					y0 = midY - dirY * span;
					x1 = midX + dirX * span;
					y1 = midY + dirY * span;

					// Interaction check:
					// Cross section ~ 0.002 * sqrt(E / 100)
					const pInteraction = isForceHit
						? 1.0
						: 0.002 * Math.sqrt(currentEnergyLevel / 100);
					const isHit = Math.random() < pInteraction;

					let hitPoint = null;
					let eventData = null;
					let cherenkovCone = null;
					let litDoms = [];

					if (isHit) {
						// Vertex inside instrumented volume
						const vx = detLeft + Math.random() * (detRight - detLeft);
						const vy = detTop + Math.random() * (detBottom - detTop);
						hitPoint = { x: vx, y: vy };

						// Energy calculation based on current energy level with log-normal distribution
						let energyTeV = currentEnergyLevel * (0.4 + Math.random() * 1.8);
						if (currentEnergyLevel >= 10000) {
							energyTeV = 1000 + Math.random() * 9000;
						}

						const isCascade = Math.random() > 0.65;
						const sourceInfo =
							CANDIDATE_SOURCES[Math.floor(Math.random() * CANDIDATE_SOURCES.length)];

						eventData = {
							energyTeV: energyTeV,
							zenithDeg: thetaDeg + (Math.random() - 0.5) * 0.8, // Reconstruction error ~0.4 deg
							isCascade: isCascade,
							source: sourceInfo,
							totalCharge: 0,
							hitDomsCount: 0,
						};

						// Calculate Cherenkov cone envelope in ice
						// Cherenkov angle in ice: theta_c ≈ 40.2° ≈ 0.70 rad
						const thetaC = (40.5 * Math.PI) / 180;
						const trackLength = isCascade
							? 80 + Math.random() * 40
							: 240 + Math.random() * 100;
						const trackEnd = {
							x: vx + dirX * trackLength,
							y: vy + dirY * trackLength,
						};

						// Normal to track direction
						const nx = -dirY;
						const ny = dirX;
						const coneWidth = trackLength * Math.tan(thetaC);

						cherenkovCone = {
							v0: { x: vx, y: vy },
							v1: trackEnd,
							dirX: dirX,
							dirY: dirY,
							normX: nx,
							normY: ny,
							length: trackLength,
							coneWidth: coneWidth,
						};

						// Find which DOMs fall in Cherenkov light corridor & compute physical timing
						let minTime = Infinity;
						let maxTime = -Infinity;
						const rawHits = [];

						for (const dom of domList) {
							// Vector from vertex to DOM
							const dx = dom.x - vx;
							const dy = dom.y - vy;
							const proj = dx * dirX + dy * dirY; // distance along track
							const perp = Math.abs(dx * nx + dy * ny); // perpendicular distance

							// Optical threshold: forward cone within 160px
							if (proj > -10 && proj < trackLength + 60 && perp < coneWidth * 1.2 + 25) {
								// Speed of muon ~ c, speed of light in ice c/n (n ≈ 1.31)
								// Physical arrival time t_ns
								const tNs = (proj * 1.0) / 0.3 + (perp * 1.31) / 0.3; // in simulated nanoseconds
								const chargePE = Math.max(
									1,
									Math.round((380 / (perp + 12)) * (1.0 + Math.random() * 0.4)),
								);

								if (tNs < minTime) minTime = tNs;
								if (tNs > maxTime) maxTime = tNs;

								rawHits.push({
									dom: dom,
									tNs: tNs,
									chargePE: chargePE,
								});
							}
						}

						if (maxTime <= minTime) maxTime = minTime + 10;
						let totalPE = 0;

						for (const hit of rawHits) {
							const tRatio = Math.max(0, Math.min(1, (hit.tNs - minTime) / (maxTime - minTime)));
							const timingColor = getTimingColor(tRatio);

							hit.dom.litProgress = 1.0;
							hit.dom.charge = hit.chargePE;
							hit.dom.timingColor = timingColor;
							hit.dom.hitTimeNs = Math.round(hit.tNs);

							totalPE += hit.chargePE;
							litDoms.push(hit.dom);
						}

						eventData.totalCharge = totalPE;
						eventData.hitDomsCount = rawHits.length;
					}

					return {
						x0: x0,
						y0: y0,
						x1: x1,
						y1: y1,
						dirX: dirX,
						dirY: dirY,
						progress: 0,
						speed: 0.035, // progress increment per frame
						isHit: isHit,
						hitPoint: hitPoint,
						eventData: eventData,
						cherenkovCone: cherenkovCone,
						litDoms: litDoms,
						alpha: 1.0,
					};
				}

				// POPULATE EVENT READOUT TELEMETRY
				function displayEventTelemetry(data) {
					if (!data) return;

					// Format energy: TeV or PeV
					let energyStr = "";
					if (data.energyTeV >= 1000) {
						energyStr = `${(data.energyTeV / 1000).toFixed(2)} PeV`;
					} else {
						energyStr = `${data.energyTeV.toFixed(1)} TeV`;
					}

					if (readoutEnergy) readoutEnergy.textContent = energyStr;
					if (readoutZenith) readoutZenith.textContent = `${data.zenithDeg.toFixed(1)}°`;
					if (readoutDoms) readoutDoms.textContent = `${data.hitDomsCount} / 504`;
					if (readoutCharge) readoutCharge.textContent = `${data.totalCharge.toLocaleString()} p.e.`;

					const isEnPage =
						document.documentElement.lang === "en" ||
						location.pathname.startsWith("/en") ||
						document.documentElement.getAttribute("data-lang") === "en";

					if (eventTopologyBadge) {
						const typeStr = data.isCascade
							? isEnPage
								? "CASCADE (ν_e / ν_τ)"
								: "级联型 (ν_e / ν_τ 强子簇射)"
							: isEnPage
								? "TRACK (ν_μ 缪子径迹)"
								: "径迹型 (ν_μ 相对论缪子)";
						eventTopologyBadge.textContent = typeStr;
						eventTopologyBadge.className =
							"text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-950/80 border border-cyan-500/70 text-cyan-300 font-bold";
					}

					if (readoutSource) {
						readoutSource.textContent = isEnPage ? data.source.nameEn : data.source.nameZh;
					}
					if (readoutDetail) {
						readoutDetail.textContent = isEnPage ? data.source.detailEn : data.source.detailZh;
					}

					// Show canvas pinned badge
					if (sourceBadge && sourceName) {
						sourceName.textContent = isEnPage ? data.source.nameEn : data.source.nameZh;
						sourceBadge.style.opacity = "1";
					}
				}

				// UPDATE TALLY METRICS & HISTOGRAM
				function updateTallyMetrics(newFired, newHits) {
					tallyFired += newFired;
					tallyHits += newHits;
					tallyEscaped += newFired - newHits;

					if (tallyFiredEl) tallyFiredEl.textContent = tallyFired.toLocaleString();
					if (tallyHitsEl) tallyHitsEl.textContent = tallyHits.toLocaleString();
					if (tallyEscapedEl) tallyEscapedEl.textContent = tallyEscaped.toLocaleString();

					const rate = tallyFired > 0 ? (tallyHits / tallyFired) * 100 : 0;
					if (tallyRateEl) tallyRateEl.textContent = `${rate.toFixed(2)}%`;

					// Update histogram bars
					const maxBin = Math.max(1, ...histogramCounts);
					const bars = [barBin0, barBin1, barBin2, barBin3];
					const counts = [countBin0, countBin1, countBin2, countBin3];

					for (let i = 0; i < 4; i++) {
						if (bars[i]) {
							const pct = (histogramCounts[i] / maxBin) * 100;
							bars[i].style.width = `${Math.min(100, Math.max(6, pct))}%`;
						}
						if (counts[i]) {
							counts[i].textContent = String(histogramCounts[i]);
						}
					}
				}

				// REGISTER HIT IN HISTOGRAM
				function recordHistogramEnergy(energyTeV) {
					if (energyTeV < 10) {
						histogramCounts[0]++;
					} else if (energyTeV < 100) {
						histogramCounts[1]++;
					} else if (energyTeV < 1000) {
						histogramCounts[2]++;
					} else {
						histogramCounts[3]++;
					}
				}

				// FIRE SINGLE ACTION
				function fireSingleNeutrino(isForce = false) {
					const track = computeTrajectory(currentZenithDeg, isForce);
					activeTracks.push(track);

					updateTallyMetrics(1, track.isHit ? 1 : 0);

					if (track.isHit) {
						recordHistogramEnergy(track.eventData.energyTeV);
						displayEventTelemetry(track.eventData);
						showToast(
							"⚡",
							`捕获中微子！能量: ${(track.eventData.energyTeV >= 1000 ? (track.eventData.energyTeV / 1000).toFixed(2) + " PeV" : track.eventData.energyTeV.toFixed(1) + " TeV")} · 触发 ${track.eventData.hitDomsCount} 个 DOM`,
							`Neutrino Captured! E = ${(track.eventData.energyTeV >= 1000 ? (track.eventData.energyTeV / 1000).toFixed(2) + " PeV" : track.eventData.energyTeV.toFixed(1) + " TeV")} · ${track.eventData.hitDomsCount} DOMs Lit`,
						);
					} else {
						showToast(
							"👻",
							"未命中 · 幽灵粒子穿透地球与冰层逸出 (弱相互作用极度罕见)",
							"Missed · Ghost neutrino passed through Earth without collision",
						);
					}
				}

				if (btnFireSingle) {
					btnFireSingle.addEventListener("click", () => fireSingleNeutrino(false));
				}
				if (btnTriggerEvent) {
					btnTriggerEvent.addEventListener("click", () => fireSingleNeutrino(true));
				}

				// BARRAGE MODE (N=2000)
				let isBarraging = false;
				function runBarrage() {
					if (isBarraging) return;
					isBarraging = true;
					const N = 2000;
					const pInt = 0.002 * Math.sqrt(currentEnergyLevel / 100);

					let barrageHits = 0;

					// Monte Carlo trials
					for (let i = 0; i < N; i++) {
						if (Math.random() < pInt) {
							barrageHits++;
							// Sample energy in TeV
							let energyTeV = currentEnergyLevel * (0.3 + Math.random() * 2.2);
							recordHistogramEnergy(energyTeV);
						}
					}

					// Visual stream: generate 25 quick animated track streaks
					const streamCount = 25;
					for (let i = 0; i < streamCount; i++) {
						const isThisHit = i === 0 && barrageHits > 0;
						setTimeout(() => {
							const t = computeTrajectory(currentZenithDeg, isThisHit);
							t.speed = 0.05 + Math.random() * 0.04;
							activeTracks.push(t);
							if (isThisHit && t.isHit) {
								displayEventTelemetry(t.eventData);
							}
						}, i * 35);
					}

					updateTallyMetrics(N, barrageHits);

					setTimeout(() => {
						isBarraging = false;
						showToast(
							"🚀",
							`齐射完毕: 2,000 颗中微子 · 捕获 ${barrageHits} 例 · 逸出 ${N - barrageHits} 例`,
							`Barrage Done: 2,000 fired · ${barrageHits} captured · ${N - barrageHits} escaped`,
						);
					}, 1000);
				}

				if (btnBarrage) {
					btnBarrage.addEventListener("click", runBarrage);
				}

				// CLEAR / RESET
				if (btnClear) {
					btnClear.addEventListener("click", () => {
						activeTracks = [];
						for (const d of domList) {
							d.litProgress = 0;
							d.charge = 0;
						}
						tallyFired = 0;
						tallyHits = 0;
						tallyEscaped = 0;
						histogramCounts = [0, 0, 0, 0];
						updateTallyMetrics(0, 0);
						if (sourceBadge) sourceBadge.style.opacity = "0";
						if (eventTopologyBadge) {
							eventTopologyBadge.textContent = "等待事例 / QUIESCENT";
							eventTopologyBadge.className =
								"text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-900 border border-zinc-700 text-zinc-400";
						}
						if (readoutEnergy) readoutEnergy.textContent = "-- TeV";
						if (readoutZenith) readoutZenith.textContent = "--°";
						if (readoutDoms) readoutDoms.textContent = "0 / 504";
						if (readoutCharge) readoutCharge.textContent = "0 p.e.";
						showToast("🔄", "画布与统计已重置", "Display and statistics cleared");
					});
				}

				// HISTORIC PRESET BUTTONS
				function loadHistoricEvent(energyTeV, zenithDeg, isCascade, sourceName, desc) {
					setZenith(zenithDeg);
					const track = computeTrajectory(zenithDeg, true);
					track.eventData.energyTeV = energyTeV;
					track.eventData.isCascade = isCascade;
					track.eventData.source = {
						nameZh: sourceName,
						nameEn: sourceName,
						detailZh: desc,
						detailEn: desc,
					};
					activeTracks.push(track);
					recordHistogramEnergy(energyTeV);
					updateTallyMetrics(1, 1);
					displayEventTelemetry(track.eventData);
					showToast("⭐", `载入历史里程碑: ${sourceName}`, `Loaded historic event: ${sourceName}`);
				}

				if (presetErnie) {
					presetErnie.addEventListener("click", () => {
						loadHistoricEvent(
							1140,
							34.2,
							true,
							"Ernie (厄尼 · 2012 第一批 PeV 宇宙级联事件)",
							"人类首个确认的千万亿电子伏特级 (PeV) 宇宙高能中微子，开启高能中微子天文学纪元。",
						);
					});
				}
				if (presetBert) {
					presetBert.addEventListener("click", () => {
						loadHistoricEvent(
							1040,
							52.1,
							true,
							"Bert (伯特 · 2012 第一批 PeV 宇宙级联事件)",
							"与 Ernie 同年探测到的孪生 PeV 级联事例，彻底证实天体物理高能中微子通量。",
						);
					});
				}
				if (presetBlazar) {
					presetBlazar.addEventListener("click", () => {
						loadHistoricEvent(
							290,
							142.3,
							false,
							"IceCube-170922A (耀变体 TXS 0506+056 联合证实)",
							"穿透整个地球的上行缪子径迹！全球 20 座电磁望远镜联合预警，首度证实黑洞喷流中微子源。",
						);
					});
				}
				if (presetNgc) {
					presetNgc.addEventListener("click", () => {
						loadHistoricEvent(
							79,
							104.5,
							false,
							"NGC 1068 (星暴星系活跃核稳态辐射 · 2022)",
							"冰立方积累 10 年数据探测到的活跃星系核稳态中微子点源，多信使天文学重大进展。",
						);
					});
				}

				// ==========================================
				// CANVAS RENDER LOOP
				// ==========================================
				function render() {
					ctx.clearRect(0, 0, cw, ch);

					// 1. Background Glacier Ice Gradient
					const iceGrad = ctx.createLinearGradient(0, 0, 0, ch);
					iceGrad.addColorStop(0, "#081b33"); // Cold surface twilight
					iceGrad.addColorStop(0.18, "#041022"); // Firn layer transition
					iceGrad.addColorStop(0.45, "#020a17"); // 1450m ultra-clear ice
					iceGrad.addColorStop(0.75, "#020712"); // 2000m deep dark ice
					iceGrad.addColorStop(1.0, "#01040a"); // 2800m bedrock approach
					ctx.fillStyle = iceGrad;
					ctx.fillRect(0, 0, cw, ch);

					// 2. Volcanic Dust Layer (around ~2000m depth, between 60% and 66% of canvas)
					const dustY0 = Math.floor(detTop + (detBottom - detTop) * 0.52);
					const dustY1 = Math.floor(detTop + (detBottom - detTop) * 0.62);
					const dustGrad = ctx.createLinearGradient(0, dustY0, 0, dustY1);
					dustGrad.addColorStop(0, "rgba(50, 40, 25, 0)");
					dustGrad.addColorStop(0.5, "rgba(70, 55, 30, 0.14)");
					dustGrad.addColorStop(1, "rgba(50, 40, 25, 0)");
					ctx.fillStyle = dustGrad;
					ctx.fillRect(detLeft - 20, dustY0, detRight - detLeft + 40, dustY1 - dustY0);

					// 3. Depth Scale & Labels on Left
					ctx.strokeStyle = "rgba(56, 189, 248, 0.25)";
					ctx.lineWidth = 1;
					const rulerX = detLeft - 18;
					ctx.beginPath();
					ctx.moveTo(rulerX, surfaceY);
					ctx.lineTo(rulerX, detBottom + 20);
					ctx.stroke();

					ctx.fillStyle = "rgba(148, 163, 184, 0.75)";
					ctx.font = "10px monospace";
					ctx.textAlign = "right";

					// 0m Surface
					ctx.fillText("0 m", rulerX - 6, surfaceY + 3);
					ctx.beginPath();
					ctx.moveTo(rulerX - 4, surfaceY);
					ctx.lineTo(rulerX + 4, surfaceY);
					ctx.stroke();

					// 1,450m Top
					ctx.fillText("-1,450 m", rulerX - 6, detTop + 3);
					ctx.beginPath();
					ctx.moveTo(rulerX - 4, detTop);
					ctx.lineTo(rulerX + 4, detTop);
					ctx.stroke();

					// Volcanic dust marker
					ctx.fillStyle = "rgba(217, 119, 6, 0.65)";
					ctx.fillText("~2,000 m (Dust)", rulerX - 6, (dustY0 + dustY1) / 2 + 3);
					ctx.fillStyle = "rgba(148, 163, 184, 0.75)";

					// 2,450m Bottom
					ctx.fillText("-2,450 m", rulerX - 6, detBottom + 3);
					ctx.beginPath();
					ctx.moveTo(rulerX - 4, detBottom);
					ctx.lineTo(rulerX + 4, detBottom);
					ctx.stroke();

					// 4. Surface Snow Line & South Pole Station Markers
					ctx.strokeStyle = "rgba(224, 242, 254, 0.8)";
					ctx.lineWidth = 2;
					ctx.beginPath();
					ctx.moveTo(0, surfaceY);
					for (let x = 0; x <= cw; x += 10) {
						const y = surfaceY + Math.sin(x * 0.02) * 1.5;
						ctx.lineTo(x, y);
					}
					ctx.stroke();

					// IceCube Laboratory (ICL) Building
					const iclX = detLeft + 90;
					ctx.fillStyle = "#1e293b";
					ctx.strokeStyle = "#0284c7";
					ctx.lineWidth = 1;
					ctx.fillRect(iclX - 24, surfaceY - 14, 48, 14);
					ctx.strokeRect(iclX - 24, surfaceY - 14, 48, 14);
					// Twin towers of ICL
					ctx.fillRect(iclX - 20, surfaceY - 22, 10, 8);
					ctx.strokeRect(iclX - 20, surfaceY - 22, 10, 8);
					ctx.fillRect(iclX + 10, surfaceY - 22, 10, 8);
					ctx.strokeRect(iclX + 10, surfaceY - 22, 10, 8);

					ctx.fillStyle = "rgba(224, 242, 254, 0.85)";
					ctx.font = "9px monospace";
					ctx.textAlign = "center";
					ctx.fillText("IceCube Lab (ICL)", iclX, surfaceY - 27);

					// South Pole Ceremonial Marker
					const spX = detLeft + 25;
					ctx.strokeStyle = "#f59e0b";
					ctx.lineWidth = 2;
					ctx.beginPath();
					ctx.moveTo(spX, surfaceY - 18);
					ctx.lineTo(spX, surfaceY);
					ctx.stroke();
					// Red flag
					ctx.fillStyle = "#ef4444";
					ctx.beginPath();
					ctx.moveTo(spX, surfaceY - 18);
					ctx.lineTo(spX + 12, surfaceY - 13);
					ctx.lineTo(spX, surfaceY - 8);
					ctx.fill();
					ctx.fillStyle = "#fbbf24";
					ctx.fillText("South Pole", spX + 6, surfaceY - 22);

					// Ambient snow particles
					for (const s of ambientSnow) {
						s.x += s.vx;
						s.y += s.vy;
						if (s.x < 0) s.x = cw;
						if (s.y > surfaceY) s.y = 0;
						ctx.fillStyle = `rgba(224, 242, 254, ${s.alpha})`;
						ctx.fillRect(s.x, s.y, s.size, s.size);
					}

					// 5. Cable Strings
					const xStep = (detRight - detLeft) / (NUM_STRINGS - 1);
					ctx.strokeStyle = "rgba(56, 189, 248, 0.12)";
					ctx.lineWidth = 1;
					for (let s = 0; s < NUM_STRINGS; s++) {
						const sx = detLeft + s * xStep;
						ctx.beginPath();
						ctx.moveTo(sx, surfaceY);
						ctx.lineTo(sx, detBottom + 12);
						ctx.stroke();
					}

					// 6. Active Particle Tracks & Cherenkov Cones
					for (let i = activeTracks.length - 1; i >= 0; i--) {
						const tr = activeTracks[i];
						tr.progress += tr.speed;

						// Interpolated head position of the particle
						const currX = tr.x0 + (tr.x1 - tr.x0) * Math.min(1, tr.progress);
						const currY = tr.y0 + (tr.y1 - tr.y0) * Math.min(1, tr.progress);

						// Draw dashed ghost trajectory streak
						ctx.save();
						ctx.strokeStyle = `rgba(34, 211, 238, ${0.4 * tr.alpha})`;
						ctx.lineWidth = 1.5;
						ctx.setLineDash([4, 6]);
						ctx.beginPath();
						ctx.moveTo(tr.x0, tr.y0);
						ctx.lineTo(currX, currY);
						ctx.stroke();
						ctx.restore();

						// Particle head glow
						if (tr.progress < 1.1) {
							ctx.fillStyle = `rgba(255, 255, 255, ${0.9 * tr.alpha})`;
							ctx.beginPath();
							ctx.arc(currX, currY, 2.5, 0, Math.PI * 2);
							ctx.fill();
						}

						// If hit occurred, draw Cherenkov shockwave cone & muon ionizing track
						if (tr.isHit && tr.cherenkovCone && tr.progress > 0.3) {
							const cone = tr.cherenkovCone;
							const vx = cone.v0.x;
							const vy = cone.v0.y;

							// Draw translucent Cherenkov Blue Cone Envelope
							ctx.save();
							ctx.beginPath();
							ctx.moveTo(vx, vy);
							ctx.lineTo(
								cone.v1.x + cone.normX * cone.coneWidth,
								cone.v1.y + cone.normY * cone.coneWidth,
							);
							ctx.lineTo(
								cone.v1.x - cone.normX * cone.coneWidth,
								cone.v1.y - cone.normY * cone.coneWidth,
							);
							ctx.closePath();

							const coneGrad = ctx.createLinearGradient(vx, vy, cone.v1.x, cone.v1.y);
							coneGrad.addColorStop(0, `rgba(6, 182, 212, ${0.35 * tr.alpha})`);
							coneGrad.addColorStop(0.7, `rgba(2, 132, 199, ${0.2 * tr.alpha})`);
							coneGrad.addColorStop(1, `rgba(30, 58, 138, ${0.05 * tr.alpha})`);
							ctx.fillStyle = coneGrad;
							ctx.fill();

							// Cherenkov shockwave outer wavefront line
							ctx.strokeStyle = `rgba(56, 189, 248, ${0.45 * tr.alpha})`;
							ctx.lineWidth = 1;
							ctx.stroke();
							ctx.restore();

							// Relativistic Muon Track core
							ctx.save();
							ctx.strokeStyle = `rgba(255, 255, 255, ${0.95 * tr.alpha})`;
							ctx.lineWidth = 2.5;
							ctx.beginPath();
							ctx.moveTo(vx, vy);
							ctx.lineTo(cone.v1.x, cone.v1.y);
							ctx.stroke();

							// Outer intense cyan ionizing aura
							ctx.strokeStyle = `rgba(34, 211, 238, ${0.5 * tr.alpha})`;
							ctx.lineWidth = 7;
							ctx.stroke();
							ctx.restore();

							// Reverse Cosmic Direction Vector (Back-pointing arrow to cosmos)
							ctx.save();
							ctx.setLineDash([3, 4]);
							ctx.strokeStyle = `rgba(251, 191, 36, ${0.8 * tr.alpha})`;
							ctx.lineWidth = 1.5;
							const revLen = 140;
							const revX = vx - cone.dirX * revLen;
							const revY = vy - cone.dirY * revLen;
							ctx.beginPath();
							ctx.moveTo(vx, vy);
							ctx.lineTo(revX, revY);
							ctx.stroke();

							// Arrow head
							const arrHeadLen = 10;
							const arrowAngle = Math.atan2(-cone.dirY, -cone.dirX);
							ctx.fillStyle = `rgba(251, 191, 36, ${0.9 * tr.alpha})`;
							ctx.beginPath();
							ctx.moveTo(revX, revY);
							ctx.lineTo(
								revX - arrHeadLen * Math.cos(arrowAngle - Math.PI / 6),
								revY - arrHeadLen * Math.sin(arrowAngle - Math.PI / 6),
							);
							ctx.lineTo(
								revX - arrHeadLen * Math.cos(arrowAngle + Math.PI / 6),
								revY - arrHeadLen * Math.sin(arrowAngle + Math.PI / 6),
							);
							ctx.closePath();
							ctx.fill();

							// Label
							ctx.font = "bold 9px monospace";
							ctx.fillStyle = `rgba(251, 191, 36, ${0.95 * tr.alpha})`;
							ctx.fillText("COSMIC ORIGIN VECTOR", revX + 8, revY - 4);
							ctx.restore();
						}

						// Fade out old tracks gently
						if (tr.progress > 1.2) {
							tr.alpha -= 0.015;
							if (tr.alpha <= 0) {
								activeTracks.splice(i, 1);
							}
						}
					}

					// 7. Render DOM Modules (Digital Optical Modules)
					for (const d of domList) {
						if (d.litProgress > 0.05) {
							// Hit DOM: Pulsing halo & Charge-scaled radius
							const baseR = 3 + Math.min(8, Math.sqrt(d.charge) * 0.45);

							// Outer soft halo
							ctx.fillStyle = d.timingColor.replace("rgb", "rgba").replace(")", ", 0.25)");
							ctx.beginPath();
							ctx.arc(d.x, d.y, baseR * 2.8, 0, Math.PI * 2);
							ctx.fill();

							// Mid halo
							ctx.fillStyle = d.timingColor.replace("rgb", "rgba").replace(")", ", 0.55)");
							ctx.beginPath();
							ctx.arc(d.x, d.y, baseR * 1.6, 0, Math.PI * 2);
							ctx.fill();

							// Solid core
							ctx.fillStyle = d.timingColor;
							ctx.beginPath();
							ctx.arc(d.x, d.y, baseR, 0, Math.PI * 2);
							ctx.fill();

							// White hot center
							ctx.fillStyle = "#ffffff";
							ctx.beginPath();
							ctx.arc(d.x, d.y, baseR * 0.45, 0, Math.PI * 2);
							ctx.fill();

							// Decay lit progress very slowly to leave long phosphorescence
							d.litProgress = Math.max(0, d.litProgress - 0.003);
						} else {
							// Quiescent DOM: Faint optical sphere
							ctx.fillStyle = "rgba(56, 189, 248, 0.35)";
							ctx.beginPath();
							ctx.arc(d.x, d.y, 1.8, 0, Math.PI * 2);
							ctx.fill();
						}
					}

					animId = requestAnimationFrame(render);
				}

				// INIT
				window.addEventListener("resize", resizeCanvas);
				resizeCanvas();
				updateZenithLabel(34);
				setEnergy(100);
				render();

				// Canvas Hover Tooltip on DOMs
				canvas.addEventListener("mousemove", (e) => {
					const rect = canvas.getBoundingClientRect();
					const mx = e.clientX - rect.left;
					const my = e.clientY - rect.top;

					let hoveredDom = null;
					for (const d of domList) {
						if (Math.hypot(d.x - mx, d.y - my) < 8) {
							hoveredDom = d;
							break;
						}
					}

					if (hoveredDom && hoveredDom.litProgress > 0.1) {
						canvas.title = `String #${hoveredDom.stringIndex} · DOM #${hoveredDom.domIndex} | Depth: ${hoveredDom.depthM}m | Time: +${hoveredDom.hitTimeNs}ns | Charge: ${hoveredDom.charge} p.e.`;
					} else if (hoveredDom) {
						canvas.title = `String #${hoveredDom.stringIndex} · DOM #${hoveredDom.domIndex} | Depth: ${hoveredDom.depthM}m (Quiescent)`;
					} else {
						canvas.title = "";
					}
				});
			}

			// Clean up animation on Astro page transitions
			window.addEventListener(
				"astro:before-swap",
				() => {
					if (animId) cancelAnimationFrame(animId);
					if (tickerTimer) clearInterval(tickerTimer);
				},
				{ once: true },
			);

			// Init on current load and future Swup page transitions
			initGhostCatcher();
			document.addEventListener("astro:page-load", initGhostCatcher);
		})();
	</script>
</MainGridLayout>
