				let detLeft = 0;
				let detRight = 0;
				let surfaceY = 0;

				const NUM_STRINGS = 34;
				const DOMS_PER_STRING = 14;
				let domList = []; // Array of DOM objects

				// Active particle tracks currently animating
				// Each track: { x0, y0, x1, y1, angleRad, progress, speed, isHit, hitPoint, eventData, cherenkovCone, litDoms, alpha }
				let activeTracks = [];
				let ambientSnow = [];

				// Toast timeout
				let toastTimer = null;
				function showToast(icon, msgZh, msgEn, duration = 3200) {
					if (!eventToast || !toastMsg) return;
					clearTimeout(toastTimer);
