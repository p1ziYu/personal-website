					// Init Circuit Mode Layers
					circuitLayers.l23 = [];
					circuitLayers.l5 = [];
					circuitLayers.synapses = [];
					for (let i = 0; i < 18; i++) {
						circuitLayers.l23.push({
							x: margin + (i / 17) * (canvasW - margin * 2),
							y: canvasH * 0.32 + (Math.random() - 0.5) * 40,
							firing: false,
							spikeProgress: 0,
							refractory: 0,
						});
					}
					for (let i = 0; i < 22; i++) {
						circuitLayers.l5.push({
							x: margin + (i / 21) * (canvasW - margin * 2),
							y: canvasH * 0.72 + (Math.random() - 0.5) * 50,
							firing: false,
							spikeProgress: 0,
							refractory: 0,
						});
					}
					// connect synapses L2/3 -> L5
					for (let i = 0; i < circuitLayers.l23.length; i++) {
						const numConn = 2 + Math.floor(Math.random() * 2);
						for (let c = 0; c < numConn; c++) {
							const targetIdx = Math.floor(Math.random() * circuitLayers.l5.length);
							circuitLayers.synapses.push({
								fromIdx: i,
								toIdx: targetIdx,
								progress: 0,
								active: false,
							});
						}
					}

					// Init Retina Grid
					retinaGrid.cells = [];
					for (let r = 0; r < retinaGrid.rows; r++) {
						for (let c = 0; c < retinaGrid.cols; c++) {
