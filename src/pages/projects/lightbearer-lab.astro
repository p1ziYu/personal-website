				if (presetSwitch) presetSwitch.addEventListener("click", () => applyPreset("switch"));
				if (presetEyespot) presetEyespot.addEventListener("click", () => applyPreset("eyespot"));
				if (presetSingle) presetSingle.addEventListener("click", () => applyPreset("single"));
				if (presetCircuit) presetCircuit.addEventListener("click", () => applyPreset("circuit"));
				if (presetVision) presetVision.addEventListener("click", () => applyPreset("vision"));
				if (cardEyespot) cardEyespot.addEventListener("click", () => applyPreset("eyespot"));
				if (cardSingle) cardSingle.addEventListener("click", () => applyPreset("single"));
				if (cardCircuit) cardCircuit.addEventListener("click", () => applyPreset("circuit"));
				if (cardVision) cardVision.addEventListener("click", () => applyPreset("vision"));

				// Sliders event listeners
				if (sliderFreq) {
					sliderFreq.addEventListener("input", (e) => {
						frequencyHz = Number.parseInt(e.target.value, 10);
						if (sliderFreqBadge) sliderFreqBadge.textContent = `${frequencyHz} Hz`;
						if (statFreqReadout) statFreqReadout.textContent = `${frequencyHz.toFixed(1)} Hz`;
					});
				}
				if (sliderWidth) {
					sliderWidth.addEventListener("input", (e) => {
						pulseWidthMs = Number.parseInt(e.target.value, 10);
						if (sliderWidthBadge) sliderWidthBadge.textContent = `${pulseWidthMs} ms`;
					});
				}
				if (sliderRadius) {
					sliderRadius.addEventListener("input", (e) => {
						beamRadius = Number.parseInt(e.target.value, 10);
						if (sliderRadiusBadge) sliderRadiusBadge.textContent = `${beamRadius} px`;
					});
				}

				// Toggle light button
				if (btnToggleLight) {
					btnToggleLight.addEventListener("click", () => {
						lightEnabled = !lightEnabled;
						if (lightEnabled) {
							btnToggleLight.classList.remove("bg-zinc-800", "border-zinc-700");
							btnToggleLight.classList.add("bg-blue-600", "border-blue-400/50");
							if (lightToggleIcon) lightToggleIcon.textContent = "💡";
							if (lightToggleText) lightToggleText.textContent = "蓝光开启 LIGHT ON";
							if (lightToggleTextEn) lightToggleTextEn.textContent = "LIGHT ON";
							if (statBeamMode) statBeamMode.textContent = "470nm BLUE ACTIVE";
							showToast("💡", "蓝光激光开启 · 470 nm 照射中");
						} else {
							btnToggleLight.classList.remove("bg-blue-600", "border-blue-400/50");
							btnToggleLight.classList.add("bg-zinc-800", "border-zinc-700");
							if (lightToggleIcon) lightToggleIcon.textContent = "🌑";
							if (lightToggleText) lightToggleText.textContent = "蓝光关闭 LIGHT OFF";
							if (lightToggleTextEn) lightToggleTextEn.textContent = "LIGHT OFF";
							if (statBeamMode) statBeamMode.textContent = "LASER OFF";
							showToast("🌑", "蓝光关闭 · 神经元恢复静息态");
						}
					});
				}

				// Strobe mode button
				if (btnStrobeMode) {
					btnStrobeMode.addEventListener("click", () => {
						strobeActive = !strobeActive;
						if (strobeActive) {
							btnStrobeMode.classList.remove("text-zinc-400", "border-zinc-700");
							btnStrobeMode.classList.add("text-amber-300", "border-amber-500/50");
							if (statStrobeState) statStrobeState.textContent = `${frequencyHz} Hz STROBE`;
							showToast("⚡", `频闪模式已开启 (${frequencyHz} Hz) · 毫秒级周期放电`);
						} else {
							btnStrobeMode.classList.remove("text-amber-300", "border-amber-500/50");
							btnStrobeMode.classList.add("text-zinc-400", "border-zinc-700");
							strobePulseOn = true;
							if (statStrobeState) statStrobeState.textContent = "CONTINUOUS BEAM";
							showToast("🔆", "常开照明模式 · 持续光束");
						}
					});
				}

				// Reset network button
				if (btnResetLab) {
					btnResetLab.addEventListener("click", () => {
						totalSpikesFired = 0;
						totalLightPulses = 0;
						if (statSpikes) statSpikes.textContent = "0";
						if (statPulses) statPulses.textContent = "0";
						rasterHistory = [];
						generateNeuronNetwork();
						showToast("↺", "神经回路已重置 · 电生理参数就绪");
					});
				}

				// Pointer interactions (mouse & touch)
				function updateBeamPointer(clientX, clientY) {
					const rect = canvas.getBoundingClientRect();
					beamX = Math.max(20, Math.min(canvasW - 20, clientX - rect.left));
					beamY = Math.max(20, Math.min(canvasH - 20, clientY - rect.top));
				}

				canvas.addEventListener("pointerdown", (e) => {
					updateBeamPointer(e.clientX, e.clientY);
				});
				window.addEventListener("pointermove", (e) => {
					const rect = canvas.getBoundingClientRect();
					if (
						e.clientX >= rect.left &&
						e.clientX <= rect.right &&
						e.clientY >= rect.top &&
						e.clientY <= rect.bottom
					) {
						updateBeamPointer(e.clientX, e.clientY);
					}
				});

				// Initialize layout
				handleResize();
				window.addEventListener("resize", handleResize);
				generateNeuronNetwork();

				// ==========================================
				// MAIN SIMULATION LOOP (60 FPS)
				// ==========================================
				function renderLoop(currentTime) {
					const dt = Math.min((currentTime - lastFrameTime) / 1000, 0.1);
					lastFrameTime = currentTime;

					// Compute strobe pulse timing
					if (strobeActive) {
						const periodMs = 1000 / frequencyHz;
						const elapsedInPeriod = (currentTime - lastStrobeToggleTime) % periodMs;
						const prevPulseState = strobePulseOn;
						strobePulseOn = elapsedInPeriod < pulseWidthMs;
						if (!prevPulseState && strobePulseOn) {
							totalLightPulses++;
							if (statPulses) statPulses.textContent = String(totalLightPulses);
						}
					} else {
						strobePulseOn = true;
					}

					const isLightEffective = lightEnabled && strobePulseOn;

					// Record into raster history
					if (currentTime % 16 < 8) {
						// Record every ~16ms
						const sampledSpikes = [];
						// sample first 8 neurons
						for (let s = 0; s < 8; s++) {
							sampledSpikes.push(neurons[s] && neurons[s].spikeProgress > 0 && neurons[s].spikeProgress < 0.3);
						}
						rasterHistory.push({
							light: isLightEffective,
							spikes: sampledSpikes,
							time: currentTime,
						});
						if (rasterHistory.length > 250) rasterHistory.shift();
					}

					// Clear canvases
					ctx.fillStyle = "#030814";
					ctx.fillRect(0, 0, canvasW, canvasH);

					// Draw background grid lines
					ctx.strokeStyle = "rgba(30, 41, 59, 0.4)";
					ctx.lineWidth = 0.5;
					const gridSpacing = 40;
					ctx.beginPath();
					for (let x = 0; x < canvasW; x += gridSpacing) {
						ctx.moveTo(x, 0);
						ctx.lineTo(x, canvasH);
					}
					for (let y = 0; y < canvasH; y += gridSpacing) {
						ctx.moveTo(0, y);
						ctx.lineTo(canvasW, y);
					}
					ctx.stroke();

					// RENDER MODE-SPECIFIC CANVAS
					if (currentPreset === "switch") {
						renderSwitchMode(dt, isLightEffective, currentTime);
					} else if (currentPreset === "eyespot") {
						renderEyespotMode(dt, isLightEffective, currentTime);
					} else if (currentPreset === "single") {
						renderSingleMode(dt, isLightEffective, currentTime);
					} else if (currentPreset === "circuit") {
						renderCircuitMode(dt, isLightEffective, currentTime);
					} else if (currentPreset === "vision") {
						renderVisionMode(dt, isLightEffective, currentTime);
					}

					// Render secondary canvases
					renderRasterPlot();
					renderScopePlot(dt, isLightEffective);

					animId = requestAnimationFrame(renderLoop);
				}

				// ------------------------------------------
				// MODE 1: THE SWITCH (DEFAULT NEURON FIELD)
				// ------------------------------------------
				function renderSwitchMode(dt, isLightEffective, currentTime) {
					// Draw blue beam spot
					if (lightEnabled) {
						const beamAlpha = strobePulseOn ? 0.85 : 0.15;
						const grad = ctx.createRadialGradient(beamX, beamY, 5, beamX, beamY, beamRadius);
						grad.addColorStop(0, `rgba(56, 189, 248, ${0.45 * beamAlpha})`);
						grad.addColorStop(0.4, `rgba(2, 132, 199, ${0.25 * beamAlpha})`);
						grad.addColorStop(0.8, `rgba(3, 105, 161, ${0.1 * beamAlpha})`);
						grad.addColorStop(1, "rgba(2, 132, 199, 0)");

						ctx.fillStyle = grad;
						ctx.beginPath();
						ctx.arc(beamX, beamY, beamRadius, 0, Math.PI * 2);
						ctx.fill();

						// Concentric ring guide
						ctx.strokeStyle = `rgba(56, 189, 248, ${0.4 * beamAlpha})`;
						ctx.lineWidth = 1;
						ctx.setLineDash([4, 4]);
						ctx.beginPath();
						ctx.arc(beamX, beamY, beamRadius, 0, Math.PI * 2);
						ctx.stroke();
						ctx.setLineDash([]);

						// Center laser pinpoint
						ctx.fillStyle = `rgba(224, 242, 254, ${0.9 * beamAlpha})`;
						ctx.beginPath();
						ctx.arc(beamX, beamY, 3, 0, Math.PI * 2);
						ctx.fill();
					}

					// Update and draw neurons
					let illuminatedCount = 0;

					for (const n of neurons) {
						// Distance to beam
						const dist = Math.hypot(n.x - beamX, n.y - beamY);
						const insideBeam = dist <= beamRadius + n.baseRadius;
						if (insideBeam) illuminatedCount++;

						// Refractory timer decrement
						if (n.refractoryTimer > 0) {
							n.refractoryTimer -= dt;
						}

						// Fire neuron if inside active beam and not refractory
						if (insideBeam && isLightEffective && n.refractoryTimer <= 0) {
							n.firing = true;
							n.spikeProgress = 0.01;
							n.refractoryTimer = 0.05; // 50ms refractory period (~20Hz max rate)
							n.lastFiredTime = currentTime;
							n.spikesCount++;
							totalSpikesFired++;
							if (statSpikes) statSpikes.textContent = String(totalSpikesFired);
						}

						// Update spike wave progress along neurites
						if (n.spikeProgress > 0) {
							n.spikeProgress += dt * 3.5; // ~280ms total animation duration
							if (n.spikeProgress >= 1) {
								n.spikeProgress = 0;
								n.firing = false;
							}
						}

						// Draw neurites / dendrites
						for (const b of n.branches) {
							ctx.strokeStyle = n.firing ? "rgba(96, 165, 250, 0.7)" : "rgba(51, 65, 85, 0.5)";
							ctx.lineWidth = 1.2;
							ctx.beginPath();
							ctx.moveTo(n.x, n.y);
							ctx.lineTo(n.x + b.x1, n.y + b.y1);
							ctx.lineTo(n.x + b.x2, n.y + b.y2);
							ctx.stroke();

							// If firing, draw action potential spark traveling along neurite
							if (n.spikeProgress > 0) {
								const t = Math.min(n.spikeProgress, 1);
								const sparkX = t < 0.5 ? n.x + b.x1 * (t * 2) : n.x + b.x1 + (b.x2 - b.x1) * ((t - 0.5) * 2);
								const sparkY = t < 0.5 ? n.y + b.y1 * (t * 2) : n.y + b.y1 + (b.y2 - b.y1) * ((t - 0.5) * 2);

								ctx.fillStyle = "#fbbf24";
								ctx.shadowColor = "#f59e0b";
								ctx.shadowBlur = 8;
								ctx.beginPath();
								ctx.arc(sparkX, sparkY, 2.8, 0, Math.PI * 2);
								ctx.fill();
								ctx.shadowBlur = 0;
							}
						}

						// Draw soma body
						ctx.beginPath();
						ctx.arc(n.x, n.y, n.baseRadius, 0, Math.PI * 2);

						if (n.spikeProgress > 0) {
							// Action potential flash: warm amber/white
							const intensity = 1 - n.spikeProgress;
							ctx.fillStyle = `rgba(245, 158, 11, ${0.4 + intensity * 0.6})`;
							ctx.shadowColor = "#fbbf24";
							ctx.shadowBlur = 14;
							ctx.fill();
							ctx.shadowBlur = 0;
							ctx.strokeStyle = "#ffffff";
							ctx.lineWidth = 2;
							ctx.stroke();
						} else {
							// Quiescent soma with ChR2 channel expression dot
							ctx.fillStyle = insideBeam && lightEnabled ? "#0c2847" : "#0a1324";
							ctx.fill();
							ctx.strokeStyle = insideBeam && lightEnabled ? "#38bdf8" : "#334155";
							ctx.lineWidth = 1.4;
							ctx.stroke();
						}

						// ChR2 blue dot in the center of soma (symbolizing channelrhodopsin expression)
						ctx.fillStyle = insideBeam && isLightEffective ? "#38bdf8" : "#0284c7";
						ctx.beginPath();
						ctx.arc(n.x, n.y, 2.5, 0, Math.PI * 2);
						ctx.fill();
					}

					// Update UI ratios
					const activePct = (illuminatedCount / NUM_NEURONS) * 100;
					if (statActiveRatio) statActiveRatio.textContent = `${illuminatedCount} / ${NUM_NEURONS} (${activePct.toFixed(0)}%)`;
					if (barActivePct) barActivePct.textContent = `${activePct.toFixed(1)}%`;
					if (barFillActive) barFillActive.style.width = `${activePct}%`;
					if (barFillQuiescent) barFillQuiescent.style.width = `${100 - activePct}%`;
				}

				// ------------------------------------------
				// MODE 2: EYESPOT (CHLAMYDOMONAS PHOTOTAXIS)
				// ------------------------------------------
				function renderEyespotMode(dt, isLightEffective) {
					// Draw water fluid particles in background
					ctx.fillStyle = "rgba(14, 165, 233, 0.05)";
					ctx.fillRect(0, 0, canvasW, canvasH);

					// Draw light beam target
					if (lightEnabled) {
						const grad = ctx.createRadialGradient(beamX, beamY, 10, beamX, beamY, 120);
						grad.addColorStop(0, "rgba(56, 189, 248, 0.5)");
						grad.addColorStop(0.5, "rgba(2, 132, 199, 0.2)");
						grad.addColorStop(1, "rgba(2, 132, 199, 0)");
						ctx.fillStyle = grad;
						ctx.beginPath();
						ctx.arc(beamX, beamY, 120, 0, Math.PI * 2);
						ctx.fill();

						ctx.fillStyle = "#38bdf8";
						ctx.font = "11px monospace";
						ctx.fillText("470 nm 光源 (LIGHT SOURCE)", beamX - 70, beamY - 130);
					}

					// Phototaxis physics: alga steers toward light beam
					const dx = beamX - algaState.x;
					const dy = beamY - algaState.y;
					const dist = Math.hypot(dx, dy);
					const targetAngle = Math.atan2(dy, dx);

					// Smooth angle interpolation toward light if light effective
					if (isLightEffective) {
						let angleDiff = targetAngle - algaState.angle;
						while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;
						while (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
						algaState.angle += angleDiff * dt * 3.5;
					}

					// Propulsion forward
					const speed = isLightEffective ? (dist > 40 ? 110 : 25) : 18;
					algaState.vx = Math.cos(algaState.angle) * speed;
					algaState.vy = Math.sin(algaState.angle) * speed;
					algaState.x += algaState.vx * dt;
					algaState.y += algaState.vy * dt;

					// Flagella phase
					algaState.flagellaPhase += dt * (isLightEffective ? 14 : 5);

					// Record swim trajectory
					algaState.tailHistory.push({ x: algaState.x, y: algaState.y });
					if (algaState.tailHistory.length > 70) algaState.tailHistory.shift();

					// Draw swim trajectory path
					ctx.strokeStyle = "rgba(16, 185, 129, 0.35)";
					ctx.lineWidth = 2;
					ctx.beginPath();
					for (let i = 0; i < algaState.tailHistory.length; i++) {
						const pt = algaState.tailHistory[i];
						if (i === 0) ctx.moveTo(pt.x, pt.y);
						else ctx.lineTo(pt.x, pt.y);
					}
					ctx.stroke();

					// Draw Chlamydomonas alga body
					ctx.save();
					ctx.translate(algaState.x, algaState.y);
					ctx.rotate(algaState.angle);

					// Ovoid cell body (chloroplast green)
					ctx.fillStyle = "#10b981";
					ctx.shadowColor = "#34d399";
					ctx.shadowBlur = 10;
					ctx.beginPath();
					ctx.ellipse(0, 0, 24, 15, 0, 0, Math.PI * 2);
					ctx.fill();
					ctx.shadowBlur = 0;

					ctx.strokeStyle = "#059669";
					ctx.lineWidth = 1.8;
					ctx.stroke();

					// Chloroplast internal texture
					ctx.fillStyle = "#047857";
					ctx.beginPath();
					ctx.ellipse(-4, 0, 14, 9, 0, 0, Math.PI * 2);
					ctx.fill();

					// Carotenoid Eye-spot (ChR2 stigma - bright orange-red spot on anterior shoulder)
					ctx.fillStyle = "#f97316";
					ctx.shadowColor = "#ea580c";
					ctx.shadowBlur = 8;
					ctx.beginPath();
					ctx.arc(8, -8, 3.5, 0, Math.PI * 2);
					ctx.fill();
					ctx.shadowBlur = 0;

					// Label eyespot
					ctx.fillStyle = "#fed7aa";
					ctx.font = "9px monospace";
					ctx.fillText("眼点 ChR2", 14, -12);

					// Two undulating flagella (anterior breaststroke)
					const wave1 = Math.sin(algaState.flagellaPhase) * 12;
					const wave2 = Math.cos(algaState.flagellaPhase) * 12;

					ctx.strokeStyle = "#a7f3d0";
					ctx.lineWidth = 1.6;
					ctx.beginPath();
					ctx.moveTo(24, -4);
					ctx.bezierCurveTo(36, -18 + wave1, 48, -10 + wave2, 54, -22 + wave1);
					ctx.stroke();

					ctx.beginPath();
					ctx.moveTo(24, 4);
					ctx.bezierCurveTo(36, 18 - wave1, 48, 10 - wave2, 54, 22 - wave1);
					ctx.stroke();

					ctx.restore();

					// Educational annotation HUD
					ctx.fillStyle = "rgba(15, 23, 42, 0.85)";
					ctx.strokeStyle = "rgba(16, 185, 129, 0.4)";
					ctx.lineWidth = 1;
					ctx.fillRect(20, canvasH - 75, 340, 55);
					ctx.strokeRect(20, canvasH - 75, 340, 55);

					ctx.fillStyle = "#34d399";
					ctx.font = "bold 11px monospace";
					ctx.fillText("衣藻正趋光性 (Positive Phototaxis)", 32, canvasH - 55);
					ctx.fillStyle = "#94a3b8";
					ctx.font = "10px monospace";
					ctx.fillText("眼点 ChR2 捕获光子 → 膜去极化 → 鞭毛不对称摆动游向光源", 32, canvasH - 35);
				}

				// ------------------------------------------
				// MODE 3: SINGLE CELL (PATCH-CLAMP CLOSEUP)
				// ------------------------------------------
				function renderSingleMode(isLightEffective, currentTime) {
					const cx = canvasW * 0.45;
					const cy = canvasH * 0.48;

					// Draw single large pyramidal neuron
					// Apical dendrite pointing up
					ctx.strokeStyle = singleNeuronState.phase === "spike" ? "#fbbf24" : "#475569";
					ctx.lineWidth = 4;
					ctx.beginPath();
					ctx.moveTo(cx, cy - 35);
					ctx.lineTo(cx, cy - 130);
					// branches
					ctx.lineTo(cx - 40, cy - 180);
					ctx.moveTo(cx, cy - 130);
					ctx.lineTo(cx + 45, cy - 175);
					ctx.stroke();

					// Basal dendrites
					ctx.lineWidth = 3;
					ctx.beginPath();
					ctx.moveTo(cx - 20, cy + 25);
					ctx.lineTo(cx - 70, cy + 80);
					ctx.moveTo(cx + 20, cy + 25);
					ctx.lineTo(cx + 75, cy + 75);
					ctx.stroke();

					// Axon & Myelin Sheaths pointing right
					ctx.lineWidth = 2.5;
					ctx.beginPath();
					ctx.moveTo(cx + 35, cy);
					ctx.lineTo(cx + 220, cy);
					ctx.stroke();

					// Myelin sheaths
					ctx.fillStyle = "#1e293b";
					ctx.strokeStyle = "#38bdf8";
					ctx.lineWidth = 1.2;
					for (let i = 0; i < 4; i++) {
						const mx = cx + 50 + i * 40;
						ctx.fillRect(mx, cy - 6, 26, 12);
						ctx.strokeRect(mx, cy - 6, 26, 12);
					}

					// Large Soma body
					ctx.beginPath();
					ctx.arc(cx, cy, 38, 0, Math.PI * 2);

					if (singleNeuronState.phase === "spike") {
						ctx.fillStyle = "rgba(245, 158, 11, 0.85)";
						ctx.shadowColor = "#fbbf24";
						ctx.shadowBlur = 25;
						ctx.fill();
						ctx.shadowBlur = 0;
						ctx.strokeStyle = "#ffffff";
						ctx.lineWidth = 3;
						ctx.stroke();
					} else {
						ctx.fillStyle = isLightEffective ? "#0e2d4d" : "#0c182e";
						ctx.fill();
						ctx.strokeStyle = isLightEffective ? "#38bdf8" : "#334155";
						ctx.lineWidth = 2;
						ctx.stroke();
					}

					// Nucleus
					ctx.fillStyle = "rgba(30, 58, 138, 0.7)";
					ctx.beginPath();
					ctx.arc(cx - 5, cy, 14, 0, Math.PI * 2);
					ctx.fill();

					// Draw ChR2 channel gates in lipid bilayer around soma
					const numGates = 12;
					for (let i = 0; i < numGates; i++) {
						const angle = (i / numGates) * Math.PI * 2;
						const gx = cx + Math.cos(angle) * 38;
						const gy = cy + Math.sin(angle) * 38;

						ctx.fillStyle = isLightEffective ? "#38bdf8" : "#0369a1";
						ctx.shadowColor = "#38bdf8";
						ctx.shadowBlur = isLightEffective ? 8 : 0;
						ctx.beginPath();
						ctx.arc(gx, gy, 4, 0, Math.PI * 2);
						ctx.fill();
						ctx.shadowBlur = 0;

						// If light active: draw incoming Na⁺ ions (amber dots streaming inward)
						if (isLightEffective) {
							const ionDist = 50 - (currentTime % 800) / 800 * 16;
							const ix = cx + Math.cos(angle) * ionDist;
							const iy = cy + Math.sin(angle) * ionDist;
							ctx.fillStyle = "#fde047";
							ctx.beginPath();
							ctx.arc(ix, iy, 2, 0, Math.PI * 2);
							ctx.fill();
						}
					}

					// Draw light beam over soma
					if (lightEnabled) {
						const grad = ctx.createRadialGradient(cx, cy, 10, cx, cy, 90);
						grad.addColorStop(0, "rgba(56, 189, 248, 0.4)");
						grad.addColorStop(1, "rgba(2, 132, 199, 0)");
						ctx.fillStyle = grad;
						ctx.beginPath();
						ctx.arc(cx, cy, 90, 0, Math.PI * 2);
						ctx.fill();
					}

					// Membrane patch-clamp callout HUD
					ctx.fillStyle = "rgba(2, 6, 23, 0.9)";
					ctx.strokeStyle = "rgba(56, 189, 248, 0.5)";
					ctx.lineWidth = 1;
					ctx.fillRect(20, 20, 270, 75);
					ctx.strokeRect(20, 20, 270, 75);

					ctx.fillStyle = "#38bdf8";
					ctx.font = "bold 11px monospace";
					ctx.fillText("膜片钳单通道记录 (PATCH-CLAMP)", 32, 40);
					ctx.fillStyle = "#e2e8f0";
					ctx.font = "10px monospace";
					ctx.fillText(`通道开门状态: ${isLightEffective ? "100% 开放 (OPEN)" : "0% 关闭 (CLOSED)"}`, 32, 58);
					ctx.fillText(`电离潜伏期 Latency: ~2.1 ms (光子 → 电荷)`, 32, 74);
				}

				// ------------------------------------------
				// MODE 4: CIRCUIT (SYNAPTIC CASCADE & PSTH)
				// ------------------------------------------
				function renderCircuitMode(dt, isLightEffective, currentTime) {
					// Draw layer dividers & labels
					ctx.strokeStyle = "rgba(51, 65, 85, 0.4)";
					ctx.lineWidth = 1;
					ctx.setLineDash([4, 4]);
					ctx.beginPath();
					ctx.moveTo(30, canvasH * 0.52);
					ctx.lineTo(canvasW - 30, canvasH * 0.52);
					ctx.stroke();
					ctx.setLineDash([]);

					ctx.fillStyle = "#64748b";
					ctx.font = "10px monospace";
					ctx.fillText("CORTICAL LAYER 2/3 (ChR2+ 兴奋性投射源)", 35, canvasH * 0.16);
					ctx.fillText("CORTICAL LAYER 5 (突触耦联下游锥体网络)", 35, canvasH * 0.58);

					// Update & draw Layer 2/3 neurons
					for (let i = 0; i < circuitLayers.l23.length; i++) {
						const n = circuitLayers.l23[i];
						const dist = Math.hypot(n.x - beamX, n.y - beamY);
						const insideBeam = dist <= beamRadius;

						if (n.refractory > 0) n.refractory -= dt;
						if (insideBeam && isLightEffective && n.refractory <= 0) {
							n.firing = true;
							n.spikeProgress = 0.01;
							n.refractory = 0.08;
							// Activate outbound synapses
							for (const syn of circuitLayers.synapses) {
								if (syn.fromIdx === i) {
									syn.active = true;
									syn.progress = 0.01;
								}
							}
						}

						if (n.spikeProgress > 0) {
							n.spikeProgress += dt * 4;
							if (n.spikeProgress >= 1) {
								n.spikeProgress = 0;
								n.firing = false;
							}
						}

						ctx.fillStyle = n.firing ? "#fbbf24" : insideBeam ? "#0284c7" : "#0f172a";
						ctx.beginPath();
						ctx.arc(n.x, n.y, 8, 0, Math.PI * 2);
						ctx.fill();
						ctx.strokeStyle = insideBeam ? "#38bdf8" : "#334155";
						ctx.lineWidth = 1.5;
						ctx.stroke();
					}

					// Update & draw Synapses
					for (const syn of circuitLayers.synapses) {
						const fromN = circuitLayers.l23[syn.fromIdx];
						const toN = circuitLayers.l5[syn.toIdx];

						ctx.strokeStyle = syn.active ? "rgba(96, 165, 250, 0.6)" : "rgba(30, 41, 59, 0.4)";
						ctx.lineWidth = 1;
						ctx.beginPath();
						ctx.moveTo(fromN.x, fromN.y);
						ctx.lineTo(toN.x, toN.y);
						ctx.stroke();

						if (syn.active) {
							syn.progress += dt * 3; // synaptic conduction delay ~3.5 ms
							const sx = fromN.x + (toN.x - fromN.x) * syn.progress;
							const sy = fromN.y + (toN.y - fromN.y) * syn.progress;

							// Synaptic neurotransmitter packet
							ctx.fillStyle = "#fbbf24";
							ctx.beginPath();
							ctx.arc(sx, sy, 2.5, 0, Math.PI * 2);
							ctx.fill();

							if (syn.progress >= 1) {
								syn.active = false;
								toN.firing = true;
								toN.spikeProgress = 0.01;
								totalSpikesFired++;
							}
						}
					}

					// Update & draw Layer 5 neurons
					for (const n of circuitLayers.l5) {
						if (n.spikeProgress > 0) {
							n.spikeProgress += dt * 4;
							if (n.spikeProgress >= 1) {
								n.spikeProgress = 0;
								n.firing = false;
							}
						}

						ctx.fillStyle = n.firing ? "#f59e0b" : "#0f172a";
						ctx.beginPath();
						ctx.arc(n.x, n.y, 9, 0, Math.PI * 2);
						ctx.fill();
						ctx.strokeStyle = n.firing ? "#fbbf24" : "#334155";
						ctx.lineWidth = 1.5;
						ctx.stroke();
					}

					// Draw light beam over L2/3
					if (lightEnabled) {
						const grad = ctx.createRadialGradient(beamX, beamY, 10, beamX, beamY, beamRadius);
						grad.addColorStop(0, "rgba(56, 189, 248, 0.4)");
						grad.addColorStop(1, "rgba(2, 132, 199, 0)");
						ctx.fillStyle = grad;
						ctx.beginPath();
						ctx.arc(beamX, beamY, beamRadius, 0, Math.PI * 2);
						ctx.fill();
					}
				}

				// ------------------------------------------
				// MODE 5: VISION (2021 RETINITIS PIGMENTOSA)
				// ------------------------------------------
				function renderVisionMode(dt, isLightEffective, currentTime) {
					const cellW = (canvasW - 120) / retinaGrid.cols;
					const cellH = (canvasH - 120) / retinaGrid.rows;
					const startX = 60;
					const startY = 60;

					let totalTargetCells = 0;
					let hitTargetCells = 0;

					for (const cell of retinaGrid.cells) {
						const cx = startX + cell.col * cellW + cellW / 2;
						const cy = startY + cell.row * cellH + cellH / 2;

						// Check if illuminated by beam
						const dist = Math.hypot(cx - beamX, cy - beamY);
						const inBeam = dist <= beamRadius;

						if (cell.isTarget) totalTargetCells++;

						if (inBeam && isLightEffective) {
							cell.charge = Math.min(1.0, cell.charge + dt * 1.5);
							cell.lastHit = currentTime;
						} else {
							cell.charge = Math.max(0.0, cell.charge - dt * 0.25);
						}

						if (cell.isTarget && cell.charge > 0.4) hitTargetCells++;

						// Draw retinal ganglion cell sensor pixel
						ctx.beginPath();
						ctx.roundRect(startX + cell.col * cellW + 2, startY + cell.row * cellH + 2, cellW - 4, cellH - 4, 4);

						if (cell.charge > 0.1) {
							ctx.fillStyle = cell.isTarget
								? `rgba(245, 158, 11, ${cell.charge})`
								: `rgba(56, 189, 248, ${cell.charge * 0.5})`;
							ctx.fill();
							ctx.strokeStyle = cell.isTarget ? "#fbbf24" : "#38bdf8";
							ctx.lineWidth = 1.2;
							ctx.stroke();
						} else {
							ctx.fillStyle = "rgba(15, 23, 42, 0.6)";
							ctx.fill();
							ctx.strokeStyle = "rgba(30, 41, 59, 0.4)";
							ctx.lineWidth = 0.8;
							ctx.stroke();
						}
					}

					// Draw projected beam
					if (lightEnabled) {
						const grad = ctx.createRadialGradient(beamX, beamY, 10, beamX, beamY, beamRadius);
						grad.addColorStop(0, "rgba(56, 189, 248, 0.45)");
						grad.addColorStop(1, "rgba(2, 132, 199, 0)");
						ctx.fillStyle = grad;
						ctx.beginPath();
						ctx.arc(beamX, beamY, beamRadius, 0, Math.PI * 2);
						ctx.fill();
					}

					// Recognition readout HUD
					const reconPct = Math.min(100, (hitTargetCells / Math.max(1, totalTargetCells)) * 100);
					ctx.fillStyle = "rgba(2, 6, 23, 0.9)";
					ctx.strokeStyle = reconPct > 70 ? "rgba(245, 158, 11, 0.7)" : "rgba(56, 189, 248, 0.5)";
					ctx.lineWidth = 1;
					ctx.fillRect(startX, canvasH - 50, 400, 36);
					ctx.strokeRect(startX, canvasH - 50, 400, 36);

					ctx.fillStyle = reconPct > 70 ? "#fbbf24" : "#38bdf8";
					ctx.font = "bold 11px monospace";
					ctx.fillText(`视力重构识别度: ${reconPct.toFixed(0)}% · 目标: 视力表 'E' 字`, startX + 14, canvasH - 28);
				}

				// ------------------------------------------
				// RASTER PLOT RENDERER
				// ------------------------------------------
				function renderRasterPlot() {
					rasterCtx.fillStyle = "#01040a";
					rasterCtx.fillRect(0, 0, rasterW, rasterH);

					// Grid vertical time lines
					rasterCtx.strokeStyle = "rgba(30, 41, 59, 0.35)";
					rasterCtx.lineWidth = 1;
					const numGrid = 8;
					for (let i = 0; i <= numGrid; i++) {
						const gx = (i / numGrid) * rasterW;
						rasterCtx.beginPath();
						rasterCtx.moveTo(gx, 0);
						rasterCtx.lineTo(gx, rasterH);
						rasterCtx.stroke();
					}

					// Lane divider: top lane for light stimulus
					const stimLaneH = 34;
					rasterCtx.strokeStyle = "rgba(56, 189, 248, 0.3)";
					rasterCtx.beginPath();
					rasterCtx.moveTo(0, stimLaneH);
					rasterCtx.lineTo(rasterW, stimLaneH);
					rasterCtx.stroke();

					rasterCtx.fillStyle = "#60a5fa";
					rasterCtx.font = "9px monospace";
					rasterCtx.fillText("470nm LIGHT", 8, 22);

					// Draw stimulus history on top lane
					const histLen = rasterHistory.length;
					for (let i = 0; i < histLen; i++) {
						const item = rasterHistory[i];
						const x = (i / histLen) * rasterW;
						const nextX = ((i + 1) / histLen) * rasterW;
						const w = Math.max(2, nextX - x);

						if (item.light) {
							rasterCtx.fillStyle = "#38bdf8";
							rasterCtx.fillRect(x, 6, w, stimLaneH - 12);
						}

						// Draw neuron spike tick marks (channels 1..8)
						const neuronLaneStart = stimLaneH + 10;
						const laneH = (rasterH - neuronLaneStart) / 8;

						for (let s = 0; s < 8; s++) {
							const y = neuronLaneStart + s * laneH;
							if (item.spikes && item.spikes[s]) {
								rasterCtx.fillStyle = "#fbbf24";
								rasterCtx.fillRect(x, y + 2, 2.5, laneH - 4);
							}
						}
					}

					// Channel lane labels on left
					const neuronLaneStart = stimLaneH + 10;
					const laneH = (rasterH - neuronLaneStart) / 8;
					rasterCtx.fillStyle = "#64748b";
					rasterCtx.font = "8px monospace";
					for (let s = 0; s < 8; s++) {
						const y = neuronLaneStart + s * laneH;
						rasterCtx.fillText(`N#${s + 1}`, 8, y + laneH * 0.7);
					}
				}

				// ------------------------------------------
				// MINI OSCILLOSCOPE VOLTAGE TRACE RENDERER
				// ------------------------------------------
				function renderScopePlot(dt, isLightEffective) {
					scopeCtx.fillStyle = "#02050e";
					scopeCtx.fillRect(0, 0, scopeW, scopeH);

					// Baseline grid
					scopeCtx.strokeStyle = "rgba(30, 41, 59, 0.4)";
					scopeCtx.lineWidth = 0.5;
					scopeCtx.beginPath();
					// -70mV line
					const y70 = scopeH * 0.75;
					scopeCtx.moveTo(0, y70);
					scopeCtx.lineTo(scopeW, y70);
					// 0mV line
					const y0 = scopeH * 0.35;
					scopeCtx.moveTo(0, y0);
					scopeCtx.lineTo(scopeW, y0);
					scopeCtx.stroke();

					// Voltage dynamics
					if (isLightEffective) {
						if (singleNeuronState.phase === "rest") {
							singleNeuronState.phase = "depol";
							singleNeuronState.phaseTimer = 0;
						}
					}

					// Advance membrane potential state machine
					if (singleNeuronState.phase === "depol") {
						singleNeuronState.phaseTimer += dt;
						singleNeuronState.vm += dt * 450; // fast depolarization
						if (singleNeuronState.vm >= -50) {
							singleNeuronState.phase = "spike";
						}
					} else if (singleNeuronState.phase === "spike") {
						singleNeuronState.vm += dt * 900;
						if (singleNeuronState.vm >= 32) {
							singleNeuronState.phase = "repol";
						}
					} else if (singleNeuronState.phase === "repol") {
						singleNeuronState.vm -= dt * 650;
						if (singleNeuronState.vm <= -78) {
							singleNeuronState.phase = "hyperpol";
						}
					} else if (singleNeuronState.phase === "hyperpol") {
						singleNeuronState.vm += dt * 80;
						if (singleNeuronState.vm >= -70) {
							singleNeuronState.vm = -70;
							singleNeuronState.phase = "rest";
						}
					} else {
						// small thermal noise
						singleNeuronState.vm = -70 + (Math.random() - 0.5) * 0.6;
					}

					// Push to buffer
					scopeBuffer.push(singleNeuronState.vm);
					if (scopeBuffer.length > 120) scopeBuffer.shift();

					if (scopeVmVal) scopeVmVal.textContent = `${singleNeuronState.vm.toFixed(1)} mV`;

					// Draw waveform
					scopeCtx.strokeStyle = singleNeuronState.phase === "spike" ? "#fbbf24" : "#38bdf8";
					scopeCtx.lineWidth = 1.8;
					scopeCtx.beginPath();

					for (let i = 0; i < scopeBuffer.length; i++) {
						const v = scopeBuffer[i];
						const x = (i / (scopeBuffer.length - 1)) * scopeW;
						// Map -90mV to +40mV into height
						const norm = (v - (-90)) / (40 - (-90));
						const y = scopeH - norm * scopeH;
						if (i === 0) scopeCtx.moveTo(x, y);
						else scopeCtx.lineTo(x, y);
					}
					scopeCtx.stroke();
				}

				// Start loop
				animId = requestAnimationFrame(renderLoop);
			}

			// Clean up animation on Astro page transitions
			window.addEventListener(
				"astro:before-swap",
				() => {
					if (animId) cancelAnimationFrame(animId);
					if (strobeInterval) clearInterval(strobeInterval);
				},
				{ once: true },
			);

			// Init on current load and future page transitions
			initLightbearerLab();
			document.addEventListener("astro:page-load", initLightbearerLab);
		})();
	</script>
</MainGridLayout>
