				function handleResize() {
					const dpr = Math.min(window.devicePixelRatio || 1, 2);
					const rect = canvas.getBoundingClientRect();
					canvasW = rect.width;
					canvasH = rect.height;
					canvas.width = Math.floor(canvasW * dpr);
					canvas.height = Math.floor(canvasH * dpr);
					ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

					const rasterRect = rasterCanvas.getBoundingClientRect();
					rasterW = rasterRect.width;
					rasterH = rasterRect.height;
					rasterCanvas.width = Math.floor(rasterW * dpr);
					rasterCanvas.height = Math.floor(rasterH * dpr);
					rasterCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

					const scopeRect = scopeCanvas.getBoundingClientRect();
					scopeW = scopeRect.width;
					scopeH = scopeRect.height;
					scopeCanvas.width = Math.floor(scopeW * dpr);
					scopeCanvas.height = Math.floor(scopeH * dpr);
					scopeCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
				}

				// Generate Neurons
				function generateNeuronNetwork() {
					neurons = [];
					const margin = 50;
					for (let i = 0; i < NUM_NEURONS; i++) {
						const nx = margin + Math.random() * (canvasW - margin * 2);
						const ny = margin + Math.random() * (canvasH - margin * 2);
						const branches = [];
						const numBranches = 4 + Math.floor(Math.random() * 4);
						for (let b = 0; b < numBranches; b++) {
							const angle = (b / numBranches) * Math.PI * 2 + (Math.random() - 0.5) * 0.5;
							const len1 = 18 + Math.random() * 26;
							const x1 = Math.cos(angle) * len1;
							const y1 = Math.sin(angle) * len1;
							// sub-branch
							const subAngle = angle + (Math.random() - 0.5) * 0.8;
							const len2 = 12 + Math.random() * 18;
							const x2 = x1 + Math.cos(subAngle) * len2;
							const y2 = y1 + Math.sin(subAngle) * len2;
							branches.push({ x1, y1, x2, y2 });
						}

						neurons.push({
							id: i,
							x: nx,
							y: ny,
							baseRadius: 6.5 + Math.random() * 3,
							branches,
							chr2: true, // all express ChR2
							firing: false,
							spikeProgress: 0,
							refractoryTimer: 0,
							lastFiredTime: 0,
							spikesCount: 0,
						});
