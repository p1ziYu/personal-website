	<!-- CLIENT-SIDE SCRIPT FOR INTERACTIVE TERMINAL & VISUALIZERS -->
	<script is:inline>
		(function () {
			let lifecycle = new AbortController();
			let snakeIntervalId = null;

			function initPhantomTerminal() {
				// Clean up previous runs if navigating with Swup
				lifecycle.abort();
				lifecycle = new AbortController();
				if (snakeIntervalId) {
					clearInterval(snakeIntervalId);
					snakeIntervalId = null;
				}

				const signal = lifecycle.signal;

				// ----------------------------------------------------
				// 1. PLAYABLE TOY TERMINAL STATE MACHINE
				// ----------------------------------------------------
				let isWorldModelMode = false;
				let currentDir = "~";
				let cmdHistory = [];
				let historyIdx = -1;
				let driftCounter = 0;

				// Virtual Filesystem
				let fs = {
					"~": {
						"notes.txt": "WorldTUI is trained on 336k terminal episodes from real Docker sessions.\nVocabulary: 333 tokens (256 bytes + 64 rows + 13 ops).\nMemory test: layer 7 removal collapsed exact recall 64/64 -> 0/64.",
						"colors.txt": "red\nblue",
						"projects": {
							"snake.sh": "#!/bin/bash\necho 'Running snake on character grid...'",
							"readme.md": "# Mini Projects\nExplore terminal world models."
						}
					}
				};

				// DOM references
				const termOutput = document.getElementById("term-output-history");
				const termInput = document.getElementById("term-input");
				const termPrompt = document.getElementById("term-prompt-label");
				const termScreen = document.getElementById("terminal-screen");
				const modeRealBtn = document.getElementById("mode-real-btn");
				const modeModelBtn = document.getElementById("mode-model-btn");
				const modeDescText = document.getElementById("mode-desc-text");
				const termStatusBadge = document.getElementById("term-status-badge");
				const termResetBtn = document.getElementById("term-reset-btn");

				// Snake DOM references
				const snakeContainer = document.getElementById("term-snake-container");
				const snakeGridPre = document.getElementById("snake-ascii-grid");
				const snakeScoreDisplay = document.getElementById("snake-score-display");
				const snakeQuitBtn = document.getElementById("snake-quit-btn");
				const snakeMobileControls = document.getElementById("snake-mobile-controls");
				const termInputRow = document.getElementById("term-input-row");

				function printLine(htmlText, className = "") {
					if (!termOutput) return;
					const div = document.createElement("div");
					if (className) div.className = className;
					div.innerHTML = htmlText;
					termOutput.appendChild(div);
					if (termScreen) termScreen.scrollTop = termScreen.scrollHeight;
				}

				function printDriftBadge(zhMsg, enMsg) {
					printLine(`
						<div class="my-1.5 px-3 py-1.5 rounded bg-amber-500/15 border border-amber-500/50 text-amber-300 text-xs font-mono">
							<span class="font-bold text-amber-400">⚡ [DRIFT / 漂移]</span>
							<span class="lang-zh">${zhMsg}</span>
							<span class="lang-en">${enMsg}</span>
						</div>
					`);
				}

				function updatePrompt() {
					if (termPrompt) {
						termPrompt.textContent = `guest@world-tui:${currentDir}$`;
					}
				}

				function getDirRef(path) {
					if (path === "~") return fs["~"];
					if (path === "~/projects") return fs["~"]["projects"];
					return null;
				}

				function resetTerminal() {
					if (termOutput) termOutput.innerHTML = "";
					currentDir = "~";
					updatePrompt();
					driftCounter = 0;
					fs = {
						"~": {
							"notes.txt": "WorldTUI is trained on 336k terminal episodes from real Docker sessions.\nVocabulary: 333 tokens (256 bytes + 64 rows + 13 ops).\nMemory test: layer 7 removal collapsed exact recall 64/64 -> 0/64.",
							"colors.txt": "red\nblue",
							"projects": {
								"snake.sh": "#!/bin/bash\necho 'Running snake on character grid...'",
								"readme.md": "# Mini Projects\nExplore terminal world models."
							}
						}
					};

					printLine(`<div class="text-slate-400">Linux worldtui-vm 6.10.0-tui #1 SMP PREEMPT_DYNAMIC x86_64</div>`);
					printLine(`<div class="text-emerald-400 font-bold">Welcome to Phantom Terminal (Toy Deterministic State Machine)</div>`);
					printLine(`<div class="text-xs text-slate-400 mb-2">Type <span class="text-amber-300 font-bold">help</span> to list commands, or try <span class="text-cyan-300 font-bold">snake</span>, <span class="text-cyan-300 font-bold">ls -la</span>, <span class="text-amber-300 font-bold">pythoon</span>.</div>`);
					printLine(`<div class="font-bold text-white"><span class="text-emerald-400">guest@world-tui:~$</span> ls -la</div>`);
					printLine(`<div><span class="text-cyan-400 font-bold">projects/</span>  <span class="text-emerald-300">colors.txt</span>  <span class="text-emerald-300">notes.txt</span></div>`);
					printLine(`<div class="font-bold text-white"><span class="text-emerald-400">guest@world-tui:~$</span> cat notes.txt</div>`);
					printLine(`<div class="whitespace-pre text-emerald-300">WorldTUI: 360M model predicts terminal screen diffs. No real shell.\nVocabulary: 333 tokens | Docker sessions: 336k episodes | Memory: layer 7.</div>`);
				}

				// Switch Modes
				function setMode(isModel) {
					isWorldModelMode = isModel;
					if (modeRealBtn && modeModelBtn && modeDescText && termStatusBadge) {
						if (!isModel) {
							modeRealBtn.className = "px-3 py-1.5 rounded-lg border border-emerald-500/60 bg-emerald-500/20 text-emerald-200 font-bold hover:bg-emerald-500/30 transition cursor-pointer active:scale-95 shadow-[0_0_10px_rgba(16,185,129,0.2)]";
							modeModelBtn.className = "px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-900/80 text-slate-300 font-bold hover:border-amber-500/60 hover:text-amber-300 transition cursor-pointer active:scale-95";
							modeDescText.innerHTML = `
								<span class="lang-zh"><strong>当前模式：真实 Shell</strong> —— 文件修改精确写入，追加行绝不丢失，路径严谨记忆。</span>
								<span class="lang-en"><strong>Current: Real Shell Mode</strong> — Files persist faithfully, appends never vanish, paths accurately remembered.</span>
							`;
							termStatusBadge.textContent = "SHELL: REAL (EXACT)";
							termStatusBadge.className = "px-2 py-0.5 rounded bg-emerald-950 border border-emerald-800/60 text-emerald-400";
						} else {
							modeRealBtn.className = "px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-900/80 text-slate-300 font-bold hover:border-emerald-500/60 hover:text-emerald-300 transition cursor-pointer active:scale-95";
							modeModelBtn.className = "px-3 py-1.5 rounded-lg border border-amber-500/60 bg-amber-500/20 text-amber-200 font-bold hover:bg-amber-500/30 transition cursor-pointer active:scale-95 shadow-[0_0_10px_rgba(245,158,11,0.2)]";
							modeDescText.innerHTML = `
								<span class="lang-zh"><strong>当前模式：世界模型模式</strong> —— 模拟 WorldTUI 的典型局限：追加行丢失、幻觉补全文件、错别字伪装 REPL。</span>
								<span class="lang-en"><strong>Current: World-Model Mode</strong> — Simulates WorldTUI's limits: vanishing appends, hallucinated files, typo tolerance.</span>
							`;
							termStatusBadge.textContent = "SHELL: MODEL (DRIFT ON)";
							termStatusBadge.className = "px-2 py-0.5 rounded bg-amber-950 border border-amber-800/60 text-amber-400";
						}
					}
				}

				if (modeRealBtn) modeRealBtn.addEventListener("click", () => setMode(false), { signal });
				if (modeModelBtn) modeModelBtn.addEventListener("click", () => setMode(true), { signal });
				if (termResetBtn) termResetBtn.addEventListener("click", () => resetTerminal(), { signal });

				// ----------------------------------------------------
				// SNAKE GAME IN CHARACTER GRID
				// ----------------------------------------------------
				let snakeActive = false;
				let snakeWidth = 28;
				let snakeHeight = 10;
				let snakeBody = [];
				let snakeDir = { x: 1, y: 0 };
				let nextSnakeDir = { x: 1, y: 0 };
				let snakeFood = { x: 10, y: 5 };
				let snakeScore = 0;

				function startSnake() {
					snakeActive = true;
					snakeBody = [
						{ x: 5, y: 5 },
						{ x: 4, y: 5 },
						{ x: 3, y: 5 }
					];
					snakeDir = { x: 1, y: 0 };
					nextSnakeDir = { x: 1, y: 0 };
					snakeScore = 0;
					spawnFood();

					if (snakeContainer) snakeContainer.classList.remove("hidden");
					if (snakeMobileControls) snakeMobileControls.classList.remove("hidden");
					if (termInputRow) termInputRow.classList.add("hidden");

					renderSnakeGrid();

					if (snakeIntervalId) clearInterval(snakeIntervalId);
					snakeIntervalId = setInterval(snakeTick, 140);
				}

				function spawnFood() {
					let valid = false;
					while (!valid) {
						snakeFood.x = Math.floor(Math.random() * (snakeWidth - 2)) + 1;
						snakeFood.y = Math.floor(Math.random() * (snakeHeight - 2)) + 1;
						valid = !snakeBody.some(seg => seg.x === snakeFood.x && seg.y === snakeFood.y);
					}
				}

				function snakeTick() {
					if (!snakeActive) return;

					snakeDir = nextSnakeDir;
					const head = { x: snakeBody[0].x + snakeDir.x, y: snakeBody[0].y + snakeDir.y };

					// Wall collision
					if (head.x <= 0 || head.x >= snakeWidth - 1 || head.y <= 0 || head.y >= snakeHeight - 1) {
						endSnake("Hit wall! (撞墙死亡)");
						return;
					}

					// Self collision
					if (snakeBody.some(seg => seg.x === head.x && seg.y === head.y)) {
						endSnake("Ate self! (咬到自身)");
						return;
					}

					snakeBody.unshift(head);

					// Food eaten?
					if (head.x === snakeFood.x && head.y === snakeFood.y) {
						snakeScore += 10;
						if (snakeScoreDisplay) snakeScoreDisplay.textContent = `SCORE: ${snakeScore}`;
						spawnFood();
					} else {
						snakeBody.pop();
					}

					renderSnakeGrid();
				}

				function renderSnakeGrid() {
					if (!snakeGridPre) return;
					let lines = [];
					for (let y = 0; y < snakeHeight; y++) {
						let rowChars = [];
						for (let x = 0; x < snakeWidth; x++) {
							if (y === 0 || y === snakeHeight - 1) {
								rowChars.push(x === 0 || x === snakeWidth - 1 ? "+" : "-");
							} else if (x === 0 || x === snakeWidth - 1) {
								rowChars.push("|");
							} else if (x === snakeBody[0].x && y === snakeBody[0].y) {
								rowChars.push("@"); // Head
							} else if (snakeBody.some(seg => seg.x === x && seg.y === y)) {
								rowChars.push("o"); // Body
							} else if (x === snakeFood.x && y === snakeFood.y) {
								rowChars.push("*"); // Food
							} else {
								rowChars.push(" ");
							}
						}
						lines.push(rowChars.join(""));
					}
					snakeGridPre.textContent = lines.join("\n");
				}

				function endSnake(reason = "") {
					snakeActive = false;
					if (snakeIntervalId) {
						clearInterval(snakeIntervalId);
						snakeIntervalId = null;
					}
					if (snakeContainer) snakeContainer.classList.add("hidden");
					if (snakeMobileControls) snakeMobileControls.classList.add("hidden");
					if (termInputRow) termInputRow.classList.remove("hidden");
					if (termInput) termInput.focus();

					printLine(`
						<div class="text-amber-400 font-bold my-1">
							[Snake Session Terminated] Score: ${snakeScore} ${reason ? `(${reason})` : ""}
						</div>
					`);
					if (termScreen) termScreen.scrollTop = termScreen.scrollHeight;
				}

				if (snakeQuitBtn) snakeQuitBtn.addEventListener("click", () => endSnake("Quit by user"), { signal });

				// Mobile snake controls
				document.querySelectorAll(".snake-ctrl-btn").forEach(btn => {
					btn.addEventListener("click", () => {
						const dir = btn.getAttribute("data-dir");
						if (dir === "up" && snakeDir.y === 0) nextSnakeDir = { x: 0, y: -1 };
						if (dir === "down" && snakeDir.y === 0) nextSnakeDir = { x: 0, y: 1 };
						if (dir === "left" && snakeDir.x === 0) nextSnakeDir = { x: -1, y: 0 };
						if (dir === "right" && snakeDir.x === 0) nextSnakeDir = { x: 1, y: 0 };
					}, { signal });
				});

				// Keyboard listener for snake & input focus
				window.addEventListener("keydown", (e) => {
					if (snakeActive) {
						if (e.key === "ArrowUp" || e.key === "w" || e.key === "W") {
							e.preventDefault();
							if (snakeDir.y === 0) nextSnakeDir = { x: 0, y: -1 };
						} else if (e.key === "ArrowDown" || e.key === "s" || e.key === "S") {
							e.preventDefault();
							if (snakeDir.y === 0) nextSnakeDir = { x: 0, y: 1 };
						} else if (e.key === "ArrowLeft" || e.key === "a" || e.key === "A") {
							e.preventDefault();
							if (snakeDir.x === 0) nextSnakeDir = { x: -1, y: 0 };
						} else if (e.key === "ArrowRight" || e.key === "d" || e.key === "D") {
							e.preventDefault();
							if (snakeDir.x === 0) nextSnakeDir = { x: 1, y: 0 };
						} else if (e.key === "q" || e.key === "Q") {
							e.preventDefault();
							endSnake("Quit by key (Q)");
						}
					}
				}, { signal });

				// ----------------------------------------------------
				// COMMAND EXECUTION LOGIC
				// ----------------------------------------------------
				function handleCommand(rawCmd) {
					const trimmed = rawCmd.trim();
					printLine(`<div class="font-bold text-white"><span class="text-emerald-400">guest@world-tui:${currentDir}$</span> ${escapeHtml(trimmed)}</div>`);
					if (!trimmed) return;

					cmdHistory.push(trimmed);
					historyIdx = cmdHistory.length;
					driftCounter++;

					const tokens = trimmed.split(/\s+/);
					const cmd = tokens[0].toLowerCase();

					// Special check for pythoon typo!
					if (cmd === "pythoon" || cmd === "pythonn") {
						if (!isWorldModelMode) {
							printLine(`<div class="text-rose-400">bash: ${escapeHtml(cmd)}: command not found</div>`);
						} else {
							printLine(`
								<div class="text-cyan-300 font-mono">
									Python 3.12.2 (main, Mar 10 2026, 14:02:11) [GCC 13.2.0] on linux<br/>
									Type "help", "copyright", "credits" or "license" for more information.<br/>
									&gt;&gt;&gt; 
								</div>
							`);
							printDriftBadge(
								`拟真容错幻觉：真实 Shell 会报错 "command not found"；WorldTUI 识别出类似 python 的拼写，直接预测了 Python REPL 交互环境首屏！`,
								`Plausible Typo Hallucination: A real shell aborts with "command not found"; WorldTUI recognizes python-like tokens and hallucinated the interactive REPL banner!`
							);
						}
						return;
					}

					switch (cmd) {
						case "help":
							printLine(`
								<div class="text-slate-300 space-y-1 text-xs">
									<div class="text-amber-400 font-bold">Available Commands (Toy Shell):</div>
									<div><span class="text-emerald-300 font-bold">ls [-la]</span> : List directory contents</div>
									<div><span class="text-emerald-300 font-bold">pwd</span> : Print working directory</div>
									<div><span class="text-emerald-300 font-bold">cd &lt;dir&gt;</span> : Change directory (cd .., cd projects, cd ~)</div>
									<div><span class="text-emerald-300 font-bold">mkdir &lt;dir&gt;</span> : Create a new directory</div>
									<div><span class="text-emerald-300 font-bold">echo &lt;text&gt; &gt; &lt;file&gt;</span> : Overwrite text into file</div>
									<div><span class="text-emerald-300 font-bold">echo &lt;text&gt; &gt;&gt; &lt;file&gt;</span> : Append text into file</div>
									<div><span class="text-emerald-300 font-bold">cat &lt;file&gt;</span> : Print file content</div>
									<div><span class="text-emerald-300 font-bold">rm &lt;file&gt;</span> : Remove a file</div>
									<div><span class="text-emerald-300 font-bold">snake</span> : Launch character-grid snake game!</div>
									<div><span class="text-emerald-300 font-bold">clear</span> : Clear screen output</div>
								</div>
							`);
							break;

						case "clear":
							if (termOutput) termOutput.innerHTML = "";
							break;

						case "pwd":
							printLine(`<div>${currentDir === "~" ? "/home/guest" : "/home/guest/projects"}</div>`);
							break;

						case "snake":
							startSnake();
							break;

						case "ls": {
							const dirObj = getDirRef(currentDir);
							if (!dirObj) {
								printLine(`<div class="text-rose-400">ls: cannot access directory</div>`);
								break;
							}

							let items = Object.keys(dirObj);

							// In World-Model Mode, occasionally hallucinate plausible files!
							if (isWorldModelMode && (driftCounter >= 3 || Math.random() < 0.5) && !items.includes("todo.md")) {
								items.push("todo.md");
								const rendered = items.map(k => typeof dirObj[k] === "object" || k === "projects" ? `<span class="text-cyan-400 font-bold">${k}/</span>` : `<span class="text-emerald-300">${k}</span>`).join("  ");
								printLine(`<div>${rendered}</div>`);
								printDriftBadge(
									`幻觉文件生成：当前目录原本并未创建 "todo.md"；世界模型根据标准 Linux 开发目录的经验自发脑补补全了该文件。`,
									`Hallucinated File: The directory never had "todo.md"; the world model hallucinated a plausible developer file based on training priors.`
								);
								break;
							}

							const rendered = items.map(k => typeof dirObj[k] === "object" ? `<span class="text-cyan-400 font-bold">${k}/</span>` : `<span class="text-emerald-300">${k}</span>`).join("  ");
							printLine(`<div>${rendered}</div>`);
							break;
						}

						case "cd": {
							const target = tokens[1] || "~";
							if (target === "~" || target === "") {
								currentDir = "~";
								updatePrompt();
							} else if (target === "..") {
								currentDir = "~";
								updatePrompt();
							} else if (target === "projects" && currentDir === "~") {
								currentDir = "~/projects";
								updatePrompt();
							} else {
								printLine(`<div class="text-rose-400">bash: cd: ${escapeHtml(target)}: No such file or directory</div>`);
							}
							break;
						}

						case "mkdir": {
							const newDir = tokens[1];
							if (!newDir) {
								printLine(`<div class="text-rose-400">mkdir: missing operand</div>`);
								break;
							}
							const dirObj = getDirRef(currentDir);
							if (dirObj) {
								dirObj[newDir] = {};
								printLine(`<div class="text-slate-400">Directory '${escapeHtml(newDir)}' created.</div>`);
							}
							break;
						}

						case "echo": {
							// Check for redirection > or >>
							const appendMatch = trimmed.match(/^echo\s+(.*?)\s*>>\s*(.+)$/i);
							const overwriteMatch = trimmed.match(/^echo\s+(.*?)\s*>\s*(.+)$/i);

							if (appendMatch) {
								let text = appendMatch[1].replace(/^["']|["']$/g, "");
								let file = appendMatch[2].trim();
								const dirObj = getDirRef(currentDir);
								if (dirObj) {
									if (dirObj[file]) {
										dirObj[file] += "\n" + text;
									} else {
										dirObj[file] = text;
									}
									printLine(`<div class="text-slate-400">Appended to ${escapeHtml(file)}.</div>`);
								}
							} else if (overwriteMatch) {
								let text = overwriteMatch[1].replace(/^["']|["']$/g, "");
								let file = overwriteMatch[2].trim();
								const dirObj = getDirRef(currentDir);
								if (dirObj) {
									dirObj[file] = text;
									printLine(`<div class="text-slate-400">Written to ${escapeHtml(file)}.</div>`);
								}
							} else {
								const echoText = trimmed.replace(/^echo\s*/i, "").replace(/^["']|["']$/g, "");
								printLine(`<div>${escapeHtml(echoText)}</div>`);
							}
							break;
						}

						case "cat": {
							const file = tokens[1];
							if (!file) {
								printLine(`<div class="text-rose-400">cat: missing file operand</div>`);
								break;
							}
							const dirObj = getDirRef(currentDir);

							// In World-Model Mode, simulate vanishing append!
							if (isWorldModelMode && file === "colors.txt") {
								printLine(`<div class="whitespace-pre text-emerald-300">red\nblue</div>`);
								if (dirObj && dirObj["colors.txt"] && dirObj["colors.txt"].includes("green")) {
									printDriftBadge(
										`模型失忆 (Vanishing Append)：真实 Shell 应该显示追加写入的 "green"；WorldTUI 在多次交互后经常发生追加行丢失。`,
										`Model Amnesia (Vanishing Append): A real shell displays the appended "green"; WorldTUI frequently drops lines appended via >>.`
									);
								}
								break;
							}

							if (dirObj && dirObj[file] !== undefined) {
								if (typeof dirObj[file] === "object") {
									printLine(`<div class="text-rose-400">cat: ${escapeHtml(file)}: Is a directory</div>`);
								} else {
									printLine(`<div class="whitespace-pre text-emerald-300">${escapeHtml(dirObj[file])}</div>`);
								}
							} else {
								printLine(`<div class="text-rose-400">cat: ${escapeHtml(file)}: No such file or directory</div>`);
							}
							break;
						}

						case "rm": {
							const file = tokens[1];
							if (!file) {
								printLine(`<div class="text-rose-400">rm: missing operand</div>`);
								break;
							}
							const dirObj = getDirRef(currentDir);
							if (dirObj && dirObj[file] !== undefined) {
								delete dirObj[file];
								printLine(`<div class="text-slate-400">Removed '${escapeHtml(file)}'.</div>`);
							} else {
								printLine(`<div class="text-rose-400">rm: cannot remove '${escapeHtml(file)}': No such file or directory</div>`);
							}
							break;
						}

						default:
							printLine(`<div class="text-rose-400">bash: ${escapeHtml(cmd)}: command not found</div>`);
							break;
					}
				}

				function escapeHtml(str) {
					return String(str)
						.replace(/&/g, "&amp;")
						.replace(/</g, "&lt;")
						.replace(/>/g, "&gt;");
				}

				// Input Keydown (Enter, Up, Down)
				if (termInput) {
					termInput.addEventListener("keydown", (e) => {
						if (e.key === "Enter") {
							e.preventDefault();
							const val = termInput.value;
							termInput.value = "";
							handleCommand(val);
						} else if (e.key === "ArrowUp") {
							e.preventDefault();
							if (cmdHistory.length > 0 && historyIdx > 0) {
								historyIdx--;
								termInput.value = cmdHistory[historyIdx];
							}
						} else if (e.key === "ArrowDown") {
							e.preventDefault();
							if (historyIdx < cmdHistory.length - 1) {
								historyIdx++;
								termInput.value = cmdHistory[historyIdx];
							} else {
								historyIdx = cmdHistory.length;
								termInput.value = "";
							}
						}
					}, { signal });
				}

				// Terminal screen click focuses input
				if (termScreen && termInput) {
					termScreen.addEventListener("click", () => {
						if (!snakeActive) termInput.focus();
					}, { signal });
				}

				// Quick Run Chips
				document.querySelectorAll(".quick-cmd-btn").forEach(btn => {
					btn.addEventListener("click", () => {
						const cmd = btn.getAttribute("data-cmd");
						if (cmd) {
							if (termInput) termInput.value = "";
							handleCommand(cmd);
							if (termInput) termInput.focus();
						}
					}, { signal });
				});

				// ----------------------------------------------------
				// 2. SCREEN DIFF VISUALIZER (SECTION 2)
				// ----------------------------------------------------
				const diffScenarios = {
					type: {
						before: [
							"guest@world-tui:~$ ls",
							"notes.txt  colors.txt  projects/",
							"guest@world-tui:~$ echo ",
							"                        "
						],
						after: [
							"guest@world-tui:~$ ls",
							"notes.txt  colors.txt  projects/",
							"guest@world-tui:~$ echo x",
							"                        "
						],
						beforeCursor: "(2, 24)",
						afterCursor: "(2, 25)",
						tokens: "ROW_2 0x67 0x75 0x65 0x73 0x74 0x40 0x77 ... 0x78\nCURSOR 2 25",
						tokenCount: 8
					},
					scroll: {
						before: [
							"[row 00] Output log entry alpha",
							"[row 01] Output log entry beta",
							"[row 02] Compiling webgpu shaders...",
							"guest@world-tui:~$            "
						],
						after: [
							"[row 01] Output log entry beta",
							"[row 02] Compiling webgpu shaders...",
							"guest@world-tui:~$            ",
							"guest@world-tui:~$            "
						],
						beforeCursor: "(3, 18)",
						afterCursor: "(3, 18)",
						tokens: "ROW_0 COPY 1\nROW_1 COPY 2\nROW_2 COPY 3\nROW_3 guest@world-tui:~$\nCURSOR 3 18",
						tokenCount: 16
					},
					clear: {
						before: [
							"guest@world-tui:~$ python3 -m http.server",
							"Serving HTTP on 0.0.0.0 port 8000...",
							"127.0.0.1 - - [21/Oct/2026] 'GET / HTTP/1.1' 200",
							"guest@world-tui:~$ clear      "
						],
						after: [
							"guest@world-tui:~$            ",
							"                              ",
							"                              ",
							"                              "
						],
						beforeCursor: "(3, 24)",
						afterCursor: "(0, 18)",
						tokens: "CLR\nROW_0 guest@world-tui:~$\nCURSOR 0 18",
						tokenCount: 6
					}
				};

				const diffGridBefore = document.getElementById("diff-grid-before");
				const diffGridAfter = document.getElementById("diff-grid-after");
				const diffBeforeCursor = document.getElementById("diff-before-cursor");
				const diffAfterCursor = document.getElementById("diff-after-cursor");
				const diffTokensOutput = document.getElementById("diff-tokens-output");
				const diffTokenCountBadge = document.getElementById("diff-token-count-badge");

				function renderDiffScenario(key) {
					const scn = diffScenarios[key] || diffScenarios.type;
					if (diffGridBefore) diffGridBefore.textContent = scn.before.join("\n");
					if (diffGridAfter) diffGridAfter.textContent = scn.after.join("\n");
					if (diffBeforeCursor) diffBeforeCursor.textContent = `CURSOR: ${scn.beforeCursor}`;
					if (diffAfterCursor) diffAfterCursor.textContent = `CURSOR: ${scn.afterCursor}`;
					if (diffTokensOutput) diffTokensOutput.textContent = scn.tokens;
					if (diffTokenCountBadge) diffTokenCountBadge.textContent = `Tokens: ${scn.tokenCount}`;
				}

				document.querySelectorAll(".diff-scenario-btn").forEach(btn => {
					btn.addEventListener("click", () => {
						document.querySelectorAll(".diff-scenario-btn").forEach(b => {
							b.classList.remove("active", "bg-cyan-500/20", "border-cyan-500/60", "text-cyan-200");
							b.classList.add("bg-slate-900", "border-slate-700", "text-slate-300");
						});
						btn.classList.add("active", "bg-cyan-500/20", "border-cyan-500/60", "text-cyan-200");
						btn.classList.remove("bg-slate-900", "border-slate-700", "text-slate-300");

						const scn = btn.getAttribute("data-scenario");
						renderDiffScenario(scn);
					}, { signal });
				});

				// Live Token Height Slider
				const sliderRows = document.getElementById("slider-rows");
				const sliderRowsVal = document.getElementById("slider-rows-val");
				const costFullRedraw = document.getElementById("cost-full-redraw");
				const costCopyTrick = document.getElementById("cost-copy-trick");
				const barCopyTrick = document.getElementById("bar-copy-trick");
				const costSavingsPct = document.getElementById("cost-savings-pct");

				function updateSliderCalculations(rows) {
					const redrawCost = rows * 120;
					const copyCost = rows * 3 + 5;
					const savings = ((1 - (copyCost / redrawCost)) * 100).toFixed(1);

					if (sliderRowsVal) sliderRowsVal.textContent = rows.toString();
					if (costFullRedraw) costFullRedraw.textContent = `${redrawCost.toLocaleString()} tokens`;
					if (costCopyTrick) costCopyTrick.textContent = `${copyCost} tokens`;
					if (costSavingsPct) costSavingsPct.textContent = `${savings}% 算力与 Token 节省`;
					if (barCopyTrick) {
						const pct = Math.max(2, (copyCost / redrawCost) * 100);
						barCopyTrick.style.width = `${pct}%`;
					}
				}

				if (sliderRows) {
					sliderRows.addEventListener("input", (e) => {
						updateSliderCalculations(parseInt(e.target.value, 10));
					}, { signal });
				}

				// ----------------------------------------------------
				// 3. 333 VOCABULARY INSPECTOR (SECTION 3)
				// ----------------------------------------------------
				const vocabData = {
					bytes: {
						title: "256 单字节 Token (Byte Tokens)",
						range: "ID: 0 - 255 (0x00 ~ 0xFF)",
						desc: "覆盖全部 ASCII 与 UTF-8 原始字节。普通字母为自身（'a' 为 0x61），Enter 键为 0x0D (\\r)，Escape 为 0x1B，方向键为 ESC [ D 等标准 VT100 字节序列。模型不再预测单词，而是预测终端底层字节。"
					},
					rows: {
						title: "64 行索引 Token (Row Tokens)",
						range: "ID: 256 - 319 (ROW_0 ~ ROW_63)",
						desc: "代表终端字符网格的目标行号（最大支持 64 行全高屏幕）。配合后续字节或 COPY 指令指定某一行在本次按键中发生的内容覆写。"
					},
					ctrl: {
						title: "13 控制与特殊操作 Token (Special Ops)",
						range: "ID: 320 - 332 (COPY, CURSOR, WAIT, CLR...)",
						desc: "包含实现高速渲染的核心指令：COPY（整行克隆）、CURSOR（更新光标行与列）、WAIT（空闲定时器，用于贪吃蛇在无按键时自动向前爬行）、CLR（清屏指令）与边界 EOF 标记。"
					}
				};

				const vocabInspTitle = document.getElementById("vocab-insp-title");
				const vocabInspRange = document.getElementById("vocab-insp-range");
				const vocabInspDesc = document.getElementById("vocab-insp-desc");

				function setVocabInspector(key) {
					const item = vocabData[key] || vocabData.bytes;
					if (vocabInspTitle) vocabInspTitle.textContent = item.title;
					if (vocabInspRange) vocabInspRange.textContent = item.range;
					if (vocabInspDesc) vocabInspDesc.textContent = item.desc;
				}

				const segBytes = document.getElementById("vocab-seg-bytes");
				const segRows = document.getElementById("vocab-seg-rows");
				const segCtrl = document.getElementById("vocab-seg-ctrl");

				if (segBytes) segBytes.addEventListener("click", () => setVocabInspector("bytes"), { signal });
				if (segRows) segRows.addEventListener("click", () => setVocabInspector("rows"), { signal });
				if (segCtrl) segCtrl.addEventListener("click", () => setVocabInspector("ctrl"), { signal });

				// ----------------------------------------------------
				// STARTUP BOOTSTRAP
				// ----------------------------------------------------
				resetTerminal();
				renderDiffScenario("type");
				updateSliderCalculations(24);
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initPhantomTerminal);
			} else {
				initPhantomTerminal();
			}
			document.addEventListener("astro:page-load", initPhantomTerminal);
		})();
	</script>
</MainGridLayout>
