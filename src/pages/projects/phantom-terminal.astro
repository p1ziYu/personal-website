---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

interface Props {
	lang?: string;
}

const { lang = Astro.url.pathname.startsWith("/en") ? "en" : "zh_CN" } =
	Astro.props;
const isEn = lang === "en";

const title = isEn
	? "THE PHANTOM TERMINAL · When a 360M Model Pretends to Be a Terminal"
	: "终端在做梦 · 3.6亿参数神经网络伪装的幻影终端";
const description = isEn
	? "No shell, no filesystem — every keystroke feeds into a 360M parameter neural network predicting terminal screen diffs. Exploring WorldTUI: Qwen2.5-Coder-0.5B fine-tuned into a 208 MB in-browser world model, the 333-token vocabulary, the COPY scroll trick, and the quiet tragedy of layer-7 memory loss."
	: "没有真实 Shell，没有物理文件系统，每一次键盘敲击都由 3.6 亿参数的神经网络直接预测终端屏幕的网格变化。剖析 WorldTUI：Qwen2.5-Coder-0.5B 微调出的 208MB 浏览器世界模型、333 极简词表、屏幕差分 COPY 技巧与深层记忆灾难。";
---

<MainGridLayout title={title} description={description} lang={lang}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mb-8">
		<div class="z-10 px-4 sm:px-8 py-8 relative w-full rounded-(--radius-large) overflow-hidden bg-[#070d0a] text-emerald-100 border border-emerald-900/60 shadow-2xl selection:bg-emerald-500/30 selection:text-emerald-200">
			<!-- Ambient Phosphor Glow & Scanline Background -->
			<div class="absolute inset-0 pointer-events-none opacity-15 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:20px_20px] overflow-hidden"></div>
			<div class="absolute -top-36 -left-36 w-96 h-96 bg-emerald-600/15 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute top-1/3 -right-32 w-96 h-96 bg-cyan-600/15 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute bottom-16 left-1/3 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl pointer-events-none"></div>

			<!-- HERO HEADER SECTION -->
			<header class="relative z-10 mb-10 pb-8 border-b border-emerald-900/60">
				<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
					<div class="flex flex-wrap items-center gap-2">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-mono font-semibold tracking-wide">
							<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
							<span>HN 2026-10-21 · 621 PTS · WORLDTUI</span>
						</div>
						<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono">
							<span>🖥️</span>
							<span class="lang-zh">世界模型终端 · 360M 参数</span>
							<span class="lang-en">World Model TUI · 360M Params</span>
						</div>
						<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-mono">
							<span>⚡</span>
							<span class="lang-zh">WebGPU 本地 208MB · 零后端</span>
							<span class="lang-en">WebGPU In-Browser 208MB · No Shell</span>
						</div>
					</div>

					<!-- In-Page Language Switcher -->
					<div class="flex items-center gap-3">
						<div class="text-xs font-mono text-emerald-400/70 hidden sm:block">
							<span class="lang-zh">交互式原理解析 · 2026-10-24</span>
							<span class="lang-en">Interactive Deep Dive · 2026-10-24</span>
						</div>
						<a
							id="inpage-lang-toggle"
							href={isEn ? "/projects/phantom-terminal/" : "/en/projects/phantom-terminal/"}
							class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-emerald-950/70 border border-emerald-500/40 text-emerald-300 hover:text-white hover:bg-emerald-900/80 font-mono text-xs transition cursor-pointer active:scale-95"
							title={isEn ? "切换为中文" : "Switch to English"}
						>
							<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
								<path d="m12.87 15.07-2.54-2.51.03-.03A17.52 17.52 0 0 0 14.07 6H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7 1.62-4.33L19.12 17h-3.24z"/>
							</svg>
							<span class="lang-zh font-bold">English</span>
							<span class="lang-en font-bold">中文</span>
						</a>
					</div>
				</div>

				<h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-2 font-mono">
					<span class="lang-zh">终端在做梦</span>
					<span class="lang-en">THE PHANTOM TERMINAL</span>
				</h1>

				<p class="text-lg sm:text-xl font-bold text-emerald-400 mb-4 tracking-wide font-mono">
					<span class="lang-zh">没有 Shell，没有文件系统：3.6 亿参数神经网络直接预测屏幕差分</span>
					<span class="lang-en">No Shell, No Filesystem: A 360M Neural Network Predicts Screen Diffs Per Keystroke</span>
				</p>

				<div class="space-y-3 max-w-4xl text-emerald-100/90 leading-relaxed text-sm sm:text-base font-sans">
					<p>
						<span class="lang-zh">
							<strong>2026 年 10 月 21 日</strong>，Hacker News 首页热门讨论（作者 simedw，斩获约 621 点赞、186 条深度讨论）引爆了极客社区：<strong>《WorldTUI: I trained a 360M model to pretend to be a terminal》</strong>。屏幕背后没有 bash、没有 zsh、没有任何 Linux 内核与物理磁盘——用户的每一个原始按键字节直接喂给一个小模型，模型直接预测终端<strong>屏幕字符网格的局部差分与光标位置</strong>。
						</span>
						<span class="lang-en">
							On <strong>21 October 2026</strong>, a front-page Hacker News post by simedw (~621 points, ~186 comments) captured the imagination of systems hackers worldwide: <strong>"WorldTUI: I trained a 360M model to pretend to be a terminal."</strong> There is no bash, no zsh, no operating system, and no filesystem. Every raw keystroke enters a small neural network, which directly predicts <strong>screen character-grid diffs and cursor movements</strong>.
						</span>
					</p>
					<p class="text-xs sm:text-sm text-emerald-200/70">
						<span class="lang-zh">
							这是谷歌 <strong>Genie 3</strong>（应用由模型生成而非代码编写）理念在现实中最轻巧的落地雏形。本页面并非对该演示的机械复制，而是我们针对其核心技术机理的原创深度剖析与交互演练场。从 333 个极端微词表、屏幕差分 COPY 压缩，到 DAgger 自我修复与第 7 层被剔除后“记忆悄然暴毙”的残酷蒸馏事故，带你完整透视这个 208MB 的“终端世界模型”。
						</span>
						<span class="lang-en">
							This is Google's <strong>Genie 3</strong> vision (applications learned rather than written) condensed into the smallest viable universe. This page is our original interactive exploration of WorldTUI's inner mechanisms: the 333-token vocabulary, the COPY scroll trick, DAgger self-repair, and the chilling distillation finding where dropping Layer 7 silently vaporized all memory while keeping next-token accuracy intact.
						</span>
					</p>
				</div>

				<!-- TRANSPARENCY NOTICE BANNER -->
				<div class="mt-6 p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs sm:text-sm leading-relaxed font-mono">
					<div class="flex items-start gap-2.5">
						<span class="text-base sm:text-lg select-none">⚠️</span>
						<div>
							<span class="lang-zh">
								<strong>透明度前置声明</strong>：下方可操作的“幻影终端”是一个纯手写、完全确定性的 JavaScript 状态机玩具，<strong>绝非真正的神经网络模型</strong>。它通过规则模拟了世界模型的交互手感与典型幻觉；真正的 WorldTUI 是一个完整的 208 MB Qwen2.5-Coder-0.5B (int4) 模型，通过 WebGPU WGSL 着色器在读者浏览器的标签页内本地推理运行。
							</span>
							<span class="lang-en">
								<strong>Upfront Transparency Notice</strong>: The playable interactive terminal below is a deterministic, hand-written JavaScript toy, <strong>NOT a machine learning model</strong>. It is designed to illustrate the interactive sensation and scripted model drifts; simedw's real WorldTUI is a genuine 208 MB Qwen2.5-Coder-0.5B (int4) running locally in your browser via WebGPU WGSL compute shaders.
							</span>
						</div>
					</div>
				</div>
			</header>

			<!-- SECTION 1: THE PLAYABLE TOY TERMINAL -->
			<section class="relative z-10 mb-14">
				<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
					<div class="flex items-center gap-2">
						<span class="text-emerald-400 font-mono text-xl font-bold">01/</span>
						<h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight font-mono">
							<span class="lang-zh">幻影终端演练场 · THE PHANTOM TERMINAL</span>
							<span class="lang-en">THE PHANTOM TERMINAL · Playable Toy</span>
						</h2>
					</div>

					<!-- Real Shell vs World-Model Toggle -->
					<div class="flex flex-wrap items-center gap-2 text-xs font-mono">
						<span class="text-emerald-400/80 mr-1 hidden sm:inline">
							<span class="lang-zh">运行模式:</span>
							<span class="lang-en">Mode:</span>
						</span>
						<button
							type="button"
							id="mode-real-btn"
							class="px-3 py-1.5 rounded-lg border border-emerald-500/60 bg-emerald-500/20 text-emerald-200 font-bold hover:bg-emerald-500/30 transition cursor-pointer active:scale-95 shadow-[0_0_10px_rgba(16,185,129,0.2)]"
						>
							<span class="lang-zh">🟢 真实 Shell 模式 (精确持久)</span>
							<span class="lang-en">🟢 Real Shell Mode (Exact)</span>
						</button>
						<button
							type="button"
							id="mode-model-btn"
							class="px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-900/80 text-slate-300 font-bold hover:border-amber-500/60 hover:text-amber-300 transition cursor-pointer active:scale-95"
						>
							<span class="lang-zh">🧠 世界模型模式 (模拟漂移幻觉)</span>
							<span class="lang-en">🧠 World-Model Mode (Simulated Drift)</span>
						</button>
						<button
							type="button"
							id="term-reset-btn"
							class="px-2.5 py-1.5 rounded-lg border border-slate-700 bg-slate-900/60 text-slate-400 hover:text-white hover:border-slate-500 transition cursor-pointer active:scale-95"
							title="Reset terminal filesystem and history"
						>
							<span class="lang-zh">↺ 重置</span>
							<span class="lang-en">↺ Reset</span>
						</button>
					</div>
				</div>

				<!-- Mode Explanatory Pill -->
				<div id="mode-desc-pill" class="mb-4 px-3.5 py-2 rounded-lg bg-emerald-950/40 border border-emerald-900/50 text-xs font-mono text-emerald-300 flex items-center justify-between">
					<div id="mode-desc-text">
						<span class="lang-zh"><strong>当前模式：真实 Shell</strong> —— 文件修改精确写入，追加行绝不丢失，路径严谨记忆。</span>
						<span class="lang-en"><strong>Current: Real Shell Mode</strong> — Files persist faithfully, appends never vanish, paths accurately remembered.</span>
					</div>
					<span class="text-[11px] text-emerald-400/60 font-sans hidden md:inline">
						<span class="lang-zh">切换至世界模型体验“模型失忆”与“幻觉补全”</span>
						<span class="lang-en">Switch to World-Model Mode to experience hallucinations</span>
					</span>
				</div>

				<!-- TERMINAL WINDOW WRAPPER -->
				<div class="rounded-xl overflow-hidden border border-emerald-800/60 bg-[#040806] shadow-2xl">
					<!-- Title Bar -->
					<div class="px-4 py-2.5 bg-[#09130d] border-b border-emerald-900/60 flex items-center justify-between select-none">
						<div class="flex items-center gap-2">
							<span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
							<span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
							<span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
							<span class="ml-2 text-xs font-mono text-emerald-400/80 font-bold">guest@world-tui:~ (tty1) [hand-written JS toy]</span>
						</div>
						<div class="flex items-center gap-2 text-[11px] font-mono text-emerald-500/60">
							<span id="term-status-badge" class="px-2 py-0.5 rounded bg-emerald-950 border border-emerald-800/60 text-emerald-400">
								SHELL: READY
							</span>
						</div>
					</div>

					<!-- Screen Body -->
					<div
						id="terminal-screen"
						class="p-4 sm:p-5 font-mono text-xs sm:text-sm text-emerald-300 leading-relaxed min-h-[360px] max-h-[480px] overflow-y-auto cursor-text bg-[#030705] relative selection:bg-emerald-500/30 selection:text-white"
					>
						<!-- Past Outputs container -->
						<div id="term-output-history" class="space-y-1"></div>

						<!-- Active Snake Board Container (Hidden by default) -->
						<div id="term-snake-container" class="hidden my-2 p-3 bg-black/90 rounded border border-emerald-600/60">
							<div class="text-xs text-amber-300 mb-1 flex items-center justify-between">
								<span>🐍 SNAKE IN TERMINAL (CHARACTER GRID GAME)</span>
								<span id="snake-score-display" class="font-bold text-emerald-400">SCORE: 0</span>
							</div>
							<pre id="snake-ascii-grid" class="font-mono text-emerald-400 leading-none select-none text-[13px]"></pre>
							<div class="mt-2 text-[11px] text-emerald-500 flex flex-wrap items-center justify-between gap-2">
								<span>
									<span class="lang-zh">方向键 / WASD 移动 · 按 Q 退出回终端</span>
									<span class="lang-en">Arrows / WASD to move · Press Q to quit to prompt</span>
								</span>
								<button id="snake-quit-btn" type="button" class="px-2 py-0.5 rounded bg-rose-950 border border-rose-700 text-rose-300 hover:bg-rose-900 text-xs">
									<span class="lang-zh">退出 Snake (Q)</span>
									<span class="lang-en">Quit Snake (Q)</span>
								</button>
							</div>
						</div>

						<!-- Active Prompt Row -->
						<div id="term-input-row" class="flex items-center gap-1.5 mt-2">
							<span id="term-prompt-label" class="text-emerald-400 font-bold select-none shrink-0">guest@world-tui:~$</span>
							<div class="relative flex-1 flex items-center">
								<input
									id="term-input"
									type="text"
									autocomplete="off"
									autocorrect="off"
									autocapitalize="off"
									spellcheck="false"
									class="w-full bg-transparent border-none outline-none text-emerald-200 font-mono text-xs sm:text-sm p-0 m-0 focus:ring-0"
									aria-label="Terminal Input"
								/>
							</div>
						</div>
					</div>

					<!-- Mobile On-Screen Snake Controls (only shown when snake active) -->
					<div id="snake-mobile-controls" class="hidden px-4 py-3 bg-[#08120c] border-t border-emerald-900/60 flex items-center justify-center gap-3 select-none">
						<button data-dir="up" class="snake-ctrl-btn px-4 py-2 rounded bg-emerald-950 border border-emerald-700 text-emerald-300 active:scale-90 font-mono font-bold">▲</button>
						<button data-dir="left" class="snake-ctrl-btn px-4 py-2 rounded bg-emerald-950 border border-emerald-700 text-emerald-300 active:scale-90 font-mono font-bold">◀</button>
						<button data-dir="down" class="snake-ctrl-btn px-4 py-2 rounded bg-emerald-950 border border-emerald-700 text-emerald-300 active:scale-90 font-mono font-bold">▼</button>
						<button data-dir="right" class="snake-ctrl-btn px-4 py-2 rounded bg-emerald-950 border border-emerald-700 text-emerald-300 active:scale-90 font-mono font-bold">▶</button>
					</div>

					<!-- Bottom Quick Chips Bar -->
					<div class="px-4 py-2.5 bg-[#070e0a] border-t border-emerald-900/60 flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
						<div class="flex items-center gap-1.5 text-emerald-400/70">
							<span>⚡</span>
							<span class="lang-zh">快捷指令:</span>
							<span class="lang-en">Quick Run:</span>
						</div>
						<div class="flex flex-wrap items-center gap-1.5" id="term-quick-chips">
							<button type="button" data-cmd="help" class="quick-cmd-btn px-2.5 py-1 rounded bg-emerald-950/70 border border-emerald-800/80 text-emerald-300 hover:bg-emerald-900 transition active:scale-95">help</button>
							<button type="button" data-cmd="ls -la" class="quick-cmd-btn px-2.5 py-1 rounded bg-emerald-950/70 border border-emerald-800/80 text-emerald-300 hover:bg-emerald-900 transition active:scale-95">ls -la</button>
							<button type="button" data-cmd="echo green >> colors.txt" class="quick-cmd-btn px-2.5 py-1 rounded bg-emerald-950/70 border border-emerald-800/80 text-emerald-300 hover:bg-emerald-900 transition active:scale-95">echo green &gt;&gt; colors.txt</button>
							<button type="button" data-cmd="cat colors.txt" class="quick-cmd-btn px-2.5 py-1 rounded bg-emerald-950/70 border border-emerald-800/80 text-emerald-300 hover:bg-emerald-900 transition active:scale-95">cat colors.txt</button>
							<button type="button" data-cmd="pythoon" class="quick-cmd-btn px-2.5 py-1 rounded bg-amber-950/50 border border-amber-800/70 text-amber-300 hover:bg-amber-900/60 transition active:scale-95" title="Type typo to test model behavior">pythoon (typo!)</button>
							<button type="button" data-cmd="snake" class="quick-cmd-btn px-2.5 py-1 rounded bg-cyan-950/60 border border-cyan-800/80 text-cyan-300 hover:bg-cyan-900 transition active:scale-95">snake 🐍</button>
							<button type="button" data-cmd="clear" class="quick-cmd-btn px-2.5 py-1 rounded bg-slate-900 border border-slate-700 text-slate-300 hover:bg-slate-800 transition active:scale-95">clear</button>
						</div>
					</div>
				</div>
			</section>

			<!-- SECTION 2: THE SCREEN IS THE STATE -->
			<section class="relative z-10 mb-14">
				<div class="flex items-center gap-2 mb-3">
					<span class="text-cyan-400 font-mono text-xl font-bold">02/</span>
					<h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight font-mono">
						<span class="lang-zh">屏幕即状态 · 屏幕差分与 COPY 技巧</span>
						<span class="lang-en">THE SCREEN IS THE STATE · Screen Diffs & The COPY Trick</span>
					</h2>
				</div>

				<p class="text-sm sm:text-base text-emerald-100/90 max-w-4xl leading-relaxed mb-6">
					<span class="lang-zh">
						终端本质上是一个二维字符矩阵（如 80 列 × 24 行），而非像 ChatGPT 对话框那样的单向文本流。普通语言模型只能向末尾追加 token，根本无法原生表达光标跳跃回顶部、vim 插入新行或终端清屏。WorldTUI 的核心突破在于：<strong>将终端屏幕视为显存快照，每次按键只预测修改了哪些行（Screen Diffs）与最终光标位置</strong>。
					</span>
					<span class="lang-en">
						A terminal is fundamentally a 2D character matrix (e.g. 80 columns by 24 rows), not a unidirectional stream of text. Conventional LLMs append tokens to the end, making it impossible to express cursor jumps to the top left, vim row insertions, or screen clears. WorldTUI's key insight: <strong>the terminal screen is a frame buffer; each keystroke predicts which rows changed (Screen Diffs) and where the cursor ended up</strong>.
					</span>
				</p>

				<!-- Scenario Picker Tabs -->
				<div class="flex flex-wrap gap-2 mb-4">
					<button
						type="button"
						data-scenario="type"
						class="diff-scenario-btn active px-3.5 py-2 rounded-lg bg-cyan-500/20 border border-cyan-500/60 text-cyan-200 font-mono text-xs font-bold transition cursor-pointer"
					>
						<span class="lang-zh">情境 A: 键入单字 (打字)</span>
						<span class="lang-en">Scenario A: Type Character</span>
					</button>
					<button
						type="button"
						data-scenario="scroll"
						class="diff-scenario-btn px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-700 text-slate-300 font-mono text-xs font-bold hover:border-cyan-500/40 hover:text-cyan-300 transition cursor-pointer"
					>
						<span class="lang-zh">情境 B: 底部回车滚屏 (COPY 奇迹)</span>
						<span class="lang-en">Scenario B: Scroll on Enter (COPY Trick)</span>
					</button>
					<button
						type="button"
						data-scenario="clear"
						class="diff-scenario-btn px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-700 text-slate-300 font-mono text-xs font-bold hover:border-cyan-500/40 hover:text-cyan-300 transition cursor-pointer"
					>
						<span class="lang-zh">情境 C: 执行 clear 清屏</span>
						<span class="lang-en">Scenario C: Clear Command</span>
					</button>
				</div>

				<!-- Side by Side Visual Grids -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
					<!-- Before Grid -->
					<div class="p-4 rounded-xl bg-[#050c08] border border-emerald-900/60">
						<div class="flex items-center justify-between text-xs font-mono text-emerald-400 mb-2">
							<span class="font-bold">
								<span class="lang-zh">按键前屏幕状态 (Screen Before)</span>
								<span class="lang-en">Screen State Before Keystroke</span>
							</span>
							<span id="diff-before-cursor" class="text-slate-400">CURSOR: (23, 17)</span>
						</div>
