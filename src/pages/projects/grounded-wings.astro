				// ==========================================
				// 2. RUN OR FLY SWAMP MINI-SIMULATOR
				// ==========================================
				const simCanvas = document.getElementById("sim-canvas");
				const simBtnRun = document.getElementById("sim-btn-run");
				const simBtnFly = document.getElementById("sim-btn-fly");
				const simBtnReset = document.getElementById("sim-btn-reset");
				const hudMode = document.getElementById("hud-mode");
				const hudDist = document.getElementById("hud-dist");
				const hudSpeed = document.getElementById("hud-speed");
				const simBanner = document.getElementById("sim-banner");
				const simBannerText = document.getElementById("sim-banner-text");

				let simCtx = simCanvas ? simCanvas.getContext("2d") : null;
				let simState = {
					mode: "idle", // 'idle', 'running', 'flying', 'finished'
					activeMode: null,
					posX: 50,
					posY: 0,
					velX: 0,
					velY: 0,
					distanceMeters: 0,
					animStep: 0,
					targetDistance: 0,
					particles: [],
					bestRun: 104.2,
					bestFly: 31.5,
				};

				function resizeSimCanvas() {
					if (!simCanvas) return;
					const rect = simCanvas.getBoundingClientRect();
					const dpr = window.devicePixelRatio || 1;
					simCanvas.width = Math.round(rect.width * dpr);
					simCanvas.height = Math.round(rect.height * dpr);
				}

				window.addEventListener("resize", resizeSimCanvas, { signal: lifecycle.signal });
				resizeSimCanvas();

				function spawnParticles(x, y, count, type) {
					for (let i = 0; i < count; i++) {
						simState.particles.push({
							x,
							y,
							vx: (Math.random() - 0.7) * (type === "mud" ? 4 : 2),
							vy: (Math.random() - 0.5) * (type === "mud" ? 4 : 3) - 1.5,
							radius: Math.random() * (type === "mud" ? 3.5 : 2.5) + 1,
							color: type === "mud"
								? (Math.random() > 0.5 ? "#475569" : "#334155")
								: (Math.random() > 0.5 ? "#f59e0b" : "#cbd5e1"),
							life: 1.0,
							decay: Math.random() * 0.03 + 0.02,
						});
					}
				}

				function launchSimulator(mode) {
					simState.mode = mode;
					simState.activeMode = mode;
					simState.posX = 60;
					simState.animStep = 0;
					simState.particles = [];

					if (mode === "run") {
						simState.targetDistance = 95 + Math.random() * 15; // 95 - 110 m
						simState.velX = 8.5;
						if (hudMode) {
							hudMode.className = "text-emerald-400 font-bold";
							hudMode.textContent = isEn() ? "RUN DASH / 奔跑中" : "RUN DASH / 奔跑中";
						}
					} else {
						simState.targetDistance = 26 + Math.random() * 8; // 26 - 34 m
						simState.velX = 4.2;
						if (hudMode) {
							hudMode.className = "text-amber-400 font-bold";
							hudMode.textContent = isEn() ? "BURST FLAP / 扑腾中" : "BURST FLAP / 扑腾中";
						}
					}

					if (simBanner) simBanner.style.opacity = "0";
				}

				if (simBtnRun) {
					simBtnRun.addEventListener("click", () => launchSimulator("run"), { signal: lifecycle.signal });
				}
				if (simBtnFly) {
					simBtnFly.addEventListener("click", () => launchSimulator("fly"), { signal: lifecycle.signal });
				}
				if (simBtnReset) {
					simBtnReset.addEventListener("click", () => {
						simState.mode = "idle";
						simState.activeMode = null;
						simState.posX = 60;
						simState.distanceMeters = 0;
						simState.particles = [];
						if (hudMode) {
							hudMode.className = "text-slate-400 font-bold";
							hudMode.textContent = "READY / 待命";
						}
						if (hudDist) hudDist.textContent = "0.0 m";
						if (hudSpeed) hudSpeed.textContent = "0.0 m/s";
						if (simBanner) simBanner.style.opacity = "0";
					}, { signal: lifecycle.signal });
				}

				// Simulator Game Loop
				let lastSimTime = performance.now();

				function renderSimulator(time) {
					if (!simCtx || !simCanvas) return;
					const dt = Math.min((time - lastSimTime) / 1000, 0.1);
					lastSimTime = time;

					const w = simCanvas.width;
					const h = simCanvas.height;
					const groundY = h * 0.72;

					// Clear background
					simCtx.fillStyle = "#071318";
					simCtx.fillRect(0, 0, w, h);

					// Draw Jurassic Swamp Backing (Atmosphere Gradient)
					const swampGrad = simCtx.createLinearGradient(0, 0, 0, groundY);
					swampGrad.addColorStop(0, "#081c1c");
					swampGrad.addColorStop(0.6, "#0b2628");
					swampGrad.addColorStop(1, "#13352f");
					simCtx.fillStyle = swampGrad;
					simCtx.fillRect(0, 0, w, groundY);

					// Distant Cycad / Jurassic Tree Silhouettes
					simCtx.fillStyle = "#0c2522";
					for (let i = 0; i < 7; i++) {
						const tx = (i * w * 0.18 + 40);
						simCtx.beginPath();
						simCtx.moveTo(tx, groundY);
						simCtx.lineTo(tx + 6, groundY - 60);
						simCtx.lineTo(tx - 25, groundY - 80);
						simCtx.lineTo(tx, groundY - 68);
						simCtx.lineTo(tx + 30, groundY - 82);
						simCtx.lineTo(tx + 8, groundY - 60);
						simCtx.closePath();
						simCtx.fill();
					}

					// Ground Surface (Muddy Swamp & Waterline)
					simCtx.fillStyle = "#1e293b";
					simCtx.fillRect(0, groundY, w, h - groundY);

					// Marsh Water Reflection Layer
					simCtx.fillStyle = "#042f2e";
					simCtx.fillRect(0, groundY, w, 10);
					simCtx.fillStyle = "#0f766e";
					for (let i = 0; i < 5; i++) {
						const px = (i * 220 + (time * 0.05) % 220) % w;
						simCtx.fillRect(px, groundY + 3, 40, 2);
					}

					// Distance Markers on Ground
					simCtx.fillStyle = "#64748b";
					simCtx.font = `${Math.round(10 * (window.devicePixelRatio || 1))}px monospace`;
					for (let m = 0; m <= 120; m += 20) {
						const markX = 60 + (m / 120) * (w - 120);
						simCtx.fillRect(markX, groundY, 2, 8);
						simCtx.fillText(`${m}m`, markX - 10, groundY + 22);
					}

					// Update simulation physics
					if (simState.mode === "run") {
						simState.animStep += dt * 16;
						const progress = simState.posX / (w - 100);
						simState.distanceMeters = progress * 120;

						// Running jump over a puddle at midpoint
						const jumpMid = w * 0.45;
						let jumpH = 0;
						if (Math.abs(simState.posX - jumpMid) < 80) {
							jumpH = Math.sin(((simState.posX - jumpMid + 80) / 160) * Math.PI) * 25;
						}
						simState.posY = groundY - 30 - jumpH;
						simState.posX += simState.velX * (w / 700);

						// Mud splash particles
						if (Math.random() < 0.4) {
							spawnParticles(simState.posX - 10, groundY, 2, "mud");
						}

						if (hudDist) hudDist.textContent = `${simState.distanceMeters.toFixed(1)} m`;
						if (hudSpeed) hudSpeed.textContent = `${(simState.velX * 1.8).toFixed(1)} m/s`;

						if (simState.distanceMeters >= simState.targetDistance || simState.posX >= w - 100) {
							simState.mode = "finished";
							if (hudMode) {
								hudMode.className = "text-emerald-400 font-bold";
								hudMode.textContent = "DASH FINISHED! / 奔跑到达";
							}
							if (simBanner && simBannerText) {
								simBannerText.innerHTML = isEn()
									? `🏃 <strong>Ground Sprint Victorious!</strong> Covered <strong>${simState.distanceMeters.toFixed(1)} m</strong> smoothly across muddy terrain. Running wins!`
									: `🏃 <strong>沼泽地栖奔跑完胜！</strong> 疾行覆盖 <strong>${simState.distanceMeters.toFixed(1)} 米</strong>，长腿迈步轻盈高效。奔跑大胜！`;
								simBanner.style.opacity = "1";
							}
						}
					} else if (simState.mode === "fly") {
						simState.animStep += dt * 22;
						const progress = simState.posX / (w - 100);
						simState.distanceMeters = progress * 120;

						// Clumsy struggling flight arc: lifts, stalls, drops
						const flightProgress = simState.distanceMeters / simState.targetDistance;
						let altitude = 0;
						if (flightProgress < 0.3) {
							altitude = (flightProgress / 0.3) * 35;
						} else if (flightProgress < 0.7) {
							altitude = 35 - ((flightProgress - 0.3) / 0.4) * 15 + Math.sin(time * 0.02) * 5;
						} else {
							altitude = 20 * (1 - (flightProgress - 0.7) / 0.3);
						}
						altitude = Math.max(0, altitude);
						simState.posY = groundY - 30 - altitude;
						simState.posX += simState.velX * (w / 700);

						// Clumsy feather particles
						if (Math.random() < 0.25) {
							spawnParticles(simState.posX, simState.posY, 1, "feather");
						}

						if (hudDist) hudDist.textContent = `${simState.distanceMeters.toFixed(1)} m`;
						if (hudSpeed) hudSpeed.textContent = `${Math.max(1.0, (simState.velX * (1 - flightProgress * 0.6) * 1.5)).toFixed(1)} m/s`;

						if (simState.distanceMeters >= simState.targetDistance) {
							simState.mode = "finished";
							// Splash landing
							spawnParticles(simState.posX, groundY, 8, "mud");
							if (hudMode) {
								hudMode.className = "text-amber-400 font-bold";
								hudMode.textContent = "CRASH-LANDED / 扑腾力竭";
							}
							if (simBanner && simBannerText) {
								simBannerText.innerHTML = isEn()
									? `🪶 <strong>Burst Flap Exhausted!</strong> Stalled out at <strong>${simState.distanceMeters.toFixed(1)} m</strong>. Forelimbs too short to sustain lift.`
									: `🪶 <strong>短途扑腾力竭着陆！</strong> 仅飞出 <strong>${simState.distanceMeters.toFixed(1)} 米</strong> 便失速栽倒。前肢短小，升力难以为继！`;
								simBanner.style.opacity = "1";
							}
						}
					} else if (simState.mode === "idle") {
						simState.posY = groundY - 30;
					}

					// Update & Draw Particles
					for (let i = simState.particles.length - 1; i >= 0; i--) {
						const p = simState.particles[i];
						p.x += p.vx;
						p.y += p.vy;
						p.life -= p.decay;
						if (p.life <= 0) {
							simState.particles.splice(i, 1);
							continue;
						}
						simCtx.fillStyle = p.color;
						simCtx.globalAlpha = p.life;
						simCtx.beginPath();
						simCtx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
						simCtx.fill();
					}
					simCtx.globalAlpha = 1.0;

					// Draw Animated Yuezhuornis Bird Sprite
					simCtx.save();
					simCtx.translate(simState.posX, simState.posY);

					// Bird Body & Tail
					simCtx.fillStyle = "#10b981";
					simCtx.beginPath();
					simCtx.ellipse(0, 0, 18, 10, 0, 0, Math.PI * 2);
					simCtx.fill();

					// Tail
					simCtx.fillStyle = "#059669";
					simCtx.beginPath();
					simCtx.moveTo(-15, 0);
					simCtx.lineTo(-32, -4);
					simCtx.lineTo(-30, 6);
					simCtx.closePath();
					simCtx.fill();

					// Head & Beak
					simCtx.fillStyle = "#10b981";
					simCtx.beginPath();
					simCtx.arc(16, -8, 7, 0, Math.PI * 2);
					simCtx.fill();

					// Eye & Beak
					simCtx.fillStyle = "#facc15";
					simCtx.fillRect(18, -10, 2.5, 2.5);
					simCtx.fillStyle = "#f59e0b";
					simCtx.beginPath();
					simCtx.moveTo(22, -9);
					simCtx.lineTo(31, -7);
					simCtx.lineTo(22, -5);
					simCtx.closePath();
					simCtx.fill();

					// Animated Legs (Walking/Running cycle)
					simCtx.strokeStyle = "#38bdf8";
					simCtx.lineWidth = 2.5;
					simCtx.lineCap = "round";

					if (simState.mode === "run") {
						const legSwing1 = Math.sin(simState.animStep) * 14;
						const legSwing2 = Math.sin(simState.animStep + Math.PI) * 14;

						// Leg 1
						simCtx.beginPath();
						simCtx.moveTo(-2, 6);
						simCtx.lineTo(legSwing1, 26);
						simCtx.stroke();

						// Leg 2
						simCtx.beginPath();
						simCtx.moveTo(4, 6);
						simCtx.lineTo(legSwing2, 26);
						simCtx.stroke();
					} else if (simState.mode === "fly") {
						// Legs dangling back
						simCtx.beginPath();
						simCtx.moveTo(-2, 6);
						simCtx.lineTo(-12, 20);
						simCtx.stroke();
						simCtx.beginPath();
						simCtx.moveTo(4, 6);
						simCtx.lineTo(-6, 22);
						simCtx.stroke();
					} else {
						// Idle standing legs
						simCtx.beginPath();
						simCtx.moveTo(-2, 6);
						simCtx.lineTo(-2, 26);
						simCtx.stroke();
						simCtx.beginPath();
						simCtx.moveTo(4, 6);
						simCtx.lineTo(4, 26);
						simCtx.stroke();
					}

					// Animated Wings (Small wings!)
					simCtx.fillStyle = "#34d399";
					simCtx.beginPath();
					if (simState.mode === "fly") {
						const flapAngle = Math.sin(simState.animStep * 1.5) * 18;
						simCtx.moveTo(2, -2);
						simCtx.lineTo(-12, -18 + flapAngle);
						simCtx.lineTo(-16, 2);
					} else {
						// Tucked short wing
						simCtx.moveTo(4, -2);
						simCtx.lineTo(-10, -6);
						simCtx.lineTo(-12, 4);
					}
					simCtx.closePath();
					simCtx.fill();

					simCtx.restore();

					requestAnimationFrame(renderSimulator);
				}

				requestAnimationFrame(renderSimulator);

