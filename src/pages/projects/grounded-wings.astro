				function selectMosaicSpot(spotId) {
					const data = mosaicData[spotId];
					if (!data) return;

					// Update tab buttons
					[tabSpot1, tabSpot2, tabSpot3, tabSpot4].forEach((tab, idx) => {
						if (!tab) return;
						if (idx + 1 === spotId) {
							tab.className = "spot-tab-btn py-1.5 px-1 rounded bg-emerald-950/80 border border-emerald-400 text-emerald-300 font-bold transition active:scale-95 text-center cursor-pointer";
						} else {
							tab.className = "spot-tab-btn py-1.5 px-1 rounded bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-300 font-bold transition active:scale-95 text-center cursor-pointer";
						}
					});

					if (cardSpotNum) cardSpotNum.textContent = data.num;
					if (cardTraitTitle) {
						cardTraitTitle.innerHTML = `<span class="lang-zh">${data.titleZh}</span><span class="lang-en">${data.titleEn}</span>`;
					}
					if (cardAffinityBadge) {
						cardAffinityBadge.className = `px-2.5 py-1 rounded-full text-xs font-mono font-bold border ${data.affinityClass}`;
						cardAffinityBadge.innerHTML = `<span class="lang-zh">${data.affinityZh}</span><span class="lang-en">${data.affinityEn}</span>`;
					}
					if (cardPlainSentence) {
						cardPlainSentence.innerHTML = `<span class="lang-zh">${data.sentenceZh}</span><span class="lang-en">${data.sentenceEn}</span>`;
					}
					if (cardFactText) {
						cardFactText.innerHTML = `<span class="lang-zh">${data.factZh}</span><span class="lang-en">${data.factEn}</span>`;
					}
					if (cardInferenceText) {
						cardInferenceText.innerHTML = `<span class="lang-zh">${data.inferZh}</span><span class="lang-en">${data.inferEn}</span>`;
					}
				}

				if (hotspotWings) hotspotWings.addEventListener("click", () => selectMosaicSpot(1), { signal: lifecycle.signal });
				if (hotspotTeeth) hotspotTeeth.addEventListener("click", () => selectMosaicSpot(2), { signal: lifecycle.signal });
				if (hotspotToe) hotspotToe.addEventListener("click", () => selectMosaicSpot(3), { signal: lifecycle.signal });
				if (hotspotPelvis) hotspotPelvis.addEventListener("click", () => selectMosaicSpot(4), { signal: lifecycle.signal });

				if (tabSpot1) tabSpot1.addEventListener("click", () => selectMosaicSpot(1), { signal: lifecycle.signal });
				if (tabSpot2) tabSpot2.addEventListener("click", () => selectMosaicSpot(2), { signal: lifecycle.signal });
				if (tabSpot3) tabSpot3.addEventListener("click", () => selectMosaicSpot(3), { signal: lifecycle.signal });
				if (tabSpot4) tabSpot4.addEventListener("click", () => selectMosaicSpot(4), { signal: lifecycle.signal });

				// Initialize with default state
				updateWingRatio(0.70, "Yuezhuornis");
				selectMosaicSpot(1);
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initGroundedWings);
			} else {
				initGroundedWings();
			}
			document.addEventListener("astro:page-load", initGroundedWings);
		})();
	</script>
</MainGridLayout>
