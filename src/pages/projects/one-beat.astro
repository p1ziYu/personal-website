	<!-- CLIENT-SIDE SIMULATION & INTERACTIVE ENGINE -->
	<script is:inline>
		(() => {
			function initOneBeat() {
				const canvas = document.getElementById("honeycomb-canvas");
				if (!canvas || canvas.dataset.labReady === "true") return;
				canvas.dataset.labReady = "true";

				const lifecycle = new AbortController();
				document.addEventListener("astro:before-swap", () => lifecycle.abort(), { once: true });


				// ==========================================
				// 1. HONEYCOMB SIMULATION (37 ACTIVE UNITS)
				// ==========================================
				// Build 37 hex grid nodes (radius <= 3)
				const hexCoords = [];
				for (let q = -3; q <= 3; q++) {
					for (let r = -3; r <= 3; r++) {
						if (Math.max(Math.abs(q), Math.abs(r), Math.abs(q + r)) <= 3) {
							// Axial coordinates to cartesian
							const x = Math.sqrt(3) * (q + r / 2.0);
							const y = 1.5 * r;
							const dist = Math.max(Math.abs(q), Math.abs(r), Math.abs(q + r));
							hexCoords.push({ q, r, x, y, dist });
						}
					}
				}
				// Sort by distance from center so inner layers come first (12 units, 24 units, 37 units)
				hexCoords.sort((a, b) => a.dist - b.dist || Math.hypot(a.x, a.y) - Math.hypot(b.x, b.y));

				const TOTAL_UNITS = 37;
				let activeUnitCount = 37; // toggled between 12, 24, 37

				// Adjacency for the 37 nodes
				const hexAdj = Array.from({ length: TOTAL_UNITS }, () => []);
				for (let i = 0; i < TOTAL_UNITS; i++) {
					for (let j = 0; j < TOTAL_UNITS; j++) {
						if (i !== j) {
							const dx = hexCoords[i].x - hexCoords[j].x;
							const dy = hexCoords[i].y - hexCoords[j].y;
							if (Math.abs(Math.hypot(dx, dy) - Math.sqrt(3)) < 0.1) {
								hexAdj[i].push(j);
							}
						}
					}
				}

				// State for Honeycomb
				const phases = new Float64Array(TOTAL_UNITS);
				const intrinsicFrequencies = new Float64Array(TOTAL_UNITS);
				const pinPhases = new Float64Array(TOTAL_UNITS);
				for (let i = 0; i < TOTAL_UNITS; i++) {
					phases[i] = Math.random() * Math.PI * 2;
					intrinsicFrequencies[i] = 2.0 + 0.6 * Math.sin(i * 1.7 + 0.8);
					pinPhases[i] = (i * 1.57) % (Math.PI * 2);
				}

				let hcRunning = true;
				let hcEta = 0.85; // nonreciprocity
				let hcK = 1.20; // coupling
				let hcNoise = 0.05; // noise
				const hcEtaThreshold = 0.40;

				// Sparkline history of R
				const rHistory = new Array(120).fill(0.98);

				// Canvas contexts
				const hcCtx = canvas.getContext("2d");
				const sparkCanvas = document.getElementById("hc-sparkline-canvas");
				const sparkCtx = sparkCanvas ? sparkCanvas.getContext("2d") : null;

				// DOM readouts
				const rValEl = document.getElementById("hc-r-val");
				const stateBadgeEl = document.getElementById("hc-state-badge");
				const lambdaValEl = document.getElementById("hc-lambda-val");
				const lambdaDescEl = document.getElementById("hc-lambda-desc");
				const lambdaBarEl = document.getElementById("hc-lambda-bar");
				const alertBanner = document.getElementById("honeycomb-alert");

				// Sparkline update
				function updateSparkline() {
					if (!sparkCtx || !sparkCanvas) return;
					const w = sparkCanvas.width;
					const h = sparkCanvas.height;
					sparkCtx.clearRect(0, 0, w, h);

					// Draw grid lines
					sparkCtx.strokeStyle = "rgba(51, 65, 85, 0.4)";
					sparkCtx.lineWidth = 1;
					sparkCtx.beginPath();
					sparkCtx.moveTo(0, h * 0.2);
					sparkCtx.lineTo(w, h * 0.2);
					sparkCtx.moveTo(0, h * 0.8);
					sparkCtx.lineTo(w, h * 0.8);
					sparkCtx.stroke();

					// Draw line of R history
					sparkCtx.strokeStyle = "#818cf8";
					sparkCtx.lineWidth = 2;
					sparkCtx.beginPath();
					const step = w / (rHistory.length - 1);
					for (let i = 0; i < rHistory.length; i++) {
						const r = rHistory[i];
						const y = h - r * (h - 8) - 4;
						const x = i * step;
						if (i === 0) sparkCtx.moveTo(x, y);
						else sparkCtx.lineTo(x, y);
					}
					sparkCtx.stroke();

					// Fill area
					sparkCtx.lineTo(w, h);
					sparkCtx.lineTo(0, h);
					sparkCtx.closePath();
					sparkCtx.fillStyle = "rgba(99, 102, 241, 0.15)";
					sparkCtx.fill();
				}

				// Phase color mapping
				function getPhaseColor(phi) {
					// phi in [0, 2pi) -> hue in degrees
					const norm = ((phi % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
					const h = (norm / (Math.PI * 2)) * 360;
					return `hsl(${h}, 85%, 62%)`;
				}

				// Honeycomb animation loop
				let lastTime = performance.now();
				function stepHoneycomb(now) {
					if (!hcRunning) {
						lastTime = now;
						requestAnimationFrame(stepHoneycomb);
						return;
					}
					const dt = Math.min(0.06, (now - lastTime) / 1000);
					lastTime = now;

					// Physics integration step
					const dPhases = new Float64Array(activeUnitCount);
					const activeDrive = Math.max(0, hcEta - hcEtaThreshold) / (1 - hcEtaThreshold);

					for (let i = 0; i < activeUnitCount; i++) {
						if (hcEta < hcEtaThreshold) {
							// Below threshold: local pinning + frequency spread -> patchy
							const pin = (1.0 - hcEta / hcEtaThreshold) * 1.8;
							dPhases[i] = 0.4 * intrinsicFrequencies[i] - pin * Math.sin(phases[i] - pinPhases[i]);
						} else {
							// Above threshold: active nonreciprocal self-oscillation (~30 Hz)
							dPhases[i] = 3.2 + 0.08 * intrinsicFrequencies[i];
						}

						// Neighbor coupling
						const nbrs = hexAdj[i].filter(j => j < activeUnitCount);
						for (const j of nbrs) {
							const dphi = phases[j] - phases[i];
							if (hcEta < hcEtaThreshold) {
								dPhases[i] += (hcK * 0.22) * Math.sin(dphi);
							} else {
								// Nonreciprocal coarsening acceleration
								const boost = 1.0 + 2.8 * Math.pow(activeDrive, 1.2);
								dPhases[i] += (hcK * boost / nbrs.length) * Math.sin(dphi);
							}
						}

						// Environmental noise
						dPhases[i] += hcNoise * (Math.random() - 0.5) * 5;
					}

					// Apply updates and compute synchrony R
					let sumCos = 0;
					let sumSin = 0;
					let totalNeighborCoherence = 0;
					let edgeCount = 0;

					for (let i = 0; i < activeUnitCount; i++) {
						phases[i] += dPhases[i] * dt;
						sumCos += Math.cos(phases[i]);
						sumSin += Math.sin(phases[i]);

						// Compute local spatial correlation for wavelength estimate
						const nbrs = hexAdj[i].filter(j => j < activeUnitCount);
						for (const j of nbrs) {
							if (i < j) {
								totalNeighborCoherence += Math.cos(phases[i] - phases[j]);
								edgeCount++;
							}
						}
					}

					const R = Math.hypot(sumCos, sumSin) / activeUnitCount;
					rHistory.shift();
					rHistory.push(R);

					// Estimated dominant wavelength
					const meanCoherence = edgeCount > 0 ? totalNeighborCoherence / edgeCount : 1;
					// When coherence is ~1, lambda -> infinity
					// When coherence is ~0 or negative, lambda is small (~ 1.5 a)
					let lambdaTextZh = "λ → ∞ (全局同步)";
					let lambdaTextEn = "λ → ∞ (Global Sync)";
					let lambdaDescZh = "系统级同相搏动（粗化终点）";
					let lambdaDescEn = "Lattice-scale uniform pulse (Coarsened)";
					let lambdaPct = 100;

					if (R < 0.45 || meanCoherence < 0.2) {
						lambdaTextZh = "λ ≈ 1.3 a (微观涟漪)";
						lambdaTextEn = "λ ≈ 1.3 a (Micro-Ripples)";
						lambdaDescZh = "斑块状混乱与短波扰动";
						lambdaDescEn = "Patchy disorder & short waves";
						lambdaPct = 20;
					} else if (R < 0.85 || meanCoherence < 0.75) {
						lambdaTextZh = "λ ≈ 3.8 a (波粗化中)";
						lambdaTextEn = "λ ≈ 3.8 a (Coarsening Waves)";
						lambdaDescZh = "短波碰撞合并为长波前";
						lambdaDescEn = "Short waves merging into broad fronts";
						lambdaPct = 60;
					}

					// Update DOM readouts
					if (rValEl) rValEl.textContent = R.toFixed(3);
					if (lambdaValEl) {
						lambdaValEl.innerHTML = `<span class="lang-zh">${lambdaTextZh}</span><span class="lang-en">${lambdaTextEn}</span>`;
					}
					if (lambdaDescEl) {
						lambdaDescEl.innerHTML = `<span class="lang-zh">${lambdaDescZh}</span><span class="lang-en">${lambdaDescEn}</span>`;
					}
					if (lambdaBarEl) lambdaBarEl.style.width = `${lambdaPct}%`;

					if (stateBadgeEl) {
						if (R > 0.90) {
							stateBadgeEl.className = "text-indigo-400 font-bold";
							stateBadgeEl.innerHTML = `<span class="lang-zh">时间晶体全局同拍</span><span class="lang-en">Time Crystal Sync</span>`;
						} else if (R > 0.60) {
							stateBadgeEl.className = "text-cyan-400 font-bold";
							stateBadgeEl.innerHTML = `<span class="lang-zh">波粗化长波合并</span><span class="lang-en">Wave Coarsening</span>`;
						} else {
							stateBadgeEl.className = "text-amber-400 font-bold";
							stateBadgeEl.innerHTML = `<span class="lang-zh">斑块状混沌无序</span><span class="lang-en">Patchy Disorder</span>`;
						}
					}

					updateSparkline();

					// Render Honeycomb onto canvas
					const cw = canvas.width;
					const ch = canvas.height;
					hcCtx.clearRect(0, 0, cw, ch);

					const centerX = cw / 2;
					const centerY = ch / 2;
					const scale = Math.min(cw, ch) / 10.5;

					// 1. Draw elastic links
					hcCtx.lineWidth = 3.5;
					for (let i = 0; i < activeUnitCount; i++) {
						const xi = centerX + hexCoords[i].x * scale;
						const yi = centerY + hexCoords[i].y * scale;
						const nbrs = hexAdj[i].filter(j => j < activeUnitCount);
						for (const j of nbrs) {
							if (i < j) {
								const xj = centerX + hexCoords[j].x * scale;
								const yj = centerY + hexCoords[j].y * scale;
								const phaseDiff = Math.abs(Math.sin((phases[i] - phases[j]) / 2));
								// When synchronized (diff=0), link glows indigo; when in opposition, amber/red
								hcCtx.strokeStyle = `rgba(${Math.round(99 + phaseDiff * 140)}, ${Math.round(102 - phaseDiff * 60)}, ${Math.round(241 - phaseDiff * 100)}, 0.45)`;
								hcCtx.beginPath();
								hcCtx.moveTo(xi, yi);
								hcCtx.lineTo(xj, yj);
								hcCtx.stroke();
							}
						}
					}

					// 2. Draw nodes (active robotic units)
					for (let i = 0; i < activeUnitCount; i++) {
						const x = centerX + hexCoords[i].x * scale;
						const y = centerY + hexCoords[i].y * scale;
						const phi = phases[i];
						const color = getPhaseColor(phi);

						// Node breathing pulse
						const pulse = 1.0 + 0.18 * Math.cos(phi);
						const baseRadius = 15;
						const radius = baseRadius * pulse;

						// Outer subtle glow halo
						hcCtx.fillStyle = color;
						hcCtx.globalAlpha = 0.22;
						hcCtx.beginPath();
						hcCtx.arc(x, y, radius * 1.45, 0, Math.PI * 2);
						hcCtx.fill();
						hcCtx.globalAlpha = 1.0;

						// Node body
						hcCtx.fillStyle = color;
						hcCtx.beginPath();
						hcCtx.arc(x, y, radius, 0, Math.PI * 2);
						hcCtx.fill();

						// Inner robotic actuator ring & core
						hcCtx.fillStyle = "#070b14";
						hcCtx.beginPath();
						hcCtx.arc(x, y, radius * 0.55, 0, Math.PI * 2);
						hcCtx.fill();

						// Phase pointer needle
						hcCtx.strokeStyle = "#ffffff";
						hcCtx.lineWidth = 2;
						hcCtx.beginPath();
						hcCtx.moveTo(x, y);
						hcCtx.lineTo(x + Math.cos(phi) * (radius * 0.85), y + Math.sin(phi) * (radius * 0.85));
						hcCtx.stroke();

						// Cell index number
						hcCtx.fillStyle = "rgba(255, 255, 255, 0.75)";
						hcCtx.font = "9px monospace";
						hcCtx.textAlign = "center";
						hcCtx.textBaseline = "middle";
						hcCtx.fillText(`${i + 1}`, x, y);
					}

					requestAnimationFrame(stepHoneycomb);
				}

				// Honeycomb UI Controls
				const btnPlay = document.getElementById("hc-btn-play");
				const playIcon = document.getElementById("hc-play-icon");
				const playText = document.getElementById("hc-play-text");
				const btnPoke = document.getElementById("hc-btn-poke");
				const btnReset = document.getElementById("hc-btn-reset");

				const sliderEta = document.getElementById("hc-slider-eta");
				const sliderK = document.getElementById("hc-slider-k");
				const sliderNoise = document.getElementById("hc-slider-noise");
				const valEta = document.getElementById("hc-val-eta");
				const valK = document.getElementById("hc-val-k");
				const valNoise = document.getElementById("hc-val-noise");

				if (btnPlay) {
					btnPlay.addEventListener("click", () => {
						hcRunning = !hcRunning;
						if (playIcon) playIcon.textContent = hcRunning ? "⏸" : "▶";
						if (playText) {
							playText.innerHTML = hcRunning
								? `<span class="lang-zh">暂停</span><span class="lang-en">Pause</span>`
								: `<span class="lang-zh">播放</span><span class="lang-en">Play</span>`;
						}
					}, { signal: lifecycle.signal });
				}

				function pokePatch() {
					// Randomize a patch of ~8 units
					const centerIdx = Math.floor(Math.random() * activeUnitCount);
					const patch = [centerIdx, ...hexAdj[centerIdx].filter(j => j < activeUnitCount)];
					for (const idx of patch) {
						phases[idx] = Math.random() * Math.PI * 2;
					}
					if (alertBanner) {
						alertBanner.style.opacity = "1";
						setTimeout(() => { alertBanner.style.opacity = "0"; }, 2000);
					}
				}

				if (btnPoke) {
					btnPoke.addEventListener("click", pokePatch, { signal: lifecycle.signal });
				}

				if (btnReset) {
					btnReset.addEventListener("click", () => {
						for (let i = 0; i < TOTAL_UNITS; i++) {
							phases[i] = Math.random() * Math.PI * 2;
						}
						rHistory.fill(0.3);
					}, { signal: lifecycle.signal });
				}

				// Click on canvas to poke clicked unit
				canvas.addEventListener("click", (e) => {
					const rect = canvas.getBoundingClientRect();
					const cw = canvas.width;
					const ch = canvas.height;
					const clickX = ((e.clientX - rect.left) / rect.width) * cw;
					const clickY = ((e.clientY - rect.top) / rect.height) * ch;

					const centerX = cw / 2;
					const centerY = ch / 2;
					const scale = Math.min(cw, ch) / 10.5;

					let hitIdx = -1;
					let minDist = 35;
					for (let i = 0; i < activeUnitCount; i++) {
						const x = centerX + hexCoords[i].x * scale;
						const y = centerY + hexCoords[i].y * scale;
						const d = Math.hypot(clickX - x, clickY - y);
						if (d < minDist) {
							minDist = d;
							hitIdx = i;
						}
					}
					if (hitIdx !== -1) {
						phases[hitIdx] = (phases[hitIdx] + Math.PI) % (Math.PI * 2);
						const nbrs = hexAdj[hitIdx].filter(j => j < activeUnitCount);
						for (const n of nbrs) {
							phases[n] = (phases[n] + Math.random() * Math.PI) % (Math.PI * 2);
						}
					}
				}, { signal: lifecycle.signal });

				if (sliderEta) {
					sliderEta.addEventListener("input", (e) => {
						hcEta = parseFloat(e.target.value);
						if (valEta) valEta.textContent = hcEta.toFixed(2);
					}, { signal: lifecycle.signal });
				}

				if (sliderK) {
					sliderK.addEventListener("input", (e) => {
						hcK = parseFloat(e.target.value);
						if (valK) valK.textContent = hcK.toFixed(2);
					}, { signal: lifecycle.signal });
				}

				if (sliderNoise) {
					sliderNoise.addEventListener("input", (e) => {
						hcNoise = parseFloat(e.target.value);
						if (valNoise) valNoise.textContent = hcNoise.toFixed(2);
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 2. RING LAB SIMULATION (24 MOTOR UNITS)
				// ==========================================
				const ringCanvas = document.getElementById("ring-canvas");
				const ringCtx = ringCanvas ? ringCanvas.getContext("2d") : null;
				const RING_UNITS = 24;

				let ringTime = 0;
				let ringSpeed = 1.0;
				let ringCoarsenStartTime = performance.now();

				// Mode amplitudes: A6 starts at 1.0, decays to A4, A2, and finally locks to Mode 1 (One Beat)
				let ampMode6 = 1.0;
				let ampMode4 = 0.05;
				let ampMode2 = 0.02;
				let ampMode1 = 0.02;

				const ringModeVal = document.getElementById("ring-mode-val");
				const ringModeState = document.getElementById("ring-mode-state");
				const ringModeDesc = document.getElementById("ring-mode-desc");
				const barM1 = document.getElementById("ring-bar-m1");
				const barM2 = document.getElementById("ring-bar-m2");
				const barM4 = document.getElementById("ring-bar-m4");
				const barM6 = document.getElementById("ring-bar-m6");
				const pctM1 = document.getElementById("ring-pct-m1");
				const pctM2 = document.getElementById("ring-pct-m2");
				const pctM4 = document.getElementById("ring-pct-m4");
				const pctM6 = document.getElementById("ring-pct-m6");
				const coarsenTimer = document.getElementById("ring-coarsen-timer");
				const btnRestartRing = document.getElementById("ring-btn-restart");
				const btnSpeedRing = document.getElementById("ring-btn-speed");
				const speedTextRing = document.getElementById("ring-speed-text");

				function resetRingCoarsening() {
					ampMode6 = 1.0;
					ampMode4 = 0.08;
					ampMode2 = 0.03;
					ampMode1 = 0.02;
					ringCoarsenStartTime = performance.now();
				}

				if (btnRestartRing) {
					btnRestartRing.addEventListener("click", resetRingCoarsening, { signal: lifecycle.signal });
				}

				if (btnSpeedRing) {
					btnSpeedRing.addEventListener("click", () => {
						if (ringSpeed === 1.0) ringSpeed = 2.0;
						else if (ringSpeed === 2.0) ringSpeed = 0.5;
						else ringSpeed = 1.0;
						if (speedTextRing) speedTextRing.textContent = `${ringSpeed.toFixed(1)}×`;
					}, { signal: lifecycle.signal });
				}

				let lastRingFrameTime = performance.now();
				function stepRing(now) {
					if (!ringCtx || !ringCanvas) return;
					const dt = Math.min(0.06, (now - lastRingFrameTime) / 1000) * ringSpeed;
					lastRingFrameTime = now;
					ringTime += dt;

					// Coarsening dynamics (energy transfers from Mode 6 -> 4 -> 2 -> 1)
					const elapsedSec = (now - ringCoarsenStartTime) / 1000 * ringSpeed;
					if (coarsenTimer) coarsenTimer.textContent = `${elapsedSec.toFixed(1)} s`;

					// Mode 6 decays
					ampMode6 = Math.max(0.005, 1.0 * Math.exp(-elapsedSec / 2.8));
					// Mode 4 emerges then decays
					ampMode4 = Math.max(0.01, 1.4 * (elapsedSec / 2.5) * Math.exp(-elapsedSec / 3.5));
					// Mode 2 emerges next
					ampMode2 = Math.max(0.01, 1.3 * Math.pow(elapsedSec / 4.5, 2) * Math.exp(-elapsedSec / 5.2));
					// Mode 1 (collective beat) grows and saturates as the final attractor
					ampMode1 = Math.min(1.0, 0.02 + 0.98 * (1.0 - Math.exp(-elapsedSec / 4.8)));

					const totalAmp = ampMode6 + ampMode4 + ampMode2 + ampMode1;
					const p6 = Math.round((ampMode6 / totalAmp) * 100);
					const p4 = Math.round((ampMode4 / totalAmp) * 100);
					const p2 = Math.round((ampMode2 / totalAmp) * 100);
					const p1 = Math.max(0, 100 - p6 - p4 - p2);

					if (barM1) barM1.style.width = `${p1}%`;
					if (barM2) barM2.style.width = `${p2}%`;
					if (barM4) barM4.style.width = `${p4}%`;
					if (barM6) barM6.style.width = `${p6}%`;
					if (pctM1) pctM1.textContent = `${p1}%`;
					if (pctM2) pctM2.textContent = `${p2}%`;
					if (pctM4) pctM4.textContent = `${p4}%`;
					if (pctM6) pctM6.textContent = `${p6}%`;

					// Update Dominant Mode description
					if (p1 > 70) {
						if (ringModeVal) ringModeVal.textContent = "Mode 1";
						if (ringModeState) {
							ringModeState.innerHTML = `<span class="lang-zh">宏观单拍集体循环 (One Beat)</span><span class="lang-en">Collective One-Beat Cycle</span>`;
						}
						if (ringModeDesc) {
							ringModeDesc.innerHTML = `<span class="lang-zh">短波涟漪已被完全吞噬。24 个单元以统一节奏起伏，环身周期性整体膨胀与收缩。</span><span class="lang-en">Short ripples fully coarsened. All 24 units oscillate in unison, breathing cyclically.</span>`;
						}
					} else if (p2 > p4 && p2 > p6) {
						if (ringModeVal) ringModeVal.textContent = "Mode 2";
						if (ringModeState) {
							ringModeState.innerHTML = `<span class="lang-zh">双峰椭圆波动过渡</span><span class="lang-en">Mode-2 Elliptic Pulse</span>`;
						}
						if (ringModeDesc) {
							ringModeDesc.innerHTML = `<span class="lang-zh">4 波模式融合为双峰椭圆摆动，波长持续扩展逼近系统全尺寸。</span><span class="lang-en">Mode-4 has merged into a dual-lobe pulse, wavelength expanding across ring.</span>`;
						}
					} else if (p4 > p6) {
						if (ringModeVal) ringModeVal.textContent = "Mode 4";
						if (ringModeState) {
							ringModeState.innerHTML = `<span class="lang-zh">四峰长波合并阶</span><span class="lang-en">Mode-4 Wave Merging</span>`;
						}
						if (ringModeDesc) {
							ringModeDesc.innerHTML = `<span class="lang-zh">高阶短波相互碰撞吞噬，涟漪波长明显拉长，进入第二级粗化。</span><span class="lang-en">Short ripples colliding and merging into broader wave peaks.</span>`;
						}
					} else {
						if (ringModeVal) ringModeVal.textContent = "Mode 6";
						if (ringModeState) {
							ringModeState.innerHTML = `<span class="lang-zh">高频短波起振 (High Ripples)</span><span class="lang-en">Initial High Ripples</span>`;
						}
						if (ringModeDesc) {
							ringModeDesc.innerHTML = `<span class="lang-zh">初始扰动激发 6 峰密集微波，非互易能量正在向低阶模式流动。</span><span class="lang-en">6 distinct wave ripples excited around ring; coarsening cascade starting.</span>`;
						}
					}

					// Render the 24-unit motorized ring
					const rw = ringCanvas.width;
					const rh = ringCanvas.height;
					ringCtx.clearRect(0, 0, rw, rh);

					const cx = rw / 2;
					const cy = rh / 2;
					const baseR = Math.min(rw, rh) * 0.36;

					// Compute unit radial positions
					const unitPositions = [];
					for (let i = 0; i < RING_UNITS; i++) {
						const phi = (i / RING_UNITS) * Math.PI * 2;
						// Radial displacement sum of modes
						const disp6 = ampMode6 * Math.sin(6 * phi - ringTime * 8);
						const disp4 = ampMode4 * Math.sin(4 * phi - ringTime * 5);
						const disp2 = ampMode2 * Math.sin(2 * phi - ringTime * 3);
						const disp1 = ampMode1 * Math.sin(1 * phi - ringTime * 2);

						const totalDisp = (disp6 * 0.35 + disp4 * 0.45 + disp2 * 0.6 + disp1 * 0.8) * 24;
						const r = baseR + totalDisp;
						const x = cx + r * Math.cos(phi);
						const y = cy + r * Math.sin(phi);
						unitPositions.push({ x, y, phi, disp: totalDisp });
					}

					// Draw connecting elastic ring springs
					ringCtx.strokeStyle = "rgba(6, 182, 212, 0.45)";
					ringCtx.lineWidth = 4;
					ringCtx.beginPath();
					for (let i = 0; i <= RING_UNITS; i++) {
						const pos = unitPositions[i % RING_UNITS];
						if (i === 0) ringCtx.moveTo(pos.x, pos.y);
						else ringCtx.lineTo(pos.x, pos.y);
					}
					ringCtx.stroke();

					// Draw central reference ring
					ringCtx.strokeStyle = "rgba(51, 65, 85, 0.25)";
					ringCtx.lineWidth = 1;
					ringCtx.setLineDash([4, 4]);
					ringCtx.beginPath();
					ringCtx.arc(cx, cy, baseR, 0, Math.PI * 2);
					ringCtx.stroke();
					ringCtx.setLineDash([]);

					// Draw 24 motorized units
					for (let i = 0; i < RING_UNITS; i++) {
						const pos = unitPositions[i];
						const normDisp = pos.disp / 24; // in [-1, 1]
						// Color by displacement: cyan for expansion (+), purple/rose for contraction (-)
						const hue = normDisp > 0 ? 185 + normDisp * 25 : 270 - normDisp * 40;
						const color = `hsl(${hue}, 85%, 60%)`;

						// Unit node
						ringCtx.fillStyle = color;
						ringCtx.beginPath();
						ringCtx.arc(pos.x, pos.y, 8.5, 0, Math.PI * 2);
						ringCtx.fill();

						// Inner core
						ringCtx.fillStyle = "#070b14";
						ringCtx.beginPath();
						ringCtx.arc(pos.x, pos.y, 4, 0, Math.PI * 2);
						ringCtx.fill();
					}

					// Center emblem: "ONE BEAT"
					ringCtx.fillStyle = "rgba(255, 255, 255, 0.9)";
					ringCtx.font = "bold 13px monospace";
					ringCtx.textAlign = "center";
					ringCtx.textBaseline = "middle";
					ringCtx.fillText("ONE BEAT", cx, cy - 6);
					ringCtx.fillStyle = "#06b6d4";
					ringCtx.font = "10px monospace";
					ringCtx.fillText("24 ACTIVE UNITS", cx, cy + 10);

					requestAnimationFrame(stepRing);
				}

				// ==========================================
				// 3. DISTURBANCE & ROBUSTNESS TEST
				// ==========================================
				const btnShake = document.getElementById("btn-shake-test");
				const size12Btn = document.getElementById("size-btn-12");
				const size24Btn = document.getElementById("size-btn-24");
				const size37Btn = document.getElementById("size-btn-37");

				const statRecoveryTime = document.getElementById("stat-recovery-time");
				const statRecoveryDesc = document.getElementById("stat-recovery-desc");
				const statPostR = document.getElementById("stat-post-r");
				const statPostDesc = document.getElementById("stat-post-desc");

				function setLatticeSize(size) {
					activeUnitCount = size;
					// Update button styles
					[size12Btn, size24Btn, size37Btn].forEach(b => {
						if (b) {
							b.className = "px-2.5 py-1 rounded-lg text-slate-400 hover:text-white transition active:scale-95 cursor-pointer";
						}
					});
					const activeBtn = size === 12 ? size12Btn : size === 24 ? size24Btn : size37Btn;
					if (activeBtn) {
						activeBtn.className = "px-2.5 py-1 rounded-lg bg-fuchsia-600 text-white font-bold transition active:scale-95 cursor-pointer";
					}

					// Update stats for the size
					if (size === 12) {
						if (statRecoveryTime) statRecoveryTime.textContent = "1.85 s";
						if (statRecoveryDesc) {
							statRecoveryDesc.innerHTML = `<span class="lang-zh">12 单元：边界损耗大，恢复滞后</span><span class="lang-en">12 units: High boundary loss, sluggish</span>`;
						}
						if (statPostR) statPostR.textContent = "84.2%";
						if (statPostDesc) {
							statPostDesc.innerHTML = `<span class="lang-zh">受限于边界噪声，同拍度不完全</span><span class="lang-en">Edge noise limits complete synchrony</span>`;
						}
					} else if (size === 24) {
						if (statRecoveryTime) statRecoveryTime.textContent = "1.15 s";
						if (statRecoveryDesc) {
							statRecoveryDesc.innerHTML = `<span class="lang-zh">24 单元：中等尺度平稳恢复</span><span class="lang-en">24 units: Moderate steady healing</span>`;
						}
						if (statPostR) statPostR.textContent = "93.6%";
						if (statPostDesc) {
							statPostDesc.innerHTML = `<span class="lang-zh">较强体态粗化，接近全局锁定</span><span class="lang-en">Strong bulk coarsening, near lock</span>`;
						}
					} else {
						if (statRecoveryTime) statRecoveryTime.textContent = "0.82 s";
						if (statRecoveryDesc) {
							statRecoveryDesc.innerHTML = `<span class="lang-zh">37 单元：强波粗化瞬时愈合</span><span class="lang-en">37 units: Rapid bulk healing</span>`;
						}
						if (statPostR) statPostR.textContent = "98.8%";
						if (statPostDesc) {
							statPostDesc.innerHTML = `<span class="lang-zh">完全恢复至全局时间晶体</span><span class="lang-en">Full return to time crystal</span>`;
						}
					}
				}

				if (size12Btn) size12Btn.addEventListener("click", () => setLatticeSize(12), { signal: lifecycle.signal });
				if (size24Btn) size24Btn.addEventListener("click", () => setLatticeSize(24), { signal: lifecycle.signal });
				if (size37Btn) size37Btn.addEventListener("click", () => setLatticeSize(37), { signal: lifecycle.signal });

				if (btnShake) {
					btnShake.addEventListener("click", () => {
						// Randomize ALL phases in current lattice
						for (let i = 0; i < activeUnitCount; i++) {
							phases[i] = (phases[i] + (Math.random() - 0.5) * Math.PI * 2.5) % (Math.PI * 2);
						}
						// Dip R history
						const dipVal = activeUnitCount === 12 ? 0.22 : activeUnitCount === 24 ? 0.31 : 0.38;
						rHistory[rHistory.length - 1] = dipVal;
						rHistory[rHistory.length - 2] = dipVal + 0.05;

						if (alertBanner) {
							alertBanner.style.opacity = "1";
							setTimeout(() => { alertBanner.style.opacity = "0"; }, 2500);
						}
					}, { signal: lifecycle.signal });
				}

				// ==========================================
				// 4. NONRECIPROCAL A-B INTERACTIVE DIAGRAM
				// ==========================================
				const diaBtnRec = document.getElementById("dia-btn-rec");
				const diaBtnNonrec = document.getElementById("dia-btn-nonrec");
				const diaLabelAb = document.getElementById("dia-label-ab");
				const diaLabelBa = document.getElementById("dia-label-ba");
				const diaArrowBa = document.getElementById("dia-arrow-ba");
				const diaExplanation = document.getElementById("dia-explanation-text");

				function setDiagramMode(mode) {
					if (mode === "reciprocal") {
						diaBtnRec.className = "py-1 px-3 rounded-lg bg-indigo-600 text-white font-bold transition active:scale-95 cursor-pointer";
						diaBtnNonrec.className = "py-1 px-3 rounded-lg border border-slate-700 text-slate-400 hover:text-white transition active:scale-95 cursor-pointer";

						if (diaLabelAb) diaLabelAb.textContent = "F_A→B = +1.0 (Action)";
						if (diaLabelBa) {
							diaLabelBa.textContent = "F_B→A = -1.0 (Equal Reaction)";
							diaLabelBa.setAttribute("fill", "#06b6d4");
						}
						if (diaArrowBa) {
							diaArrowBa.setAttribute("stroke-width", "4");
							diaArrowBa.setAttribute("stroke", "#06b6d4");
							diaArrowBa.setAttribute("marker-end", "url(#arrow-cyan)");
						}
						if (diaExplanation) {
							diaExplanation.innerHTML = `<span class="lang-zh">当前状态：<strong>经典牛顿互易 (Reciprocal)</strong> — 作用力与反作用力大小相等、方向相反。能量守恒，无内生自驱力，系统在阻尼下迅速归于死寂。</span><span class="lang-en">Current: <strong>Newtonian Reciprocal</strong> — Action equals reaction. Energy is conserved; oscillations decay into quiet thermodynamic equilibrium.</span>`;
						}
					} else {
						diaBtnNonrec.className = "py-1 px-3 rounded-lg bg-indigo-600 text-white font-bold transition active:scale-95 cursor-pointer";
						diaBtnRec.className = "py-1 px-3 rounded-lg border border-slate-700 text-slate-400 hover:text-white transition active:scale-95 cursor-pointer";

						if (diaLabelAb) diaLabelAb.textContent = "F_A→B = +1.0 (Strong Push)";
						if (diaLabelBa) {
							diaLabelBa.textContent = "F_B→A = +0.1 (Asymmetric Drag)";
							diaLabelBa.setAttribute("fill", "#fb7185");
						}
						if (diaArrowBa) {
							diaArrowBa.setAttribute("stroke-width", "2");
							diaArrowBa.setAttribute("stroke", "#f43f5e");
							diaArrowBa.setAttribute("marker-end", "url(#arrow-rose)");
						}
						if (diaExplanation) {
							diaExplanation.innerHTML = `<span class="lang-zh">当前状态：<strong>机电非互易 (Nonreciprocal)</strong> — 单元 A 测得位移后对 B 施加全力推搡，而 B 对 A 仅反馈微弱阻尼甚至同向推力。系统净做功大于零，循环驱动空间行波与模式粗化。</span><span class="lang-en">Current: <strong>Active Nonreciprocal</strong> — Cell A senses position and forcefully drives B, while B feeds back negligible resistance. The closed loop performs net positive work, driving traveling wave cascades.</span>`;
						}
					}
				}

				if (diaBtnRec) diaBtnRec.addEventListener("click", () => setDiagramMode("reciprocal"), { signal: lifecycle.signal });
				if (diaBtnNonrec) diaBtnNonrec.addEventListener("click", () => setDiagramMode("nonreciprocal"), { signal: lifecycle.signal });

				// Resize handler for crisp Canvas resolution
				function resizeCanvases() {
					const dpr = window.devicePixelRatio || 1;
					if (canvas) {
						const rect = canvas.getBoundingClientRect();
						canvas.width = Math.round(rect.width * dpr);
						canvas.height = Math.round(rect.height * dpr);
					}
					if (sparkCanvas) {
						const rect = sparkCanvas.getBoundingClientRect();
						sparkCanvas.width = Math.round(rect.width * dpr);
						sparkCanvas.height = Math.round(rect.height * dpr);
					}
					if (ringCanvas) {
						const rect = ringCanvas.getBoundingClientRect();
						ringCanvas.width = Math.round(rect.width * dpr);
						ringCanvas.height = Math.round(rect.height * dpr);
					}
				}

				window.addEventListener("resize", resizeCanvases, { signal: lifecycle.signal });
				resizeCanvases();

				// Start animation loops
				requestAnimationFrame(stepHoneycomb);
				requestAnimationFrame(stepRing);
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initOneBeat);
			} else {
				initOneBeat();
			}
			document.addEventListener("astro:page-load", initOneBeat);
		})();
	</script>
</MainGridLayout>
