	<script is:inline>
		// ==========================================
		// Heilbronn Problem Interactive Engine
		// Vanilla JavaScript (No TypeScript-only syntax in client bundle)
		// ==========================================

		// Benchmark values for unit square
		const BENCHMARK_MAP = {
			3: { val: 0.5000, tag: "严格最优 Δ", proven: true },
			4: { val: 0.5000, tag: "严格最优 Δ", proven: true },
			5: { val: 0.1925, tag: "严格最优 Δ", proven: true },
			6: { val: 0.1250, tag: "严格最优 Δ", proven: true },
			7: { val: 0.0839, tag: "严格最优 Δ", proven: true },
			8: { val: 0.0724, tag: "严格最优 Δ", proven: true },
			9: { val: 0.0549, tag: "严格最优 Δ (2026)", proven: true },
			10: { val: 0.0465, tag: "搜索纪录", proven: false },
			11: { val: 0.0381, tag: "搜索纪录", proven: false },
			12: { val: 0.0336, tag: "搜索纪录", proven: false },
			13: { val: 0.0292, tag: "搜索纪录", proven: false },
			14: { val: 0.0261, tag: "搜索纪录", proven: false },
			15: { val: 0.0233, tag: "搜索纪录", proven: false },
			16: { val: 0.0210, tag: "搜索纪录", proven: false }
		};

		// Lifecycle state
		let activeAnimFrameId = null;
		let activeResizeObserver = null;

		function initPlayground() {
			// Cleanup previous instances if navigating via astro:page-load
			if (activeAnimFrameId) {
				cancelAnimationFrame(activeAnimFrameId);
				activeAnimFrameId = null;
			}
			if (activeResizeObserver) {
				activeResizeObserver.disconnect();
				activeResizeObserver = null;
			}

			// DOM Elements
			const canvas = document.getElementById("heilbronn-canvas");
			if (!canvas) return;
			const ctx = canvas.getContext("2d");
			if (!ctx) return;

			const statMinArea = document.getElementById("stat-min-area");
			const statSessionBest = document.getElementById("stat-session-best");
			const statTotalTriangles = document.getElementById("stat-total-triangles");
			const statKnownBest = document.getElementById("stat-known-best");
			const statKnownTag = document.getElementById("stat-known-tag");
			const statusIndicator = document.getElementById("status-indicator");

			const sliderN = document.getElementById("slider-n");
			const labelN = document.getElementById("label-n");
			const calcCombText = document.getElementById("calc-comb-text");

			const btnRandom = document.getElementById("btn-random");
			const btnReset = document.getElementById("btn-reset");
			const btnAnneal = document.getElementById("btn-anneal");
			const btnLoadBest = document.getElementById("btn-load-best");
			const annealBtnText = document.getElementById("anneal-btn-text");
			const annealIcon = document.getElementById("anneal-icon");
			const annealLiveDot = document.getElementById("anneal-live-dot");
			const annealRateText = document.getElementById("anneal-rate-text");
			const annealStepsCounter = document.getElementById("anneal-steps-counter");

			// Playground State
			let currentN = parseInt(sliderN ? sliderN.value : "8", 10) || 8;
			let points = []; // Array of { u, v } in [0, 1]
			let sessionBestPerN = {}; // Track best area per N
			let sessionBestPointsPerN = {}; // Track best layout per N

			let isAnnealing = false;
			let annealStepCount = 0;
			let lastAnnealAttemptTime = 0;
			const ANNEAL_INTERVAL_MS = 1000 / 30; // ~30 moves per second

			// Interaction State
			let draggingIndex = -1;
			let hoveredIndex = -1;

			// Combinations calculation C(n, 3)
			function combinations3(n) {
				if (n < 3) return 0;
				return (n * (n - 1) * (n - 2)) / 6;
			}

			// Generate points evenly spaced on a circle inside unit square
			function generateCircularPoints(count) {
				const pts = [];
				const cx = 0.5;
				const cy = 0.5;
				const r = 0.38; // Inscribed circle margin
				for (let i = 0; i < count; i++) {
					const angle = (i * 2 * Math.PI) / count - Math.PI / 2;
					pts.push({
						u: Math.max(0.01, Math.min(0.99, cx + r * Math.cos(angle))),
						v: Math.max(0.01, Math.min(0.99, cy + r * Math.sin(angle)))
					});
				}
				return pts;
			}

			// Generate randomized points inside unit square
			function generateRandomPoints(count) {
				const pts = [];
				for (let i = 0; i < count; i++) {
					pts.push({
						u: 0.05 + Math.random() * 0.9,
						v: 0.05 + Math.random() * 0.9
					});
				}
				return pts;
			}

			// Initialize points
			points = generateCircularPoints(currentN);

			// Triangle area formula from 3 normalized coordinates
			function calcTriangleArea(p1, p2, p3) {
				return 0.5 * Math.abs((p2.u - p1.u) * (p3.v - p1.v) - (p3.u - p1.u) * (p2.v - p1.v));
			}

			// Full evaluation: find minimum area and all minimal triangles
			function evaluateLayout(pts) {
				const n = pts.length;
				if (n < 3) return { minArea: 0, minTriangles: [], totalCount: 0 };

				let minArea = Infinity;
				const triangles = [];

				for (let i = 0; i < n - 2; i++) {
					for (let j = i + 1; j < n - 1; j++) {
						for (let k = j + 1; k < n; k++) {
							const area = calcTriangleArea(pts[i], pts[j], pts[k]);
							if (area < minArea) {
								minArea = area;
							}
							triangles.push({ i, j, k, area });
						}
					}
				}

				// Find ties within epsilon
				const epsilon = 1e-5;
				const minTriangles = [];
				for (let t = 0; t < triangles.length; t++) {
					if (Math.abs(triangles[t].area - minArea) <= epsilon) {
						minTriangles.push(triangles[t]);
					}
				}

				return {
					minArea: minArea,
					minTriangles: minTriangles,
					totalCount: triangles.length
				};
			}

			// Fast minArea evaluation for annealing step
			function evaluateMinAreaOnly(pts) {
				const n = pts.length;
				if (n < 3) return 0;
				let minA = Infinity;
				for (let i = 0; i < n - 2; i++) {
					for (let j = i + 1; j < n - 1; j++) {
						for (let k = j + 1; k < n; k++) {
							const a = 0.5 * Math.abs((pts[j].u - pts[i].u) * (pts[k].v - pts[i].v) - (pts[k].u - pts[i].u) * (pts[j].v - pts[i].v));
							if (a < minA) {
								minA = a;
							}
						}
					}
				}
				return minA;
			}

			// Record session best for current N
			function updateSessionBest(area) {
				const currentBest = sessionBestPerN[currentN] || 0;
				if (area > currentBest) {
					sessionBestPerN[currentN] = area;
					sessionBestPointsPerN[currentN] = points.map(function(p) { return { u: p.u, v: p.v }; });
				}
			}

			// Initial evaluation
			const initialEval = evaluateLayout(points);
			updateSessionBest(initialEval.minArea);

			// Update DOM metrics
			function updateMetricsUI(evalResult) {
				const minArea = evalResult.minArea;
				if (statMinArea) statMinArea.textContent = minArea.toFixed(4);

				const bestForThisN = sessionBestPerN[currentN] || minArea;
				if (statSessionBest) statSessionBest.textContent = bestForThisN.toFixed(4);

				const totalComb = combinations3(currentN);
				if (statTotalTriangles) statTotalTriangles.textContent = String(totalComb);
				if (calcCombText) calcCombText.textContent = totalComb + " 个三元组";

				const bench = BENCHMARK_MAP[currentN];
				if (bench) {
					if (statKnownBest) statKnownBest.textContent = bench.val.toFixed(4);
					if (statKnownTag) {
						statKnownTag.textContent = bench.tag;
						statKnownTag.className = bench.proven
							? "text-[10px] px-1.5 py-0.5 rounded bg-emerald-950/60 border border-emerald-800 text-emerald-300"
							: "text-[10px] px-1.5 py-0.5 rounded bg-amber-950/60 border border-amber-800 text-amber-300";
					}
				}
			}

			// Update Annealing UI
			function updateAnnealingButtonState() {
				if (!btnAnneal || !annealBtnText || !annealIcon || !annealLiveDot || !annealRateText) return;
				if (isAnnealing) {
					btnAnneal.className = "w-full py-3.5 px-4 rounded-xl bg-amber-600 hover:bg-amber-500 active:scale-95 text-white font-mono font-bold text-sm tracking-wide shadow-[0_0_20px_rgba(217,119,6,0.6)] transition flex items-center justify-center gap-2.5 animate-pulse";
					annealBtnText.textContent = "停止优化 (Pause Annealing)";
					annealIcon.textContent = "⏸️";
					annealLiveDot.className = "w-2 h-2 rounded-full bg-emerald-400 animate-ping";
					annealRateText.textContent = "正在模拟退火搜索中 (~30 步/秒)";
					if (statusIndicator) {
						statusIndicator.textContent = "ANNEALING SEARCHING";
						statusIndicator.className = "text-[11px] font-mono text-amber-400 bg-amber-950/60 px-2.5 py-0.5 rounded border border-amber-900/80";
					}
				} else {
					btnAnneal.className = "w-full py-3.5 px-4 rounded-xl bg-red-600 hover:bg-red-500 active:scale-95 text-white font-mono font-bold text-sm tracking-wide shadow-[0_0_20px_rgba(239,68,68,0.4)] transition flex items-center justify-center gap-2.5";
					annealBtnText.textContent = "退火优化 (Simulated Annealing)";
					annealIcon.textContent = "🔥";
					annealLiveDot.className = "w-2 h-2 rounded-full bg-zinc-500";
					annealRateText.textContent = "退火引擎已就绪 (~30 步/秒)";
					if (statusIndicator) {
						statusIndicator.textContent = "INTERACTIVE READY";
						statusIndicator.className = "text-[11px] font-mono text-red-400/80 bg-red-950/40 px-2.5 py-0.5 rounded border border-red-900/50";
					}
				}
			}

			// Resize canvas buffer crisp on retina
			let canvasDisplayWidth = 400;
			function resizeCanvas() {
				const rect = canvas.getBoundingClientRect();
				const dpr = window.devicePixelRatio || 1;
				const displaySize = Math.max(300, Math.floor(rect.width));
				canvasDisplayWidth = displaySize;

				if (canvas.width !== Math.round(displaySize * dpr) || canvas.height !== Math.round(displaySize * dpr)) {
					canvas.width = Math.round(displaySize * dpr);
					canvas.height = Math.round(displaySize * dpr);
				}
			}

			resizeCanvas();
			activeResizeObserver = new ResizeObserver(function() {
				resizeCanvas();
			});
			activeResizeObserver.observe(canvas.parentElement || canvas);

			// Render canvas frame
			function render(timestamp) {
				const dpr = window.devicePixelRatio || 1;
				ctx.save();
				ctx.scale(dpr, dpr);

				const width = canvasDisplayWidth;
				const height = canvasDisplayWidth;
				ctx.clearRect(0, 0, width, height);

				// Canvas background
				ctx.fillStyle = "#070b12";
				ctx.fillRect(0, 0, width, height);

				// Unit square bounds inside canvas (with padding for points)
				const padding = Math.max(24, Math.round(width * 0.08));
				const sqSize = width - 2 * padding;

				// Unit square background fill
				ctx.fillStyle = "#0c111a";
				ctx.fillRect(padding, padding, sqSize, sqSize);

				// Subtle dot grid inside unit square
				ctx.fillStyle = "rgba(255, 255, 255, 0.07)";
				const gridStep = sqSize / 10;
				for (let gx = 1; gx < 10; gx++) {
					for (let gy = 1; gy < 10; gy++) {
						ctx.beginPath();
						ctx.arc(padding + gx * gridStep, padding + gy * gridStep, 1.2, 0, Math.PI * 2);
						ctx.fill();
					}
				}

				// Unit square boundary border
				ctx.strokeStyle = "#27272a";
				ctx.lineWidth = 1.5;
				ctx.strokeRect(padding, padding, sqSize, sqSize);

				// Corner labels
				ctx.fillStyle = "#52525b";
				ctx.font = "9px ui-monospace, SFMono-Regular, monospace";
				ctx.textBaseline = "middle";
				ctx.textAlign = "right";
				ctx.fillText("(0,0)", padding - 6, padding);
				ctx.fillText("(0,1)", padding - 6, padding + sqSize);
				ctx.textAlign = "left";
				ctx.fillText("(1,0)", padding + sqSize + 6, padding);
				ctx.fillText("(1,1)", padding + sqSize + 6, padding + sqSize);

				// Compute evaluation
				const evalResult = evaluateLayout(points);
				updateSessionBest(evalResult.minArea);

				// Pulse animation factor for smallest triangle
				const now = timestamp || performance.now();
				const pulse = Math.sin(now * 0.005);
				const fillAlpha = 0.28 + 0.14 * pulse; // 0.14 ~ 0.42
				const strokeAlpha = 0.75 + 0.25 * pulse;

				// Track minimal triangle vertices for highlight
				const minimalVertexSet = {};

				// Draw all smallest triangle(s)
				if (evalResult.minTriangles.length > 0) {
					for (let m = 0; m < evalResult.minTriangles.length; m++) {
						const tri = evalResult.minTriangles[m];
						const p1 = points[tri.i];
						const p2 = points[tri.j];
						const p3 = points[tri.k];

						minimalVertexSet[tri.i] = true;
						minimalVertexSet[tri.j] = true;
						minimalVertexSet[tri.k] = true;

						const x1 = padding + p1.u * sqSize;
						const y1 = padding + p1.v * sqSize;
						const x2 = padding + p2.u * sqSize;
						const y2 = padding + p2.v * sqSize;
						const x3 = padding + p3.u * sqSize;
						const y3 = padding + p3.v * sqSize;

						// Fill
						ctx.beginPath();
						ctx.moveTo(x1, y1);
						ctx.lineTo(x2, y2);
						ctx.lineTo(x3, y3);
						ctx.closePath();
						ctx.fillStyle = "rgba(239, 68, 68, " + fillAlpha + ")";
						ctx.fill();

						// Stroke
						ctx.lineWidth = 2.5;
						ctx.lineJoin = "round";
						ctx.strokeStyle = "rgba(239, 68, 68, " + strokeAlpha + ")";
						ctx.stroke();

						// Centroid callout badge on the primary smallest triangle
						if (m === 0) {
							const cx = (x1 + x2 + x3) / 3;
							const cy = (y1 + y2 + y3) / 3;
							const badgeText = "min S = " + evalResult.minArea.toFixed(4);

							ctx.font = "bold 10px ui-monospace, SFMono-Regular, monospace";
							const textW = ctx.measureText(badgeText).width;
							const badgeW = textW + 12;
							const badgeH = 18;
							const badgeX = Math.max(padding + 2, Math.min(padding + sqSize - badgeW - 2, cx - badgeW / 2));
							const badgeY = Math.max(padding + 2, Math.min(padding + sqSize - badgeH - 2, cy - badgeH / 2));

							ctx.fillStyle = "rgba(10, 14, 23, 0.9)";
							ctx.strokeStyle = "rgba(239, 68, 68, 0.8)";
							ctx.lineWidth = 1;
							ctx.beginPath();
							ctx.roundRect ? ctx.roundRect(badgeX, badgeY, badgeW, badgeH, 4) : ctx.rect(badgeX, badgeY, badgeW, badgeH);
							ctx.fill();
							ctx.stroke();

							ctx.fillStyle = "#ffffff";
							ctx.textAlign = "center";
							ctx.textBaseline = "middle";
							ctx.fillText(badgeText, badgeX + badgeW / 2, badgeY + badgeH / 2);
						}
					}
				}

				// Draw all points
				for (let i = 0; i < points.length; i++) {
					const px = padding + points[i].u * sqSize;
					const py = padding + points[i].v * sqSize;
					const isMinimal = minimalVertexSet[i] === true;
					const isDragged = draggingIndex === i;
					const isHovered = hoveredIndex === i;

					if (isMinimal) {
						// Bottleneck vertex: Red glow & ring
						ctx.fillStyle = "rgba(239, 68, 68, " + (0.3 + 0.15 * pulse) + ")";
						ctx.beginPath();
						ctx.arc(px, py, 12, 0, Math.PI * 2);
						ctx.fill();

						ctx.fillStyle = "#ef4444";
						ctx.beginPath();
						ctx.arc(px, py, 5.5, 0, Math.PI * 2);
						ctx.fill();

						ctx.fillStyle = "#ffffff";
						ctx.beginPath();
						ctx.arc(px, py, 2, 0, Math.PI * 2);
						ctx.fill();
					} else {
						// Other points: small dots as requested
						ctx.fillStyle = "rgba(255, 255, 255, 0.15)";
						ctx.beginPath();
						ctx.arc(px, py, 6.5, 0, Math.PI * 2);
						ctx.fill();

						ctx.fillStyle = "#d4d4d8";
						ctx.beginPath();
						ctx.arc(px, py, 4, 0, Math.PI * 2);
						ctx.fill();

						ctx.fillStyle = "#18181b";
						ctx.beginPath();
						ctx.arc(px, py, 1.5, 0, Math.PI * 2);
						ctx.fill();
					}

					// Active drag/hover focus ring
					if (isDragged || isHovered) {
						ctx.strokeStyle = "#ffffff";
						ctx.lineWidth = 2;
						ctx.beginPath();
						ctx.arc(px, py, 14, 0, Math.PI * 2);
						ctx.stroke();

						// Coordinate tooltip above point
						ctx.fillStyle = "#ffffff";
						ctx.font = "9px ui-monospace, SFMono-Regular, monospace";
						ctx.textAlign = "center";
						ctx.textBaseline = "bottom";
						ctx.fillText("P" + (i + 1) + " (" + points[i].u.toFixed(2) + ", " + points[i].v.toFixed(2) + ")", px, py - 16);
					}
				}

				ctx.restore();

				// Update live numbers in DOM
				updateMetricsUI(evalResult);
			}

			// Simulated annealing step
			function annealStep(timestamp) {
				if (!isAnnealing) return;

				if (timestamp - lastAnnealAttemptTime >= ANNEAL_INTERVAL_MS) {
					lastAnnealAttemptTime = timestamp;

					// Current min area
					const currentMinArea = evaluateMinAreaOnly(points);

					// 1. Pick random point
					const idx = Math.floor(Math.random() * points.length);
					const oldU = points[idx].u;
					const oldV = points[idx].v;

					// 2. Jitter position by small amount
					const jitterRadius = 0.045;
					const du = (Math.random() * 2 - 1) * jitterRadius;
					const dv = (Math.random() * 2 - 1) * jitterRadius;
					points[idx].u = Math.max(0.01, Math.min(0.99, oldU + du));
					points[idx].v = Math.max(0.01, Math.min(0.99, oldV + dv));

					// 3. Evaluate new min area
					const newMinArea = evaluateMinAreaOnly(points);

					// 4. Accept if improved, or with ~5% probability if worsening
					if (newMinArea > currentMinArea) {
						// Keep improvement!
						annealStepCount++;
					} else if (Math.random() < 0.05) {
						// Keep worsening change to escape local minimum
						annealStepCount++;
					} else {
						// Revert change
						points[idx].u = oldU;
						points[idx].v = oldV;
					}

					if (annealStepsCounter) {
						annealStepsCounter.textContent = annealStepCount + " 次尝试";
					}
				}
			}

			// Main continuous animation loop
			function animationLoop(timestamp) {
				if (isAnnealing) {
					annealStep(timestamp);
				}
				render(timestamp);
				activeAnimFrameId = requestAnimationFrame(animationLoop);
			}

			// Start loop
			activeAnimFrameId = requestAnimationFrame(animationLoop);

			// ==========================================
			// Event Listeners & Interaction
			// ==========================================

			// Coordinate conversion helpers
			function getPointerCanvasPos(e) {
				const rect = canvas.getBoundingClientRect();
				const x = e.clientX - rect.left;
				const y = e.clientY - rect.top;
				return { x: x, y: y };
			}

			function canvasToUnit(x, y) {
				const padding = Math.max(24, Math.round(canvasDisplayWidth * 0.08));
				const sqSize = canvasDisplayWidth - 2 * padding;
				const u = Math.max(0.005, Math.min(0.995, (x - padding) / sqSize));
				const v = Math.max(0.005, Math.min(0.995, (y - padding) / sqSize));
				return { u: u, v: v };
			}

			function findPointNear(x, y, radius) {
				const padding = Math.max(24, Math.round(canvasDisplayWidth * 0.08));
				const sqSize = canvasDisplayWidth - 2 * padding;
				let foundIdx = -1;
				let minD = radius;

				for (let i = 0; i < points.length; i++) {
					const px = padding + points[i].u * sqSize;
					const py = padding + points[i].v * sqSize;
					const d = Math.hypot(px - x, py - y);
					if (d < minD) {
						minD = d;
						foundIdx = i;
					}
				}
				return foundIdx;
			}

			// Pointer Down
			canvas.addEventListener("pointerdown", function(e) {
				const pos = getPointerCanvasPos(e);
				const hitIdx = findPointNear(pos.x, pos.y, 20);

				if (hitIdx !== -1) {
					draggingIndex = hitIdx;
					canvas.setPointerCapture(e.pointerId);
					const uv = canvasToUnit(pos.x, pos.y);
					points[draggingIndex].u = uv.u;
					points[draggingIndex].v = uv.v;
				}
			});

			// Pointer Move
			canvas.addEventListener("pointermove", function(e) {
				const pos = getPointerCanvasPos(e);

				if (draggingIndex !== -1) {
					const uv = canvasToUnit(pos.x, pos.y);
					points[draggingIndex].u = uv.u;
					points[draggingIndex].v = uv.v;
				} else {
					const hitIdx = findPointNear(pos.x, pos.y, 16);
					hoveredIndex = hitIdx;
					canvas.style.cursor = hitIdx !== -1 ? "grab" : "crosshair";
				}
			});

			// Pointer Up / Cancel
			function onPointerUp(e) {
				if (draggingIndex !== -1) {
					try {
						canvas.releasePointerCapture(e.pointerId);
					} catch (_err) {}
					draggingIndex = -1;
				}
			}

			canvas.addEventListener("pointerup", onPointerUp);
			canvas.addEventListener("pointercancel", onPointerUp);

			// Slider N Change
			if (sliderN) {
				sliderN.addEventListener("input", function() {
					const newN = parseInt(sliderN.value, 10);
					if (newN === currentN) return;
					currentN = newN;
					if (labelN) labelN.textContent = String(currentN);

					// Stop annealing when N changes
					if (isAnnealing) {
						isAnnealing = false;
						updateAnnealingButtonState();
					}

					// If session best already exists for new N, restore it; otherwise circular
					if (sessionBestPointsPerN[currentN]) {
						points = sessionBestPointsPerN[currentN].map(function(p) { return { u: p.u, v: p.v }; });
					} else {
						points = generateCircularPoints(currentN);
					}
				});
			}

			// Randomize Points Button
			if (btnRandom) {
				btnRandom.addEventListener("click", function() {
					points = generateRandomPoints(currentN);
				});
			}

			// Reset Circular Button
			if (btnReset) {
				btnReset.addEventListener("click", function() {
					points = generateCircularPoints(currentN);
				});
			}

			// Anneal Toggle Button
			if (btnAnneal) {
				btnAnneal.addEventListener("click", function() {
					isAnnealing = !isAnnealing;
					updateAnnealingButtonState();
				});
			}

			// Restore Best Button
			if (btnLoadBest) {
				btnLoadBest.addEventListener("click", function() {
					const bestPts = sessionBestPointsPerN[currentN];
					if (bestPts && bestPts.length === currentN) {
						points = bestPts.map(function(p) { return { u: p.u, v: p.v }; });
						btnLoadBest.textContent = "已恢复最优 ✓";
						setTimeout(function() {
							btnLoadBest.textContent = "⭐ 载入会话最优";
						}, 1500);
					} else {
						btnLoadBest.textContent = "当前已是最优";
						setTimeout(function() {
							btnLoadBest.textContent = "⭐ 载入会话最优";
						}, 1200);
					}
				});
			}
		}

		// Initial start and Astro page transition support
		initPlayground();
		document.addEventListener("astro:page-load", initPlayground);
	</script>
</MainGridLayout>
