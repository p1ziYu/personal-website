---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "最小的三角形 · Heilbronn 问题游乐场";
const description =
	"在正方形里放 n 个点，怎么放才能让任意三点组成的三角形都不太“瘦”？1950 年 Hans Heilbronn 极值几何问题交互式模拟、实时退火算法优化与已知世界纪录。";
---

<MainGridLayout title={title} description={description}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mb-8">
		<div class="z-10 px-5 sm:px-9 py-8 relative w-full rounded-(--radius-large) overflow-hidden bg-[#0a0e17] text-zinc-100 border border-zinc-800/80 shadow-2xl selection:bg-red-500/30 selection:text-red-200">
			<!-- Background Ambient Glow & Grid -->
			<div class="absolute inset-0 pointer-events-none opacity-20 bg-[radial-gradient(#ef4444_1px,transparent_1px)] [background-size:24px_24px] overflow-hidden"></div>
			<div class="absolute -top-32 -left-32 w-80 h-80 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute top-1/2 -right-32 w-80 h-80 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>

			<!-- HERO SECTION -->
			<section class="relative z-10 mb-10 pb-8 border-b border-zinc-800/80">
				<div class="flex flex-wrap items-center justify-between gap-4 mb-3">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-mono font-medium tracking-wide">
						<span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
						EXTREMAL GEOMETRY · HEILBRONN PROBLEM
					</div>
					<div class="text-xs font-mono text-zinc-300">
						HN 热议 · 2026-10-04
					</div>
				</div>

				<h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-3">
					最小的三角形
				</h1>
				<p class="text-lg sm:text-xl font-medium text-red-400/90 mb-4 tracking-wide font-mono">
					Heilbronn 问题 · 点的布局游乐场
				</p>
				<p class="text-sm sm:text-base text-zinc-300/80 max-w-3xl leading-relaxed mb-8">
					在正方形里放 n 个点，怎么放才能让任意三点组成的三角形都不太"瘦"？1950 年 Hans Heilbronn 提出的问题：最大化所有三点组合中面积最小的那个三角形。n 增大时答案以什么速度衰减，至今仍是未解之谜。
				</p>

				<!-- Stats Dashboard Display -->
				<div class="rounded-2xl bg-black/80 border border-zinc-800 p-5 sm:p-7 shadow-inner relative overflow-hidden">
					<div class="flex flex-wrap items-center justify-between gap-2 mb-4">
						<div class="flex items-center gap-2">
							<span class="text-xs font-mono uppercase tracking-widest text-zinc-300">
								实时几何指标 · REAL-TIME TRIANGLE METRICS
							</span>
						</div>
						<div id="status-indicator" class="text-[11px] font-mono text-red-400/80 bg-red-950/40 px-2.5 py-0.5 rounded border border-red-900/50">
							INTERACTIVE READY
						</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-6 text-center max-w-3xl mx-auto">
						<!-- STAT 1: Current Min Area -->
						<div class="flex flex-col items-center justify-center bg-zinc-950/90 rounded-xl p-3 sm:p-5 border border-zinc-800/80 shadow-[inset_0_2px_4px_rgba(0,0,0,0.8)]">
							<div id="stat-min-area" class="stat-digit font-mono text-3xl sm:text-4xl font-black text-red-500 drop-shadow-[0_0_12px_rgba(239,68,68,0.7)]">
								0.0000
							</div>
							<span class="mt-2 text-xs font-mono text-zinc-300">当前最小三角形面积</span>
							<span class="text-[10px] font-mono text-zinc-400">min Area(Δ)</span>
						</div>

						<!-- STAT 2: Session Best -->
						<div class="flex flex-col items-center justify-center bg-zinc-950/90 rounded-xl p-3 sm:p-5 border border-zinc-800/80 shadow-[inset_0_2px_4px_rgba(0,0,0,0.8)]">
							<div id="stat-session-best" class="stat-digit font-mono text-3xl sm:text-4xl font-black text-emerald-400 drop-shadow-[0_0_12px_rgba(52,211,153,0.7)]">
								0.0000
							</div>
							<span class="mt-2 text-xs font-mono text-zinc-300">本次会话最优</span>
							<span class="text-[10px] font-mono text-zinc-400">Session Best</span>
						</div>

						<!-- STAT 3: Total Triangles C(n, 3) -->
						<div class="flex flex-col items-center justify-center bg-zinc-950/90 rounded-xl p-3 sm:p-5 border border-zinc-800/80 shadow-[inset_0_2px_4px_rgba(0,0,0,0.8)]">
							<div id="stat-total-triangles" class="stat-digit font-mono text-3xl sm:text-4xl font-black text-white">
								56
							</div>
							<span class="mt-2 text-xs font-mono text-zinc-300">三角形总数</span>
							<span class="text-[10px] font-mono text-zinc-400">C(n, 3) 组合数</span>
						</div>
					</div>

					<!-- Benchmark Comparison Note -->
					<div class="mt-4 pt-3 border-t border-zinc-800/80 flex flex-wrap items-center justify-between text-xs font-mono text-zinc-300 px-2 gap-2">
						<div class="flex items-center gap-2">
							<span class="text-zinc-400">当前点数数学已知最优纪录:</span>
							<span id="stat-known-best" class="text-red-400 font-bold">0.0724</span>
							<span id="stat-known-tag" class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-700 text-zinc-300">已证明最优</span>
						</div>
						<div class="text-[11px] text-zinc-400">
							单位正方形 Area = 1.0000
						</div>
					</div>
				</div>
			</section>

			<!-- INTERACTIVE CANVAS & CONTROLS SECTION -->
			<section class="relative z-10 mb-10 pb-10 border-b border-zinc-800/80">
				<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
					<div>
						<h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2">
							<span class="text-red-500 font-mono text-xl">01/</span> 交互游乐场 (Interactive Arena)
						</h2>
						<p class="text-xs sm:text-sm text-zinc-300 mt-1">
							在单位正方形中自由拖拽点，或启动模拟退火算法让点阵自主寻优。瓶颈最小三角形将以脉冲红光突出显示。
						</p>
					</div>

					<!-- Secondary helpers -->
					<div class="flex flex-wrap gap-2 text-xs font-mono">
						<button id="btn-load-best" class="px-3 py-1.5 rounded-lg bg-zinc-900 border border-zinc-700/80 hover:border-emerald-500/60 hover:text-white transition active:scale-95 text-zinc-300 flex items-center gap-1.5">
							<span>⭐ 载入会话最优</span>
						</button>
					</div>
				</div>

				<!-- Main Playground Layout Grid -->
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
					<!-- Canvas Container (Left / Top) -->
					<div class="lg:col-span-7 flex flex-col items-center">
						<div class="relative w-full max-w-[500px] aspect-square rounded-2xl bg-[#070b12] border border-zinc-800 p-2 sm:p-4 shadow-[0_0_30px_rgba(0,0,0,0.6)] flex items-center justify-center overflow-hidden">
							<!-- Subtle Ambient glow inside canvas card -->
							<div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_center,rgba(239,68,68,0.06)_0,transparent_70%)]"></div>
							
							<canvas
								id="heilbronn-canvas"
								class="w-full h-full block cursor-crosshair touch-none rounded-xl"
							></canvas>
						</div>

						<div class="w-full max-w-[500px] mt-3 px-2 flex items-center justify-between text-xs font-mono text-zinc-300">
							<div class="flex items-center gap-1.5">
								<span class="inline-block w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
								<span>红色高亮：当前瓶颈最小三角形</span>
							</div>
							<div class="text-[11px] text-zinc-400">
								支持鼠标与触屏多点拖拽
							</div>
						</div>
					</div>

					<!-- Controls Deck (Right / Bottom) -->
					<div class="lg:col-span-5 flex flex-col gap-5">
						<!-- Slider Card -->
						<div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800">
							<div class="flex items-center justify-between mb-3">
								<label for="slider-n" class="text-xs font-mono uppercase tracking-wider text-zinc-300 font-semibold">
									点数配置 (Point Count n)
								</label>
								<div class="flex items-center gap-2">
									<span class="text-xs font-mono text-zinc-400">n =</span>
									<span id="label-n" class="font-mono text-xl font-black text-red-400">8</span>
								</div>
							</div>

							<input
								id="slider-n"
								type="range"
								min="3"
								max="16"
								value="8"
								step="1"
								class="w-full h-2 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-red-500"
							/>

							<div class="flex justify-between text-[10px] font-mono text-zinc-400 mt-2">
								<span>n = 3 (初阶)</span>
								<span>n = 8 (推荐)</span>
								<span>n = 16 (组合爆炸)</span>
							</div>

							<div class="mt-4 p-2.5 rounded-xl bg-zinc-900/80 border border-zinc-800 text-[11px] font-mono text-zinc-300 flex justify-between items-center">
								<span>当前组合空间 C(n, 3):</span>
								<span id="calc-comb-text" class="text-white font-bold">56 个三元组</span>
							</div>
						</div>

						<!-- Action Buttons Card -->
						<div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800 flex flex-col gap-3">
							<span class="text-xs font-mono uppercase tracking-wider text-zinc-300 font-semibold mb-1">
								优化与布局动作
							</span>

							<!-- Toggle Annealing Button -->
							<button
								id="btn-anneal"
								class="w-full py-3.5 px-4 rounded-xl bg-red-600 hover:bg-red-500 active:scale-95 text-white font-mono font-bold text-sm tracking-wide shadow-[0_0_20px_rgba(239,68,68,0.4)] transition flex items-center justify-center gap-2.5"
							>
								<span id="anneal-icon" class="text-lg">🔥</span>
								<span id="anneal-btn-text">退火优化 (Simulated Annealing)</span>
							</button>

							<div class="grid grid-cols-2 gap-3 mt-1">
								<!-- Randomize Button -->
								<button
									id="btn-random"
									class="py-2.5 px-3 rounded-xl bg-zinc-900 border border-zinc-700/80 hover:border-red-500/60 hover:text-white transition active:scale-95 text-xs font-mono font-semibold text-zinc-200 flex items-center justify-center gap-1.5"
								>
									<span>🎲 随机撒点</span>
								</button>

								<!-- Reset Circular Button -->
								<button
									id="btn-reset"
									class="py-2.5 px-3 rounded-xl bg-zinc-900 border border-zinc-700/80 hover:border-red-500/60 hover:text-white transition active:scale-95 text-xs font-mono font-semibold text-zinc-200 flex items-center justify-center gap-1.5"
								>
									<span>🔄 重置 (圆周)</span>
								</button>
							</div>

							<!-- Annealing Status Pill -->
							<div id="anneal-status-banner" class="mt-2 p-2.5 rounded-xl bg-zinc-900/50 border border-zinc-800 text-[11px] font-mono text-zinc-400 flex items-center justify-between">
								<span class="flex items-center gap-1.5">
									<span id="anneal-live-dot" class="w-2 h-2 rounded-full bg-zinc-500"></span>
									<span id="anneal-rate-text">退火引擎就绪 (~30 步/秒)</span>
								</span>
								<span id="anneal-steps-counter">0 次尝试</span>
							</div>
						</div>

						<!-- Legend Card -->
						<div class="p-4 rounded-2xl bg-zinc-950/60 border border-zinc-800/80 text-xs font-mono space-y-2 text-zinc-300">
							<div class="text-[11px] uppercase tracking-wider text-zinc-300 font-semibold mb-1">
								图例与交互说明
							</div>
							<div class="flex items-center gap-2">
								<span class="w-3 h-3 rounded-full bg-red-500 border border-white"></span>
								<span>红色顶点：瓶颈最小三角形角点</span>
							</div>
							<div class="flex items-center gap-2">
								<span class="w-2.5 h-2.5 rounded-full bg-zinc-300 border border-zinc-700"></span>
								<span>灰色顶点：普通散点（均可拖拽调整）</span>
							</div>
							<div class="flex items-center gap-2">
								<span class="w-3 h-3 border border-red-500/60 bg-red-500/20"></span>
								<span>红色半透明区：面积最小的瓶颈三角形（若并列则全亮）</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- WHY IS IT SO HARD SECTION -->
			<section class="relative z-10 mb-10 pb-10 border-b border-zinc-800/80">
				<h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2 mb-2">
					<span class="text-red-500 font-mono text-xl">02/</span> 为什么这么难 (Why It's So Hard)
				</h2>
				<p class="text-xs sm:text-sm text-zinc-300 mb-6">
					看似简单的几何摆放，背后是极值几何与组合优化领域的“硬骨头”。
				</p>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<!-- Bullet Card 1 -->
					<div class="bg-zinc-950/70 border border-zinc-800/80 rounded-2xl p-5 flex flex-col justify-between">
						<div>
							<div class="text-red-400 font-mono text-xs font-bold mb-2">挑战 01</div>
							<h3 class="text-base font-bold text-white mb-2">
								组合爆炸 (Combinatorial Explosion)
							</h3>
							<p class="text-xs text-zinc-300/80 leading-relaxed mb-4">
								每帧要检查 <span class="text-red-400 font-mono">C(n, 3)</span> 个三角形；当 n 从 8 增长至 16 时，三角形总数从 56 激增至 560。随着点数增加，需全局比对的三元子集呈现三次幂级数膨胀。
							</p>
						</div>
						<div class="pt-3 border-t border-zinc-800/60 text-[11px] font-mono text-zinc-400">
							瓶颈判定：任意三点接近共线即归零
						</div>
					</div>

					<!-- Bullet Card 2 -->
					<div class="bg-zinc-950/70 border border-zinc-800/80 rounded-2xl p-5 flex flex-col justify-between">
						<div>
							<div class="text-red-400 font-mono text-xs font-bold mb-2">挑战 02</div>
							<h3 class="text-base font-bold text-white mb-2">
								优化景观布满局部最优 (Rough Landscape)
							</h3>
							<p class="text-xs text-zinc-300/80 leading-relaxed mb-4">
								优化景观布满局部最优，贪心很容易卡住；目标函数由 <code class="text-red-300 font-mono">min</code> 算子定义，导数不连续且极度陡峭，微小的局部移动往往导致其他无关三点突变为新的瓶颈。
							</p>
						</div>
						<div class="pt-3 border-t border-zinc-800/60 text-[11px] font-mono text-zinc-400">
							算法机制：以 5% 概率接受劣解跳出陷阱
						</div>
					</div>

					<!-- Bullet Card 3 -->
					<div class="bg-zinc-950/70 border border-zinc-800/80 rounded-2xl p-5 flex flex-col justify-between">
						<div>
							<div class="text-red-400 font-mono text-xs font-bold mb-2">挑战 03</div>
							<h3 class="text-base font-bold text-white mb-2">
								极小已知边界 (Sparse Exact Solutions)
							</h3>
							<p class="text-xs text-zinc-300/80 leading-relaxed mb-4">
								精确最优解只在很小的 n 已知（正方形 n=9 的最优性 2026 年才被证明），更大的 n 全靠计算机搜索不断刷新纪录。理论渐近衰减阶至今仍未被完全闭合。
							</p>
						</div>
						<div class="pt-3 border-t border-zinc-800/60 text-[11px] font-mono text-zinc-400">
							数学前沿：n=9 刚于 2026 得到严格证明
						</div>
					</div>
				</div>
			</section>

			<!-- CREDIT & BENCHMARK SECTION -->
			<section class="relative z-10 mb-8 pb-8">
				<h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2 mb-2">
					<span class="text-red-500 font-mono text-xl">03/</span> 灵感来源与参考纪录 (Credits & Benchmark)
				</h2>
				<p class="text-xs sm:text-sm text-zinc-300 mb-6">
					站在数学家与分布式计算探索者的肩膀上。
				</p>

				<!-- Benchmark Table + External Link Card -->
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<!-- Leaderboard Card -->
					<div class="lg:col-span-2 p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800">
						<div class="text-xs font-mono uppercase tracking-wider text-zinc-300 font-semibold mb-3 flex items-center justify-between">
							<span>单位正方形已知数学最优解一览表 (n = 3 ~ 10)</span>
							<span class="text-red-400 text-[11px]">Δ 标记表示严格证明</span>
						</div>

						<div class="overflow-x-auto">
							<table class="w-full text-xs font-mono text-left">
								<thead>
									<tr class="border-b border-zinc-800 text-zinc-400">
										<th class="py-2 px-3">点数 n</th>
										<th class="py-2 px-3">最小面积 Δ(n)</th>
										<th class="py-2 px-3">状态</th>
										<th class="py-2 px-3">几何构型特征</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-zinc-800/60 text-zinc-300">
									<tr class="hover:bg-zinc-900/50">
										<td class="py-2 px-3 font-bold text-white">n = 3</td>
										<td class="py-2 px-3 text-red-400 font-bold">0.500000</td>
										<td class="py-2 px-3 text-emerald-400">严格最优 Δ</td>
										<td class="py-2 px-3 text-zinc-400">正方形任意 3 个角点</td>
									</tr>
									<tr class="hover:bg-zinc-900/50">
										<td class="py-2 px-3 font-bold text-white">n = 4</td>
										<td class="py-2 px-3 text-red-400 font-bold">0.500000</td>
										<td class="py-2 px-3 text-emerald-400">严格最优 Δ</td>
										<td class="py-2 px-3 text-zinc-400">正方形 4 个角点</td>
									</tr>
									<tr class="hover:bg-zinc-900/50">
										<td class="py-2 px-3 font-bold text-white">n = 5</td>
										<td class="py-2 px-3 text-red-400 font-bold">0.192450</td>
										<td class="py-2 px-3 text-emerald-400">严格最优 Δ</td>
										<td class="py-2 px-3 text-zinc-400">凸五边形变体</td>
									</tr>
									<tr class="hover:bg-zinc-900/50">
										<td class="py-2 px-3 font-bold text-white">n = 6</td>
										<td class="py-2 px-3 text-red-400 font-bold">0.125000</td>
										<td class="py-2 px-3 text-emerald-400">严格最优 Δ</td>
										<td class="py-2 px-3 text-zinc-400">1/8 面积对称布局</td>
									</tr>
									<tr class="hover:bg-zinc-900/50">
										<td class="py-2 px-3 font-bold text-white">n = 7</td>
										<td class="py-2 px-3 text-red-400 font-bold">0.083859</td>
										<td class="py-2 px-3 text-emerald-400">严格最优 Δ</td>
										<td class="py-2 px-3 text-zinc-400">多边界吸附点</td>
									</tr>
									<tr class="hover:bg-zinc-900/50">
										<td class="py-2 px-3 font-bold text-white">n = 8</td>
										<td class="py-2 px-3 text-red-400 font-bold">0.072376</td>
										<td class="py-2 px-3 text-emerald-400">严格最优 Δ</td>
										<td class="py-2 px-3 text-zinc-400">非均匀环形分散</td>
									</tr>
									<tr class="hover:bg-zinc-900/50">
										<td class="py-2 px-3 font-bold text-white">n = 9</td>
										<td class="py-2 px-3 text-red-400 font-bold">0.054876</td>
										<td class="py-2 px-3 text-emerald-400">严格最优 Δ (2026)</td>
										<td class="py-2 px-3 text-zinc-400">2026 最新严格数学证明</td>
									</tr>
									<tr class="hover:bg-zinc-900/50">
										<td class="py-2 px-3 font-bold text-white">n = 10</td>
