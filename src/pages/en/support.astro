---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
---

<MainGridLayout lang="en" title="Support This Site" description="Thank you for visiting p1ziYu’s Space">
	<section class="card-base p-8 sm:p-10">
		<div class="page-heading mb-6">
			<div class="page-icon" aria-hidden="true"><Icon name="material-symbols:favorite-outline" /></div>
			<div><h2>Support This Site</h2><p>Thank you for your support</p></div>
		</div>
		<p class="text-neutral-600 dark:text-neutral-300 leading-7">If you enjoy what you find here, sharing a post or bookmarking the site is a wonderful way to support it.</p>
		<p class="text-sm text-neutral-500 dark:text-neutral-400 mt-4">I haven’t set up a way to accept donations, so there are no payment codes here.</p>
	</section>
</MainGridLayout>
