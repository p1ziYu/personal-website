---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
---

<MainGridLayout title="音乐" description="痞子宇的歌单">
	<section class="card-base p-8 sm:p-10">
		<div class="page-heading mb-6">
			<div class="page-icon" aria-hidden="true"><Icon name="material-symbols:music-note-rounded" /></div>
			<div><h2>音乐</h2><p>沿途听到的声音</p></div>
		</div>
		<p class="text-neutral-600 dark:text-neutral-300 leading-7">歌单入口已恢复。等加入自己的歌曲或歌单后，这里会显示 Firefly 的播放器。</p>
	</section>
</MainGridLayout>
