	// ── Virtual Scroll for Playlist ──────────────────────────
	var PRIMARY_COLOR = getComputedStyle(document.documentElement).getPropertyValue("--primary").trim() || "#6366f1";

	function vsApplyActiveStyle(el, isActive) {
		var overlay = el.querySelector(".item-active-overlay");
		var title = el.querySelector(".item-title");
		var eqBars = el.querySelector(".eq-bars");
		var playIcon = el.querySelector(".eq-play-icon");
		var isPlaying = mgr ? mgr.getState().isPlaying : false;

		if (isActive) {
			el.classList.add("bg-neutral-100", "dark:bg-white/10");
			el.setAttribute("aria-current", "true");
			if (overlay) { overlay.classList.remove("hidden"); overlay.classList.add("flex"); }
			if (title) title.style.color = PRIMARY_COLOR;
			if (isPlaying) {
				if (eqBars) { eqBars.classList.remove("hidden"); eqBars.classList.add("flex"); }
				if (playIcon) playIcon.classList.add("hidden");
			} else {
				if (eqBars) { eqBars.classList.add("hidden"); eqBars.classList.remove("flex"); }
				if (playIcon) playIcon.classList.remove("hidden");
			}
		} else {
			el.classList.remove("bg-neutral-100", "dark:bg-white/10");
			el.removeAttribute("aria-current");
			if (overlay) { overlay.classList.add("hidden"); overlay.classList.remove("flex"); }
			if (title) title.style.color = "";
		}
	}

	function vsCreateItemEl(idx) {
		var vs = local.vs;
		var track = vs.playlist[idx];
		var clone = ui.itemTemplate.content.cloneNode(true);
		var itemEl = clone.querySelector(".playlist-item");
		var img = clone.querySelector(".item-cover");
		var title = clone.querySelector(".item-title");
		var artist = clone.querySelector(".item-artist");

		if (img) {
			img.src = track.pic || "";
			img.alt = track.name + " - " + track.artist;
		}
		if (title) title.innerText = track.name;
		if (artist) artist.innerText = track.artist;

		itemEl.dataset.index = idx;
		itemEl.setAttribute("role", "option");
		itemEl.tabIndex = 0;
		itemEl.setAttribute("aria-label", track.name + " - " + track.artist);
		itemEl.onclick = function () { if (mgr) mgr.playTrackByIndex(idx); };
		itemEl.onkeydown = function (e) {
			if (e.key === "Enter" || e.key === " ") { e.preventDefault(); itemEl.click(); return; }
			if (!["ArrowUp", "ArrowDown", "Home", "End"].includes(e.key)) return;
			e.preventDefault();
			var target = e.key === "Home" ? 0 : e.key === "End" ? vs.playlist.length - 1 : idx + (e.key === "ArrowDown" ? 1 : -1);
			target = Math.max(0, Math.min(vs.playlist.length - 1, target));
			ui.playlistContainer.scrollTop = target * ITEM_H;
			vsCommitRange();
			if (vs.renderedEls[target]) vs.renderedEls[target].focus();
		};

		itemEl.style.position = "absolute";
		itemEl.style.left = "0";
		itemEl.style.right = "0";
		itemEl.style.top = (idx * ITEM_H) + "px";
		itemEl.style.height = ITEM_H + "px";

		if (idx === vs.currentIndex) {
			vsApplyActiveStyle(itemEl, true);
		}
		return clone;
	}

	function vsCommitRange() {
		var vs = local.vs;
		if (vs.playlist.length === 0 || !vs.drawerOpen || !ui.playlistContainer) return;

		var container = ui.playlistContainer;
		var scrollTop = container.scrollTop;
		var viewHeight = container.clientHeight || 192;
		var start = Math.max(0, Math.floor(scrollTop / ITEM_H) - OVERSCAN);
		var end = Math.min(vs.playlist.length, Math.ceil((scrollTop + viewHeight) / ITEM_H) + OVERSCAN);

		if (start === vs.renderedStart && end === vs.renderedEnd) return;

		if (vs.renderedStart === -1) {
			var frag = document.createDocumentFragment();
			for (var i = start; i < end; i++) {
				frag.appendChild(vsCreateItemEl(i));
			}
			container.appendChild(frag);
		} else {
			var oldEls = vs.renderedEls;
			for (var ri = vs.renderedStart; ri < vs.renderedEnd; ri++) {
				if (ri < start || ri >= end) {
					if (oldEls[ri]) { oldEls[ri].remove(); delete oldEls[ri]; }
				}
			}
			for (var ai = start; ai < end; ai++) {
				if (!oldEls[ai]) {
					var newEl = vsCreateItemEl(ai);
					var inserted = false;
					for (var ni = ai + 1; ni < end; ni++) {
						if (oldEls[ni]) {
							container.insertBefore(newEl, oldEls[ni]);
							inserted = true;
							break;
						}
					}
					if (!inserted) container.appendChild(newEl);
					oldEls[ai] = newEl;
				}
			}
		}

		vs.renderedEls = {};
		var children = container.children;
		for (var ci = 0; ci < children.length; ci++) {
			var idx = parseInt(children[ci].dataset.index);
			if (!isNaN(idx)) vs.renderedEls[idx] = children[ci];
		}

		vs.renderedStart = start;
		vs.renderedEnd = end;
	}

	function vsRequestUpdate() {
		var vs = local.vs;
		if (vs.scrollRaf) return;
		vs.scrollRaf = requestAnimationFrame(function () {
			vs.scrollRaf = 0;
			vsCommitRange();
		});
	}

	function vsSetContainerHeight() {
		if (ui.playlistContainer) {
			ui.playlistContainer.style.height = (local.vs.playlist.length * ITEM_H) + "px";
		}
	}

	function renderPlaylist(playlist, currentIndex) {
		var vs = local.vs;
		vs.playlist = playlist;
		vs.currentIndex = currentIndex;
		vs.renderedStart = -1;
		vs.renderedEnd = -1;
		vs.renderedEls = {};
		vs.drawerOpen = ui.playlistDrawer ? ui.playlistDrawer.style.gridTemplateRows === "1fr" : false;
		if (ui.playlistContainer) {
			ui.playlistContainer.innerHTML = "";
			if (vs.drawerOpen) {
				vsSetContainerHeight();
				vsCommitRange();
			}
		}
	}

	function updatePlaylistActiveUI(currentIndex) {
		var vs = local.vs;
		var oldIndex = vs.currentIndex;
		vs.currentIndex = currentIndex;

		if (vs.renderedEls[oldIndex]) {
			vsApplyActiveStyle(vs.renderedEls[oldIndex], false);
		}

		if (currentIndex >= 0 && currentIndex < vs.playlist.length && ui.playlistContainer) {
			if (currentIndex < vs.renderedStart || currentIndex >= vs.renderedEnd) {
				ui.playlistContainer.scrollTop = currentIndex * ITEM_H;
				vsCommitRange();
			}
			if (vs.renderedEls[currentIndex]) {
				vsApplyActiveStyle(vs.renderedEls[currentIndex], true);
			}
		}
	}

	// ── Lyrics Rendering ─────────────────────────────────────
	function renderLyricsUI(lyrics, status) {
		if (!ui.lrcContainer) return;
		var d = getI18nDict();
		local.currentLrcIndex = -1;
		ui.lrcContainer.innerHTML = "";

		if (status === "loading") {
			ui.lrcContainer.innerHTML = '<div class="text-neutral-400 text-xs py-8">' + d.loadingLyrics + "</div>";
			return;
		}
		if (status === "failed") {
			ui.lrcContainer.innerHTML = '<div class="text-neutral-400 text-xs py-8">' + d.failedLyrics + "</div>";
			return;
		}
		if (!lyrics || lyrics.length === 0) {
			ui.lrcContainer.innerHTML = '<div class="text-neutral-400 text-xs py-8" role="option">' + d.noLyrics + "</div>";
			return;
		}

		lyrics.forEach(function (line, index) {
			var lineEl = document.createElement("div");
			lineEl.className = "lrc-line transition-all duration-300 text-xs text-neutral-400 py-0.5 cursor-pointer hover:text-(--primary)";
			lineEl.innerText = line.text;
			lineEl.dataset.index = index;
			lineEl.setAttribute("role", "option");
			lineEl.setAttribute("aria-label", line.text);
			lineEl.onclick = function () {
				if (mgr) mgr.seekToTime(line.time);
			};
			ui.lrcContainer.appendChild(lineEl);
		});
	}

	function updateLrcHighlight(index) {
		if (!ui.lrcContainer || index === local.currentLrcIndex) return;
		local.currentLrcIndex = index;

		var lines = ui.lrcContainer.querySelectorAll(".lrc-line");
		lines.forEach(function (line, i) {
			if (i === index) {
				line.classList.add("text-(--primary)", "font-bold", "text-sm");
				line.classList.remove("text-neutral-400", "text-xs");
			} else {
				line.classList.remove("text-(--primary)", "font-bold", "text-sm");
				line.classList.add("text-neutral-400", "text-xs");
			}
		});

		if (index !== -1 && !local.isUserScrolling) {
			var line = ui.lrcContainer.querySelector('.lrc-line[data-index="' + index + '"]');
			if (line) {
				var containerHeight = ui.lrcContainer.clientHeight;
				var lineOffset = line.offsetTop;
				var lineHeight = line.offsetHeight;
				var targetScroll = lineOffset - (containerHeight / 2) + (lineHeight / 2);
				ui.lrcContainer.scrollTo({ top: targetScroll, behavior: "smooth" });
			}
		}
	}

	function resetScrollTimeout() {
		clearTimeout(local.scrollTimeout);
		local.scrollTimeout = setTimeout(function () {
			local.isUserScrolling = false;
			if (mgr) {
				var s = mgr.getState();
				if (s.currentLrcIndex >= 0 && ui.lrcContainer) {
					var line = ui.lrcContainer.querySelector('.lrc-line[data-index="' + s.currentLrcIndex + '"]');
					if (line) {
						var containerHeight = ui.lrcContainer.clientHeight;
						var lineOffset = line.offsetTop;
						var lineHeight = line.offsetHeight;
						var targetScroll = lineOffset - (containerHeight / 2) + (lineHeight / 2);
						ui.lrcContainer.scrollTo({ top: targetScroll, behavior: "auto" });
					}
				}
			}
		}, 3000);
	}

	if (ui.lrcContainer) {
		ui.lrcContainer.addEventListener("wheel", function () {
			local.isUserScrolling = true;
			resetScrollTimeout();
		});
		ui.lrcContainer.addEventListener("touchstart", function () {
			local.isUserScrolling = true;
			resetScrollTimeout();
		});
	}

	// ── Full UI Sync from Manager ────────────────────────────
	function syncAll() {
		if (!mgr) return;
		var s = mgr.getState();
		if (!s.initialized) return;

		setLoading(false);
		var d = getI18nDict();

		if (s.playlist.length === 0) {
			if (ui.title) ui.title.innerText = s.error || d.noSongs;
			if (ui.titleMini) ui.titleMini.innerText = s.error || d.noSongs;
			return;
		}

		renderPlaylist(s.playlist, s.currentIndex);
		if (s.track) updateTrackUI(s.track);
		updatePlayStateUI(s.isPlaying);
		updateModeUI(s.playMode);
		updateVolumeUI(s.volume, s.isMuted);

		if (s.duration > 0) {
			if (ui.progressBar) ui.progressBar.style.width = s.progress + "%";
			if (ui.progressThumb) ui.progressThumb.style.left = s.progress + "%";
			if (ui.progressContainer) ui.progressContainer.setAttribute("aria-valuenow", Math.round(s.progress).toString());
			if (ui.currentTime) ui.currentTime.innerText = s.currentTimeStr;
			if (ui.totalTime) ui.totalTime.innerText = s.durationStr;
		}

		renderLyricsUI(s.lyrics, s.lyrics && s.lyrics.length > 0 ? "loaded" : "none");
		if (s.currentLrcIndex >= 0) updateLrcHighlight(s.currentLrcIndex);

		if (s.track && s.track.pic) {
			if (ui.cover && ui.cover.src && ui.cover.complete && ui.cover.naturalWidth > 0) {
				ui.cover.classList.remove("opacity-0");
			}
			if (ui.coverMini && ui.coverMini.src && ui.coverMini.complete && ui.coverMini.naturalWidth > 0) {
				ui.coverMini.classList.remove("opacity-0");
			}
		}
	}

	// ── Cover Image Load Events ──────────────────────────────
	function onCoverLoad(img) {
		if (img) img.classList.remove("opacity-0");
	}
	if (ui.cover) ui.cover.addEventListener("load", function () { onCoverLoad(ui.cover); });
	if (ui.coverMini) ui.coverMini.addEventListener("load", function () { onCoverLoad(ui.coverMini); });

	// ── Event Listeners (from MusicManager) ───────────────────
	window.addEventListener("fm:init", function (e) {
		var detail = e.detail;
		setLoading(false);
		if (detail.playlist && detail.playlist.length > 0) {
			renderPlaylist(detail.playlist, 0);
			updateModeUI(detail.playMode);
			updateVolumeUI(detail.volume, detail.isMuted);
		} else {
			var d = getI18nDict();
			if (ui.title) ui.title.innerText = d.noSongs;
			if (ui.titleMini) ui.titleMini.innerText = d.noSongs;
		}
	});

	window.addEventListener("fm:track", function (e) {
		var detail = e.detail;
		updateTrackUI(detail.track);
		updatePlaylistActiveUI(detail.index);
	});

	window.addEventListener("fm:play-state", function (e) {
		updatePlayStateUI(e.detail.isPlaying);
	});

	window.addEventListener("fm:time", function (e) {
		var detail = e.detail;
		if (ui.progressBar) ui.progressBar.style.width = detail.progress + "%";
		if (ui.progressThumb) ui.progressThumb.style.left = detail.progress + "%";
		if (ui.progressContainer) ui.progressContainer.setAttribute("aria-valuenow", Math.round(detail.progress).toString());
		if (ui.currentTime) ui.currentTime.innerText = detail.currentTimeStr;
		if (ui.totalTime) ui.totalTime.innerText = detail.durationStr;
	});

	window.addEventListener("fm:volume", function (e) {
		updateVolumeUI(e.detail.volume, e.detail.isMuted);
	});

	window.addEventListener("fm:mode", function (e) {
		updateModeUI(e.detail.playMode);
	});

	window.addEventListener("fm:lyrics", function (e) {
		local.lyricsStatus = e.detail.status;
		renderLyricsUI(e.detail.lyrics, e.detail.status);
	});

	window.addEventListener("fm:lrc-index", function (e) {
		updateLrcHighlight(e.detail.index);
	});

	window.addEventListener("fm:error", function (e) {
		var d = getI18nDict();
		var msg = e.detail.message || d.error;
		if (ui.title) ui.title.innerText = msg;
		if (ui.titleMini) ui.titleMini.innerText = msg;
	});

	// ── Button Controls ──────────────────────────────────────
	function togglePlay() { if (mgr) mgr.togglePlay(); }
	if (ui.btnPlay) ui.btnPlay.addEventListener("click", togglePlay);
	if (ui.btnPlayMini) ui.btnPlayMini.addEventListener("click", togglePlay);

	if (ui.btnNext) ui.btnNext.addEventListener("click", function () { if (mgr) mgr.playNext(); });
	if (ui.btnPrev) ui.btnPrev.addEventListener("click", function () { if (mgr) mgr.playPrev(); });
	if (ui.btnRepeat) ui.btnRepeat.addEventListener("click", function () { if (mgr) mgr.cyclePlayMode(); });
	if (ui.btnMute) ui.btnMute.addEventListener("click", function () { if (mgr) mgr.toggleMute(); });

	if (ui.volContainer) {
		ui.volContainer.addEventListener("keydown", function (e) {
			if (!mgr || !["ArrowLeft", "ArrowDown", "ArrowRight", "ArrowUp", "Home", "End"].includes(e.key)) return;
			e.preventDefault();
			var volume = mgr.getState().volume;
			mgr.setVolume(e.key === "Home" ? 0 : e.key === "End" ? 1 : volume + (["ArrowRight", "ArrowUp"].includes(e.key) ? 0.05 : -0.05));
		});
		ui.volContainer.addEventListener("click", function (e) {
			var rect = ui.volContainer.getBoundingClientRect();
			var x = e.clientX - rect.left;
			var val = Math.max(0, Math.min(1, x / rect.width));
			if (mgr) mgr.setVolume(val);
		});
	}

	if (ui.progressContainer) {
		ui.progressContainer.addEventListener("keydown", function (e) {
			if (!mgr || !["ArrowLeft", "ArrowDown", "ArrowRight", "ArrowUp", "Home", "End"].includes(e.key)) return;
			e.preventDefault();
			var progress = mgr.getState().progress / 100;
			mgr.seek(e.key === "Home" ? 0 : e.key === "End" ? 1 : progress + (["ArrowRight", "ArrowUp"].includes(e.key) ? 0.05 : -0.05));
		});
		ui.progressContainer.addEventListener("click", function (e) {
			var rect = ui.progressContainer.getBoundingClientRect();
			var clickX = e.clientX - rect.left;
			var percent = Math.min(Math.max(clickX / rect.width, 0), 1);
			if (mgr) mgr.seek(percent);
		});
	}

	// ── Drawer Toggles ───────────────────────────────────────
	function toggleLyricsDrawer() {
		if (!ui.lrcDrawer) return;
		var isOpen = ui.lrcDrawer.style.gridTemplateRows === "1fr";
		if (isOpen) {
			ui.lrcDrawer.style.gridTemplateRows = "0fr";
			ui.lrcDrawer.classList.remove("opacity-100");
			ui.lrcDrawer.classList.add("opacity-0");
			if (ui.btnLrc) {
				ui.btnLrc.classList.remove("text-(--primary)");
				ui.btnLrc.classList.add("text-neutral-400");
			}
			if (ui.iconLrcOn) ui.iconLrcOn.classList.add("hidden");
			if (ui.iconLrcOff) ui.iconLrcOff.classList.remove("hidden");
		} else {
			// Close playlist drawer if open
			if (ui.playlistDrawer) {
				ui.playlistDrawer.style.gridTemplateRows = "0fr";
				ui.playlistDrawer.classList.remove("opacity-100");
				ui.playlistDrawer.classList.add("opacity-0");
				local.vs.drawerOpen = false;
			}
			if (ui.btnDrawer) {
				ui.btnDrawer.classList.remove("text-(--primary)");
				ui.btnDrawer.classList.add("text-neutral-400");
			}
			if (ui.btnDrawerBottom) {
				ui.btnDrawerBottom.classList.remove("text-(--primary)");
				ui.btnDrawerBottom.classList.add("text-neutral-400");
			}

			ui.lrcDrawer.style.gridTemplateRows = "1fr";
			ui.lrcDrawer.classList.add("opacity-100");
			ui.lrcDrawer.classList.remove("opacity-0");
			if (ui.btnLrc) {
				ui.btnLrc.classList.add("text-(--primary)");
				ui.btnLrc.classList.remove("text-neutral-400");
			}
			if (ui.iconLrcOn) ui.iconLrcOn.classList.remove("hidden");
			if (ui.iconLrcOff) ui.iconLrcOff.classList.add("hidden");
		}
		requestAnimationFrame(ensureInViewport);
	}

	function togglePlaylistDrawer() {
		if (!ui.playlistDrawer) return;
		var isOpen = ui.playlistDrawer.style.gridTemplateRows === "1fr";
		if (isOpen) {
			ui.playlistDrawer.style.gridTemplateRows = "0fr";
			ui.playlistDrawer.classList.remove("opacity-100");
			ui.playlistDrawer.classList.add("opacity-0");
			if (ui.btnDrawer) {
				ui.btnDrawer.classList.remove("text-(--primary)");
				ui.btnDrawer.classList.add("text-neutral-400");
			}
			if (ui.btnDrawerBottom) {
				ui.btnDrawerBottom.classList.remove("text-(--primary)");
				ui.btnDrawerBottom.classList.add("text-neutral-400");
			}
			local.vs.drawerOpen = false;
		} else {
			// Close lyrics drawer if open
			if (ui.lrcDrawer) {
				ui.lrcDrawer.style.gridTemplateRows = "0fr";
				ui.lrcDrawer.classList.remove("opacity-100");
				ui.lrcDrawer.classList.add("opacity-0");
			}
			if (ui.btnLrc) {
				ui.btnLrc.classList.remove("text-(--primary)");
				ui.btnLrc.classList.add("text-neutral-400");
			}
			if (ui.iconLrcOn) ui.iconLrcOn.classList.add("hidden");
			if (ui.iconLrcOff) ui.iconLrcOff.classList.remove("hidden");

			ui.playlistDrawer.style.gridTemplateRows = "1fr";
			ui.playlistDrawer.classList.add("opacity-100");
			ui.playlistDrawer.classList.remove("opacity-0");
			if (ui.btnDrawer) {
				ui.btnDrawer.classList.remove("text-neutral-400");
				ui.btnDrawer.classList.add("text-(--primary)");
			}
			if (ui.btnDrawerBottom) {
				ui.btnDrawerBottom.classList.remove("text-neutral-400");
				ui.btnDrawerBottom.classList.add("text-(--primary)");
			}
			local.vs.drawerOpen = true;

			if (local.vs.playlist.length > 0) {
				requestAnimationFrame(function () {
					vsSetContainerHeight();
					vsCommitRange();
				});
			}
		}
		requestAnimationFrame(ensureInViewport);
	}

	if (ui.btnLrc) ui.btnLrc.addEventListener("click", toggleLyricsDrawer);
	if (ui.btnDrawer) ui.btnDrawer.addEventListener("click", togglePlaylistDrawer);
	if (ui.btnDrawerBottom) ui.btnDrawerBottom.addEventListener("click", togglePlaylistDrawer);

	if (ui.playlistContainer) {
		ui.playlistContainer.addEventListener("scroll", function () {
			vsRequestUpdate();
		});
	}

	// ── Dynamic i18n Updater (Swup & Language switch) ────────
	function updateI18nLabels() {
		var d = getI18nDict();
		var isPlaying = mgr ? mgr.getState().isPlaying : false;
		var isMuted = mgr ? mgr.getState().isMuted : false;
		var playMode = mgr ? mgr.getState().playMode : 0;

		var playLabel = isPlaying ? d.pause : d.play;
		if (ui.btnPlay) { ui.btnPlay.setAttribute("aria-label", playLabel); ui.btnPlay.title = playLabel; }
		if (ui.btnPlayMini) { ui.btnPlayMini.setAttribute("aria-label", playLabel); ui.btnPlayMini.title = playLabel; }

		if (ui.btnPrev) { ui.btnPrev.setAttribute("aria-label", d.prev); ui.btnPrev.title = d.prev; }
		if (ui.btnNext) { ui.btnNext.setAttribute("aria-label", d.next); ui.btnNext.title = d.next; }

		var muteLabel = isMuted ? d.unmute : d.mute;
		if (ui.btnMute) { ui.btnMute.setAttribute("aria-label", muteLabel); ui.btnMute.title = muteLabel; }

		var modeTitle = playMode === 1 ? d.modeOne : playMode === 2 ? d.modeRandom : d.modeList;
		if (ui.btnRepeat) { ui.btnRepeat.setAttribute("aria-label", modeTitle); ui.btnRepeat.title = modeTitle; }

		if (ui.btnLrc) { ui.btnLrc.setAttribute("aria-label", d.lyrics); ui.btnLrc.title = d.lyrics; }
		if (ui.btnDrawer) { ui.btnDrawer.setAttribute("aria-label", d.playlist); ui.btnDrawer.title = d.playlist; }
		if (ui.btnDrawerBottom) { ui.btnDrawerBottom.setAttribute("aria-label", d.playlist); ui.btnDrawerBottom.title = d.playlist; }
		if (btnCollapse) { btnCollapse.setAttribute("aria-label", d.collapse); btnCollapse.title = d.collapse; }
		if (btnExpand) { btnExpand.setAttribute("aria-label", d.expand); btnExpand.title = d.expand; }
		if (btnExpandText) { btnExpandText.setAttribute("title", d.expand); }

		var handles = player.querySelectorAll(".drag-handle");
		handles.forEach(function (h) {
			h.setAttribute("aria-label", d.drag);
			h.title = d.drag;
		});

		player.setAttribute("aria-label", d.music);
		player.querySelectorAll(".playlist-container").forEach(function (el) { el.setAttribute("aria-label", d.playlist); });
		player.querySelectorAll(".lrc-container").forEach(function (el) { el.setAttribute("aria-label", d.lyrics); });
		player.querySelectorAll(".vol-container").forEach(function (el) { el.setAttribute("aria-label", d.volume); });
		player.querySelectorAll(".progress-container").forEach(function (el) { el.setAttribute("aria-label", d.progress); });
		var s = mgr ? mgr.getState() : null;
		player.querySelectorAll(".music-cover, .music-cover-mini").forEach(function (el) { el.alt = s && s.track && s.track.pic ? s.track.name + " - " + s.track.artist : d.noCover; });
		if (s) { renderLyricsUI(s.lyrics, local.lyricsStatus || (s.lyrics.length ? "loaded" : "none")); updateLrcHighlight(s.currentLrcIndex); }
		if (!s || !s.track) {
			if (ui.title) ui.title.innerText = d.music;
			if (ui.titleMini) ui.titleMini.innerText = d.music;
			if (ui.artist) ui.artist.innerText = d.noPlaying;
		}
	}

	document.addEventListener("astro:after-swap", updateI18nLabels);
	window.addEventListener("lang-change", updateI18nLabels);

	// ── Startup & Init ───────────────────────────────────────
	if (mgr) {
		var state = mgr.getState();
		if (state.initialized) {
			syncAll();
		} else {
			setLoading(true);
			scheduleManagerInit();
		}
	}
})();
</script>

<style>
	@keyframes spin-slow {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}
	.animate-spin-slow {
		animation: spin-slow 12s linear infinite;
	}

	#floating-music-player.is-dragging {
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4) !important;
		opacity: 0.92 !important;
		transform: scale(1.02);
		transition: none !important;
	}

	/* Equalizer bounce for active item */
	.eq-bars .eq-bar {
		animation: eq-bounce 1.2s ease-in-out infinite;
	}
	.eq-bars .eq-bar:nth-child(1) { animation-duration: 0.8s; }
	.eq-bars .eq-bar:nth-child(2) { animation-duration: 0.6s; animation-delay: 0.15s; }
	.eq-bars .eq-bar:nth-child(3) { animation-duration: 1.0s; animation-delay: 0.3s; }

	@keyframes eq-bounce {
		0%, 100% { height: 3px; }
		50% { height: 12px; }
	}
</style>
