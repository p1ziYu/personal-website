---
import { Icon } from "astro-icon/components";
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { getLangFromPath, i18n } from "@/i18n/translation";

const uiLang = getLangFromPath(Astro.url.pathname);
const config = musicPlayerConfig;

const i18nData = {
	zh_CN: {
		play: i18n(I18nKey.musicPlay, "zh_CN"),
		pause: i18n(I18nKey.musicPause, "zh_CN"),
		prev: i18n(I18nKey.musicPrev, "zh_CN"),
		next: i18n(I18nKey.musicNext, "zh_CN"),
		volume: i18n(I18nKey.musicVolume, "zh_CN"),
		mute: i18n(I18nKey.musicMute, "zh_CN"),
		unmute: i18n(I18nKey.musicUnmute, "zh_CN"),
		playlist: i18n(I18nKey.musicPlaylist, "zh_CN"),
		lyrics: i18n(I18nKey.musicLyrics, "zh_CN"),
		noLyrics: i18n(I18nKey.musicNoLyrics, "zh_CN"),
		loadingLyrics: i18n(I18nKey.musicLoadingLyrics, "zh_CN"),
		failedLyrics: i18n(I18nKey.musicFailedLyrics, "zh_CN"),
		noSongs: i18n(I18nKey.musicNoSongs, "zh_CN"),
		error: i18n(I18nKey.musicError, "zh_CN"),
		progress: i18n(I18nKey.musicProgress, "zh_CN"),
		cover: i18n(I18nKey.musicCover, "zh_CN"),
		noCover: i18n(I18nKey.musicNoCover, "zh_CN"),
		music: i18n(I18nKey.music, "zh_CN"),
		noPlaying: i18n(I18nKey.musicNoPlaying, "zh_CN"),
		collapse: i18n(I18nKey.musicCollapse, "zh_CN"),
		expand: i18n(I18nKey.musicExpand, "zh_CN"),
		drag: i18n(I18nKey.musicDrag, "zh_CN"),
		modeList: "列表循环",
		modeOne: "单曲循环",
		modeRandom: "随机播放",
	},
	en: {
		play: i18n(I18nKey.musicPlay, "en"),
		pause: i18n(I18nKey.musicPause, "en"),
		prev: i18n(I18nKey.musicPrev, "en"),
		next: i18n(I18nKey.musicNext, "en"),
		volume: i18n(I18nKey.musicVolume, "en"),
		mute: i18n(I18nKey.musicMute, "en"),
		unmute: i18n(I18nKey.musicUnmute, "en"),
		playlist: i18n(I18nKey.musicPlaylist, "en"),
		lyrics: i18n(I18nKey.musicLyrics, "en"),
		noLyrics: i18n(I18nKey.musicNoLyrics, "en"),
		loadingLyrics: i18n(I18nKey.musicLoadingLyrics, "en"),
		failedLyrics: i18n(I18nKey.musicFailedLyrics, "en"),
		noSongs: i18n(I18nKey.musicNoSongs, "en"),
		error: i18n(I18nKey.musicError, "en"),
		progress: i18n(I18nKey.musicProgress, "en"),
		cover: i18n(I18nKey.musicCover, "en"),
		noCover: i18n(I18nKey.musicNoCover, "en"),
		music: i18n(I18nKey.music, "en"),
		noPlaying: i18n(I18nKey.musicNoPlaying, "en"),
		collapse: i18n(I18nKey.musicCollapse, "en"),
		expand: i18n(I18nKey.musicExpand, "en"),
		drag: i18n(I18nKey.musicDrag, "en"),
		modeList: "List Loop",
		modeOne: "Single Loop",
		modeRandom: "Shuffle",
	},
};

const i18nDataStr = JSON.stringify(i18nData);
---

<!-- 播放列表条目模板 -->
<template id="floating-music-item-template">
	<div class="playlist-item flex items-center gap-2.5 p-1.5 rounded-lg cursor-pointer hover:bg-black/5 dark:hover:bg-white/5 transition-colors group">
		<div class="w-8 h-8 rounded-md overflow-hidden shrink-0 relative bg-neutral-200 dark:bg-neutral-700">
			<img src="" class="item-cover w-full h-full object-cover" loading="lazy" alt="" />
			<div class="item-active-overlay absolute inset-0 bg-(--primary)/20 hidden items-center justify-center">
				<div class="eq-bars flex items-end gap-[2px] h-3">
					<span class="eq-bar w-[2px] bg-(--primary) rounded-sm"></span>
					<span class="eq-bar w-[2px] bg-(--primary) rounded-sm"></span>
					<span class="eq-bar w-[2px] bg-(--primary) rounded-sm"></span>
				</div>
				<svg class="eq-play-icon text-(--primary) hidden" width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
					<path d="M8 5v14l11-7z"/>
				</svg>
			</div>
		</div>
		<div class="flex-1 min-w-0">
			<div class="item-title text-xs font-bold text-neutral-700 dark:text-neutral-200 truncate group-hover:text-(--primary) transition-colors"></div>
			<div class="item-artist text-[10px] text-neutral-400 truncate"></div>
		</div>
	</div>
</template>

<div
	id="floating-music-player"
	class="music-player-widget fixed z-[995] select-none text-neutral-800 dark:text-neutral-100 transition-[box-shadow,opacity,transform] duration-200"
	role="region"
	aria-label={i18n(I18nKey.music, uiLang)}
	data-collapsed="false"
	style="visibility: hidden;"
>
	<!-- Mini Mode Container (Pill) -->
	<div
		id="player-mini"
		class="mini-mode-container items-center gap-2 px-2.5 py-1.5 rounded-full bg-(--card-bg)/90 dark:bg-(--card-bg)/85 backdrop-blur-md border border-black/10 dark:border-white/10 shadow-lg hidden"
	>
		<!-- Dedicated Mini Drag Handle -->
		<div
			class="drag-handle drag-handle-mini cursor-grab active:cursor-grabbing p-1 text-neutral-400 hover:text-(--primary) touch-none flex items-center justify-center rounded-full transition-colors"
			title={i18n(I18nKey.musicDrag, uiLang)}
			aria-label={i18n(I18nKey.musicDrag, uiLang)}
			role="button"
			tabindex="0"
		>
			<Icon name="material-symbols:drag-indicator" class="text-base" aria-hidden="true" />
		</div>

		<!-- Mini Rotating Cover -->
		<div class="w-7 h-7 rounded-full overflow-hidden bg-(--primary)/10 shrink-0 relative flex items-center justify-center border border-white/60 dark:border-neutral-700 shadow-xs">
			<Icon name="material-symbols:music-note-rounded" class="text-sm text-(--primary) opacity-40 absolute" aria-hidden="true" />
			<img class="music-cover-mini w-full h-full object-cover animate-spin-slow opacity-0 transition-opacity duration-300" src="" alt={i18n(I18nKey.musicCover, uiLang)} style="animation-play-state: paused;" />
		</div>

		<!-- Mini Play/Pause Button -->
		<button
			class="btn-play-mini w-7 h-7 rounded-full bg-(--btn-regular-bg) hover:bg-(--btn-regular-bg-hover) active:bg-(--btn-regular-bg-active) text-(--primary) flex items-center justify-center transition-all active:scale-95 shrink-0"
			title={i18n(I18nKey.musicPlay, uiLang)}
			aria-label={i18n(I18nKey.musicPlay, uiLang)}
		>
			<Icon name="material-symbols:play-arrow-rounded" class="icon-play text-base ml-0.5" aria-hidden="true" />
			<Icon name="material-symbols:pause-rounded" class="icon-pause text-base hidden" aria-hidden="true" />
		</button>

		<!-- Mini Track Title (Click also expands) -->
		<div
			class="btn-expand-text min-w-0 max-w-[110px] sm:max-w-[140px] overflow-hidden cursor-pointer"
			title={i18n(I18nKey.musicExpand, uiLang)}
			role="button"
			tabindex="0"
		>
			<span class="music-title-mini text-xs font-semibold text-neutral-800 dark:text-neutral-100 truncate block">
				{i18n(I18nKey.music, uiLang)}
			</span>
		</div>

		<!-- Mini Expand Button -->
		<button
			class="btn-expand w-6 h-6 rounded-full hover:bg-black/5 dark:hover:bg-white/5 text-neutral-400 hover:text-(--primary) flex items-center justify-center transition-all active:scale-95 shrink-0"
			title={i18n(I18nKey.musicExpand, uiLang)}
			aria-label={i18n(I18nKey.musicExpand, uiLang)}
		>
			<Icon name="material-symbols:open-in-full-rounded" class="text-xs" aria-hidden="true" />
		</button>
	</div>

	<!-- Expanded Mode Container (Card) -->
	<div
		id="player-expanded"
		class="expanded-mode-container w-72 sm:w-80 rounded-2xl bg-(--card-bg)/95 dark:bg-(--card-bg)/90 backdrop-blur-md border border-black/10 dark:border-white/10 shadow-2xl p-3 flex flex-col gap-2 relative overflow-hidden hidden"
	>
		<!-- Top Bar: Drag Handle Strip + Utility Buttons -->
		<div class="flex items-center justify-between gap-1 select-none border-b border-black/5 dark:border-white/5 pb-1.5 -mx-1 px-1">
			<!-- Dedicated Drag Handle Strip -->
			<div
				class="drag-handle drag-handle-expanded flex-1 flex items-center gap-1.5 cursor-grab active:cursor-grabbing text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 touch-none py-0.5 select-none"
				title={i18n(I18nKey.musicDrag, uiLang)}
				aria-label={i18n(I18nKey.musicDrag, uiLang)}
				role="button"
				tabindex="0"
			>
				<Icon name="material-symbols:drag-indicator" class="text-base" aria-hidden="true" />
				<span class="text-xs font-semibold tracking-wider uppercase opacity-75">{i18n(I18nKey.music, uiLang)}</span>
			</div>

			<!-- Header Action Buttons -->
			<div class="flex items-center gap-0.5">
				<!-- Lyrics Drawer Toggle -->
				<button
					class={`btn-lrc-toggle hover:text-(--primary) hover:bg-black/5 dark:hover:bg-white/5 transition-all duration-200 p-1.5 rounded-lg text-neutral-400 shrink-0 ${!config.showLyrics ? 'hidden' : ''}`}
					title={i18n(I18nKey.musicLyrics, uiLang)}
					aria-label={i18n(I18nKey.musicLyrics, uiLang)}
				>
					<Icon name="material-symbols:subtitles-off-outline-rounded" class="icon-lrc-off text-base" aria-hidden="true" />
					<Icon name="material-symbols:subtitles-outline-rounded" class="icon-lrc-on text-base hidden" aria-hidden="true" />
				</button>

				<!-- Playlist Drawer Toggle -->
				<button
					class="btn-drawer-toggle text-neutral-400 hover:text-(--primary) hover:bg-black/5 dark:hover:bg-white/5 transition-all duration-200 p-1.5 rounded-lg shrink-0"
					title={i18n(I18nKey.musicPlaylist, uiLang)}
					aria-label={i18n(I18nKey.musicPlaylist, uiLang)}
				>
					<Icon name="mdi:playlist-music" class="text-base" aria-hidden="true" />
				</button>

				<!-- Collapse Button -->
				<button
					class="btn-collapse text-neutral-400 hover:text-(--primary) hover:bg-black/5 dark:hover:bg-white/5 transition-all duration-200 p-1.5 rounded-lg shrink-0 active:scale-95"
					title={i18n(I18nKey.musicCollapse, uiLang)}
					aria-label={i18n(I18nKey.musicCollapse, uiLang)}
				>
					<Icon name="material-symbols:close-fullscreen-rounded" class="text-sm" aria-hidden="true" />
				</button>
			</div>
		</div>

		<!-- Track Info & Volume Row -->
		<div class="flex items-center gap-2.5 px-0.5 pt-0.5">
			<!-- Circular Album Cover -->
			<div class="relative shrink-0 w-12 h-12">
				<div class="w-full h-full rounded-full overflow-hidden shadow-md border-2 border-white dark:border-neutral-700 relative z-10 bg-(--primary)/10 flex items-center justify-center">
					<Icon name="material-symbols:music-note-rounded" class="text-xl text-(--primary) opacity-40 absolute" aria-hidden="true" />
					<img class="music-cover w-full h-full object-cover animate-spin-slow relative z-10 opacity-0 transition-opacity duration-300" src="" alt={i18n(I18nKey.musicCover, uiLang)} style="animation-play-state: paused;" />
				</div>
			</div>

			<!-- Info + Time + Volume -->
			<div class="flex-1 min-w-0 flex flex-col justify-center gap-0.5 overflow-hidden">
				<div class="min-w-0 overflow-hidden">
					<h3 class="music-title font-bold text-sm text-neutral-800 dark:text-neutral-100 leading-tight truncate">
						{i18n(I18nKey.music, uiLang)}
					</h3>
				</div>
				<div class="min-w-0 overflow-hidden">
					<p class="music-artist text-[11px] font-medium text-neutral-500 dark:text-neutral-400 truncate">
						{i18n(I18nKey.musicNoPlaying, uiLang)}
					</p>
				</div>
				<!-- Time & Volume -->
				<div class="flex items-center justify-between text-neutral-400 text-[10px] font-mono mt-0.5">
					<div class="flex items-center gap-1" aria-live="polite">
						<span class="current-time">0:00</span>
						<span class="opacity-50" aria-hidden="true">/</span>
						<span class="total-time">0:00</span>
					</div>

					<div class="flex items-center gap-1">
						<button class="btn-mute hover:text-(--primary) p-0.5 rounded-sm flex items-center transition-colors" title={i18n(I18nKey.musicMute, uiLang)} aria-label={i18n(I18nKey.musicMute, uiLang)}>
							<Icon name="material-symbols:volume-up-rounded" class="icon-vol-high text-sm" aria-hidden="true" />
							<Icon name="material-symbols:volume-off-rounded" class="icon-vol-mute text-sm hidden" aria-hidden="true" />
						</button>
						<div class="vol-container h-1 w-14 bg-neutral-300/60 dark:bg-neutral-600/40 rounded-full cursor-pointer relative" role="slider" tabindex="0" aria-label={i18n(I18nKey.musicVolume, uiLang)} aria-valuemin="0" aria-valuemax="100" aria-valuenow="70">
							<div class="vol-bar absolute left-0 top-0 h-full bg-(--primary) rounded-full w-[70%]"></div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Progress Bar (Slim, interactive) -->
		<div class="px-0.5 my-0.5">
			<div
				class="progress-container relative w-full h-1 bg-neutral-300/60 dark:bg-neutral-600/40 rounded-full cursor-pointer touch-none group"
				role="slider"
				tabindex="0"
				aria-label={i18n(I18nKey.musicProgress, uiLang)}
				aria-valuemin="0"
				aria-valuemax="100"
				aria-valuenow="0"
			>
				<div class="progress-bar absolute left-0 top-0 h-full bg-(--primary) rounded-full w-0 transition-[width] duration-100"></div>
				<div class="progress-thumb absolute top-1/2 -mt-1.5 -ml-1.5 w-3 h-3 bg-(--primary) ring-2 ring-white dark:ring-neutral-800 rounded-full shadow-xs scale-0 group-hover:scale-100 transition-transform duration-200"></div>
			</div>
		</div>

		<!-- Main Playback Controls Row -->
		<div class="flex items-center justify-between px-2 select-none pt-0.5">
			<!-- Repeat Mode Toggle -->
			<button
				class="btn-repeat text-neutral-400 hover:text-(--primary) transition-colors p-1.5 rounded-lg active:scale-95"
				title={i18n(I18nKey.musicPlayMode, uiLang)}
				aria-label={i18n(I18nKey.musicPlayMode, uiLang)}
			>
				<Icon name="material-symbols:repeat-rounded" class="icon-repeat text-lg" aria-hidden="true" />
				<Icon name="material-symbols:repeat-one-rounded" class="icon-repeat-one text-lg hidden" aria-hidden="true" />
				<Icon name="material-symbols:shuffle-rounded" class="icon-shuffle text-lg hidden" aria-hidden="true" />
			</button>

			<!-- Previous Song -->
			<button
				class="btn-prev text-neutral-600 dark:text-neutral-300 hover:text-(--primary) transition-colors p-1.5 rounded-lg active:scale-95"
				title={i18n(I18nKey.musicPrev, uiLang)}
				aria-label={i18n(I18nKey.musicPrev, uiLang)}
			>
				<Icon name="material-symbols:skip-previous-rounded" class="text-2xl" aria-hidden="true" />
			</button>

			<!-- Play / Pause Feature Button -->
			<button
				class="btn-play w-10 h-10 bg-(--btn-regular-bg) hover:bg-(--btn-regular-bg-hover) active:bg-(--btn-regular-bg-active) text-(--primary) rounded-full flex items-center justify-center transition-all duration-200 active:scale-95 shadow-xs"
				title={i18n(I18nKey.musicPlay, uiLang)}
				aria-label={i18n(I18nKey.musicPlay, uiLang)}
			>
				<Icon name="material-symbols:play-arrow-rounded" class="icon-play text-2xl ml-0.5" aria-hidden="true" />
				<Icon name="material-symbols:pause-rounded" class="icon-pause text-2xl hidden" aria-hidden="true" />
			</button>

			<!-- Next Song -->
			<button
				class="btn-next text-neutral-600 dark:text-neutral-300 hover:text-(--primary) transition-colors p-1.5 rounded-lg active:scale-95"
				title={i18n(I18nKey.musicNext, uiLang)}
				aria-label={i18n(I18nKey.musicNext, uiLang)}
			>
				<Icon name="material-symbols:skip-next-rounded" class="text-2xl" aria-hidden="true" />
			</button>

			<!-- Bottom Playlist Toggle -->
			<button
				class="btn-drawer-toggle-bottom text-neutral-400 hover:text-(--primary) transition-colors p-1.5 rounded-lg active:scale-95"
				title={i18n(I18nKey.musicPlaylist, uiLang)}
				aria-label={i18n(I18nKey.musicPlaylist, uiLang)}
			>
				<Icon name="mdi:playlist-music" class="text-lg" aria-hidden="true" />
			</button>
		</div>

		<!-- Lyrics Drawer Accordion -->
		<div class="lrc-drawer grid transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] grid-rows-[0fr] opacity-0">
			<div class="overflow-hidden min-h-0">
				<div class="mt-1 pt-1.5 border-t border-black/5 dark:border-white/5">
					<div
						class="lrc-container h-44 overflow-y-auto custom-scrollbar flex flex-col items-center gap-1.5 p-3 py-20 text-center relative scroll-smooth"
						role="listbox"
						aria-label={i18n(I18nKey.musicLyrics, uiLang)}
					>
						<div class="text-neutral-400 text-xs py-8" role="option">
							{i18n(I18nKey.musicNoLyrics, uiLang)}
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Playlist Drawer Accordion -->
		<div class="playlist-drawer grid transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] grid-rows-[0fr] opacity-0">
			<div class="overflow-hidden min-h-0">
				<div class="mt-1 pt-1.5 border-t border-black/5 dark:border-white/5">
					<div
						class="playlist-container max-h-48 overflow-y-auto custom-scrollbar pr-1 pb-1 relative"
						role="listbox"
						aria-label={i18n(I18nKey.musicPlaylist, uiLang)}
					>
						<!-- Items inserted by virtual scroll -->
					</div>
				</div>
			</div>
		</div>

		<!-- Loading Overlay -->
		<div
			class="music-loading absolute inset-0 z-20 flex flex-col items-center justify-center bg-white/60 dark:bg-[#1a1b26]/70 backdrop-blur-[2px] transition-opacity duration-300 opacity-0 pointer-events-none rounded-2xl"
			aria-busy="true"
			aria-hidden="true"
		>
			<div class="w-7 h-7 text-(--primary) animate-spin">
				<Icon name="material-symbols:sync-rounded" class="text-2xl" aria-hidden="true" />
			</div>
		</div>
	</div>
</div>

<script is:inline define:vars={{ i18nDataStr }}>
(function () {
	// Guard against duplicate execution in same document
	if (window.__fireflyFloatingMusicInit) return;
	window.__fireflyFloatingMusicInit = true;

	var allI18n = JSON.parse(i18nDataStr);

	function getCurrentLang() {
		var path = window.location.pathname || "/";
		return (path.startsWith("/en/") || path === "/en") ? "en" : "zh_CN";
	}

	function getI18nDict() {
		var lang = getCurrentLang();
		return allI18n[lang] || allI18n.zh_CN;
	}

	var player = document.getElementById("floating-music-player");
	if (!player) return;

	var miniMode = document.getElementById("player-mini");
	var expandedMode = document.getElementById("player-expanded");

	// ── Position & Drag State ────────────────────────────────
	var STORAGE_POS_KEY = "firefly-music-player-pos";
	var STORAGE_COLLAPSED_KEY = "firefly-music-player-collapsed";

	var isDragging = false;
	var activePointerId = null;
	var startPointerX = 0;
	var startPointerY = 0;
	var startElemX = 0;
	var startElemY = 0;

	function clampPosition(x, y, w, h) {
		var pad = 12;
		var maxW = window.innerWidth;
		var maxH = window.innerHeight;
		var minX = pad;
		var maxX = Math.max(pad, maxW - w - pad);
		var minY = pad;
		var maxY = Math.max(pad, maxH - h - pad);
		return {
			x: Math.min(Math.max(minX, x), maxX),
			y: Math.min(Math.max(minY, y), maxY)
		};
	}

	function applyCoordinates(x, y) {
		player.style.left = x + "px";
		player.style.top = y + "px";
		player.style.right = "auto";
		player.style.bottom = "auto";
	}

	function ensureInViewport() {
		var rect = player.getBoundingClientRect();
		if (rect.width === 0 || rect.height === 0) return;
		var clamped = clampPosition(rect.left, rect.top, rect.width, rect.height);
		if (Math.abs(clamped.x - rect.left) > 1 || Math.abs(clamped.y - rect.top) > 1) {
			applyCoordinates(clamped.x, clamped.y);
		}
	}

	function restorePosition() {
		var isSmall = window.innerWidth < 768;
		var savedPos = null;
		try {
			var raw = localStorage.getItem(STORAGE_POS_KEY);
			if (raw) savedPos = JSON.parse(raw);
		} catch (e) {}

		var rect = player.getBoundingClientRect();
		var w = rect.width || (isSmall ? 180 : 320);
		var h = rect.height || (isSmall ? 44 : 140);

		if (savedPos && typeof savedPos.x === "number" && typeof savedPos.y === "number") {
			var clamped = clampPosition(savedPos.x, savedPos.y, w, h);
			applyCoordinates(clamped.x, clamped.y);
		} else {
			// Default: bottom-left corner with safe-area spacing
			var defaultX = isSmall ? 16 : 20;
			var defaultY = Math.max(12, window.innerHeight - h - (isSmall ? 20 : 24));
			var clampedDefault = clampPosition(defaultX, defaultY, w, h);
			applyCoordinates(clampedDefault.x, clampedDefault.y);
		}
		player.style.visibility = "visible";
	}

	function bindDragHandle(handle) {
		if (!handle) return;

		handle.addEventListener("pointerdown", function (e) {
			if (e.button !== 0) return;
			if (e.target.closest("button, input, select, textarea, a")) return;

			isDragging = true;
			activePointerId = e.pointerId;
			try {
				handle.setPointerCapture(e.pointerId);
			} catch (_) {}

			startPointerX = e.clientX;
			startPointerY = e.clientY;
			var rect = player.getBoundingClientRect();
			startElemX = rect.left;
			startElemY = rect.top;

			player.classList.add("is-dragging");
		});

		handle.addEventListener("pointermove", function (e) {
			if (!isDragging || e.pointerId !== activePointerId) return;
			var dx = e.clientX - startPointerX;
			var dy = e.clientY - startPointerY;
			var rect = player.getBoundingClientRect();
			var clamped = clampPosition(startElemX + dx, startElemY + dy, rect.width, rect.height);
			applyCoordinates(clamped.x, clamped.y);
		});

		function onPointerUp(e) {
			if (!isDragging || e.pointerId !== activePointerId) return;
			isDragging = false;
			player.classList.remove("is-dragging");
			try {
				handle.releasePointerCapture(e.pointerId);
			} catch (_) {}
			activePointerId = null;

			var rect = player.getBoundingClientRect();
			try {
				localStorage.setItem(STORAGE_POS_KEY, JSON.stringify({
					x: Math.round(rect.left),
					y: Math.round(rect.top)
				}));
			} catch (_) {}
		}

		handle.addEventListener("pointerup", onPointerUp);
		handle.addEventListener("pointercancel", onPointerUp);
	}

	var dragHandles = player.querySelectorAll(".drag-handle");
	for (var i = 0; i < dragHandles.length; i++) {
		bindDragHandle(dragHandles[i]);
	}

	// ── Collapse / Expand Mode ───────────────────────────────
	function setCollapsedState(collapsed, save) {
		player.setAttribute("data-collapsed", collapsed ? "true" : "false");
		if (collapsed) {
			miniMode.classList.remove("hidden");
			miniMode.classList.add("flex");
			expandedMode.classList.remove("flex");
			expandedMode.classList.add("hidden");
		} else {
			miniMode.classList.remove("flex");
			miniMode.classList.add("hidden");
			expandedMode.classList.remove("hidden");
			expandedMode.classList.add("flex");
		}

		if (save !== false) {
			try {
				localStorage.setItem(STORAGE_COLLAPSED_KEY, collapsed ? "1" : "0");
			} catch (_) {}
		}

		requestAnimationFrame(function () {
			ensureInViewport();
		});
	}

	function initCollapsedState() {
		var saved = null;
		try {
			saved = localStorage.getItem(STORAGE_COLLAPSED_KEY);
		} catch (_) {}

		if (saved !== null) {
			setCollapsedState(saved === "1", false);
		} else {
			// Collapsed by default on small screens (< 768px)
			setCollapsedState(window.innerWidth < 768, false);
		}
	}

	initCollapsedState();
	restorePosition();

	window.addEventListener("resize", function () {
		ensureInViewport();
