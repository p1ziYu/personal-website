				ui.btnPlayMini.classList.add("bg-(--btn-regular-bg)", "hover:bg-(--btn-regular-bg-hover)", "active:bg-(--btn-regular-bg-active)", "text-(--primary)");
				if (mIconPlay) mIconPlay.classList.remove("hidden");
				if (mIconPause) mIconPause.classList.add("hidden");
			}
			ui.btnPlayMini.setAttribute("aria-label", label);
