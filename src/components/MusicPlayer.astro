			ui.btnRepeat.className = "btn-repeat p-1.5 rounded-lg active:scale-95 transition-colors " + primary;
			if (ui.iconRepeat) ui.iconRepeat.classList.add("hidden");
			if (ui.iconRepeatOne) ui.iconRepeatOne.classList.add("hidden");
			if (ui.iconShuffle) ui.iconShuffle.classList.remove("hidden");
