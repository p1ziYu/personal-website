---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "金发姑娘的墨水 · 数据墨水实验室";
const description =
	"爱德华·塔夫特（Edward Tufte）数据墨水比交互实验室：擦除图表垃圾，寻找刚刚好的 Goldilocks 甜点位。真实像素采样计算实时墨水比，体验三只熊预设与橡皮擦模式。";
---

<MainGridLayout title={title} description={description}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-5 sm:px-9 py-6 relative w-full">
			<!-- 头部介绍 -->
			<div class="mb-6">
				<div class="flex items-center gap-2 mb-2">
					<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--primary)] text-white">Daily Lab</span>
					<span class="text-xs opacity-60 font-mono">Tufte Data-Ink Ratio · 1983</span>
				</div>
				<h1 class="text-2xl sm:text-3xl font-bold mb-3 tracking-tight">金发姑娘的墨水 · 数据墨水实验室</h1>
				<p class="text-sm opacity-80 leading-relaxed mb-1.5">
					1983 年，爱德华·塔夫特（Edward Tufte）在《定量信息的可视化展示》中提出「数据墨水比」（Data-Ink Ratio = 数据墨水 / 全部墨水），主张删除一切与数据无关的「图表垃圾」（Chartjunk）。
				</p>
				<p class="text-sm opacity-70 leading-relaxed">
					今天我们要探索的交互命题是：在图表彻底丧失可读性之前，你究竟能擦掉多少墨水？最好的图表绝非墨水比达到 1.0 的极端极简，而是处在刚刚好的 Goldilocks 黄金甜点位。
				</p>
			</div>

			<!-- 控制预设与橡皮擦模式条 -->
			<div class="flex flex-wrap items-center justify-between gap-3 p-3.5 mb-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
				<!-- 三只熊预设 -->
				<div class="flex flex-wrap items-center gap-2">
					<span class="text-xs font-medium opacity-60 mr-1">三只熊预设:</span>
					<button
						id="preset-junky"
						type="button"
						class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition"
					>
						🐻 太浓 (Junky)
					</button>
					<button
						id="preset-goldilocks"
						type="button"
						class="preset-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[var(--primary)] text-white shadow-sm active:scale-95 transition"
					>
						👧 刚刚好 (Goldilocks)
					</button>
					<button
						id="preset-bare"
						type="button"
						class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition"
					>
						🐻 太淡 (Too Bare)
					</button>
				</div>

				<!-- 橡皮擦模式开关 -->
				<div class="flex items-center gap-2">
					<button
						id="eraser-btn"
						type="button"
						class="px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-amber-500/40 text-amber-600 dark:text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 active:scale-95 transition flex items-center gap-1.5"
						aria-pressed="false"
					>
						<span class="text-sm">🧽</span>
						<span>橡皮擦模式:</span>
						<span id="eraser-status" class="font-bold">关闭</span>
					</button>
				</div>
			</div>

			<!-- 墨水比实时看板与仪表盘 -->
			<div class="p-4 sm:p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 mb-5">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-3">
					<div>
						<div class="flex items-baseline gap-3">
							<span class="text-xs font-semibold uppercase tracking-wider opacity-60">真实数据墨水比</span>
							<span id="meter-zone-badge" class="px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
								刚刚好 (甜点区)
							</span>
						</div>
						<div class="flex items-baseline gap-2 mt-1">
							<span id="ratio-display" class="text-4xl sm:text-5xl font-extrabold font-mono tracking-tight text-[var(--primary)]">
								0.68
							</span>
							<span id="percent-display" class="text-base sm:text-lg font-mono opacity-60">
								(68.2%)
							</span>
						</div>
					</div>

					<div class="text-xs font-mono opacity-70 sm:text-right space-y-0.5">
						<div>数据墨水: <span id="data-ink-px" class="font-semibold text-black dark:text-white">--</span> px</div>
						<div>全部墨水: <span id="total-ink-px" class="font-semibold text-black dark:text-white">--</span> px</div>
						<div class="text-[11px] opacity-50">双离屏画布逐像素采样 · 真实非拟合</div>
					</div>
				</div>

				<!-- 水平墨水比指示刻度尺 -->
				<div class="relative pt-3 pb-1">
					<div class="h-3 w-full rounded-full overflow-hidden bg-black/15 dark:bg-white/10 relative flex">
						<!-- 色温三段式标尺: 0 - 50% 太浓, 50% - 95% 刚刚好, 95% - 100% 太淡 -->
						<div class="h-full bg-linear-to-r from-rose-500/80 to-amber-500/70" style="width: 50%;"></div>
						<div class="h-full bg-linear-to-r from-emerald-500 to-teal-400" style="width: 45%;"></div>
						<div class="h-full bg-rose-500/90" style="width: 5%;"></div>
					</div>

					<!-- 指示游标 -->
					<div
						id="meter-needle"
						class="absolute top-1 -translate-x-1/2 flex flex-col items-center transition-all duration-300 pointer-events-none"
						style="left: 91%;"
					>
						<div class="w-3.5 h-3.5 rounded-full bg-[var(--primary)] border-2 border-white dark:border-black shadow-md"></div>
						<div class="w-0.5 h-3 bg-[var(--primary)]"></div>
					</div>

					<!-- 刻度标签与区间说明 -->
					<div class="flex justify-between text-[11px] font-mono opacity-50 mt-2 px-1">
						<span>0.0 (纯垃圾)</span>
						<span>0.50 (太浓)</span>
						<span class="text-emerald-500 font-medium">0.85~0.93 (Goldilocks 甜点位)</span>
						<span>0.95 (过度擦除)</span>
						<span>1.0 (纯数据/失去坐标)</span>
					</div>
				</div>
			</div>

			<!-- 主画布容器 -->
			<div class="relative rounded-2xl overflow-hidden bg-[#0d1117] border border-black/15 dark:border-white/15 shadow-2xl mb-5">
				<canvas
					id="ink-canvas"
					class="block w-full touch-none select-none"
					style="height: min(60vh, 480px); min-height: 380px;"
				></canvas>

				<!-- 橡皮擦激活态提示条 -->
				<div
					id="eraser-toast"
					class="absolute top-3 left-3 text-xs bg-amber-500/20 text-amber-200 border border-amber-500/40 backdrop-blur-md px-3 py-1.5 rounded-xl pointer-events-none transition-all duration-200 opacity-0 transform -translate-y-1"
				>
					🧽 橡皮擦激活：点击图表中的多余图层（网格、图例、装饰、背景色块等）直接擦除！
				</div>

				<!-- 动态悬停擦除提示框 -->
				<div
					id="eraser-hover-tip"
					class="absolute pointer-events-none hidden text-xs font-mono px-2.5 py-1 rounded-lg bg-black/85 text-amber-300 border border-amber-500/40 shadow-xl backdrop-blur-sm z-20"
				>
					点击擦除
				</div>
			</div>

			<!-- 独立图层开关面板 -->
			<div class="p-4 sm:p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 mb-6">
				<div class="flex items-center justify-between mb-3.5">
					<h3 class="text-sm font-bold flex items-center gap-2">
						<span>🎨 独立墨水图层控制</span>
						<span class="text-xs font-normal opacity-60">勾选切换图层，实时统计像素</span>
					</h3>
					<span class="text-xs font-mono opacity-50">10 Layers</span>
				</div>

				<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5 text-xs">
					<!-- 图层 1: 数据柱 (锁定开启) -->
					<label class="flex items-center gap-2 p-2.5 rounded-xl border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 cursor-not-allowed opacity-90 select-none">
						<input type="checkbox" id="layer-bars" checked disabled class="accent-[var(--primary)] rounded cursor-not-allowed" />
						<div class="leading-tight">
							<div class="font-semibold flex items-center gap-1">数据柱 <span class="text-[10px] text-emerald-600 dark:text-emerald-400">🔒核心</span></div>
							<div class="text-[10px] opacity-50">纯数据墨水</div>
						</div>
					</label>

					<!-- 图层 2: 网格线 -->
					<label class="layer-item flex items-center gap-2 p-2.5 rounded-xl border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer select-none transition">
						<input type="checkbox" id="layer-grid" class="layer-toggle accent-[var(--primary)] rounded cursor-pointer" />
						<div class="leading-tight">
							<div class="font-semibold">网格线</div>
							<div class="text-[10px] opacity-50">横向虚线背景</div>
						</div>
					</label>

					<!-- 图层 3: 坐标轴线 -->
					<label class="layer-item flex items-center gap-2 p-2.5 rounded-xl border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer select-none transition">
						<input type="checkbox" id="layer-axes" checked class="layer-toggle accent-[var(--primary)] rounded cursor-pointer" />
						<div class="leading-tight">
							<div class="font-semibold">坐标轴线</div>
							<div class="text-[10px] opacity-50">X / Y 实线轴</div>
						</div>
					</label>

					<!-- 图层 4: 刻度标签 -->
					<label class="layer-item flex items-center gap-2 p-2.5 rounded-xl border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer select-none transition">
						<input type="checkbox" id="layer-ticks" checked class="layer-toggle accent-[var(--primary)] rounded cursor-pointer" />
						<div class="leading-tight">
							<div class="font-semibold">刻度标签</div>
							<div class="text-[10px] opacity-50">周一~下周一及数值</div>
						</div>
					</label>

					<!-- 图层 5: 柱子描边 -->
					<label class="layer-item flex items-center gap-2 p-2.5 rounded-xl border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer select-none transition">
						<input type="checkbox" id="layer-outline" class="layer-toggle accent-[var(--primary)] rounded cursor-pointer" />
						<div class="leading-tight">
							<div class="font-semibold">柱子描边</div>
							<div class="text-[10px] opacity-50">粗重亮色轮廓</div>
						</div>
					</label>

					<!-- 图层 6: 渐变填充 -->
					<label class="layer-item flex items-center gap-2 p-2.5 rounded-xl border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer select-none transition">
						<input type="checkbox" id="layer-gradient" class="layer-toggle accent-[var(--primary)] rounded cursor-pointer" />
						<div class="leading-tight">
							<div class="font-semibold">渐变填充</div>
							<div class="text-[10px] opacity-50">高光反光质感</div>
						</div>
					</label>

					<!-- 图层 7: 数据标签 -->
					<label class="layer-item flex items-center gap-2 p-2.5 rounded-xl border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer select-none transition">
						<input type="checkbox" id="layer-dataLabels" checked class="layer-toggle accent-[var(--primary)] rounded cursor-pointer" />
						<div class="leading-tight">
							<div class="font-semibold">数据标签</div>
							<div class="text-[10px] opacity-50">柱顶精确数值</div>
						</div>
					</label>

					<!-- 图层 8: 背景色块 -->
					<label class="layer-item flex items-center gap-2 p-2.5 rounded-xl border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer select-none transition">
						<input type="checkbox" id="layer-zebra" class="layer-toggle accent-[var(--primary)] rounded cursor-pointer" />
						<div class="leading-tight">
							<div class="font-semibold">背景色块</div>
							<div class="text-[10px] opacity-50">斑马相间条纹</div>
						</div>
					</label>

					<!-- 图层 9: 图例框 -->
					<label class="layer-item flex items-center gap-2 p-2.5 rounded-xl border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer select-none transition">
						<input type="checkbox" id="layer-legend" class="layer-toggle accent-[var(--primary)] rounded cursor-pointer" />
						<div class="leading-tight">
							<div class="font-semibold">图例框</div>
							<div class="text-[10px] opacity-50">右上角单指标图例</div>
						</div>
					</label>

					<!-- 图层 10: 装饰挂件 -->
					<label class="layer-item flex items-center gap-2 p-2.5 rounded-xl border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer select-none transition">
						<input type="checkbox" id="layer-decor" class="layer-toggle accent-[var(--primary)] rounded cursor-pointer" />
						<div class="leading-tight">
							<div class="font-semibold">装饰挂件</div>
							<div class="text-[10px] opacity-50">左上徽章与折线</div>
						</div>
					</label>
				</div>
			</div>

			<!-- 可读性自检 -->
			<div class="p-4 sm:p-5 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 mb-8">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
					<div>
						<h3 class="text-sm font-bold flex items-center gap-2">
							<span>🔍 可读性自检：最高的那根柱子数值是多少？</span>
						</h3>
						<p class="text-xs opacity-60 mt-0.5">
							请尝试仅凭上方当前图表中的信息作答，检验过度擦除对读图体验的影响。
						</p>
					</div>

					<div class="flex items-center gap-2">
						<button
							data-quiz="76"
							type="button"
							class="quiz-btn px-4 py-1.5 rounded-xl text-xs font-mono font-bold border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition"
						>
							76
						</button>
						<button
							data-quiz="88"
							type="button"
							class="quiz-btn px-4 py-1.5 rounded-xl text-xs font-mono font-bold border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition"
						>
							88
						</button>
						<button
							data-quiz="95"
							type="button"
							class="quiz-btn px-4 py-1.5 rounded-xl text-xs font-mono font-bold border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition"
						>
							95
						</button>
					</div>
				</div>

				<div id="quiz-feedback" class="text-xs p-3 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 transition leading-relaxed">
					👆 点击上方选项测试答题。如果当前处于「太淡」模式，看看会发生什么。
				</div>
			</div>

			<!-- 三只熊 Explainer 卡片区 -->
			<div class="mb-8">
				<h2 class="text-lg font-bold mb-4 flex items-center gap-2">
					<span>🐻 三只熊的故事：图表设计的三个境界</span>
				</h2>
				<div class="grid sm:grid-cols-3 gap-4">
					<!-- 卡片 1: 太浓 -->
					<div class="p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 flex flex-col justify-between">
						<div>
							<div class="text-2xl mb-2">🐻</div>
							<div class="font-bold text-sm mb-1 text-rose-500">太浓 (Junky)</div>
							<p class="text-xs font-medium opacity-90 leading-relaxed mb-2">
								图表垃圾堆积如山，纯装饰墨水掩盖了核心数据信号。
							</p>
						</div>
						<p class="text-[11px] opacity-60 leading-normal">
							斑马条纹、厚重渐变与花哨挂件大量吞噬墨水，制造强烈的视觉噪音，读者需要费力在垃圾堆里寻找数据。
						</p>
					</div>

					<!-- 卡片 2: 刚刚好 -->
					<div class="p-4 rounded-2xl bg-[var(--primary)]/10 border border-[var(--primary)]/30 flex flex-col justify-between">
						<div>
							<div class="text-2xl mb-2">👧</div>
							<div class="font-bold text-sm mb-1 text-[var(--primary)]">刚刚好 (Goldilocks)</div>
							<p class="text-xs font-medium opacity-90 leading-relaxed mb-2">
								去粗取精的甜点位：去除冗余杂质，保留必要信标。
							</p>
						</div>
						<p class="text-[11px] opacity-60 leading-normal">
							保留清晰轴线、刻度与数值标签，剔除所有纯装饰物。数据墨水比处在黄金平衡点，读者一秒即能精确读数。
						</p>
					</div>

					<!-- 卡片 3: 太淡 -->
					<div class="p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 flex flex-col justify-between">
						<div>
							<div class="text-2xl mb-2">🐻</div>
							<div class="font-bold text-sm mb-1 text-amber-500">太淡 (Too Bare)</div>
							<p class="text-xs font-medium opacity-90 leading-relaxed mb-2">
								极端极简主义摧毁可读性：最大墨水比 ≠ 最好图表。
							</p>
						</div>
						<p class="text-[11px] opacity-60 leading-normal">
							为了追求理论上极限的 1.0 墨水比而擦掉轴线与刻度，图表退化为不可读的谜题。没有参照系，读者只能盲猜。
						</p>
					</div>
				</div>
			</div>

			<hr class="my-6 border-black/10 dark:border-white/10" />

			<!-- 底部版权说明 -->
			<div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-xs opacity-60">
				<div>灵感来源：Edward Tufte (1983) · Hacker News 前页 "Demystifying Tufte's data-ink ratio" (scienceux.org)</div>
				<div>本页面由 AI 生成。</div>
			</div>
		</div>
	</div>

	<script>
		type LayerKey =
			| "bars"
			| "grid"
			| "axes"
			| "ticks"
			| "outline"
			| "gradient"
			| "dataLabels"
			| "zebra"
			| "legend"
			| "decor";

		interface Particle {
			x: number;
			y: number;
			vx: number;
			vy: number;
			alpha: number;
			decay: number;
			size?: number;
			color?: string;
			isText?: boolean;
			text?: string;
		}

		interface HoverTarget {
			layer: LayerKey;
			name: string;
			rect: [number, number, number, number] | null;
			locked?: boolean;
		}

		function initGoldilocksLab() {
			const canvas = document.getElementById("ink-canvas") as HTMLCanvasElement;
			if (!canvas) return;
			const ctx = canvas.getContext("2d") as CanvasRenderingContext2D;
			if (!ctx) return;

			const ratioDisplay = document.getElementById("ratio-display") as HTMLElement;
			const percentDisplay = document.getElementById("percent-display") as HTMLElement;
			const dataInkPxEl = document.getElementById("data-ink-px") as HTMLElement;
			const totalInkPxEl = document.getElementById("total-ink-px") as HTMLElement;
			const meterNeedle = document.getElementById("meter-needle") as HTMLElement;
			const meterZoneBadge = document.getElementById("meter-zone-badge") as HTMLElement;
			const eraserBtn = document.getElementById("eraser-btn") as HTMLElement;
			const eraserStatus = document.getElementById("eraser-status") as HTMLElement;
			const eraserToast = document.getElementById("eraser-toast") as HTMLElement;
			const hoverTip = document.getElementById("eraser-hover-tip") as HTMLElement;
			const quizFeedback = document.getElementById("quiz-feedback") as HTMLElement;

			const presetJunky = document.getElementById("preset-junky") as HTMLElement;
			const presetGoldilocks = document.getElementById("preset-goldilocks") as HTMLElement;
			const presetBare = document.getElementById("preset-bare") as HTMLElement;

			if (
				!ratioDisplay ||
				!percentDisplay ||
				!dataInkPxEl ||
				!totalInkPxEl ||
				!meterNeedle ||
				!meterZoneBadge ||
				!eraserBtn ||
				!eraserStatus ||
				!eraserToast ||
				!hoverTip ||
				!quizFeedback ||
				!presetJunky ||
				!presetGoldilocks ||
				!presetBare
			) {
				return;
			}

			// 8 个合成数据点 (数值介于 20~90 之间)
			const DATA = [
				{ label: "周一", val: 42 },
				{ label: "周二", val: 68 },
				{ label: "周三", val: 35 },
				{ label: "周四", val: 88 }, // 最高柱子
				{ label: "周五", val: 54 },
				{ label: "周六", val: 76 },
				{ label: "周日", val: 61 },
				{ label: "下周一", val: 48 },
			];
			const MAX_VAL = 100;
			const BG_HEX = "#0d1117";
			const BG_RGB = [13, 17, 23];
			const THRESHOLD = 12;

			// 离屏固定基准画布尺寸
			const OFF_W = 800;
			const OFF_H = 450;

			// 图层状态 (初始为刚刚好 Goldilocks)
			const layers: Record<LayerKey, boolean> = {
				bars: true, // 核心，不可关闭
				grid: false,
				axes: true,
				ticks: true,
				outline: false,
				gradient: false,
				dataLabels: true,
				zebra: false,
				legend: false,
				decor: false,
			};

			const layerKeys: LayerKey[] = [
				"bars",
				"grid",
				"axes",
				"ticks",
				"outline",
				"gradient",
				"dataLabels",
				"zebra",
				"legend",
				"decor",
			];

			let eraserMode = false;
			let selectedQuizAnswer: string | null = null;

			const layerInputs: Record<LayerKey, HTMLInputElement | null> = {
				bars: document.getElementById("layer-bars") as HTMLInputElement | null,
				grid: document.getElementById("layer-grid") as HTMLInputElement | null,
				axes: document.getElementById("layer-axes") as HTMLInputElement | null,
				ticks: document.getElementById("layer-ticks") as HTMLInputElement | null,
				outline: document.getElementById("layer-outline") as HTMLInputElement | null,
				gradient: document.getElementById("layer-gradient") as HTMLInputElement | null,
				dataLabels: document.getElementById("layer-dataLabels") as HTMLInputElement | null,
				zebra: document.getElementById("layer-zebra") as HTMLInputElement | null,
				legend: document.getElementById("layer-legend") as HTMLInputElement | null,
				decor: document.getElementById("layer-decor") as HTMLInputElement | null,
			};

			// 创建离屏分析画布
			const offTotalCanvas = document.createElement("canvas");
			offTotalCanvas.width = OFF_W;
			offTotalCanvas.height = OFF_H;
			const offTotalCtx = offTotalCanvas.getContext("2d", { willReadFrequently: true }) as CanvasRenderingContext2D;

			const offDataCanvas = document.createElement("canvas");
			offDataCanvas.width = OFF_W;
			offDataCanvas.height = OFF_H;
			const offDataCtx = offDataCanvas.getContext("2d", { willReadFrequently: true }) as CanvasRenderingContext2D;

			if (!offTotalCtx || !offDataCtx) return;

			// 橡皮擦灰尘粒子系统
			const particles: Particle[] = [];
			function spawnPuff(x: number, y: number, text?: string) {
				for (let i = 0; i < 18; i++) {
					const angle = Math.random() * Math.PI * 2;
					const speed = 1.2 + Math.random() * 3.5;
					particles.push({
						x,
						y,
						vx: Math.cos(angle) * speed,
						vy: Math.sin(angle) * speed - 0.5,
						alpha: 1,
						decay: 0.025 + Math.random() * 0.03,
						size: 2 + Math.random() * 3,
						color: Math.random() > 0.5 ? "#f59e0b" : "#38bdf8",
					});
				}
				if (text) {
					particles.push({
						x,
						y: y - 10,
						vx: 0,
						vy: -0.8,
						alpha: 1,
						decay: 0.015,
						isText: true,
						text: text,
					});
				}
			}

			// 绘制通用函数 (基准 800 x 450)
			function drawChart(targetCtx: CanvasRenderingContext2D, activeLayers: Record<LayerKey, boolean>) {
				const W = OFF_W;
				const H = OFF_H;

				targetCtx.save();
				targetCtx.fillStyle = BG_HEX;
				targetCtx.fillRect(0, 0, W, H);

				const padLeft = 70;
				const padRight = 60;
				const padTop = 75;
				const padBottom = 55;
				const plotX = padLeft;
				const plotY = padTop;
				const plotW = W - padLeft - padRight;
				const plotH = H - padTop - padBottom;
				const slotW = plotW / DATA.length;
				const barW = 28;

				// 1. 背景色块 (zebra bands)
				if (activeLayers.zebra) {
					const bandsCount = 5;
					const bandH = plotH / bandsCount;
					for (let k = 0; k < bandsCount; k++) {
						if (k % 2 === 0) {
							targetCtx.fillStyle = "rgba(255, 255, 255, 0.065)";
							targetCtx.fillRect(plotX, plotY + k * bandH, plotW, bandH);
						}
					}
				}

				// 2. 网格线 (gridlines)
				if (activeLayers.grid) {
					targetCtx.save();
					targetCtx.strokeStyle = "rgba(255, 255, 255, 0.22)";
					targetCtx.lineWidth = 1.2;
					targetCtx.setLineDash([5, 5]);
					for (let v = 20; v <= 100; v += 20) {
						const gy = plotY + plotH - (v / MAX_VAL) * plotH;
						targetCtx.beginPath();
						targetCtx.moveTo(plotX, gy);
						targetCtx.lineTo(plotX + plotW, gy);
						targetCtx.stroke();
					}
					targetCtx.restore();
				}

				// 3. 坐标轴线 (axis lines)
				if (activeLayers.axes) {
					targetCtx.save();
					targetCtx.strokeStyle = "rgba(255, 255, 255, 0.75)";
					targetCtx.lineWidth = 2;
					targetCtx.beginPath();
					targetCtx.moveTo(plotX, plotY + plotH);
					targetCtx.lineTo(plotX + plotW, plotY + plotH);
					targetCtx.moveTo(plotX, plotY);
					targetCtx.lineTo(plotX, plotY + plotH);
					targetCtx.stroke();

					targetCtx.lineWidth = 1.5;
					for (let v = 20; v <= 100; v += 20) {
						const gy = plotY + plotH - (v / MAX_VAL) * plotH;
						targetCtx.beginPath();
						targetCtx.moveTo(plotX - 5, gy);
						targetCtx.lineTo(plotX, gy);
						targetCtx.stroke();
					}
					for (let i = 0; i < DATA.length; i++) {
						const bx = plotX + i * slotW + slotW / 2;
						targetCtx.beginPath();
						targetCtx.moveTo(bx, plotY + plotH);
						targetCtx.lineTo(bx, plotY + plotH + 5);
						targetCtx.stroke();
					}
					targetCtx.restore();
				}

				// 4. 刻度标签 (tick labels)
				if (activeLayers.ticks) {
					targetCtx.save();
					targetCtx.fillStyle = "rgba(255, 255, 255, 0.85)";
					targetCtx.font = "12px system-ui, -apple-system, sans-serif";

					targetCtx.textAlign = "right";
					targetCtx.textBaseline = "middle";
					for (let v = 0; v <= 100; v += 20) {
						const gy = plotY + plotH - (v / MAX_VAL) * plotH;
						targetCtx.fillText(String(v), plotX - 10, gy);
					}

					targetCtx.textAlign = "center";
					targetCtx.textBaseline = "top";
					for (let i = 0; i < DATA.length; i++) {
						const bx = plotX + i * slotW + slotW / 2;
						targetCtx.fillText(DATA[i].label, bx, plotY + plotH + 12);
					}
					targetCtx.restore();
				}

				// 5. 数据柱本体 (data bars)
				for (let i = 0; i < DATA.length; i++) {
					const barX = plotX + i * slotW + (slotW - barW) / 2;
					const barH = (DATA[i].val / MAX_VAL) * plotH;
					const barY = plotY + plotH - barH;

					targetCtx.save();

					if (activeLayers.gradient) {
						const g = targetCtx.createLinearGradient(barX, barY, barX + barW, barY);
						g.addColorStop(0, "#0284c7");
						g.addColorStop(0.35, "#38bdf8");
						g.addColorStop(0.7, "#7dd3fc");
						g.addColorStop(1, "#0369a1");
						targetCtx.fillStyle = g;
						targetCtx.fillRect(barX, barY, barW, barH);

						targetCtx.fillStyle = "rgba(255, 255, 255, 0.45)";
						targetCtx.fillRect(barX + 2, barY + 2, barW - 4, Math.min(12, barH * 0.3));

						targetCtx.fillStyle = "rgba(255, 255, 255, 0.2)";
						targetCtx.fillRect(barX + 4, barY + 2, 4, barH - 4);
					} else {
						targetCtx.fillStyle = "#38bdf8";
						targetCtx.fillRect(barX, barY, barW, barH);
					}

					if (activeLayers.outline) {
						targetCtx.strokeStyle = "#f43f5e";
						targetCtx.lineWidth = 3;
						targetCtx.strokeRect(barX - 1, barY - 1, barW + 2, barH + 2);
					}

					targetCtx.restore();

					if (activeLayers.dataLabels) {
						targetCtx.save();
						targetCtx.font = "bold 13px ui-monospace, SFMono-Regular, Menlo, monospace";
						targetCtx.fillStyle = "#ffffff";
						targetCtx.textAlign = "center";
						targetCtx.textBaseline = "bottom";
						targetCtx.fillText(String(DATA[i].val), barX + barW / 2, barY - 6);
						targetCtx.restore();
					}
				}

				// 9. 图例框 (legend box)
				if (activeLayers.legend) {
					targetCtx.save();
					const legX = W - 185;
					const legY = 16;
					const legW = 165;
					const legH = 46;

					targetCtx.fillStyle = "rgba(30, 41, 59, 0.9)";
					targetCtx.fillRect(legX, legY, legW, legH);
					targetCtx.strokeStyle = "rgba(255, 255, 255, 0.25)";
					targetCtx.lineWidth = 1.2;
					targetCtx.strokeRect(legX, legY, legW, legH);

					targetCtx.fillStyle = "#38bdf8";
					targetCtx.fillRect(legX + 10, legY + 16, 14, 14);

					targetCtx.font = "bold 11px system-ui, -apple-system, sans-serif";
					targetCtx.fillStyle = "#ffffff";
					targetCtx.textAlign = "left";
					targetCtx.textBaseline = "top";
					targetCtx.fillText("活跃指数指标", legX + 32, legY + 11);

					targetCtx.font = "10px system-ui, -apple-system, sans-serif";
					targetCtx.fillStyle = "rgba(255, 255, 255, 0.6)";
					targetCtx.fillText("单位: pts · N=8", legX + 32, legY + 26);
					targetCtx.restore();
				}

				// 10. 装饰挂件 (decorative sparkline/icon in the corner)
				if (activeLayers.decor) {
					targetCtx.save();
					const decX = 18;
					const decY = 14;
					const decW = 215;
					const decH = 48;

					targetCtx.fillStyle = "rgba(15, 23, 42, 0.88)";
					targetCtx.fillRect(decX, decY, decW, decH);
					targetCtx.strokeStyle = "#eab308";
					targetCtx.lineWidth = 1.5;
					targetCtx.strokeRect(decX, decY, decW, decH);

					targetCtx.font = "14px sans-serif";
					targetCtx.fillStyle = "#eab308";
					targetCtx.textAlign = "left";
					targetCtx.textBaseline = "middle";
					targetCtx.fillText("★", decX + 10, decY + 24);

					targetCtx.font = "bold 11px system-ui, -apple-system, sans-serif";
					targetCtx.fillStyle = "#fef08a";
					targetCtx.fillText("业务态势核心监控", decX + 30, decY + 17);

					targetCtx.strokeStyle = "#38bdf8";
					targetCtx.lineWidth = 1.5;
					targetCtx.beginPath();
					targetCtx.moveTo(decX + 30, decY + 34);
					targetCtx.lineTo(decX + 60, decY + 28);
					targetCtx.lineTo(decX + 90, decY + 38);
					targetCtx.lineTo(decX + 130, decY + 26);
					targetCtx.lineTo(decX + 170, decY + 32);
					targetCtx.lineTo(decX + 200, decY + 24);
					targetCtx.stroke();
					targetCtx.restore();
				}

				targetCtx.restore();
			}

			// 真实像素比计算：离屏双重渲染 + 逐像素统计
			function computeHonestRatio() {
				drawChart(offTotalCtx, layers);

				const pureDataLayers: Record<LayerKey, boolean> = {
					bars: true,
					grid: false,
					axes: false,
					ticks: false,
					outline: false,
					gradient: false,
					dataLabels: false,
					zebra: false,
					legend: false,
					decor: false,
				};
				drawChart(offDataCtx, pureDataLayers);

				const totalImg = offTotalCtx.getImageData(0, 0, OFF_W, OFF_H).data;
				const dataImg = offDataCtx.getImageData(0, 0, OFF_W, OFF_H).data;

				let totalInkPx = 0;
				let dataInkPx = 0;

				for (let i = 0; i < totalImg.length; i += 4) {
					const dTr = Math.abs(totalImg[i] - BG_RGB[0]);
					const dTg = Math.abs(totalImg[i + 1] - BG_RGB[1]);
					const dTb = Math.abs(totalImg[i + 2] - BG_RGB[2]);
					if (dTr > THRESHOLD || dTg > THRESHOLD || dTb > THRESHOLD) {
						totalInkPx++;
					}

					const dDr = Math.abs(dataImg[i] - BG_RGB[0]);
					const dDg = Math.abs(dataImg[i + 1] - BG_RGB[1]);
					const dDb = Math.abs(dataImg[i + 2] - BG_RGB[2]);
					if (dDr > THRESHOLD || dDg > THRESHOLD || dDb > THRESHOLD) {
						dataInkPx++;
					}
				}

				const rawRatio = dataInkPx / Math.max(1, totalInkPx);
				const clampedRatio = Math.min(1.0, Math.max(0.01, rawRatio));

				return {
					ratio: clampedRatio,
					dataInkPx,
					totalInkPx,
				};
			}

			// 更新 UI 仪表与状态
			function updateUI() {
				const { ratio, dataInkPx, totalInkPx } = computeHonestRatio();

				ratioDisplay.textContent = ratio.toFixed(2);
				percentDisplay.textContent = `(${(ratio * 100).toFixed(1)}%)`;
				dataInkPxEl.textContent = dataInkPx.toLocaleString();
				totalInkPxEl.textContent = totalInkPx.toLocaleString();

				const percent = Math.min(100, Math.max(0, ratio * 100));
				meterNeedle.style.left = `${percent}%`;

				if (percent < 50) {
					meterZoneBadge.textContent = "太浓 (垃圾过多)";
					meterZoneBadge.className =
						"px-2 py-0.5 rounded-full text-xs font-medium bg-rose-500/20 text-rose-500 border border-rose-500/30";
				} else if (percent > 95) {
					meterZoneBadge.textContent = "太淡 (可读性受损)";
					meterZoneBadge.className =
						"px-2 py-0.5 rounded-full text-xs font-medium bg-amber-500/20 text-amber-500 border border-amber-500/30";
				} else {
					meterZoneBadge.textContent = "刚刚好 (甜点区)";
					meterZoneBadge.className =
						"px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-500 border border-emerald-500/30";
				}

				layerKeys.forEach((key) => {
					const el = layerInputs[key];
					if (el) {
						el.checked = layers[key];
					}
				});

				const isJunky = layerKeys.every((k) => layers[k] === true);
				const isGoldilocks =
					layers.bars &&
					layers.axes &&
					layers.ticks &&
					layers.dataLabels &&
					!layers.grid &&
					!layers.outline &&
					!layers.gradient &&
					!layers.zebra &&
					!layers.legend &&
					!layers.decor;
				const isBare =
					layers.bars &&
					!layers.axes &&
					!layers.ticks &&
					!layers.dataLabels &&
					!layers.grid &&
					!layers.outline &&
					!layers.gradient &&
					!layers.zebra &&
					!layers.legend &&
					!layers.decor;

				presetJunky.className = isJunky
					? "preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-rose-600 text-white shadow-sm active:scale-95 transition"
					: "preset-btn px-3 py-1.5 rounded-xl text-xs font-medium border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition";

				presetGoldilocks.className = isGoldilocks
					? "preset-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[var(--primary)] text-white shadow-sm active:scale-95 transition"
					: "preset-btn px-3.5 py-1.5 rounded-xl text-xs font-medium border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition";

				presetBare.className = isBare
					? "preset-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-amber-600 text-white shadow-sm active:scale-95 transition"
					: "preset-btn px-3 py-1.5 rounded-xl text-xs font-medium border border-black/15 dark:border-white/15 hover:bg-black/5 dark:hover:bg-white/5 active:scale-95 transition";

				renderQuizFeedback();
			}

			// 自检问答渲染
			function renderQuizFeedback() {
				if (!selectedQuizAnswer) {
					quizFeedback.innerHTML = "👆 请点击上方选项测试当前图表的可读性。";
					quizFeedback.className =
						"text-xs p-3 rounded-xl bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 transition leading-relaxed";
					return;
				}

				const isBareState = !layers.ticks && !layers.dataLabels;

				if (isBareState) {
					quizFeedback.innerHTML = `<span class="font-bold text-amber-500">⚠️ 没有刻度标签，你答对了吗？这就是过度擦除的代价。</span><br/>当前图表既没有 Y 轴刻度，也没有数据标签——你只能凭感觉瞎猜！数据墨水比虽然达到了 1.00，但图表已经完全丧失了量化传递信息的核心功能。最高墨水比 ≠ 最好图表。`;
					quizFeedback.className =
						"text-xs p-3 rounded-xl bg-amber-500/15 border border-amber-500/40 text-amber-600 dark:text-amber-300 transition leading-relaxed";
				} else {
					if (selectedQuizAnswer === "88") {
						quizFeedback.innerHTML = `<span class="font-bold text-emerald-600 dark:text-emerald-400">✅ 回答正确！最高柱子是周四（88）。</span><br/>由于图表保留了${layers.ticks && layers.dataLabels ? "纵轴刻度与柱顶数据标签" : layers.ticks ? "纵轴刻度" : "柱顶数据标签"}，读者能一眼获知准确读数。这就是 Goldilocks 甜点位的价值：剔除噪音，保留必要信标。`;
						quizFeedback.className =
							"text-xs p-3 rounded-xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-600 dark:text-emerald-300 transition leading-relaxed";
					} else {
						quizFeedback.innerHTML = `<span class="font-bold text-rose-500">❌ 回答错误！你选了 ${selectedQuizAnswer}，最高柱子实际是 88（周四）。</span><br/>在有刻度/标签的辅助下，你可以通过对照读出正确数值。请重新观察图表尝试。`;
						quizFeedback.className =
							"text-xs p-3 rounded-xl bg-rose-500/15 border border-rose-500/40 text-rose-600 dark:text-rose-300 transition leading-relaxed";
					}
				}
			}

			// 画布自适应重置
			function resizeCanvas() {
				const dpr = Math.min(2, window.devicePixelRatio || 1);
				const rect = canvas.getBoundingClientRect();
				const w = rect.width;
				const h = rect.height;

				canvas.width = Math.max(1, Math.round(w * dpr));
				canvas.height = Math.max(1, Math.round(h * dpr));
			}

			// 主屏渲染动画循环
			let hoverInfo: HoverTarget | null = null;

			function renderMainScreen() {
				const rect = canvas.getBoundingClientRect();
				const dpr = Math.min(2, window.devicePixelRatio || 1);
				const scaleX = rect.width / OFF_W;
				const scaleY = rect.height / OFF_H;

				ctx.save();
				ctx.setTransform(dpr * scaleX, 0, 0, dpr * scaleY, 0, 0);

				drawChart(ctx, layers);

				if (eraserMode && hoverInfo && hoverInfo.layer && layers[hoverInfo.layer]) {
					ctx.save();
					ctx.strokeStyle = "#f59e0b";
					ctx.lineWidth = 2;
					ctx.setLineDash([4, 4]);
					if (hoverInfo.rect) {
						const [rx, ry, rw, rh] = hoverInfo.rect;
						ctx.strokeRect(rx, ry, rw, rh);
					}
					ctx.restore();
				}

				for (let i = particles.length - 1; i >= 0; i--) {
					const p = particles[i];
					p.alpha -= p.decay;
					if (p.alpha <= 0) {
						particles.splice(i, 1);
						continue;
					}
					p.x += p.vx;
					p.y += p.vy;

					ctx.save();
					ctx.globalAlpha = p.alpha;
					if (p.isText && p.text) {
						ctx.font = "bold 12px monospace";
						ctx.fillStyle = "#f59e0b";
						ctx.textAlign = "center";
						ctx.fillText(p.text, p.x, p.y);
					} else {
						ctx.fillStyle = p.color || "#38bdf8";
						ctx.beginPath();
						ctx.arc(p.x, p.y, p.size || 2, 0, Math.PI * 2);
						ctx.fill();
					}
					ctx.restore();
				}

				ctx.restore();
				requestAnimationFrame(renderMainScreen);
			}

			function hitTestErasableLayer(mx: number, my: number): HoverTarget | null {
				const padLeft = 70;
				const padRight = 60;
				const padTop = 75;
				const padBottom = 55;
				const plotX = padLeft;
				const plotY = padTop;
				const plotW = OFF_W - padLeft - padRight;
				const plotH = OFF_H - padTop - padBottom;
				const slotW = plotW / DATA.length;
				const barW = 28;

				// 1. 装饰挂件区域
				if (layers.decor && mx >= 18 && mx <= 233 && my >= 14 && my <= 62) {
					return { layer: "decor", name: "装饰挂件", rect: [18, 14, 215, 48] };
				}

				// 2. 图例区域
				if (layers.legend && mx >= OFF_W - 185 && mx <= OFF_W - 20 && my >= 16 && my <= 62) {
					return { layer: "legend", name: "图例框", rect: [OFF_W - 185, 16, 165, 46] };
				}

				// 3. 数据标签区域
				if (layers.dataLabels) {
					for (let i = 0; i < DATA.length; i++) {
						const bx = plotX + i * slotW + (slotW - barW) / 2;
						const bh = (DATA[i].val / MAX_VAL) * plotH;
						const by = plotY + plotH - bh;
						if (mx >= bx - 8 && mx <= bx + barW + 8 && my >= by - 26 && my <= by + 2) {
							return { layer: "dataLabels", name: "数据标签", rect: [plotX, plotY - 26, plotW, 30] };
						}
					}
				}

				// 4. 柱体边缘与渐变
				for (let i = 0; i < DATA.length; i++) {
					const bx = plotX + i * slotW + (slotW - barW) / 2;
					const bh = (DATA[i].val / MAX_VAL) * plotH;
					const by = plotY + plotH - bh;
					if (mx >= bx && mx <= bx + barW && my >= by && my <= by + bh) {
						if (layers.outline) {
							return { layer: "outline", name: "柱子描边", rect: [bx - 2, by - 2, barW + 4, bh + 4] };
						}
						if (layers.gradient) {
							return { layer: "gradient", name: "渐变高光", rect: [bx, by, barW, bh] };
						}
						return { layer: "bars", name: "数据柱 (不可擦除)", rect: null, locked: true };
					}
				}

				// 5. 刻度标签
				if (layers.ticks) {
					if (mx >= 5 && mx <= plotX && my >= plotY - 10 && my <= plotY + plotH + 10) {
						return { layer: "ticks", name: "Y 轴刻度标签", rect: [10, plotY - 10, plotX - 10, plotH + 20] };
					}
					if (mx >= plotX && mx <= plotX + plotW && my >= plotY + plotH + 5 && my <= OFF_H) {
						return { layer: "ticks", name: "X 轴刻度标签", rect: [plotX, plotY + plotH + 5, plotW, 40] };
					}
				}

				// 6. 坐标轴线
				if (layers.axes) {
					const onYAxis = Math.abs(mx - plotX) <= 8 && my >= plotY && my <= plotY + plotH;
					const onXAxis = Math.abs(my - (plotY + plotH)) <= 8 && mx >= plotX && mx <= plotX + plotW;
					if (onYAxis || onXAxis) {
						return { layer: "axes", name: "坐标轴线", rect: [plotX - 4, plotY, plotW + 4, plotH + 4] };
					}
				}

				// 7. 网格线 / 背景条纹
				if (mx >= plotX && mx <= plotX + plotW && my >= plotY && my <= plotY + plotH) {
					if (layers.grid) {
						return { layer: "grid", name: "网格线", rect: [plotX, plotY, plotW, plotH] };
					}
					if (layers.zebra) {
						return { layer: "zebra", name: "背景色块", rect: [plotX, plotY, plotW, plotH] };
					}
				}

				return null;
			}

			function getBaseCoords(e: PointerEvent | MouseEvent) {
				const rect = canvas.getBoundingClientRect();
				const px = e.clientX - rect.left;
				const py = e.clientY - rect.top;
				const bx = (px / rect.width) * OFF_W;
				const by = (py / rect.height) * OFF_H;
				return { bx, by, px, py };
			}

			canvas.addEventListener("pointermove", (e: PointerEvent) => {
				if (!eraserMode) {
					hoverInfo = null;
					hoverTip.classList.add("hidden");
					return;
				}

				const { bx, by, px, py } = getBaseCoords(e);
				const hit = hitTestErasableLayer(bx, by);
				hoverInfo = hit;

				if (hit && !hit.locked) {
					canvas.style.cursor = "pointer";
					hoverTip.textContent = `🧹 点击擦除: ${hit.name}`;
					hoverTip.style.left = `${Math.min(canvas.clientWidth - 140, Math.max(10, px + 12))}px`;
					hoverTip.style.top = `${Math.min(canvas.clientHeight - 35, Math.max(10, py + 12))}px`;
					hoverTip.classList.remove("hidden");
				} else if (hit && hit.locked) {
					canvas.style.cursor = "not-allowed";
					hoverTip.textContent = "🔒 数据柱核心不可擦除";
					hoverTip.style.left = `${Math.min(canvas.clientWidth - 160, Math.max(10, px + 12))}px`;
					hoverTip.style.top = `${Math.min(canvas.clientHeight - 35, Math.max(10, py + 12))}px`;
					hoverTip.classList.remove("hidden");
				} else {
					canvas.style.cursor = "crosshair";
					hoverTip.classList.add("hidden");
				}
			});

			canvas.addEventListener("pointerleave", () => {
				hoverInfo = null;
				hoverTip.classList.add("hidden");
			});

			canvas.addEventListener("pointerdown", (e: PointerEvent) => {
				if (!eraserMode) return;
				const { bx, by } = getBaseCoords(e);
				const hit = hitTestErasableLayer(bx, by);

				if (!hit) {
					if (layers.grid) {
						layers.grid = false;
						spawnPuff(bx, by, "-网格线!");
						updateUI();
					} else if (layers.zebra) {
						layers.zebra = false;
						spawnPuff(bx, by, "-背景色块!");
						updateUI();
					}
					return;
				}

				if (hit.locked) {
					spawnPuff(bx, by, "🔒核心数据不可擦除");
					return;
				}

				if (layers[hit.layer]) {
					layers[hit.layer] = false;
					spawnPuff(bx, by, `-${hit.name}!`);
					updateUI();
				}
			});

			presetJunky.addEventListener("click", () => {
				layerKeys.forEach((k) => {
					layers[k] = true;
				});
				updateUI();
			});

			presetGoldilocks.addEventListener("click", () => {
				layers.bars = true;
				layers.axes = true;
				layers.ticks = true;
				layers.dataLabels = true;
				layers.grid = false;
				layers.outline = false;
				layers.gradient = false;
				layers.zebra = false;
				layers.legend = false;
				layers.decor = false;
				updateUI();
			});

			presetBare.addEventListener("click", () => {
				layers.bars = true;
				layers.axes = false;
				layers.ticks = false;
				layers.dataLabels = false;
				layers.grid = false;
				layers.outline = false;
				layers.gradient = false;
				layers.zebra = false;
				layers.legend = false;
				layers.decor = false;
				updateUI();
			});

			eraserBtn.addEventListener("click", () => {
				eraserMode = !eraserMode;
				eraserStatus.textContent = eraserMode ? "已开启" : "关闭";
				eraserBtn.setAttribute("aria-pressed", String(eraserMode));

				if (eraserMode) {
					eraserBtn.classList.add("bg-amber-500", "text-black", "dark:text-black", "shadow-md");
					eraserBtn.classList.remove("text-amber-600", "dark:text-amber-400", "bg-amber-500/10");
					eraserToast.classList.remove("opacity-0", "-translate-y-1");
					canvas.style.cursor = "crosshair";
				} else {
					eraserBtn.classList.remove("bg-amber-500", "text-black", "dark:text-black", "shadow-md");
					eraserBtn.classList.add("text-amber-600", "dark:text-amber-400", "bg-amber-500/10");
					eraserToast.classList.add("opacity-0", "-translate-y-1");
					canvas.style.cursor = "default";
					hoverTip.classList.add("hidden");
					hoverInfo = null;
				}
			});

			layerKeys.forEach((key) => {
				const input = layerInputs[key];
				if (!input || key === "bars") return;
				input.addEventListener("change", (e: Event) => {
					layers[key] = (e.target as HTMLInputElement).checked;
					updateUI();
				});
			});

			const quizBtns = document.querySelectorAll(".quiz-btn");
			quizBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					selectedQuizAnswer = (btn as HTMLElement).dataset.quiz || null;
					quizBtns.forEach((b) => {
						const isSel = b === btn;
						b.classList.toggle("bg-[var(--primary)]", isSel);
						b.classList.toggle("text-white", isSel);
					});
					renderQuizFeedback();
				});
			});

			let rszTimer: ReturnType<typeof setTimeout> | undefined;
			window.addEventListener("resize", () => {
				clearTimeout(rszTimer);
				rszTimer = setTimeout(() => {
					resizeCanvas();
					updateUI();
				}, 100);
			});

			resizeCanvas();
			updateUI();
			requestAnimationFrame(renderMainScreen);
		}

		initGoldilocksLab();
		document.addEventListener("astro:page-load", initGoldilocksLab);
	</script>
</MainGridLayout>
